          {
            "type": "calculated",
            "name": "BotFriendlyName",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "VAR schema = 'Agent Performance'[BotName]",
              "VAR fromCatalogue =",
              "    LOOKUPVALUE (",
              "        'Agent Catalogue'[agent_display_name],",
              "        'Agent Catalogue'[agent_schema], schema",
              "    )",
              "RETURN",
              "    SWITCH (",
              "        schema,",
              "        \"msdyn_copilotforemployeeselfserviceit\", \"IT Self-Service\",",
              "        \"msdyn_copilotforemployeeselfservicehr\", \"HR Self-Service\",",
              "        \"cat_adaptiveCardGallery\", \"Adaptive Card Gallery\",",
              "        COALESCE ( fromCatalogue, schema )",
              "    )"
            ],
            "lineageTag": "a7b24cb8-02ea-4d50-bce4-3e0fb02f7d7e",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "ConversationType",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "VAR FirstUser = LOWER('Agent Performance'[FirstUserMessage])",
              "VAR TopicCount = 'Agent Performance'[TopicCount]",
              "VAR TurnCount = 'Agent Performance'[TurnCount]",
              "",
              "VAR Category =",
              "    IF(",
              "        TopicCount = 0,",
              "        \"🚫 Unengaged\",",
              "        IF(",
              "            TopicCount = 1 && TurnCount <= 2,",
              "            \"⚡ Quick Info\",",
              "            IF(",
              "                TopicCount >= 3,",
              "                \"🔀 Multi-Topic\",",
              "                IF(",
              "                    TurnCount >= 5,",
              "                    \"💬 Extended\",",
              "                    IF(",
              "                        CONTAINSSTRING(FirstUser, \"error\") ||",
              "                        CONTAINSSTRING(FirstUser, \"issue\") ||",
              "                        CONTAINSSTRING(FirstUser, \"problem\") ||",
              "                        CONTAINSSTRING(FirstUser, \"not working\") ||",
              "                        CONTAINSSTRING(FirstUser, \"broken\"),",
              "                        \"🔧 Troubleshooting\",",
              "                        \"❓ Standard\"",
              "                    )",
              "                )",
              "            )",
              "        )",
              "    )",
              "",
              "RETURN Category"
            ],
            "lineageTag": "4d9268d0-2b8d-482b-b4b1-a458228dccdb",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "PromptLength",
            "dataType": "int64",
            "description": "Character count of first user message — used by Prompt Quality Score",
            "expression": [
              "IF(",
              "    ISBLANK('Agent Performance'[FirstUserMessage]),",
              "    0,",
              "    LEN('Agent Performance'[FirstUserMessage])",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "b1c2d3e4-0002-0001-0001-000000000001",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "PromptQualityScore",
            "dataType": "int64",
            "description": "Composite score (0–100) rating user prompt quality based on outcome, efficiency, errors, and specificity",
            "expression": [
              "VAR IsEngaged = 'Agent Performance'[SessionType] = \"Engaged\"",
              "VAR Outcome = 'Agent Performance'[SessionOutcome]",
              "VAR Turns = 'Agent Performance'[TurnCount]",
              "VAR Reason = 'Agent Performance'[OutcomeReason]",
              "VAR MsgLen = 'Agent Performance'[PromptLength]",
              "",
              "// 1. Engagement (15 pts) — did the prompt engage the bot?",
              "VAR EngagePts = IF(IsEngaged, 15, 0)",
              "",
              "// 2. Resolution (35 pts) — ultimate success signal",
              "VAR ResolvePts =",
              "    SWITCH(Outcome,",
              "        \"Resolved\", 35,",
              "        \"Abandoned\", 5,",
              "        \"Escalated\", 15,",
              "        0",
              "    )",
              "",
              "// 3. Turn efficiency (20 pts) — fewer turns to resolve = clearer prompt",
              "VAR TurnPts =",
              "    IF(NOT IsEngaged, 0,",
              "        IF(Outcome = \"Resolved\",",
              "            IF(Turns <= 3, 20, IF(Turns <= 5, 15, IF(Turns <= 8, 10, 5))),",
              "            IF(Turns <= 2, 5,",
              "                IF(Turns <= 5, 8,",
              "                    IF(Turns <= 8, 5, 2)))",
              "        )",
              "    )",
              "",
              "// 4. Error-free (10 pts) — no system/user errors",
              "VAR ErrorPts =",
              "    IF(Reason = \"SystemError\", 0,",
              "        IF(Reason = \"UserError\", 3, 10)",
              "    )",
              "",
              "// 5. Implied success (10 pts)",
              "VAR SuccessPts = IF(UPPER('Agent Performance'[ImpliedSuccess] & \"\") = \"TRUE\", 10, 0)",
              "",
              "// 6. Prompt specificity (10 pts) — based on message length",
              "VAR SpecPts =",
              "    IF(MsgLen = 0, 0,",
              "        IF(MsgLen < 15, 2,",
              "            IF(MsgLen <= 40, 5,",
              "                IF(MsgLen <= 100, 10, 8)",
              "            )",
              "        )",
              "    )",
              "",
              "VAR RawScore = EngagePts + ResolvePts + TurnPts + ErrorPts + SuccessPts + SpecPts",
              "",
              "RETURN MIN(RawScore, 100)"
            ],
            "formatString": "#,0",
            "lineageTag": "b1c2d3e4-0002-0001-0002-000000000001",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "ConversationComplexity",
            "dataType": "int64",
            "description": "Numeric complexity score (0–5) for averaging at agent/group level",
            "expression": [
              "SWITCH(",
              "    'Agent Performance'[ConversationType],",
              "    \"🚫 Unengaged\", 0,",
              "    \"⚡ Quick Info\", 1,",
              "    \"❓ Standard\", 2,",
              "    \"🔧 Troubleshooting\", 3,",
              "    \"💬 Extended\", 4,",
              "    \"🔀 Multi-Topic\", 5,",
              "    2",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "b1c2d3e4-0002-0002-0001-000000000001",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Topic Theme",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": [
              "Higher-level grouping of PrimaryTopic for the Topic Themes treemap / slicer.",
              "Quick-win keyword bucketing — swap for a Topic Theme Mapping table when ready."
            ],
            "expression": [
              "VAR t = LOWER ( 'Agent Performance'[Topic (resolved)] )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( t ) || t = \"\", \"Untagged\",",
              "        LEFT ( t, 1 ) = UNICHAR ( 128683 ) || LEFT ( t, 1 ) = UNICHAR ( 9888 ), \"Filtered\",",
              "        CONTAINSSTRING ( t, \"password\" ) || CONTAINSSTRING ( t, \"mfa\" ) || CONTAINSSTRING ( t, \"login\" ) || CONTAINSSTRING ( t, \"vpn\" ) || CONTAINSSTRING ( t, \"access\" ) || CONTAINSSTRING ( t, \"software\" ) || CONTAINSSTRING ( t, \"hardware\" ) || CONTAINSSTRING ( t, \"printer\" ) || CONTAINSSTRING ( t, \"mailbox\" ) || CONTAINSSTRING ( t, \"equipment\" ) || CONTAINSSTRING ( t, \"device\" ) || CONTAINSSTRING ( t, \"laptop\" ) || CONTAINSSTRING ( t, \"install\" ), \"IT & Access\",",
              "        CONTAINSSTRING ( t, \"payroll\" ) || CONTAINSSTRING ( t, \"payslip\" ) || CONTAINSSTRING ( t, \"pension\" ) || CONTAINSSTRING ( t, \"tax\" ) || CONTAINSSTRING ( t, \"mileage\" ) || CONTAINSSTRING ( t, \"overtime\" ) || CONTAINSSTRING ( t, \"expense\" ) || CONTAINSSTRING ( t, \"reimburse\" ) || CONTAINSSTRING ( t, \"invoice\" ) || CONTAINSSTRING ( t, \"salary\" ), \"Pay & Expenses\",",
              "        CONTAINSSTRING ( t, \"purchase\" ) || CONTAINSSTRING ( t, \"supplier\" ) || CONTAINSSTRING ( t, \"contract\" ) || CONTAINSSTRING ( t, \"procure\" ) || CONTAINSSTRING ( t, \"vendor\" ), \"Procurement\",",
              "        CONTAINSSTRING ( t, \"leave\" ) || CONTAINSSTRING ( t, \"holiday\" ) || CONTAINSSTRING ( t, \"absence\" ) || CONTAINSSTRING ( t, \"sickness\" ) || CONTAINSSTRING ( t, \"onboard\" ) || CONTAINSSTRING ( t, \"buddy\" ) || CONTAINSSTRING ( t, \"firstday\" ) || CONTAINSSTRING ( t, \"first day\" ) || CONTAINSSTRING ( t, \"training\" ) || CONTAINSSTRING ( t, \"visa\" ) || CONTAINSSTRING ( t, \"joiner\" ), \"HR & People\",",
              "        CONTAINSSTRING ( t, \"desk\" ) || CONTAINSSTRING ( t, \"meeting\" ) || CONTAINSSTRING ( t, \"room\" ) || CONTAINSSTRING ( t, \"maintenance\" ) || CONTAINSSTRING ( t, \"facilit\" ) || CONTAINSSTRING ( t, \"travel\" ) || CONTAINSSTRING ( t, \"book\" ), \"Workplace & Travel\",",
              "        CONTAINSSTRING ( t, \"policy\" ) || CONTAINSSTRING ( t, \"compliance\" ) || CONTAINSSTRING ( t, \"benefit\" ) || CONTAINSSTRING ( t, \"carryover\" ) || CONTAINSSTRING ( t, \"carry over\" ), \"Policy\",",
              "        CONTAINSSTRING ( t, \"general\" ) || CONTAINSSTRING ( t, \"route\" ), \"General & Routing\",",
              "        \"Other\"",
              "    )"
            ],
            "lineageTag": "ap0topic-col0-0001-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Topic (resolved)",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "VAR classic = 'Agent Performance'[PrimaryTopic]",
              "VAR lc = LOWER(classic)",
              "VAR isSystemClassic = CONTAINSSTRING(lc, \"[system]\") || lc = \"logging\" || lc = \"greeting\" || CONTAINSSTRING(lc, \"conversation start\")",
              "VAR m = LOWER(TRIM('Agent Performance'[FirstUserMessage]))",
              "VAR intent = LOWER(COALESCE('Agent Performance'[Conversation Intent], \"\"))",
              "VAR mi = TRIM(m & \" \" & intent)",
              "VAR derived =",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(m) || m = \"\", \"🚫 No message\",",
              "        CONTAINSSTRING(m, \"have access to talk to this bot\") || CONTAINSSTRING(m, \"contact the owner\"), \"🚫 No Access (system)\",",
              "        LEFT(m, 1) = \"/\", \"🚫 Command\",",
              "        m IN {\"hi\", \"hey\", \"hello\", \"test\", \"ok\", \"thanks\", \"thank you\"}, \"🚫 Greeting\",",
              "        CONTAINSSTRING(m, \"what this agent can do\") || CONTAINSSTRING(m, \"what can you do\") || CONTAINSSTRING(m, \"example of what\"), \"🚫 Capability probe\",",
              "        CONTAINSSTRING(m, \"suicid\") || CONTAINSSTRING(m, \"harm myself\") || CONTAINSSTRING(m, \"kill myself\"), \"⚠ Safety / Wellbeing\",",
              "        CONTAINSSTRING(m, \"threat\") || CONTAINSSTRING(m, \"scare\") || CONTAINSSTRING(m, \"ignore previous\") || CONTAINSSTRING(m, \"pretend you\"), \"⚠ Misuse / Jailbreak\",",
              "        CONTAINSSTRING(m, \"is this valid\") || CONTAINSSTRING(m, \"is this correct\"), \"⚠ PII / Validation\",",
              "        CONTAINSSTRING(mi,\"leave\") || CONTAINSSTRING(mi,\"holiday\") || CONTAINSSTRING(mi,\"vacation\") || CONTAINSSTRING(mi,\"time off\") || CONTAINSSTRING(mi,\"day off\") || CONTAINSSTRING(mi,\"absence\") || CONTAINSSTRING(mi,\"sick\") || CONTAINSSTRING(mi,\"paternity\") || CONTAINSSTRING(mi,\"maternity\") || CONTAINSSTRING(mi,\"parental\") || CONTAINSSTRING(mi,\"carer\") || CONTAINSSTRING(mi,\"compassionate\") || CONTAINSSTRING(mi,\"bereavement\") || CONTAINSSTRING(mi,\"sabbatical\") || CONTAINSSTRING(mi,\"redundan\"), \"Leave & Absence\",",
              "        CONTAINSSTRING(mi,\"payslip\") || CONTAINSSTRING(mi,\"pay slip\") || CONTAINSSTRING(mi,\"payroll\") || CONTAINSSTRING(mi,\"salary\") || CONTAINSSTRING(mi,\"wage\") || CONTAINSSTRING(mi,\"pay rise\") || CONTAINSSTRING(mi,\"pay review\") || CONTAINSSTRING(mi,\"bonus\") || CONTAINSSTRING(mi,\"commission\") || CONTAINSSTRING(mi,\"overtime\") || CONTAINSSTRING(mi,\"expense\") || CONTAINSSTRING(mi,\"reimburse\") || CONTAINSSTRING(mi,\"allowance\") || CONTAINSSTRING(mi,\"tax code\") || CONTAINSSTRING(mi,\"p60\") || CONTAINSSTRING(mi,\"p45\"), \"Pay & Payroll\",",
              "        CONTAINSSTRING(mi,\"benefit\") || CONTAINSSTRING(mi,\"pension\") || CONTAINSSTRING(mi,\"retirement\") || CONTAINSSTRING(mi,\"insurance\") || CONTAINSSTRING(mi,\"healthcare\") || CONTAINSSTRING(mi,\"dental\") || CONTAINSSTRING(mi,\"perk\") || CONTAINSSTRING(mi,\"discount\") || CONTAINSSTRING(mi,\"cycle to work\") || CONTAINSSTRING(mi,\"share scheme\") || CONTAINSSTRING(mi,\"wellbeing\") || CONTAINSSTRING(mi,\"well-being\") || CONTAINSSTRING(mi,\"childcare\"), \"Benefits & Pension\",",
              "        CONTAINSSTRING(mi,\"recruit\") || CONTAINSSTRING(mi,\"hiring\") || CONTAINSSTRING(mi,\"interview\") || CONTAINSSTRING(mi,\"candidate\") || CONTAINSSTRING(mi,\"vacancy\") || CONTAINSSTRING(mi,\"job role\") || CONTAINSSTRING(mi,\"job description\") || CONTAINSSTRING(mi,\"applicant\") || CONTAINSSTRING(mi,\"offer letter\") || CONTAINSSTRING(mi,\"referral\") || CONTAINSSTRING(mi,\"secondment\"), \"Recruitment & Hiring\",",
              "        CONTAINSSTRING(mi,\"onboard\") || CONTAINSSTRING(mi,\"new joiner\") || CONTAINSSTRING(mi,\"new starter\") || CONTAINSSTRING(mi,\"induction\") || CONTAINSSTRING(mi,\"starter\") || CONTAINSSTRING(mi,\"first day\") || CONTAINSSTRING(mi,\"probation\") || CONTAINSSTRING(mi,\"employment letter\") || CONTAINSSTRING(mi,\"right to work\"), \"Onboarding & Joiner\",",
              "        CONTAINSSTRING(mi,\"password\") || CONTAINSSTRING(mi,\"login\") || CONTAINSSTRING(mi,\"log in\") || CONTAINSSTRING(mi,\"sign in\") || CONTAINSSTRING(mi,\"log on\") || CONTAINSSTRING(mi,\"access\") || CONTAINSSTRING(mi,\"permission\") || CONTAINSSTRING(mi,\"mfa\") || CONTAINSSTRING(mi,\"2fa\") || CONTAINSSTRING(mi,\"authenticator\") || CONTAINSSTRING(mi,\"vpn\") || CONTAINSSTRING(mi,\"reset\") || CONTAINSSTRING(mi,\"unlock\") || CONTAINSSTRING(mi,\"locked out\") || CONTAINSSTRING(mi,\"email\") || CONTAINSSTRING(mi,\"mailbox\") || CONTAINSSTRING(mi,\"network\") || CONTAINSSTRING(mi,\"wifi\") || CONTAINSSTRING(mi,\"wi-fi\") || CONTAINSSTRING(mi,\"device\") || CONTAINSSTRING(mi,\"laptop\") || CONTAINSSTRING(mi,\"printer\") || CONTAINSSTRING(mi,\"phone\") || CONTAINSSTRING(mi,\"service desk\") || CONTAINSSTRING(mi,\"help desk\") || CONTAINSSTRING(mi,\"helpdesk\") || CONTAINSSTRING(mi,\"ticket\") || CONTAINSSTRING(mi,\"incident\") || CONTAINSSTRING(mi,\"outage\"), \"IT, Access & Devices\",",
              "        CONTAINSSTRING(mi,\"software\") || CONTAINSSTRING(mi,\"application\") || CONTAINSSTRING(mi,\"install\") || CONTAINSSTRING(mi,\"licen\") || CONTAINSSTRING(mi,\"subscription\") || CONTAINSSTRING(mi,\"upgrade\") || CONTAINSSTRING(mi,\"excel\") || CONTAINSSTRING(mi,\"word\") || CONTAINSSTRING(mi,\"powerpoint\") || CONTAINSSTRING(mi,\"teams\") || CONTAINSSTRING(mi,\"sharepoint\") || CONTAINSSTRING(mi,\"onedrive\") || CONTAINSSTRING(mi,\"power bi\") || CONTAINSSTRING(mi,\"sap\") || CONTAINSSTRING(mi,\"salesforce\"), \"Software & Applications\",",
              "        CONTAINSSTRING(mi,\"policy\") || CONTAINSSTRING(mi,\"policies\") || CONTAINSSTRING(mi,\"procedure\") || CONTAINSSTRING(mi,\"code of conduct\") || CONTAINSSTRING(mi,\"compliance\") || CONTAINSSTRING(mi,\"regulation\") || CONTAINSSTRING(mi,\"contract\") || CONTAINSSTRING(mi,\"terms and condition\") || CONTAINSSTRING(mi,\"terms\") || CONTAINSSTRING(mi,\"gdpr\") || CONTAINSSTRING(mi,\"data protection\") || CONTAINSSTRING(mi,\"legal\") || CONTAINSSTRING(mi,\"audit\") || CONTAINSSTRING(mi,\"governance\") || CONTAINSSTRING(mi,\"documentation\") || CONTAINSSTRING(mi,\"process\") || CONTAINSSTRING(mi,\"notice period\") || CONTAINSSTRING(mi,\"disciplinary\") || CONTAINSSTRING(mi,\"grievance\") || CONTAINSSTRING(mi,\"flexible working\") || CONTAINSSTRING(mi,\"working from home\") || CONTAINSSTRING(mi,\"hybrid\"), \"Policy, Contracts & Compliance\",",
              "        CONTAINSSTRING(mi,\"office\") || CONTAINSSTRING(mi,\"building\") || CONTAINSSTRING(mi,\"desk\") || CONTAINSSTRING(mi,\"parking\") || CONTAINSSTRING(mi,\"car park\") || CONTAINSSTRING(mi,\"meeting room\") || CONTAINSSTRING(mi,\"facilities\") || CONTAINSSTRING(mi,\"attendance\") || CONTAINSSTRING(mi,\"badge\") || CONTAINSSTRING(mi,\"access card\") || CONTAINSSTRING(mi,\"id card\") || CONTAINSSTRING(mi,\"canteen\") || CONTAINSSTRING(mi,\"maintenance\") || CONTAINSSTRING(mi,\"health and safety\") || CONTAINSSTRING(mi,\"first aid\") || CONTAINSSTRING(mi,\"reception\"), \"Facilities & Workplace\",",
              "        CONTAINSSTRING(mi,\"who is\") || CONTAINSSTRING(mi,\"who's\") || CONTAINSSTRING(mi,\"contact details\") || CONTAINSSTRING(mi,\"contact number\") || CONTAINSSTRING(mi,\"directory\") || CONTAINSSTRING(mi,\"org chart\") || CONTAINSSTRING(mi,\"organisation chart\") || CONTAINSSTRING(mi,\"organization chart\") || CONTAINSSTRING(mi,\"reporting line\") || CONTAINSSTRING(mi,\"line manager\") || CONTAINSSTRING(mi,\"phone number\") || CONTAINSSTRING(mi,\"email address\") || CONTAINSSTRING(mi,\"find someone\"), \"People & Directory\",",
              "        CONTAINSSTRING(mi,\"customer\") || CONTAINSSTRING(mi,\"client\") || CONTAINSSTRING(mi,\"sales\") || CONTAINSSTRING(mi,\"invoice\") || CONTAINSSTRING(mi,\"billing\") || CONTAINSSTRING(mi,\"account manager\") || CONTAINSSTRING(mi,\"crm\") || CONTAINSSTRING(mi,\"quote\") || CONTAINSSTRING(mi,\"opportunity\") || CONTAINSSTRING(mi,\"complaint\") || CONTAINSSTRING(mi,\"refund\") || CONTAINSSTRING(mi,\"delivery\") || CONTAINSSTRING(mi,\"tariff\"), \"Customer, Sales & Orders\",",
              "        CONTAINSSTRING(mi,\"purchas\") || CONTAINSSTRING(mi,\"procurement\") || CONTAINSSTRING(mi,\"supplier\") || CONTAINSSTRING(mi,\"vendor\") || CONTAINSSTRING(mi,\"budget\") || CONTAINSSTRING(mi,\"finance\") || CONTAINSSTRING(mi,\"cost centre\") || CONTAINSSTRING(mi,\"cost center\") || CONTAINSSTRING(mi,\"purchase order\") || CONTAINSSTRING(mi,\"expense claim\") || CONTAINSSTRING(mi,\"forecast\"), \"Finance & Procurement\",",
              "        CONTAINSSTRING(mi,\"report\") || CONTAINSSTRING(mi,\"dashboard\") || CONTAINSSTRING(mi,\"metric\") || CONTAINSSTRING(mi,\"kpi\") || CONTAINSSTRING(mi,\"analytics\") || CONTAINSSTRING(mi,\"figures\") || CONTAINSSTRING(mi,\"statistics\") || CONTAINSSTRING(mi,\"export\"), \"Data, Reporting & Analytics\",",
              "        CONTAINSSTRING(mi,\"api\") || CONTAINSSTRING(mi,\"deployment\") || CONTAINSSTRING(mi,\"server\") || CONTAINSSTRING(mi,\"database\") || CONTAINSSTRING(mi,\"integration\") || CONTAINSSTRING(mi,\"configuration\") || CONTAINSSTRING(mi,\"fibre\") || CONTAINSSTRING(mi,\"ethernet\") || CONTAINSSTRING(mi,\"cable\") || CONTAINSSTRING(mi,\"broadband\") || CONTAINSSTRING(mi,\"connectivity\") || CONTAINSSTRING(mi,\"engineering\"), \"Technical & Engineering\",",
              "        \"Other\"",
              "    )",
              "RETURN",
              "    IF(NOT isSystemClassic && NOT ISBLANK(classic) && classic <> \"\", classic, derived)"
            ],
            "lineageTag": "ap0topic-col0-0001-000000000002",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "user_id_resolved",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": [
              "Robust user key for org attribution: resolves the session's user id (raw AAD objectId,",
              "the reliably-populated key) from Agent Sessions via the 1:1 conversation id, rather than",
              "relying on the sparse Var_ESS_UserContext_UPN. Drives the Agent Performance -> Org Data[id]",
              "relationship so an Organisation slicer filters the Agent Evaluation / Topic Analysis pages."
            ],
            "expression": [
              "LOOKUPVALUE (",
              "    'Agent Sessions'[user_id_hash],",
              "    'Agent Sessions'[conversation_id], 'Agent Performance'[ConversationTranscriptId]",
              ")"
            ],
            "lineageTag": "ap0001-col-useridresolved-0001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
