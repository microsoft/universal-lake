            "isNameInferred": false,
            "sourceColumn": "[Value]",
            "lineageTag": "a7c7a530-col0-0001-000000000001",
            "summarizeBy": "none",
            "extendedProperties": [
              {
                "type": "json",
                "name": "ParameterMetadata",
                "value": {
                  "version": 0
                }
              }
            ],
            "annotations": [
