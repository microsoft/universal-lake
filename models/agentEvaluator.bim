            "description": "Estimated minutes a human would take to perform this activity end-to-end, that the agent saved. EDITABLE — tune per customer. Indicative only.",
            "sourceColumn": "[Human Baseline (min)]",
            "lineageTag": "5a000000-col0-0000-000000000003",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Value Outcome",
