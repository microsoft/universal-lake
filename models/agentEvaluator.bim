        "partitions": [
          {
            "name": "Credit Consumption (Agent)",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Cols = {\"Agent_Name\", \"Agent_Id\", \"Product\", \"AI_Feature_Billable_Feature\", \"Billed_credit\", \"Non_billed_credit\", \"Channel\", \"Knowledge_Sources\", \"Tool_Used\", \"LLM_Model\", \"Scenario_Name\", \"Environment_Id\", \"Environment_Name\"},",
                "    Promoted = ",
                "        // Outside Fabric, read <CSV Folder Path>\\credit_consumption_agent.csv when present.",
                "        // Missing file -> the original empty shape, so the file stays optional.",
                "        if #\"Source Mode\" = \"Fabric\" then (try FabricTable(\"credit_consumption_agent\") otherwise EmptyTable(Cols))",
                "        else (try Table.SelectColumns(CsvTable(\"credit_consumption_agent\"), Cols, MissingField.UseNull)",
                "              otherwise EmptyTable(Cols)),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"Agent_Name\", type text},",
                "        {\"Agent_Id\", type text},",
                "        {\"Product\", type text},",
                "        {\"AI_Feature_Billable_Feature\", type text},",
                "        {\"Billed_credit\", Int64.Type},",
                "        {\"Non_billed_credit\", Int64.Type},",
                "        {\"Channel\", type text},",
                "        {\"Knowledge_Sources\", type text},",
                "        {\"Tool_Used\", type text},",
                "        {\"LLM_Model\", type text},",
                "        {\"Scenario_Name\", type text},",
                "        {\"Environment_Id\", type text},",
                "        {\"Environment_Name\", type text}",
                "    }, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Billed Credits",
            "description": "Total billed credits (the credits the customer is charged for).",
            "expression": "SUM('Credit Consumption (Agent)'[Billed_credit])",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0001ag-meas-0001-000000000001"
          },
          {
            "name": "Total Non-Billed Credits",
            "description": "Total non-billed credits (consumed within entitlement, not charged).",
            "expression": "SUM('Credit Consumption (Agent)'[Non_billed_credit])",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0001ag-meas-0001-000000000002"
          },
          {
            "name": "Total Consumed Credits",
            "description": "All consumed credits = billed + non-billed.",
            "expression": "[Total Billed Credits] + [Total Non-Billed Credits]",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0001ag-meas-0001-000000000003"
          },
          {
            "name": "Billing vs Transcript Gap",
            "description": [
              "Reconciliation gap: billed actuals minus the transcript-native displayed credits.",
              "Positive = billing captures cost the transcript displayedCost doesn't (classic answers,",
              "tools, non-generative turns). Expect this to be positive and sizeable."
            ],
            "expression": "[Total Consumed Credits] - [Total Cost Units]",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0001ag-meas-0001-000000000004"
          },
          {
            "name": "Billing Agents with Credits",
            "description": "Distinct agents present in the billing actuals.",
            "expression": "DISTINCTCOUNT ( 'Credit Consumption (Agent)'[Agent_Name] )",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0001ag-meas-agentcnt0001"
          },
          {
            "name": "Avg Credits per Agent (Billing)",
            "description": "Mean consumed credits per agent (billing actuals).",
            "expression": "DIVIDE ( [Total Consumed Credits], [Billing Agents with Credits] )",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0001ag-meas-avgagent0001"
