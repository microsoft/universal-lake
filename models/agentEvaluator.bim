          {
            "type": "calculated",
            "name": "Conversation Picker",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Friendly conversation label for the Transcript Explorer picker: agent · opening prompt · date.",
            "expression": [
              "VAR ag = 'Agent Sessions'[primary_agent_schema]",
              "VAR rawp = 'Agent Sessions'[first_user_prompt]",
              "VAR p1 = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(rawp, \"<div>\", \"\"), \"</div>\", \"\"), \"<m-official>\", \"\")",
              "VAR p2 = SUBSTITUTE(SUBSTITUTE(p1, \"</m-official>\", \"\"), \"**\", \"\")",
              "VAR snippet = IF(LEN(TRIM(p2)) > 60, LEFT(TRIM(p2), 60) & \"…\", TRIM(p2))",
              "VAR dt = FORMAT('Agent Sessions'[session_start_utc], \"dd MMM HH:mm\")",
              "RETURN ag & \"  ·  \" & IF(snippet = \"\", \"(no opening prompt)\", snippet) & \"  ·  \" & dt"
            ],
            "lineageTag": "ag0001se-col0-0001-000000000040",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Depth Bucket",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Conversation depth band (by message count) for flow analysis. Sort key keeps bands in order.",
            "expression": [
              "SWITCH(TRUE(),",
              "    'Agent Sessions'[msg_count] <= 1, \"1 msg\",",
              "    'Agent Sessions'[msg_count] = 2, \"2\",",
              "    'Agent Sessions'[msg_count] <= 4, \"3-4\",",
              "    'Agent Sessions'[msg_count] <= 8, \"5-8\",",
              "    \">8\")"
            ],
            "sortByColumn": "Depth Bucket Order",
            "lineageTag": "ag0001se-col0-0001-000000000050",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Depth Bucket Order",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "description": "Numeric sort order for 'Depth Bucket'.",
            "expression": [
              "SWITCH(TRUE(),",
              "    'Agent Sessions'[msg_count] <= 1, 1,",
              "    'Agent Sessions'[msg_count] = 2, 2,",
              "    'Agent Sessions'[msg_count] <= 4, 3,",
              "    'Agent Sessions'[msg_count] <= 8, 4,",
              "    5)"
            ],
            "lineageTag": "ag0001se-col0-0001-000000000051",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Conversation Archetype",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Agent activity archetype — classifies each conversation by the most advanced capability the agent used while responding (multi-agent / reasoning / knowledge / tool action), with errors flagged. Behaviour-based, so it complements (not duplicates) the depth and resolution charts.",
            "expression": [
              "",
              "VAR _agents = 'Agent Sessions'[connected_agent_count]",
              "VAR _steps  = 'Agent Sessions'[plan_step_count]",
              "VAR _search = 'Agent Sessions'[knowledge_searched]",
              "VAR _ground = 'Agent Sessions'[grounding_source]",
              "VAR _errs   = 'Agent Sessions'[error_count]",
              "RETURN",
              "    SWITCH(TRUE(),",
              "        _errs >= 1,                              \"⚠️ Hit an error\",",
              "        _agents > 0,                             \"🤝 Passed to a specialist\",",
              "        _search = TRUE() || _ground = \"Internal\", \"📚 Answered from your content\",",
              "        _steps >= 1,                             \"🧠 Carried out an action\",",
              "        \"💬 Answered from the model alone\")"
            ],
            "lineageTag": "ag0001se-col0-0001-000000000052",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "user_upn",
            "description": "UPN of the first user message, when the transcript carries one. Kept alongside user_id_hash so the org join can use whichever identifier the customer export is keyed on.",
            "dataType": "string",
            "sourceColumn": "user_upn",
            "lineageTag": "ag0001se-col0-0001-000000000901",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Org Join Key",
            "description": "Join key to the org table. Prefers the UPN, falls back to a lower-cased user_id_hash. Computed the same way on both sides.",
            "dataType": "string",
            "sourceColumn": "Org Join Key",
            "lineageTag": "ag0001se-col0-0001-000000000902",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Agent Sessions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Promoted = if #\"Source Mode\" <> \"Fabric\" then Parse_Sessions() else if true then (try FabricTable(\"agent_sessions\") otherwise EmptyTable({\"conversation_id\", \"session_start_utc\", \"session_duration_ms\", \"user_id_hash\", \"primary_agent_schema\", \"connected_agent_schemas\", \"connected_agent_count\", \"msg_count\", \"user_msg_count\", \"bot_msg_count\", \"plan_step_count\", \"total_displayed_cost\", \"total_latency_ms\", \"knowledge_searched\", \"knowledge_answered\", \"knowledge_sources_count\", \"error_count\", \"first_error_code\", \"feedback_offered_count\", \"feedback_submitted\", \"feedback_verdict\", \"feedback_comment\", \"first_user_prompt\"})) else EmptyTable({\"conversation_id\", \"session_start_utc\", \"session_duration_ms\", \"user_id_hash\", \"primary_agent_schema\", \"connected_agent_schemas\", \"connected_agent_count\", \"msg_count\", \"user_msg_count\", \"bot_msg_count\", \"plan_step_count\", \"total_displayed_cost\", \"total_latency_ms\", \"knowledge_searched\", \"knowledge_answered\", \"knowledge_sources_count\", \"error_count\", \"first_error_code\", \"feedback_offered_count\", \"feedback_submitted\", \"feedback_verdict\", \"feedback_comment\", \"first_user_prompt\"}),",
                "    // Null-safe: add the parser's primary_topic_derived when not yet produced (see Agent Turns note).",
                "    Ensured = if List.Contains(Table.ColumnNames(Promoted), \"primary_topic_derived\") then Promoted else Table.AddColumn(Promoted, \"primary_topic_derived\", each null, type text),",
                "    EnsuredUpn = if List.Contains(Table.ColumnNames(Ensured), \"user_upn\") then Ensured else Table.AddColumn(Ensured, \"user_upn\", each null, type text),",
                "    Typed = Table.TransformColumnTypes(EnsuredUpn, {",
                "        {\"conversation_id\", type text},",
                "        {\"session_start_utc\", type datetime},",
                "        {\"session_duration_ms\", Int64.Type},",
                "        {\"user_id_hash\", type text},",
                "        {\"user_upn\", type text},",
                "        {\"primary_agent_schema\", type text},",
                "        {\"connected_agent_schemas\", type text},",
                "        {\"connected_agent_count\", Int64.Type},",
                "        {\"msg_count\", Int64.Type},",
                "        {\"user_msg_count\", Int64.Type},",
                "        {\"bot_msg_count\", Int64.Type},",
                "        {\"plan_step_count\", Int64.Type},",
                "        {\"total_displayed_cost\", type number},",
                "        {\"total_latency_ms\", Int64.Type},",
                "        {\"knowledge_searched\", type logical},",
                "        {\"knowledge_answered\", type logical},",
                "        {\"knowledge_sources_count\", Int64.Type},",
                "        {\"error_count\", Int64.Type},",
                "        {\"first_error_code\", type text},",
                "        {\"feedback_offered_count\", Int64.Type},",
                "        {\"feedback_submitted\", Int64.Type},",
                "        {\"feedback_verdict\", type text},",
                "        {\"feedback_comment\", type text},",
                "        {\"first_user_prompt\", type text},",
                "        {\"primary_topic_derived\", type text}",
                "    }),",
                "    WithKey = Table.AddColumn(Typed, \"Org Join Key\", each if [user_upn] <> null and [user_upn] <> \"\" then [user_upn] else (if [user_id_hash] = null then null else Text.Lower(Text.From([user_id_hash]))), type text)",
                "in",
                "    WithKey"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Transcript Sessions",
            "description": "Total conversations in scope. Each row = one Dataverse conversationtranscript record.",
            "expression": "COUNTROWS('Agent Sessions')",
            "formatString": "#,0",
            "displayFolder": "🤖 Agent Performance",
            "lineageTag": "ag0001se-meas-0001-000000000001"
          },
          {
            "name": "Transcript Active Users",
            "description": "Distinct end users (hashed) who held at least one conversation.",
            "expression": "DISTINCTCOUNT('Agent Sessions'[user_id_hash])",
            "formatString": "#,0",
            "displayFolder": "🤖 Agent Performance",
            "lineageTag": "ag0001se-meas-0001-000000000002"
          },
          {
            "name": "Total Cost Units",
            "description": "Sum of total_displayed_cost across all sessions (in-product cost units, not money).",
            "expression": "SUM('Agent Sessions'[total_displayed_cost])",
            "formatString": "#,0",
            "displayFolder": "🤖 Agent Performance",
            "lineageTag": "ag0001se-meas-0001-000000000004",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Unmapped Credit Units",
            "description": [
              "Credit units NOT attributable to any org = Total - Mapped (Mapped uses a TREATAS virtual join on",
              "user_id_hash -> Org[id], so this is correct even if the physical relationship is invalid/blank)."
            ],
            "expression": "[Total Cost Units] - [Mapped Credit Units]",
            "formatString": "#,0",
            "displayFolder": "💳 Credits",
            "lineageTag": "ag0001se-meas-unmappedcu01"
          },
          {
            "name": "Mapped Credit Units",
            "description": "Credit units successfully attributed to an organization.",
            "expression": "CALCULATE ( [Total Cost Units], TREATAS ( CALCULATETABLE ( VALUES ( 'Chat + Agent Org Data'[id] ), KEEPFILTERS ( 'Chat + Agent Org Data'[id] <> \"\" ) ), 'Agent Sessions'[user_id_hash] ) )",
            "formatString": "#,0",
            "displayFolder": "💳 Credits",
            "lineageTag": "ag0001se-meas-mappedcu01"
          },
          {
            "name": "Session Error Rate",
            "description": "% of sessions where the bot fired at least one error trace.",
            "expression": [
              "VAR _err = CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[error_count] > 0)",
              "VAR _tot = COUNTROWS('Agent Sessions')",
              "RETURN DIVIDE(_err, _tot)"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "🤖 Agent Performance",
            "lineageTag": "ag0001se-meas-0001-000000000006"
          },
          {
            "name": "Avg Turns per Session",
            "description": "Mean number of messages (user + bot) per session.",
            "expression": "AVERAGE('Agent Sessions'[msg_count])",
            "formatString": "#,0.0",
            "displayFolder": "🤖 Agent Performance",
            "lineageTag": "ag0001se-meas-0001-000000000007"
          },
          {
            "name": "Knowledge Search Rate",
            "description": "% of sessions where the agent searched its knowledge sources.",
            "expression": [
              "VAR _hit = CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[knowledge_searched] = TRUE())",
              "RETURN DIVIDE(_hit, COUNTROWS('Agent Sessions'))"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "📚 Prompt Quality",
            "lineageTag": "ag0001se-meas-0001-000000000008"
          },
          {
            "name": "Knowledge Answered Rate",
            "description": "Of the times the agent searched its knowledge sources, how often it found an answer. The complement of Knowledge Gap Rate.",
            "expression": [
              "VAR _searched = CALCULATE ( COUNTROWS ( 'Agent Sessions' ), 'Agent Sessions'[knowledge_searched] = TRUE () )",
              "RETURN IF ( _searched > 0, 1 - [Knowledge Gap Rate] )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "📚 Prompt Quality",
            "lineageTag": "ag0001se-meas-0001-000000000009"
          },
          {
            "name": "Avg Credits per Agent",
            "description": "Mean credit units per agent (total credits / distinct agents that consumed credits).",
            "expression": [
              "DIVIDE(",
              "    [Total Cost Units],",
              "    CALCULATE(DISTINCTCOUNT('Agent Sessions'[primary_agent_schema]), 'Agent Sessions'[total_displayed_cost] > 0)",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "💳 Credits",
            "lineageTag": "ag0001se-meas-0001-000000000022"
          },
          {
            "name": "Credit Share %",
            "description": "Share of all credits taken by the agents currently in filter context.",
            "expression": [
              "DIVIDE(",
              "    [Total Cost Units],",
              "    CALCULATE([Total Cost Units], ALL('Agent Sessions'[primary_agent_schema]))",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "💳 Credits",
            "lineageTag": "ag0001se-meas-0001-000000000024"
          },
          {
            "name": "Sessions with Feedback Prompt",
            "description": "Sessions where a feedback card was shown to the user (the *offered* signal — not a verdict).",
            "expression": "CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[feedback_offered_count] > 0)",
            "formatString": "#,0",
            "displayFolder": "💬 Feedback Signal",
            "lineageTag": "ag0001se-meas-0001-000000000030"
          },
          {
            "name": "Feedback Prompt Rate",
            "description": "Share of sessions that surfaced a feedback prompt.",
            "expression": [
              "DIVIDE(",
              "    [Sessions with Feedback Prompt],",
              "    [Transcript Sessions]",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "💬 Feedback Signal",
            "lineageTag": "ag0001se-meas-0001-000000000031"
          },
          {
            "name": "Sessions with Submitted Feedback",
            "description": "Sessions where the user actually SUBMITTED a thumbs verdict (completed feedback).",
            "expression": "SUM('Agent Sessions'[feedback_submitted])",
            "formatString": "#,0",
            "displayFolder": "💬 Feedback Signal",
            "lineageTag": "ag0001se-meas-0001-000000000032"
          },
          {
            "name": "Transcript Thumbs Up",
            "description": "Submitted thumbs-up sessions (transcript-native).",
            "expression": "CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[feedback_verdict] = \"Positive\")",
            "formatString": "#,0",
            "displayFolder": "💬 Feedback Signal",
            "lineageTag": "ag0001se-meas-0001-000000000033"
          },
          {
            "name": "Transcript Thumbs Down",
            "description": "Submitted thumbs-down sessions (transcript-native).",
            "expression": "CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[feedback_verdict] = \"Negative\")",
            "formatString": "#,0",
            "displayFolder": "💬 Feedback Signal",
            "lineageTag": "ag0001se-meas-0001-000000000034"
          },
          {
            "name": "Transcript CSAT Score",
            "description": "Transcript-native CSAT: submitted thumbs-up / all submitted verdicts. Lights up automatically when an export carries completed reactions.",
            "expression": [
              "DIVIDE(",
              "    [Transcript Thumbs Up],",
              "    [Transcript Thumbs Up] + [Transcript Thumbs Down]",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "💬 Feedback Signal",
            "lineageTag": "ag0001se-meas-0001-000000000035"
          },
          {
            "name": "Feedback Submission Rate",
            "description": "Share of feedback-prompted sessions where the user actually submitted a verdict (completion rate).",
            "expression": [
              "DIVIDE(",
              "    [Sessions with Submitted Feedback],",
              "    [Sessions with Feedback Prompt]",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "💬 Feedback Signal",
            "lineageTag": "ag0001se-meas-0001-000000000036"
          },
          {
            "name": "Org Credit Share %",
            "description": "Each organization's share of total credit spend across the full population (denominator ignores the org row, respects other slicers like Date).",
            "expression": [
              "DIVIDE(",
              "    [Total Cost Units],",
              "    CALCULATE(",
              "        [Total Cost Units],",
              "        ALL('Chat + Agent Org Data')",
              "    )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "💳 Credits",
            "lineageTag": "ag0001se-meas-0001-000000000025"
          },
          {
            "name": "Avg Credits per User",
            "description": "Mean credit units per distinct end user who consumed credits (total credits / users with spend > 0).",
            "expression": [
              "DIVIDE(",
              "    [Total Cost Units],",
              "    CALCULATE(",
              "        DISTINCTCOUNT('Agent Sessions'[user_id_hash]),",
              "        'Agent Sessions'[total_displayed_cost] > 0",
              "    )",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "💳 Credits",
            "lineageTag": "ag0001se-meas-0001-000000000026"
          },
          {
            "name": "Resolved Sessions",
            "description": "Sessions that ended with an explicit \"Resolved\" outcome.",
            "expression": "CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[session_outcome_explicit] = \"Resolved\")",
            "formatString": "#,0",
            "displayFolder": "🤖 Agent Performance",
            "lineageTag": "ag0001se-meas-0001-000000000050"
          },
          {
            "name": "Knowledge Grounded Rate",
            "description": "% of sessions whose answer was grounded in an internal knowledge source.",
            "expression": "DIVIDE(CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[grounding_source] = \"Internal\"), COUNTROWS('Agent Sessions'))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "📚 Prompt Quality",
            "lineageTag": "ag0001se-meas-0001-000000000054"
          },
          {
            "name": "Error Sessions",
            "description": "Sessions that fired at least one error trace.",
            "expression": "CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[error_count] > 0)",
            "formatString": "#,0",
            "displayFolder": "🚨 Errors",
            "lineageTag": "ag0001se-meas-0001-000000000057"
          },
          {
            "name": "Sub-Agent Usage Rate",
            "description": "% of sessions that invoked at least one connected sub-agent.",
            "expression": "DIVIDE(CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[connected_agent_count] > 0), COUNTROWS('Agent Sessions'))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "🤖 Agent Performance",
            "lineageTag": "ag0001se-meas-0001-000000000063"
          },
          {
            "name": "Single-Turn Rate",
            "description": "% of conversations that never get past the first message.",
            "expression": "DIVIDE(CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[msg_count] <= 1), COUNTROWS('Agent Sessions'))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "💬 Flow",
            "lineageTag": "ag0001se-meas-0001-000000000071"
          },
          {
            "name": "Multi-Turn Sessions",
            "description": "Multi-turn (engaged) conversations — more than one message.",
            "expression": "CALCULATE(COUNTROWS('Agent Sessions'), 'Agent Sessions'[msg_count] > 1)",
            "formatString": "#,0",
            "displayFolder": "💬 Flow",
            "lineageTag": "ag0001se-meas-0001-000000000072"
          },
          {
            "name": "Returning Users",
            "description": "Distinct users who held more than one conversation (returning users).",
            "expression": "COUNTROWS(FILTER(VALUES('Agent Sessions'[user_id_hash]), CALCULATE(DISTINCTCOUNT('Agent Sessions'[conversation_id])) > 1))",
            "formatString": "#,0",
            "displayFolder": "🤖 Agent Performance",
            "lineageTag": "ag0001se-meas-0001-000000000080"
          },
          {
            "name": "Returning User Rate",
            "description": "% of users who came back for more than one conversation. High = sticky, trusted agent. (Demo data has very few distinct users, so this reads high; on real exports it reflects true repeat usage.)",
            "expression": "DIVIDE([Returning Users], [Transcript Active Users])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "🤖 Agent Performance",
            "lineageTag": "ag0001se-meas-0001-000000000081"
          },
          {
            "name": "💬 Feedback Insight (Live)",
            "description": "Second insight headline for the Transcript CSAT page: the offered → submitted → verdict funnel narrative.",
            "expression": [
              "VAR _offered = [Sessions with Feedback Prompt]",
              "VAR _sub = [Sessions with Submitted Feedback]",
              "VAR _up = [Transcript Thumbs Up]",
              "VAR _dn = [Transcript Thumbs Down]",
              "VAR _subRate = DIVIDE(_sub, _offered)",
              "RETURN",
              "    IF(",
              "        _offered = 0,",
              "        \"No feedback prompts in scope. This narrates how many users were offered a feedback card, how many responded, and the thumbs split.\",",
              "        \"Agents offered feedback in \" & FORMAT(_offered, \"#,0\") & \" session(s); \"",
              "            & FORMAT(_subRate, \"0%\") & \" left a verdict\"",
              "            & IF(_sub = 0, \" — demo transcripts carry prompts but no submitted reactions (these light up on real data).\",",
              "                \". Split: \" & _up & \" 👍 / \" & _dn & \" 👎.\")",
              "    )"
            ],
            "displayFolder": "💬 Feedback Signal",
            "lineageTag": "ag0001se-meas-0001-000000000038"
          },
          {
            "name": "Knowledge Gap Conversations",
            "description": [
              "Conversations where the agent searched your content and came back with nothing.",
              "The cleanest signal of a genuine content gap - the user asked, the agent looked, there was no answer there."
            ],
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( 'Agent Sessions' ),",
              "    'Agent Sessions'[knowledge_searched] = TRUE (),",
              "    'Agent Sessions'[knowledge_answered] = FALSE ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "4 Improvement",
            "lineageTag": "ae0new00-0000-4000-a000-000000000000"
          },
          {
            "name": "Knowledge Gap Rate",
            "description": "Of the times the agent searched, how often it found nothing usable.",
            "expression": [
              "DIVIDE (",
              "    [Knowledge Gap Conversations],",
              "    CALCULATE ( COUNTROWS ( 'Agent Sessions' ), 'Agent Sessions'[knowledge_searched] = TRUE () ),",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "4 Improvement",
            "lineageTag": "ae0new01-0000-4000-a000-000000000001"
          },
          {
            "name": "◆ Knowledge Gap Read",
            "expression": [
              "VAR gaps = [Knowledge Gap Conversations]",
              "VAR rate = [Knowledge Gap Rate]",
              "RETURN",
              "    IF (",
              "        gaps = 0,",
              "        \"No content gaps detected in this window.\",",
              "        FORMAT ( gaps, \"#,0\" ) & \" searches came back empty (\" & FORMAT ( rate, \"0.0%\" )",
              "            & \" of all searches). \"",
              "            & IF ( rate > 0.2, \"Content, not the agent, is the constraint.\",",
              "                                \"Content coverage is broadly holding.\" )",
              "    )"
            ],
            "displayFolder": "4 Improvement",
            "lineageTag": "ae0new02-0000-4000-a000-000000000002"
          },
          {
            "name": "Avg Turns (Grounded)",
            "description": "Average turns when the agent answered from your own content.",
            "expression": [
              "CALCULATE (",
              "    AVERAGE ( 'Agent Sessions'[msg_count] ),",
              "    'Agent Sessions'[knowledge_answered] = TRUE ()",
              ")"
            ],
            "formatString": "#,0.0",
            "displayFolder": "5 Depth",
            "lineageTag": "ae0new03-0000-4000-a000-000000000003"
          },
          {
            "name": "Avg Turns (Ungrounded)",
            "description": "Average turns when it did not.",
            "expression": [
              "CALCULATE (",
              "    AVERAGE ( 'Agent Sessions'[msg_count] ),",
              "    'Agent Sessions'[knowledge_answered] = FALSE ()",
              ")"
            ],
            "formatString": "#,0.0",
            "displayFolder": "5 Depth",
            "lineageTag": "ae0new04-0000-4000-a000-000000000004"
          },
          {
            "name": "◆ Depth Read",
            "expression": [
              "VAR g = [Avg Turns (Grounded)]",
              "VAR u = [Avg Turns (Ungrounded)]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( g ) || ISBLANK ( u ),",
              "        \"Not enough grounded conversations to compare.\",",
              "        FORMAT ( g, \"0.0\" ) & \" turns grounded vs \" & FORMAT ( u, \"0.0\" ) & \" ungrounded. \"",
              "            & SWITCH ( TRUE (),",
              "                u - g >= 1, \"Content is doing real work.\",",
              "                u - g > 0, \"Grounding helps only slightly.\",",
              "                \"Grounding is not helping - check retrieval.\" )",
              "    )"
            ],
            "displayFolder": "5 Depth",
            "lineageTag": "ae0new05-0000-4000-a000-000000000005"
          },
          {
            "name": "Answered from Knowledge",
            "description": [
              "Conversations answered out of your own documents and sites.",
              "Expertise the person would otherwise have had to go and find."
            ],
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( 'Agent Sessions' ),",
              "    'Agent Sessions'[knowledge_answered] = TRUE ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "3 Value",
            "lineageTag": "ae0new06-0000-4000-a000-000000000006"
          },
          {
            "name": "Specialist Agent Brought In",
            "description": "Conversations where the agent pulled in another agent to finish the job.",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( 'Agent Sessions' ),",
              "    'Agent Sessions'[connected_agent_count] > 0",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "3 Value",
            "lineageTag": "ae0new07-0000-4000-a000-000000000007"
          },
          {
            "name": "Answered from Knowledge %",
            "description": "Share of conversations answered from internal content.",
            "expression": "DIVIDE ( [Answered from Knowledge], COUNTROWS ( 'Agent Sessions' ), 0 )",
            "formatString": "0.0%",
            "displayFolder": "3 Value",
            "lineageTag": "ae0new08-0000-4000-a000-000000000008"
          },
          {
            "name": "◆ Conversation Anatomy",
            "description": [
              "Six lines instead of fifteen messages: what was asked, how much effort it took,",
              "whether your content was used, whether help was pulled in, what broke, how it ended."
            ],
            "expression": [
              "VAR conv    = SELECTEDVALUE ( 'Agent Sessions'[conversation_id] )",
              "VAR prompt  = SELECTEDVALUE ( 'Agent Sessions'[first_user_prompt] )",
              "VAR uMsgs   = SELECTEDVALUE ( 'Agent Sessions'[user_msg_count] )",
              "VAR bMsgs   = SELECTEDVALUE ( 'Agent Sessions'[bot_msg_count] )",
              "VAR secs    = DIVIDE ( SELECTEDVALUE ( 'Agent Sessions'[session_duration_ms] ), 1000 )",
              "VAR search  = SELECTEDVALUE ( 'Agent Sessions'[knowledge_searched] )",
              "VAR answer  = SELECTEDVALUE ( 'Agent Sessions'[knowledge_answered] )",
              "VAR srcs    = SELECTEDVALUE ( 'Agent Sessions'[knowledge_sources_count] )",
              "VAR agents  = SELECTEDVALUE ( 'Agent Sessions'[connected_agent_count] )",
              "VAR errs    = SELECTEDVALUE ( 'Agent Sessions'[error_count] )",
              "VAR ecode   = SELECTEDVALUE ( 'Agent Sessions'[first_error_code] )",
              "VAR outcome = SELECTEDVALUE ( 'Agent Performance'[SessionOutcome] )",
              "VAR theme   = SELECTEDVALUE ( 'Agent Performance'[Topic Theme] )",
              "VAR distinctBot =",
              "    CALCULATE ( DISTINCTCOUNT ( 'Agent Turns'[text_preview_500] ), 'Agent Turns'[turn_role] = \"bot\" )",
              "VAR repeats = bMsgs - distinctBot",
              "VAR NL = UNICHAR ( 10 )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( conv ),",
              "        \"Pick a conversation on the left to see its anatomy.\",",
              "        \"THEY ASKED      \" & COALESCE ( prompt, \"(no opening prompt captured)\" )",
              "            & IF ( NOT ISBLANK ( theme ), \"   [\" & theme & \"]\", \"\" ) & NL & NL",
              "            & \"BACK & FORTH    \" & COALESCE ( uMsgs, 0 ) & \" asks, \" & COALESCE ( bMsgs, 0 ) & \" replies\"",
              "            & IF ( secs > 0, \", over \" & FORMAT ( secs, \"#,0\" ) & \"s\", \"\" )",
              "            & IF ( repeats >= 2, \"      the agent repeated itself \" & repeats & \" times\", \"\" ) & NL & NL",
              "            & \"KNOWLEDGE       \"",
              "            & SWITCH ( TRUE (),",
              "                NOT search, \"never searched your content - answered from the model alone\",",
              "                NOT answer, \"searched your content and found nothing usable\",",
              "                COALESCE ( srcs, 0 ) & \" source(s) used\" ) & NL & NL",
              "            & \"HELP            \"",
              "            & IF ( COALESCE ( agents, 0 ) > 0,",
              "                   agents & \" specialist agent(s) brought in\", \"handled alone\" ) & NL & NL",
              "            & \"ERRORS          \"",
              "            & IF ( COALESCE ( errs, 0 ) > 0,",
              "                   errs & \" - \" & COALESCE ( ecode, \"code not captured\" ), \"none\" ) & NL & NL",
              "            & \"ENDED           \" & COALESCE ( outcome, \"no outcome recorded\" )",
              "    )"
            ],
            "displayFolder": "6 Explorer",
            "lineageTag": "ae0expl00-0000-4000-a000-0000000000e0"
          },
          {
            "name": "◆ Conversations Shown",
            "description": "How many conversations survive the current facet selection.",
            "expression": [
              "VAR n = DISTINCTCOUNT ( 'Agent Sessions'[conversation_id] )",
              "VAR AllShown = CALCULATE ( DISTINCTCOUNT ( 'Agent Sessions'[conversation_id] ), ALLSELECTED () )",
              "RETURN",
              "    IF (",
              "        n = AllShown,",
              "        FORMAT ( n, \"#,0\" ) & \" conversations - use the buttons above to narrow\",",
              "        FORMAT ( n, \"#,0\" ) & \" of \" & FORMAT ( AllShown, \"#,0\" ) & \" conversations\"",
              "    )"
            ],
            "displayFolder": "6 Explorer",
            "lineageTag": "ae0expl01-0000-4000-a000-0000000000e1"
          },
          {
            "name": "◆ Anatomy Detail",
            "description": [
              "One line of the conversation anatomy - which line depends on the",
              "Anatomy[Stage] row it is evaluated against."
            ],
            "expression": [
              "VAR stage   = SELECTEDVALUE ( 'Anatomy'[Stage] )",
              "VAR conv    = SELECTEDVALUE ( 'Agent Sessions'[conversation_id] )",
              "VAR prompt  = SELECTEDVALUE ( 'Agent Sessions'[first_user_prompt] )",
              "VAR theme   = SELECTEDVALUE ( 'Agent Performance'[Topic Theme] )",
              "VAR uMsgs   = SELECTEDVALUE ( 'Agent Sessions'[user_msg_count] )",
              "VAR bMsgs   = SELECTEDVALUE ( 'Agent Sessions'[bot_msg_count] )",
              "VAR secs    = DIVIDE ( SELECTEDVALUE ( 'Agent Sessions'[session_duration_ms] ), 1000 )",
              "VAR search  = SELECTEDVALUE ( 'Agent Sessions'[knowledge_searched] )",
              "VAR answer  = SELECTEDVALUE ( 'Agent Sessions'[knowledge_answered] )",
              "VAR srcs    = SELECTEDVALUE ( 'Agent Sessions'[knowledge_sources_count] )",
              "VAR agents  = SELECTEDVALUE ( 'Agent Sessions'[connected_agent_count] )",
              "VAR errs    = SELECTEDVALUE ( 'Agent Sessions'[error_count] )",
              "VAR ecode   = SELECTEDVALUE ( 'Agent Sessions'[first_error_code] )",
              "VAR outcome = SELECTEDVALUE ( 'Agent Performance'[SessionOutcome] )",
              "VAR distinctBot =",
              "    CALCULATE ( DISTINCTCOUNT ( 'Agent Turns'[text_preview_500] ), 'Agent Turns'[turn_role] = \"bot\" )",
              "VAR repeats = bMsgs - distinctBot",
              "RETURN",
              "    IF (",
              "        ISBLANK ( conv ),",
              "        IF ( stage = \"They asked\", \"Pick a conversation on the left.\", \"\" ),",
              "        SWITCH ( stage,",
              "            \"They asked\",",
              "                COALESCE ( prompt, \"(no opening prompt captured)\" )",
              "                    & IF ( NOT ISBLANK ( theme ), \"   ·   \" & theme, \"\" ),",
              "            \"Back & forth\",",
              "                COALESCE ( uMsgs, 0 ) & \" asks, \" & COALESCE ( bMsgs, 0 ) & \" replies\"",
              "                    & IF ( secs > 0, \", over \" & FORMAT ( secs, \"#,0\" ) & \"s\", \"\" )",
              "                    & IF ( repeats >= 2, \"   ·   the agent repeated itself \" & repeats & \" times\", \"\" ),",
              "            \"Knowledge\",",
              "                SWITCH ( TRUE (),",
              "                    NOT search, \"never searched your content - answered from the model alone\",",
              "                    NOT answer, \"searched your content and found nothing usable\",",
              "                    COALESCE ( srcs, 0 ) & \" source(s) used\" ),",
              "            \"Help\",",
              "                IF ( COALESCE ( agents, 0 ) > 0,",
              "                     agents & \" specialist agent(s) brought in\", \"handled alone\" ),",
              "            \"Errors\",",
              "                IF ( COALESCE ( errs, 0 ) > 0,",
              "                     errs & \" - \" & COALESCE ( ecode, \"code not captured\" ), \"none\" ),",
              "            \"Ended\",",
              "                COALESCE ( outcome, \"no outcome recorded\" ),",
              "            \"\"",
              "        )",
              "    )"
            ],
            "displayFolder": "6 Explorer",
            "lineageTag": "ae0anat00-meas-0001-0001-000000000001"
          },
          {
            "name": "⚠ Org Join Health",
            "description": "Diagnostic. States whether conversations actually join to the org table. The org query guarantees an 'id' column so the model always loads, which means a wrong key fails silently rather than erroring - every org breakdown returns one blank group holding all the volume. Drop this on a page when org cuts look empty.",
            "expression": [
              "VAR _Org = COUNTROWS ( 'Chat + Agent Org Data' )",
              "VAR _Facts = COUNTROWS ( 'Agent Sessions' )",
              "VAR _Matched =",
              "    COUNTROWS (",
              "        FILTER (",
              "            'Agent Sessions',",
              "            NOT ISBLANK ( RELATED ( 'Chat + Agent Org Data'[PersonId] ) )",
              "        )",
              "    )",
              "VAR _Pct = DIVIDE ( _Matched, _Facts )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( _Org ) || _Org = 0,",
              "            \"No org data loaded. Org breakdowns will be blank.\",",
              "        ISBLANK ( _Matched ) || _Matched = 0,",
              "            \"Org data loaded (\" & FORMAT ( _Org, \"#,0\" ) & \" people) but 0 of \"",
              "                & FORMAT ( _Facts, \"#,0\" )",
              "                & \" conversations match it. The join key is wrong: \"",
              "                & \"copilot_org_data[id] must hold the AAD object ID, \"",
              "                & \"the same value the parser writes to agent_sessions[user_id_hash]. \"",
              "                & \"If the export has no id column the template falls back to the UPN, which cannot match. See docs/fabric.md.\",",
              "        _Pct < 0.5,",
              "            \"Only \" & FORMAT ( _Pct, \"0%\" ) & \" of conversations match org data. \"",
              "                & \"Org breakdowns will understate volume.\",",
              "        \"OK - \" & FORMAT ( _Pct, \"0%\" ) & \" of conversations matched to org data.\"",
              "    )"
            ],
            "displayFolder": "Diagnostics",
            "lineageTag": "ag0001se-meas-0001-000000000901"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
