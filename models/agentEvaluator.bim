            "lineageTag": "ag0003er-col0-0001-000000000005",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "is_user_error",
            "dataType": "boolean",
            "sourceColumn": "is_user_error",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "ag0003er-col0-0001-000000000006",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Error Source",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Human-readable fault attribution for legends/slicers: \"User fault\" vs \"System fault\".",
            "expression": "IF('Agent Errors'[is_user_error] = TRUE(), \"👤 User fault\", \"🤖 System fault\")",
            "lineageTag": "ag0003er-col0-0001-000000000020",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Agent Errors",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Promoted = if #\"Source Mode\" <> \"Fabric\" then Parse_Errors() else if true then (try FabricTable(\"agent_errors\") otherwise EmptyTable({\"conversation_id\", \"error_timestamp_utc\", \"error_code\", \"error_sub_code\", \"error_message\", \"is_user_error\"})) else EmptyTable({\"conversation_id\", \"error_timestamp_utc\", \"error_code\", \"error_sub_code\", \"error_message\", \"is_user_error\"}),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"conversation_id\", type text},",
                "        {\"error_timestamp_utc\", type datetime},",
                "        {\"error_code\", type text},",
                "        {\"error_sub_code\", type text},",
                "        {\"error_message\", type text},",
                "        {\"is_user_error\", type logical}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Errors",
            "expression": "COUNTROWS('Agent Errors')",
            "formatString": "#,0",
            "displayFolder": "🚨 Errors",
            "lineageTag": "ag0003er-meas-0001-000000000001"
          },
          {
            "name": "System Errors",
            "description": "Errors classified as system/agent faults (not user-caused).",
            "expression": "CALCULATE(COUNTROWS('Agent Errors'), 'Agent Errors'[is_user_error] = FALSE())",
            "formatString": "#,0",
            "displayFolder": "🚨 Errors",
            "lineageTag": "ag0003er-meas-0001-000000000002"
          },
          {
            "name": "User Errors",
            "description": "Errors attributed to user input (e.g. denied access, content filtered by user prompt).",
            "expression": "CALCULATE(COUNTROWS('Agent Errors'), 'Agent Errors'[is_user_error] = TRUE())",
            "formatString": "#,0",
            "displayFolder": "🚨 Errors",
            "lineageTag": "ag0003er-meas-0001-000000000003"
          },
          {
            "name": "Error Story (Live)",
            "description": "Dynamic, data-driven error headline (template-safe). Builds a live sentence from the current filter context — bind into a text box via fx ▸ Values, or drop into a Card. Updates automatically for any customer's data and respects all slicers.",
            "expression": [
              "VAR _errs    = [Total Errors]",
              "VAR _errSess = [Error Sessions]",
              "VAR _allSess = [Transcript Sessions]",
              "VAR _errRate = DIVIDE(_errSess, _allSess)",
              "VAR _sysShare = DIVIDE([System Errors], _errs)",
              "VAR _usrShare = DIVIDE([User Errors], _errs)",
              "VAR _codeTbl = ADDCOLUMNS(VALUES('Agent Errors'[error_code]), \"@n\", [Total Errors])",
              "VAR _topCode = TOPN(1, _codeTbl, [@n], DESC)",
              "VAR _topCodeName = MAXX(_topCode, 'Agent Errors'[error_code])",
              "VAR _topCodeN = MAXX(_topCode, [@n])",
              "VAR _agentTbl = ADDCOLUMNS(VALUES('Agent Catalogue'[agent_display_name]), \"@e\", [Total Errors])",
              "VAR _topAgent = TOPN(1, FILTER(_agentTbl, [@e] > 0), [@e], DESC)",
              "VAR _topAgentName = MAXX(_topAgent, 'Agent Catalogue'[agent_display_name])",
              "VAR _topAgentN = MAXX(_topAgent, [@e])",
              "RETURN",
              "    IF(",
              "        _errs = 0,",
              "        \"No errors in the current selection — clean run. ✅\",",
              "        FORMAT(_errs, \"#,0\") & \" error\" & IF(_errs = 1, \"\", \"s\") & \" hit \" &",
              "        FORMAT(_errSess, \"#,0\") & \" of \" & FORMAT(_allSess, \"#,0\") & \" sessions (\" & FORMAT(_errRate, \"0.0%\") & \"). \" &",
              "        FORMAT(_sysShare, \"0%\") & \" are system faults the agent can fix, \" & FORMAT(_usrShare, \"0%\") & \" are user / access blocks. \" &",
              "        \"Most common cause: \" & _topCodeName & \" (\" & FORMAT(_topCodeN, \"#,0\") & \"). \" &",
              "        \"Worst agent: \" & _topAgentName & \" (\" & FORMAT(_topAgentN, \"#,0\") & \" errors) — start remediation there.\"",
              "    )"
            ],
            "displayFolder": "🚨 Errors",
            "lineageTag": "ag0003er-meas-0001-000000000050"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
