            "sourceColumn": "[Value Outcome]",
            "lineageTag": "5a000000-col0-0000-000000000004",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Confidence",
            "dataType": "string",
            "isNameInferred": false,
            "description": "Confidence in the minute estimate (High / Medium / Low).",
            "sourceColumn": "[Confidence]",
            "lineageTag": "5a000000-col0-0000-000000000005",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Source",
            "dataType": "string",
            "isNameInferred": false,
            "description": "Benchmark source / rationale for the estimate. Shown for transparency.",
            "sourceColumn": "[Source]",
            "lineageTag": "5a000000-col0-0000-000000000006",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Low (min)",
            "dataType": "double",
            "isNameInferred": false,
            "description": "Low end of the defensible minutes band for this activity (conservative estimate). Shown for transparency.",
            "sourceColumn": "[Low (min)]",
            "lineageTag": "5a000000-col0-0000-000000000007",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "High (min)",
            "dataType": "double",
            "isNameInferred": false,
            "description": "High end of the defensible minutes band for this activity (optimistic estimate). Shown for transparency.",
            "sourceColumn": "[High (min)]",
            "lineageTag": "5a000000-col0-0000-000000000008",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Studio Activity Value Map",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE(",
                "    \"Activity\", STRING,",
                "    \"Detection\", STRING,",
                "    \"Human Baseline (min)\", DOUBLE,",
                "    \"Low (min)\", DOUBLE,",
                "    \"High (min)\", DOUBLE,",
                "    \"Value Outcome\", STRING,",
                "    \"Confidence\", STRING,",
                "    \"Source\", STRING,",
                "    {",
                "        {\"Knowledge retrieval\", \"Agent searched internal knowledge (knowledge_searched = true)\", 12, 8, 18, \"Search Time Saved\", \"High\", \"Enterprise-search time saved: McKinsey 2012 / IDC 2018 (knowledge workers ~1.8 hrs/day searching); HDI 2023 service-desk knowledge lookup\"},",
                "        {\"Grounded / cited answer\", \"Agent answered from cited knowledge (knowledge_answered = true or knowledge_sources > 0)\", 6, 3, 12, \"Answer Quality & Accuracy\", \"Medium\", \"Rework avoided from grounded, cited answers vs unsourced: Forrester TEI 2022; Gartner knowledge-management\"},",
                "        {\"Generative answer\", \"Agent produced a generative response (GenerativeResponseCount > 0)\", 8, 4, 24, \"Content Output\", \"Medium\", \"Content drafting/synthesis (chat-scaled): NBER w33795 (Dillon et al. 2025); IDEAS 2026; McKinsey 2023\"},",
                "        {\"Tool / transaction\", \"Agent invoked a tool / plugin / connector (PluginCallCount > 0)\", 15, 10, 40, \"Task / Transaction Completed\", \"High\", \"Service-desk transaction AHT (raise ticket, reset access): HDI 2023; MetricNet; Forrester TEI Power Automate 2024\"},",
                "        {\"Multi-step workflow\", \"Agent ran a multi-step plan (plan_step_count > 1)\", 15, 10, 40, \"Workflow Triggered\", \"High\", \"Multi-step process automation: Forrester TEI Power Automate 2024; Gartner hyperautomation\"},",
                "        {\"Multi-agent orchestration\", \"Session orchestrated connected agents (MultiAgentSession = true)\", 10, 5, 27, \"Workflow Triggered\", \"Medium\", \"Coordination saved across connected agents: Forrester TEI 2022 orchestration\"},",
                "        {\"Reasoning / planning effort\", \"Agent executed a plan to fulfil the request (plan_step_count > 0)\", 3, 1, 6, \"General AI Productivity\", \"Low\", \"Indicative planning-effort credit (plan-step backed); conservative floor\"},",
                "        {\"Query resolved\", \"Conversation reached a resolved outcome (SessionOutcome = Resolved)\", 8, 5, 12, \"Self-Service Deflection\", \"Medium\", \"Contact deflected from human channel: MetricNet cost-per-contact; ESS self-service assumption\"},",
                "        {\"Feedback captured\", \"User submitted thumbs / written feedback (feedback_submitted > 0)\", 2, 1, 4, \"Continuous Improvement\", \"Low\", \"Signal value for agent tuning / continuous improvement\"}",
                "    }",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "5a0000000000142000900"
          }
        ]
      },
      {
        "name": "Activity Events",
        "lineageTag": "5b000000-0000-0000-0000-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "conversation_id",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[conversation_id]",
            "lineageTag": "5b000000-col0-0000-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Activity",
            "dataType": "string",
            "isNameInferred": false,
            "description": "The Studio-native activity the agent performed (joins to 'Studio Activity Value Map'[Activity]).",
            "sourceColumn": "[Activity]",
            "lineageTag": "5b000000-col0-0000-000000000002",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Value Outcome",
            "dataType": "string",
            "isNameInferred": false,
            "description": "The business value bucket this activity rolls up to (for the \"WHERE IS TIME BEING SAVED?\" breakdown).",
            "sourceColumn": "[Value Outcome]",
            "lineageTag": "5b000000-col0-0000-000000000003",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Baseline (min)",
            "dataType": "double",
            "isNameInferred": false,
            "description": "Human-equivalent minutes credited to this event (looked up from the editable 'Studio Activity Value Map' at refresh).",
            "sourceColumn": "[Baseline (min)]",
            "lineageTag": "5b000000-col0-0000-000000000004",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Topic",
            "dataType": "string",
            "isNameInferred": false,
            "description": [
              "The conversation's generic business TOPIC (from Agent Performance[Topic (resolved)] — native PrimaryTopic",
              "first, generic keyword/LLM fallback otherwise). Customer-agnostic: lets the Activity & Value / Impact page",
              "be sliced and valued by topic on ANY tenant's data without priming the template with customer words."
            ],
            "sourceColumn": "[Topic]",
            "lineageTag": "5b000000-col0-0000-000000000006",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Topic Base (min)",
            "dataType": "double",
            "description": [
              "Topic-driven human-equivalent minutes: the handle-time a human would spend on THIS conversation's topic,",
              "from the editable generic 'Agent Task Value Map' (keyed on [Topic]). Noise/system topics earn 0; unmapped",
              "topics fall back to *Default*. This is the customer-agnostic value basis woven from the generic topics."
            ],
            "expression": [
              "VAR _t = 'Activity Events'[Topic]",
              "VAR _isNoise = CONTAINSSTRING ( _t, UNICHAR ( 128683 ) ) || CONTAINSSTRING ( _t, UNICHAR ( 9888 ) )",
              "VAR _default = LOOKUPVALUE ( 'Agent Task Value Map'[Base Handle (min)], 'Agent Task Value Map'[Topic], \"*Default*\" )",
              "VAR _base = COALESCE ( LOOKUPVALUE ( 'Agent Task Value Map'[Base Handle (min)], 'Agent Task Value Map'[Topic], _t ), _default )",
              "RETURN IF ( _isNoise, 0, _base )"
            ],
            "lineageTag": "5b000000-col0-0000-000000000007",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Topic (lead)",
            "dataType": "string",
            "description": [
              "TOPIC-LED display label for the topic dimension: the generic business topic, with noise/system",
              "conversations collapsed to a single friendly bucket. This is the customer-agnostic \"what the human",
              "would have handled\" lens that LEADS the Activity & Value / Impact view."
            ],
            "expression": [
              "VAR _t = 'Activity Events'[Topic]",
              "VAR _isNoise = CONTAINSSTRING ( _t, UNICHAR ( 128683 ) ) || CONTAINSSTRING ( _t, UNICHAR ( 9888 ) )",
              "RETURN IF ( _isNoise, \"Untitled / system chat\", _t )"
            ],
            "lineageTag": "5b000000-col0-0000-000000000008",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Action",
            "dataType": "string",
            "description": [
              "PLAIN ACTION verb — the single, simple word for what the agent DID, collapsed from the detailed",
              "capability signal with minimal overlap. Pairs with [Topic (lead)] to read e.g. \"Leave & Absence ·",
              "Answered\". Customer-agnostic. The detailed 9-way [Activity] stays underneath for detection + tuning."
            ],
            "expression": [
              "SWITCH (",
              "    'Activity Events'[Activity],",
              "    \"Knowledge retrieval\", \"Answered\",",
              "    \"Grounded / cited answer\", \"Answered\",",
              "    \"Generative answer\", \"Drafted\",",
              "    \"Tool / transaction\", \"Actioned\",",
              "    \"Multi-step workflow\", \"Processed\",",
              "    \"Multi-agent orchestration\", \"Processed\",",
              "    \"Reasoning / planning effort\", \"Processed\",",
              "    \"Query resolved\", \"Resolved\",",
              "    \"Feedback captured\", \"Feedback\",",
              "    \"Handled\"",
              ")"
            ],
            "lineageTag": "5b000000-col0-0000-000000000009",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Is Primary Activity",
            "dataType": "int64",
            "description": [
              "1 for the single DOMINANT activity in each conversation (highest 'Baseline (min)', ties broken by a",
              "fixed capability priority), else 0. Used to de-duplicate value so a conversation that did several",
              "things is counted once as one human-task-equivalent. Fixed at refresh (independent of the sliders)."
            ],
            "expression": [
              "VAR _cid = 'Activity Events'[conversation_id]",
              "VAR _key =",
              "    'Activity Events'[Baseline (min)] * 100 -",
              "    SWITCH (",
              "        'Activity Events'[Activity],",
              "        \"Tool / transaction\", 1, \"Multi-step workflow\", 2, \"Knowledge retrieval\", 3,",
              "        \"Multi-agent orchestration\", 4, \"Generative answer\", 5, \"Query resolved\", 6,",
              "        \"Grounded / cited answer\", 7, \"Reasoning / planning effort\", 8, \"Feedback captured\", 9, 99",
              "    )",
              "VAR _maxKey =",
              "    MAXX (",
              "        FILTER ( ALL ( 'Activity Events' ), 'Activity Events'[conversation_id] = _cid ),",
              "        'Activity Events'[Baseline (min)] * 100 -",
              "        SWITCH (",
              "            'Activity Events'[Activity],",
              "            \"Tool / transaction\", 1, \"Multi-step workflow\", 2, \"Knowledge retrieval\", 3,",
              "            \"Multi-agent orchestration\", 4, \"Generative answer\", 5, \"Query resolved\", 6,",
              "            \"Grounded / cited answer\", 7, \"Reasoning / planning effort\", 8, \"Feedback captured\", 9, 99",
              "        )",
              "    )",
              "RETURN",
              "    IF ( _key = _maxKey, 1, 0 )"
            ],
            "lineageTag": "5b000000-col0-0000-000000000005",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Outcome",
            "dataType": "string",
            "description": [
              "VALUE OUTCOME — what value was actually gained from the task: where time/effort was saved or what",
              "helped the person/process. Plain language, paired 1:1 with [Action] (minimal overlap). This is the",
              "\"what did we get out of it\" lens for the Activity & Value view."
            ],
            "expression": [
              "SWITCH (",
              "    'Activity Events'[Action],",
              "    \"Answered\", \"Search & lookup time saved\",",
              "    \"Drafted\", \"Content creation time saved\",",
              "    \"Actioned\", \"Manual transaction handled\",",
              "    \"Processed\", \"Multi-step effort saved\",",
              "    \"Resolved\", \"Human escalation avoided\",",
              "    \"Feedback\", \"Service improvement captured\",",
              "    \"Time saved\"",
              ")"
            ],
            "lineageTag": "5b000000-col0-0000-00000000000a",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Topic + Action",
            "dataType": "string",
            "description": [
              "Topic + plain action, blended into one clear label, e.g. \"IT, Access & Devices · Actioned\".",
              "Customer-agnostic. Use where a single combined label is wanted instead of two columns."
            ],
            "expression": [
              "VAR _t = 'Activity Events'[Topic (lead)]",
              "RETURN _t & \" · \" & 'Activity Events'[Action]"
            ],
            "lineageTag": "5b000000-col0-0000-00000000000b",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Work Category",
            "dataType": "string",
            "description": [
              "WORK CATEGORY (\"type of help\") — simple, customer-agnostic Option-1 bucket for what the agent did,",
              "collapsed to 5 plain categories with minimal overlap. Pairs with [Topic (lead)] so you can break",
              "tasks/hours down BY TOPIC × CATEGORY with no duplication (one primary activity per conversation)."
            ],
            "expression": [
              "VAR cid = 'Activity Events'[conversation_id]",
              "VAR act = 'Activity Events'[Action]",
              "RETURN",
              "    SWITCH (",
              "        act,",
              "        \"Processed\", \"Multi-step handling\",",
              "        \"Answered\", \"Knowledge & answers\",",
              "        \"Resolved\", \"Self-service deflection\",",
              "        \"Drafted\", \"Content creation\",",
              "        \"Actioned\", \"Task / action completed\",",
              "        \"Other\"",
              "    )"
            ],
            "lineageTag": "5b000000-col0-0000-00000000000c",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Topic + Category",
            "dataType": "string",
            "description": "Topic + Work Category combined, e.g. \"IT, Access & Devices · Multi-step handling\". Customer-agnostic.",
            "expression": "'Activity Events'[Topic (lead)] & \" · \" & 'Activity Events'[Work Category]",
            "lineageTag": "5b000000-col0-0000-00000000000d",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Activity Events",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR _know = LOOKUPVALUE ( 'Studio Activity Value Map'[Human Baseline (min)], 'Studio Activity Value Map'[Activity], \"Knowledge retrieval\" )",
                "VAR _ground = LOOKUPVALUE ( 'Studio Activity Value Map'[Human Baseline (min)], 'Studio Activity Value Map'[Activity], \"Grounded / cited answer\" )",
                "VAR _gen = LOOKUPVALUE ( 'Studio Activity Value Map'[Human Baseline (min)], 'Studio Activity Value Map'[Activity], \"Generative answer\" )",
                "VAR _tool = LOOKUPVALUE ( 'Studio Activity Value Map'[Human Baseline (min)], 'Studio Activity Value Map'[Activity], \"Tool / transaction\" )",
                "VAR _multi = LOOKUPVALUE ( 'Studio Activity Value Map'[Human Baseline (min)], 'Studio Activity Value Map'[Activity], \"Multi-step workflow\" )",
                "VAR _orch = LOOKUPVALUE ( 'Studio Activity Value Map'[Human Baseline (min)], 'Studio Activity Value Map'[Activity], \"Multi-agent orchestration\" )",
                "VAR _reason = LOOKUPVALUE ( 'Studio Activity Value Map'[Human Baseline (min)], 'Studio Activity Value Map'[Activity], \"Reasoning / planning effort\" )",
                "VAR _res = LOOKUPVALUE ( 'Studio Activity Value Map'[Human Baseline (min)], 'Studio Activity Value Map'[Activity], \"Query resolved\" )",
                "VAR _feed = LOOKUPVALUE ( 'Studio Activity Value Map'[Human Baseline (min)], 'Studio Activity Value Map'[Activity], \"Feedback captured\" )",
                "RETURN",
                "    UNION (",
                "        SELECTCOLUMNS (",
                "            FILTER ( 'Agent Performance', RELATED ( 'Agent Sessions'[knowledge_searched] ) = TRUE () ),",
                "            \"conversation_id\", 'Agent Performance'[ConversationTranscriptId],",
                "            \"Topic\", 'Agent Performance'[Topic (resolved)],",
                "            \"Activity\", \"Knowledge retrieval\",",
                "            \"Value Outcome\", \"Search Time Saved\",",
                "            \"Baseline (min)\", _know",
                "        ),",
                "        SELECTCOLUMNS (",
                "            FILTER ( 'Agent Performance', RELATED ( 'Agent Sessions'[knowledge_answered] ) = TRUE () || RELATED ( 'Agent Sessions'[knowledge_sources_count] ) > 0 ),",
                "            \"conversation_id\", 'Agent Performance'[ConversationTranscriptId],",
                "            \"Topic\", 'Agent Performance'[Topic (resolved)],",
                "            \"Activity\", \"Grounded / cited answer\",",
                "            \"Value Outcome\", \"Answer Quality & Accuracy\",",
                "            \"Baseline (min)\", _ground",
                "        ),",
                "        SELECTCOLUMNS (",
                "            FILTER ( 'Agent Performance', 'Agent Performance'[GenerativeResponseCount] > 0 ),",
                "            \"conversation_id\", 'Agent Performance'[ConversationTranscriptId],",
                "            \"Topic\", 'Agent Performance'[Topic (resolved)],",
                "            \"Activity\", \"Generative answer\",",
                "            \"Value Outcome\", \"Content Output\",",
                "            \"Baseline (min)\", _gen",
                "        ),",
                "        SELECTCOLUMNS (",
                "            FILTER ( 'Agent Performance', 'Agent Performance'[PluginCallCount] > 0 ),",
                "            \"conversation_id\", 'Agent Performance'[ConversationTranscriptId],",
                "            \"Topic\", 'Agent Performance'[Topic (resolved)],",
                "            \"Activity\", \"Tool / transaction\",",
                "            \"Value Outcome\", \"Task / Transaction Completed\",",
                "            \"Baseline (min)\", _tool",
                "        ),",
                "        SELECTCOLUMNS (",
                "            FILTER ( 'Agent Performance', RELATED ( 'Agent Sessions'[plan_step_count] ) > 1 ),",
                "            \"conversation_id\", 'Agent Performance'[ConversationTranscriptId],",
                "            \"Topic\", 'Agent Performance'[Topic (resolved)],",
                "            \"Activity\", \"Multi-step workflow\",",
                "            \"Value Outcome\", \"Workflow Triggered\",",
                "            \"Baseline (min)\", _multi",
                "        ),",
                "        SELECTCOLUMNS (",
                "            FILTER ( 'Agent Performance', 'Agent Performance'[MultiAgentSession] = \"True\" ),",
                "            \"conversation_id\", 'Agent Performance'[ConversationTranscriptId],",
                "            \"Topic\", 'Agent Performance'[Topic (resolved)],",
                "            \"Activity\", \"Multi-agent orchestration\",",
                "            \"Value Outcome\", \"Workflow Triggered\",",
                "            \"Baseline (min)\", _orch",
                "        ),",
                "        SELECTCOLUMNS (",
                "            FILTER ( 'Agent Performance', RELATED ( 'Agent Sessions'[plan_step_count] ) > 0 ),",
                "            \"conversation_id\", 'Agent Performance'[ConversationTranscriptId],",
                "            \"Topic\", 'Agent Performance'[Topic (resolved)],",
                "            \"Activity\", \"Reasoning / planning effort\",",
                "            \"Value Outcome\", \"General AI Productivity\",",
                "            \"Baseline (min)\", _reason",
                "        ),",
                "        SELECTCOLUMNS (",
                "            FILTER ( 'Agent Performance', 'Agent Performance'[SessionOutcome] = \"Resolved\" ),",
                "            \"conversation_id\", 'Agent Performance'[ConversationTranscriptId],",
                "            \"Topic\", 'Agent Performance'[Topic (resolved)],",
                "            \"Activity\", \"Query resolved\",",
                "            \"Value Outcome\", \"Self-Service Deflection\",",
                "            \"Baseline (min)\", _res",
                "        ),",
                "        SELECTCOLUMNS (",
                "            FILTER ( 'Agent Performance', RELATED ( 'Agent Sessions'[feedback_submitted] ) > 0 ),",
                "            \"conversation_id\", 'Agent Performance'[ConversationTranscriptId],",
                "            \"Topic\", 'Agent Performance'[Topic (resolved)],",
                "            \"Activity\", \"Feedback captured\",",
                "            \"Value Outcome\", \"Continuous Improvement\",",
                "            \"Baseline (min)\", _feed",
                "        )",
                "    )"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Activity Minutes Saved",
            "description": [
              "Minutes saved, de-duplicated to ONE human-task-equivalent per conversation: each conversation is",
              "credited at its DOMINANT activity only (the highest-value capability it used), valued at the",
              "customer-adjustable per-activity minute sliders (defaults from 'Studio Activity Value Map').",
              "Within a single conversation the agent does one user-facing job via several internal capabilities,",
              "so those co-engaged steps are NOT summed (mirrors the 4MOST 'single-artifact -> don't sum' rule)."
            ],
            "expression": [
              "SUMX (",
              "    FILTER ( 'Activity Events', 'Activity Events'[Is Primary Activity] = 1 ),",
              "    SWITCH (",
              "        'Activity Events'[Activity],",
              "        \"Knowledge retrieval\", [Min KR],",
              "        \"Grounded / cited answer\", [Min GC],",
              "        \"Generative answer\", [Min GA],",
              "        \"Tool / transaction\", [Min TT],",
              "        \"Multi-step workflow\", [Min MW],",
              "        \"Multi-agent orchestration\", [Min MA],",
              "        \"Reasoning / planning effort\", [Min RP],",
              "        \"Query resolved\", [Min QR],",
              "        \"Feedback captured\", [Min FB],",
              "        'Activity Events'[Baseline (min)]",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "🔮 Activity & Value",
            "lineageTag": "5b000000-meas-0000-000000000001"
          },
          {
            "name": "Activity Hours Saved",
            "description": [
              "Hours saved = activity minutes / 60.",
              "Hours saved = activity minutes / 60. HEADLINE BASIS = BLENDED (topic-driven where a generic topic",
              "was derived, per-activity-slider fallback otherwise) — the most complete, customer-agnostic value.",
              "All downstream cards (assisted value, projected annual, per week) and the Value Story derive from this."
            ],
            "expression": "DIVIDE([Activity Minutes Saved (Blended)], 60)",
            "formatString": "#,0.0",
            "displayFolder": "🔮 Activity & Value",
            "lineageTag": "5b000000-meas-0000-000000000002"
          },
          {
            "name": "Activity Event Count",
            "description": [
              "Count of VALUED actions = one credited (dominant) activity per conversation. Reconciles with",
              "'Activity Minutes Saved' and the headline cards. For the all-capabilities count use",
              "'Activity Capability Events'."
            ],
            "expression": "CALCULATE ( COUNTROWS ( 'Activity Events' ), 'Activity Events'[Is Primary Activity] = 1 )",
            "formatString": "#,0",
            "displayFolder": "🔮 Activity & Value",
            "lineageTag": "5b000000-meas-0000-000000000003"
          },
          {
            "name": "Activity Assisted Value",
            "description": "Assisted value = hours saved × the (customer-adjustable) hourly salary slider.",
            "expression": "[Activity Hours Saved] * [Hourly Rate Value]",
            "formatString": "\\£#,0",
            "displayFolder": "🔮 Activity & Value",
            "lineageTag": "5b000000-meas-0000-000000000004"
          },
          {
            "name": "Activity Projected Annual Value",
            "description": "Projected annualised assisted value = assisted value scaled from the selected window to a full year (365 / window days). Indicative.",
            "expression": [
              "VAR _days = DATEDIFF ( MIN ( 'Agent Sessions'[Session Start Date] ), MAX ( 'Agent Sessions'[Session Start Date] ), DAY ) + 1",
              "RETURN",
              "    [Activity Assisted Value] * DIVIDE ( 365, MAX ( _days, 1 ) )"
            ],
            "formatString": "\\£#,0",
            "displayFolder": "🔮 Activity & Value",
            "lineageTag": "5b000000-meas-0000-000000000006"
          },
          {
            "name": "🔮 Activity Value Story (Live)",
            "description": "Dynamic headline for the Activity & Value page. Degrades gracefully when nothing is in scope.",
            "expression": [
              "VAR _events = [Activity Event Count]",
              "VAR _hrs = [Activity Hours Saved]",
              "VAR _val = [Activity Assisted Value]",
              "VAR _ann = [Activity Projected Annual Value]",
              "VAR _topTopic =",
              "    MAXX (",
              "        TOPN ( 1, SUMMARIZE ( FILTER ( 'Activity Events', NOT ( CONTAINSSTRING ( 'Activity Events'[Topic], UNICHAR ( 128683 ) ) ) && NOT ( CONTAINSSTRING ( 'Activity Events'[Topic], UNICHAR ( 9888 ) ) ) ), 'Activity Events'[Topic] ), [Activity Minutes Saved (Blended)], DESC ),",
              "        'Activity Events'[Topic]",
              "    )",
              "RETURN",
              "    IF (",
              "        _events = 0,",
              "        \"No activity in the current selection. This page values each conversation by its business TOPIC (the human task taken off someone's plate), with the agent's capability as supporting detail, against editable human-time estimates.\",",
              "        \"Agents handled \" & FORMAT ( _events, \"#,0\" ) & \" conversation(s), saving an estimated \" & FORMAT ( _hrs, \"#,0.0\" ) &",
              "            \" human hours — about \" & FORMAT ( _val, \"\\£#,0\" ) & \" at the selected salary (\" &",
              "            FORMAT ( _ann, \"\\£#,0\" ) & \" projected annualised). Biggest topic: \" & COALESCE ( _topTopic, \"—\" ) & \".\"",
              "    )"
            ],
            "displayFolder": "🔮 Activity & Value",
            "lineageTag": "5b000000-meas-0000-000000000007"
          },
          {
            "name": "Activity Minutes Saved (Topic-weighted)",
            "description": [
              "TOPIC-WEIGHTED minutes saved: each conversation valued ONCE (dominant activity) but at its generic",
              "TOPIC's human handle-time ('Agent Task Value Map') rather than the per-activity slider. This is the",
              "fully customer-agnostic value basis — driven by what the conversation was ABOUT (generic topic), which",
              "surfaces in any tenant's data, not by primed keywords or sparse telemetry. Conversations whose topic is",
              "noise/blank earn 0 here (no topic to value)."
            ],
            "expression": [
              "SUMX (",
              "    FILTER ( 'Activity Events', 'Activity Events'[Is Primary Activity] = 1 ),",
              "    'Activity Events'[Topic Base (min)]",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "🔮 Activity & Value",
            "lineageTag": "5b000000-meas-0000-000000000010"
          },
          {
            "name": "Activity Minutes Saved (Blended)",
            "description": [
              "BLENDED minutes saved (recommended, most complete + customer-agnostic): each conversation valued ONCE",
              "(dominant activity). Where a generic TOPIC was derived, it is valued at that topic's human handle-time",
              "('Agent Task Value Map') — i.e. by WHAT THE CONVERSATION WAS ABOUT (surfaces on any tenant, no primed",
              "words). Where no topic could be derived (blank/no-message conversations), it falls back to the editable",
              "per-activity slider value. This gives full coverage AND a topic-driven basis wherever one exists."
            ],
            "expression": [
              "SUMX (",
              "    FILTER ( 'Activity Events', 'Activity Events'[Is Primary Activity] = 1 ),",
              "    VAR _tb = 'Activity Events'[Topic Base (min)]",
              "    VAR _act =",
              "        SWITCH (",
              "            'Activity Events'[Activity],",
              "            \"Knowledge retrieval\", [Min KR],",
              "            \"Grounded / cited answer\", [Min GC],",
              "            \"Generative answer\", [Min GA],",
              "            \"Tool / transaction\", [Min TT],",
              "            \"Multi-step workflow\", [Min MW],",
              "            \"Multi-agent orchestration\", [Min MA],",
              "            \"Reasoning / planning effort\", [Min RP],",
              "            \"Query resolved\", [Min QR],",
              "            \"Feedback captured\", [Min FB],",
              "            'Activity Events'[Baseline (min)]",
              "        )",
              "    RETURN IF ( _tb > 0, _tb, _act )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "🔮 Activity & Value",
            "lineageTag": "5b000000-meas-0000-000000000012"
          },
          {
            "name": "Activity Hours Saved (Blended)",
            "description": "Blended hours saved = blended minutes / 60. (Recommended headline basis.)",
            "expression": "DIVIDE ( [Activity Minutes Saved (Blended)], 60 )",
            "formatString": "#,0.0",
            "displayFolder": "🔮 Activity & Value",
            "lineageTag": "5b000000-meas-0000-000000000013"
          },
          {
            "name": "Category Minutes Saved (Tuned)",
            "description": [
              "CATEGORY-TUNED minutes saved: each conversation valued ONCE (dominant activity) at the editable",
              "per-WORK-CATEGORY minute slider for its category. This is the basis the Impact Table (by Work Category)",
              "uses, so the category sliders visibly drive the totals. Customer-agnostic."
            ],
            "expression": [
              "SUMX (",
              "    FILTER ( 'Activity Events', 'Activity Events'[Is Primary Activity] = 1 ),",
              "    SWITCH (",
              "        'Activity Events'[Work Category],",
              "        \"Multi-step handling\", [Min Cat MS],",
              "        \"Knowledge & answers\", [Min Cat KA],",
              "        \"Self-service deflection\", [Min Cat SS],",
              "        \"Content creation\", [Min Cat CC],",
              "        \"Task / action completed\", [Min Cat TX],",
              "        0",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "🧬 Work Category",
            "lineageTag": "5b000000-meas-0000-000000000020"
          },
          {
            "name": "Category Hours Saved (Tuned)",
            "description": "Category-tuned hours saved = category-tuned minutes / 60.",
            "expression": "DIVIDE ( [Category Minutes Saved (Tuned)], 60 )",
            "formatString": "#,0.0",
            "displayFolder": "🧬 Work Category",
            "lineageTag": "5b000000-meas-0000-000000000021"
          },
          {
            "name": "Category Min (Tuned)",
            "description": [
              "The currently-selected minutes/task slider value for the Work Category in row/filter context.",
              "Reads from the per-category sliders so the Impact Table's \"Min/task\" column reflects the slider."
            ],
            "expression": [
              "VAR _cat = COALESCE ( SELECTEDVALUE ( 'Work Category Value Map'[Work Category] ), SELECTEDVALUE ( 'Activity Events'[Work Category] ) )",
              "RETURN",
              "    SWITCH (",
              "        _cat,",
              "        \"Multi-step handling\", [Min Cat MS],",
              "        \"Knowledge & answers\", [Min Cat KA],",
              "        \"Self-service deflection\", [Min Cat SS],",
              "        \"Content creation\", [Min Cat CC],",
              "        \"Task / action completed\", [Min Cat TX],",
              "        BLANK ()",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "🧬 Work Category",
            "lineageTag": "5b000000-meas-0000-000000000023"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "5b0000000000142000900"
          }
        ]
      },
