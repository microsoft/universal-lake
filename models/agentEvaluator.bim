            "name": "Work Category Value Map",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE(",
                "    \"Work Category\", STRING,",
                "    \"What it captures\", STRING,",
                "    \"Mid (min)\", INTEGER,",
                "    \"Low (min)\", INTEGER,",
                "    \"High (min)\", INTEGER,",
                "    \"Value Outcome\", STRING,",
                "    \"Source\", STRING,",
                "    \"Sort Order\", INTEGER,",
                "    \"Source URL\", STRING,",
                "    {",
                "        {\"Task / action completed\", \"Agent invoked a tool / plugin / connector to complete a task for the user (raise/resolve a ticket, reset access, book, update a record) instead of the user doing it manually\", 15, 10, 40, \"Manual task / transaction handled\", \"HDI 2023 service-desk AHT; MetricNet; Forrester TEI Power Automate 2024\", 1, \"https://www.microsoft.com/en-us/power-platform/products/power-automate\"},",
                "        {\"Multi-step handling\", \"Agent ran a multi-step / multi-agent / reasoning plan\", 12, 6, 30, \"Workflow & process effort saved\", \"Forrester TEI Power Automate 2024; Gartner hyperautomation; orchestration coordination (Forrester TEI 2022)\", 2, \"https://www.gartner.com/en/information-technology/glossary/hyperautomation\"},",
                "        {\"Knowledge & answers\", \"Agent retrieved or cited internal knowledge to answer\", 11, 5, 18, \"Search & lookup time saved\", \"McKinsey 2012 / IDC 2018 enterprise search; HDI 2023 service-desk lookup; Forrester TEI 2022 grounded answers\", 3, \"https://www.mckinsey.com/industries/technology-media-and-telecommunications/our-insights/the-social-economy\"},",
                "        {\"Content creation\", \"Agent drafted or generated content\", 8, 4, 24, \"Content creation time saved\", \"NBER w33795 (Dillon et al. 2025); McKinsey 2023; IDEAS 2026\", 4, \"https://www.nber.org/papers/w33795\"},",
                "        {\"Self-service deflection\", \"Query resolved without a human channel\", 8, 5, 12, \"Human escalation avoided\", \"MetricNet cost-per-contact; ESS self-service deflection\", 5, \"https://www.metricnet.com/\"}",
                "    }",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "5e0000000000142000900"
          }
        ]
      },
