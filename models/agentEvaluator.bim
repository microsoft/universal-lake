        "partitions": [
          {
            "name": "Agent Catalogue",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Sessions = if #\"Source Mode\" <> \"Fabric\" then Parse_Sessions() else if true then (try FabricTable(\"agent_sessions\") otherwise EmptyTable({\"primary_agent_schema\"})) else EmptyTable({\"primary_agent_schema\"}),",
                "    Sub      = if #\"Source Mode\" <> \"Fabric\" then Parse_SubAgents() else if true then (try FabricTable(\"agent_subagents\") otherwise EmptyTable({\"connected_agent_schema\"})) else EmptyTable({\"connected_agent_schema\"}),",
                "    PrimRenamed = Table.RenameColumns(Table.SelectColumns(Sessions, {\"primary_agent_schema\"}, MissingField.UseNull), {{\"primary_agent_schema\", \"agent_schema\"}}),",
                "    SubRenamed  = Table.RenameColumns(Table.SelectColumns(Sub, {\"connected_agent_schema\"}, MissingField.UseNull), {{\"connected_agent_schema\", \"agent_schema\"}}),",
                "    Combined = Table.Combine({PrimRenamed, SubRenamed}),",
                "    NonNull  = Table.SelectRows(Combined, each [agent_schema] <> null and Text.Trim(Text.From([agent_schema])) <> \"\"),",
                "    Distinct = Table.Distinct(NonNull),",
                "    Acronyms = {\"BT\",\"HR\",\"IT\",\"AI\",\"HQ\",\"QA\",\"CRM\",\"ERP\",\"M365\",\"API\",\"KPI\",\"PDF\",\"SLA\",\"VPN\"},",
                "    // Friendly display name: orchestrators cluster to one label; strip publisher prefix",
                "    // (crb93_/cr23c_/msdyn_); split camelCase + ACRONYM->Word; preserve acronyms; ESS pattern.",
                "    Clean = (schema as text) as text =>",
                "        let",
                "            s = schema,",
                "            lc = Text.Lower(s),",
                "            isOrch = Text.Contains(lc, \"header\") or Text.Contains(lc, \"orchestrator\"),",
                "            ssPos = Text.PositionOf(lc, \"copilotforemployeeselfservice\"),",
                "            ssRole = if ssPos >= 0 then Text.Select(Text.Range(lc, ssPos + Text.Length(\"copilotforemployeeselfservice\")), {\"a\"..\"z\"}) else \"\",",
                "            ssLabel = if ssRole = \"\" then \"Employee Self-Service\" else \"Employee Self-Service \" & (if List.Contains(Acronyms, Text.Upper(ssRole)) then Text.Upper(ssRole) else Text.Proper(ssRole)),",
                "            afterFirst = if Text.Contains(s, \"_\") then Text.AfterDelimiter(s, \"_\") else s,",
                "            base0 = Text.Replace(Text.Replace(afterFirst, \"_\", \" \"), \"-\", \" \"),",
                "            chars = Text.ToList(base0),",
                "            n = List.Count(chars),",
                "            isUpper = (c) => c <> \"\" and c = Text.Upper(c) and c <> Text.Lower(c),",
                "            isLowerOrDigit = (c) => c <> \"\" and (c = Text.Lower(c) and c <> Text.Upper(c) or (c >= \"0\" and c <= \"9\")),",
                "            spaced = Text.Combine(List.Transform(List.Positions(chars), (i) =>",
                "                let c = chars{i}, prev = if i = 0 then \"\" else chars{i-1}, nxt = if i = n-1 then \"\" else chars{i+1},",
                "                    b1 = i > 0 and isUpper(c) and isLowerOrDigit(prev),",
                "                    b2 = i > 0 and isUpper(c) and isUpper(prev) and nxt <> \"\" and nxt = Text.Lower(nxt) and nxt <> Text.Upper(nxt)",
                "                in (if b1 or b2 then \" \" else \"\") & c)),",
                "            words = List.Select(Text.Split(spaced, \" \"), each _ <> \"\"),",
                "            titled = Text.Combine(List.Transform(words, each if List.Contains(Acronyms, Text.Upper(_)) then Text.Upper(_) else Text.Proper(_)), \" \")",
                "        in",
                "            if isOrch then \"M365 Copilot Orchestrator\"",
                "            else if ssPos >= 0 then ssLabel",
                "            else if titled = \"\" then s else titled,",
                "    Classify = (schema as text) as text =>",
                "        let lc = Text.Lower(schema) in",
                "            if Text.Contains(lc, \"header\") or Text.Contains(lc, \"orchestrator\") then \"Orchestrator\"",
                "            else if Text.Contains(lc, \"copilotforemployeeselfservice\") then \"Self-Service\"",
                "            else if Text.StartsWith(lc, \"crb\") or Text.StartsWith(lc, \"crd\") then \"Custom Declarative\"",
                "            else if Text.StartsWith(lc, \"msdyn\") then \"First-Party Connected\"",
                "            else \"Other\",",
                "WithDisplay = Table.AddColumn(Distinct, \"agent_display_name\", each if [agent_schema] = null then null else Clean(Text.From([agent_schema])), type text),",
                "WithClass = Table.AddColumn(WithDisplay, \"agent_class\", each if [agent_schema] = null then null else Classify(Text.From([agent_schema])), type text),",
                "    Typed = Table.TransformColumnTypes(WithClass, {",
                "        {\"agent_schema\", type text},",
                "        {\"agent_display_name\", type text},",
                "        {\"agent_class\", type text}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
