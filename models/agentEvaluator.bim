            "name": "Org Join Key",
            "description": "Join key to the fact tables. Prefers PersonId_Normalized (the UPN), falls back to a lower-cased id.",
            "dataType": "string",
            "sourceColumn": "Org Join Key",
            "lineageTag": "cc000org-col0-0001-000000000901",
