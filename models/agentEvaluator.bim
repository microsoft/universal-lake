          {
            "type": "calculated",
            "name": "User_Email_Normalized",
            "dataType": "string",
            "description": "Lower/trim of User_Email — join key to Chat + Agent Org Data[PersonId_Normalized] (UPN) for org attribution of billing credits.",
            "expression": "LOWER ( TRIM ( 'Credit Consumption (User)'[User_Email] ) )",
            "lineageTag": "cc0002us-col0-emailnorm0001",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Agent_Name_Normalized",
            "dataType": "string",
            "description": "Normalized agent name (lower/trim) — join key to the shared Agent Bridge dimension so the user billing table cross-filters with the agent billing table by agent.",
            "expression": "LOWER ( TRIM ( 'Credit Consumption (User)'[Agent_Name] ) )",
            "lineageTag": "cc0002us-col0-agentnorm0001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Environment_Id",
            "dataType": "string",
            "description": "Environment derived from the user's Agent_Id via the agent billing table (one agent = one environment), so the shared Environment dimension can filter the user billing table too. MAXX (not LOOKUPVALUE) so a stray multi-environment agent can never hard-error the refresh.",
            "expression": "MAXX ( FILTER ( 'Credit Consumption (Agent)', 'Credit Consumption (Agent)'[Agent_Id] = 'Credit Consumption (User)'[Agent_Id] ), 'Credit Consumption (Agent)'[Environment_Id] )",
            "lineageTag": "cc0002us-col0-envid0001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Credit Consumption (User)",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Cols = {\"User_Id\", \"User_Email\", \"Agent_Id\", \"Agent_Name\", \"Billable_credit_used\", \"Credits_used\", \"M365_Copilot_Licensed\"},",
                "    Promoted = ",
                "        // Outside Fabric, read <CSV Folder Path>\\credit_consumption_user.csv when present.",
                "        // Missing file -> the original empty shape, so the file stays optional.",
                "        if #\"Source Mode\" = \"Fabric\" then (try FabricTable(\"credit_consumption_user\") otherwise EmptyTable(Cols))",
                "        else (try Table.SelectColumns(CsvTable(\"credit_consumption_user\"), Cols, MissingField.UseNull)",
                "              otherwise EmptyTable(Cols)),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"User_Id\", type text},",
                "        {\"User_Email\", type text},",
                "        {\"Agent_Id\", type text},",
                "        {\"Agent_Name\", type text},",
                "        {\"Billable_credit_used\", Int64.Type},",
                "        {\"Credits_used\", Int64.Type},",
                "        {\"M365_Copilot_Licensed\", type text}",
                "    }, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Credits Used (Billing)",
            "description": "Total credits used across all users (billing actuals).",
            "expression": "SUM('Credit Consumption (User)'[Credits_used])",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0002us-meas-0001-000000000001"
          },
          {
            "name": "Total Billable Credits Used",
            "description": "Total billable credits used across all users.",
            "expression": "SUM('Credit Consumption (User)'[Billable_credit_used])",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0002us-meas-0001-000000000002"
          },
          {
            "name": "Billing Active Users",
            "description": "Distinct users who consumed at least one credit (billing actuals).",
            "expression": "DISTINCTCOUNT('Credit Consumption (User)'[User_Email])",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0002us-meas-0001-000000000003"
          },
          {
            "name": "Avg Credits per User (Billing)",
            "description": "Mean credits used per credit-consuming user (billing actuals).",
            "expression": "DIVIDE([Total Credits Used (Billing)], [Billing Active Users])",
            "formatString": "#,0.00",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0002us-meas-0001-000000000004"
          },
          {
            "name": "Billing Org Credit Share %",
            "description": "Share of billing credits used by each organization (via the User->Org relationship).",
            "expression": "DIVIDE ( [Total Credits Used (Billing)], CALCULATE ( [Total Credits Used (Billing)], ALLSELECTED () ) )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0002us-meas-orgshare0001"
          },
          {
            "name": "Studio Top 10% Share",
            "description": "Share of credits consumed by the top 10% of users by consumption.",
            "expression": [
              "// Share of all credits consumed by the busiest 10% of users.",
              "// A high value means spend is concentrated in a few power users;",
              "// a low value means it is spread across the population.",
              "VAR n = [Billing Active Users]",
              "VAR k = MAX( 1, ROUND( n * 0.10, 0 ) )",
              "VAR t = ADDCOLUMNS( VALUES('Credit Consumption (User)'[User_Email]), \"@c\", [Total Credits Used (Billing)] )",
              "RETURN DIVIDE( SUMX( TOPN( k, t, [@c], DESC ), [@c] ), [Total Credits Used (Billing)] )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Billing",
            "lineageTag": "ae000001-cred-4001-8001-091372751747"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Credit Consumption (Tenant)",
