                "name": "SummarizationSetBy",
                "value": "User"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Hourly Rate (Saving)",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "GENERATESERIES(10, 150, 5)"
            }
          }
        ],
        "measures": [
          {
            "name": "Hourly Rate Value",
            "description": "Selected blended hourly cost of the human whose time the agent saves (e.g. service-desk / shared-services FTE, fully-loaded). Drives £ value. Editable slider; default £25/hr.",
            "expression": "SELECTEDVALUE('Hourly Rate (Saving)'[Hourly Rate], 25)",
            "formatString": "\\£#,0",
            "lineageTag": "a7c7a530-meas-0001-000000000001"
          }
        ],
        "annotations": [
