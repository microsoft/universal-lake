      },
      {
        "name": "Lakehouse Name",
        "description": "Name of the Lakehouse (or Warehouse) that holds the Delta tables written by the four Fabric notebooks.",
        "kind": "m",
        "expression": "null meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]",
        "lineageTag": "1a2b3c4d-fab1-4002-8002-000000000002",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "FabricTable",
        "description": [
          "Helper: read a Delta table from the Fabric Lakehouse SQL endpoint by name (dbo schema).",
          "Every CT/audit/licensed/org table sources through this so only the two parameters above need setting."
        ],
        "kind": "m",
        "expression": [
          "(tableName as text) as table =>",
          "\tlet",
          "FabEndpoint = if #\"Fabric SQL Endpoint\" = null then \"\" else Text.From(#\"Fabric SQL Endpoint\"),",
          "FabLakehouse = if #\"Lakehouse Name\" = null then \"\" else Text.From(#\"Lakehouse Name\"),",
          "Db = if FabEndpoint = \"\" or FabLakehouse = \"\" then error \"Source Mode is Fabric, so Fabric SQL Endpoint and Lakehouse Name must both be set.\" else Sql.Database(FabEndpoint, FabLakehouse),",
          "\t\tData = Table.SelectRows(Db, each [Schema] = \"dbo\" and Text.Lower([Item]) = Text.Lower(tableName)){0}[Data]",
          "\tin",
          "\t\tData"
        ],
        "lineageTag": "1a2b3c4d-fab1-4003-8003-000000000003",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "EmptyTable",
        "description": [
          "Helper: build an empty table with the given column names. Graceful fallback for OPTIONAL",
          "sources so a missing Lakehouse table never breaks the dashboard refresh."
        ],
        "kind": "m",
        "expression": "(columns as list) as table => #table(columns, {})",
        "lineageTag": "1a2b3c4d-fab1-4004-8004-000000000004",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "Source Mode",
        "description": [
          "SOURCE MODE — where the agent/transcript tables come from.",
          "\"Fabric\"        => read the pre-parsed Delta tables from the Lakehouse (original behaviour).",
          "\"Dataverse\"     => pull conversationtranscripts straight from Dataverse and parse in Power Query.",
          "\"TranscriptCSV\" => parse a local conversationtranscripts.csv (same JSON content schema as Dataverse) —",
          "used to validate the parser offline / on exported data. Credit + Agents 365 stay CSV."
        ],
        "kind": "m",
        "expression": "null meta [IsParameterQuery=true, List={\"Dataverse\", \"TranscriptCSV\", \"Fabric\"}, DefaultValue=\"TranscriptCSV\", Type=\"Text\", IsParameterQueryRequired=true]",
        "lineageTag": "1a2b3c4d-dv01-4101-8101-000000000101",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "Dataverse Url",
        "description": [
          "Dataverse environment URL (e.g. https://yourorg.crm.dynamics.com). Used when Source Mode = \"Dataverse\".",
          "Find it in Power Platform Admin Center → Environments → <your env> → Environment URL."
        ],
        "kind": "m",
        "expression": "null meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]",
        "lineageTag": "1a2b3c4d-dv01-4102-8102-000000000102",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "DataverseEntity",
        "description": [
          "Helper: read a Dataverse entity (EntitySetName, e.g. \"conversationtranscripts\") via the Web API",
          "using OData.Feed against {Dataverse Url}/api/data/v9.2/. This is the same Web-API path the parser",
          "notebook uses, so it exposes the large JSON `content` field in full (the TDS/SQL endpoint truncates",
          "it). Uses the refresher's own Organizational-account login — no app secret in the template.",
          "Pass an optional OData query string (e.g. \"?$select=...&$top=50\") to limit columns/rows."
        ],
        "kind": "m",
        "expression": [
          "(entitySetName as text, optional query as text) as table =>",
          "\tlet",
          "\t\tBase = Text.TrimEnd(#\"Dataverse Url\", \"/\") & \"/api/data/v9.2/\",",
          "\t\tUrl = Base & entitySetName & (if query = null then \"\" else query),",
          "\t\tFeed = OData.Feed(Url, null, [Implementation = \"2.0\", ODataVersion = 4])",
          "\tin",
          "\t\tFeed"
        ],
        "lineageTag": "1a2b3c4d-dv01-4103-8103-000000000103",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "CSV Folder Path",
        "description": [
          "Folder holding the supporting CSV exports for the non-Fabric paths — the credit-consumption files,",
          "Agents 365, and the org/people file. Files are read by their canonical names (see CsvTable). Populate",
          "it however you like: the manual portal exports, or the Power Automate / Entra-Graph-to-SharePoint",
          "landing flows. Used when Source Mode = \"Dataverse\" or \"TranscriptCSV\"."
        ],
        "kind": "m",
        "expression": "null meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]",
        "lineageTag": "1a2b3c4d-dv01-4110-8110-000000000110",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "CsvTable",
        "description": [
          "Helper: read a supporting CSV by its canonical base name from the CSV Folder Path (e.g.",
          "CsvTable(\"copilot_org_data\") -> {folder}\\copilot_org_data.csv). Headers promoted as-is (raw). Errors",
          "if the file is missing, so callers can `try CsvTable(...) otherwise EmptyTable(...)` to degrade",
          "gracefully. Used for sources whose table has its own column detection (org data, Agents 365)."
        ],
        "kind": "m",
        "expression": [
          "(fileName as text) as table =>",
          "\tlet",
          "\t\tDoc = Csv.Document(CsvBinary(fileName), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
          "\t\tProm = Table.PromoteHeaders(Doc, [PromoteAllScalars = true])",
          "\tin",
          "\t\tProm"
        ],
        "lineageTag": "1a2b3c4d-dv01-4111-8111-000000000111",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "CsvTableNorm",
        "description": [
          "Helper: like CsvTable but normalises headers to the underscore convention the Fabric SQL endpoint",
          "returns (space / slash / dash -> underscore, parens stripped) so raw portal exports bind to the exact",
          "column names the model's credit-consumption tables expect. Errors if the file is missing."
        ],
        "kind": "m",
        "expression": [
          "(fileName as text) as table =>",
          "\tlet",
          "\t\tDoc = Csv.Document(CsvBinary(fileName), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
          "\t\tProm = Table.PromoteHeaders(Doc, [PromoteAllScalars = true]),",
          "\t\tNorm = Table.TransformColumnNames(Prom, each",
          "\t\t\t\tText.Trim(Text.Replace(Text.Replace(Text.Replace(Text.Replace(Text.Replace(_, \" \", \"_\"), \"/\", \"_\"), \"-\", \"_\"), \"(\", \"\"), \")\", \"\")))",
          "\tin",
          "\t\tNorm"
        ],
        "lineageTag": "1a2b3c4d-dv01-4112-8112-000000000112",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "RawTranscripts",
        "description": [
          "Helper: the RAW conversation transcripts, returned identically whichever source mode is active —",
          "columns conversationtranscriptid | content | conversationstarttime | name | agent_schema_hint. The",
          "parser consumes this, so logic is source-agnostic. agent_schema_hint comes from the Dataverse bot",
          "lookup ($expand bot_conversationtranscriptid($select=schemaname)) so single-agent transcripts (whose",
          "JSON content carries no botSchemaName) still resolve a primary agent; it is null in CSV mode."
        ],
        "kind": "m",
        "expression": [
          "() as table =>",
          "\tlet",
          "\t\tCols = {\"conversationtranscriptid\", \"content\", \"conversationstarttime\", \"name\"},",
          "\t\tEmpty = Table.AddColumn(#table(Cols, {}), \"agent_schema_hint\", each null, type text),",
          "\t\tOutput =",
          "\t\t\tif #\"Source Mode\" = \"Dataverse\" then",
          "\t\t\t\tlet",
          "\t\t\t\t\t// Try WITH the bot-schema expand; some environments don't expose the",
          "\t\t\t\t\t// bot_conversationtranscriptid navigation property, so fall back to a plain",
          "\t\t\t\t\t// select (agent_schema_hint = null; the parser then derives the agent from",
          "\t\t\t\t\t// the JSON content). Keeps the Dataverse path robust across environments.",
          "\t\t\t\t\tSrcExpanded = try DataverseEntity(\"conversationtranscripts\", \"?$select=conversationtranscriptid,content,conversationstarttime,name&$expand=bot_conversationtranscriptid($select=schemaname)\"),",
          "\t\t\t\t\tSrcPlain    = DataverseEntity(\"conversationtranscripts\", \"?$select=conversationtranscriptid,content,conversationstarttime,name\"),",
          "\t\t\t\t\tHasExpand   = SrcExpanded[HasError] = false and List.Contains(Table.ColumnNames(SrcExpanded[Value]), \"bot_conversationtranscriptid\"),",
          "\t\t\t\t\tSrc         = if SrcExpanded[HasError] = false then SrcExpanded[Value] else SrcPlain,",
          "\t\t\t\t\tHave = List.Intersect({Cols, Table.ColumnNames(Src)}),",
          "\t\t\t\t\t// Flatten the bot lookup record to a schemaname text hint when present.",
          "\t\t\t\t\tWithHint = Table.AddColumn(Src, \"agent_schema_hint\", each",
          "\t\t\t\t\t\t\tif not HasExpand then null else",
          "\t\t\t\t\t\t\tlet b = try [bot_conversationtranscriptid] otherwise null",
          "\t\t\t\t\t\t\tin if b = null then null else (try Text.From(Record.FieldOrDefault(b, \"schemaname\", null)) otherwise null), type text),",
          "\t\t\t\t\tKeep = Table.SelectColumns(WithHint, List.Combine({Have, {\"agent_schema_hint\"}}), MissingField.UseNull)",
          "\t\t\t\tin",
          "\t\t\t\t\tKeep",
          "\t\t\telse if #\"Source Mode\" = \"TranscriptCSV\" then",
          "\t\t\t\tlet",
          "\t\t\t\t\tCsv = CsvTable(\"conversationtranscripts\"),",
          "\t\t\t\t\tProm = Csv,",
          "\t\t\t\t\tHave = List.Intersect({Cols, Table.ColumnNames(Prom)}),",
          "\t\t\t\t\t// Locate the bot schemaname column the CT export carries (flat dotted name in CSV mode).",
          "\t\t\t\t\tHintCol = List.First(List.Select({\"bot_conversationtranscriptid.schemaname\", \"bot_schemaname\", \"agent_schema_hint\", \"schemaname\"}, each List.Contains(Table.ColumnNames(Prom), _)), null),",
          "\t\t\t\t\tSel = Table.SelectColumns(Prom, List.Distinct(Have & (if HintCol <> null then {HintCol} else {})), MissingField.UseNull),",
          "\t\t\t\t\tWithHint = Table.AddColumn(Sel, \"agent_schema_hint\", each",
          "\t\t\t\t\t\tif HintCol = null then null else",
          "\t\t\t\t\t\tlet v = Record.FieldOrDefault(_, HintCol, null),",
          "\t\t\t\t\t\t    s = if v = null then null else Text.Trim(Text.From(v)),",
          "\t\t\t\t\t\t    bad = {\"{\", \"}\", \":\", \"<\", \">\", \"[\", \"]\", \",\", \" \"}",
          "\t\t\t\t\t\tin if s = null or s = \"\" or Text.Length(s) > 128 or List.AnyTrue(List.Transform(bad, each Text.Contains(s, _))) then null else s, type text),",
          "\t\t\t\t\tClean = Table.SelectColumns(WithHint, List.Combine({Have, {\"agent_schema_hint\"}}), MissingField.UseNull)",
          "\t\t\t\tin",
          "\t\t\t\t\tClean",
          "\t\t\telse",
          "\t\t\t\tEmpty",
          "\tin",
          "\t\tOutput"
        ],
        "lineageTag": "1a2b3c4d-dv01-4105-8105-000000000105",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "ParsedBase",
        "description": [
          "Parser base: RAW transcripts with the JSON `content` parsed once into an `acts` activities list",
          "(one row per conversation that parsed). Sessions/Turns/Errors/Sub-agents all build from this, so the",
          "JSON is parsed a single time per consuming query. Mirrors notebook cell 2b (parse JSON content)."
        ],
        "kind": "m",
        "expression": [
          "() as table =>",
          "\tlet",
          "\t\tRaw = RawTranscripts(),",
          "\t\tWithJson = Table.AddColumn(Raw, \"j\", each try Json.Document([content]) otherwise null),",
          "\t\tValid = Table.SelectRows(WithJson, each [j] <> null),",
          "\t\tWithActs = Table.AddColumn(Valid, \"acts\", each",
          "\t\t\t\tlet jj = [j]",
          "\t\t\t\tin",
          "\t\t\t\t\tif jj is list then jj",
          "\t\t\t\t\telse if jj is record then",
          "\t\t\t\t\t\t(if Record.HasFields(jj, \"activities\") and Record.Field(jj, \"activities\") is list then Record.Field(jj, \"activities\")",
          "\t\t\t\t\t\t else if Record.HasFields(jj, \"Activities\") and Record.Field(jj, \"Activities\") is list then Record.Field(jj, \"Activities\")",
          "\t\t\t\t\t\t else {})",
          "\t\t\t\t\telse {})",
          "\tin",
          "\t\tWithActs"
        ],
        "lineageTag": "1a2b3c4d-dv01-4106-8106-000000000106",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "Parse_Sessions",
        "description": [
          "Parse one row per CONVERSATION from the transcript activities — the M port of the notebook's",
          "build_sessions(). Output columns match the agent_sessions Delta contract the model consumes.",
          "LLM-derived primary_topic_derived is set null (the generic DAX Topic classifier handles topics);",
          "is_returning_user is computed across the batch (user appears in >1 conversation)."
        ],
        "kind": "m",
        "expression": [
          "() as table =>",
          "\tlet",
          "\t\tBase = ParsedBase(),",
          "\t\tfld = (r, n, d) => if r is record and Record.HasFields(r, n) then Record.Field(r, n) else d,",
          "\t\troleOf = (a) =>",
          "\t\t\t\tlet rl = fld(fld(a, \"from\", [role = null]), \"role\", null)",
          "\t\t\t\tin if rl = 0 or rl = \"user\" then \"user\" else if rl = 1 or rl = \"bot\" then \"bot\" else \"other\",",
          "\t\tverdictOf = (v) =>",
          "\t\t\t\tif v = null then null",
          "\t\t\t\telse if v is logical then (if v then \"Positive\" else \"Negative\")",
          "\t\t\t\telse if v is number then (if v > 0 then \"Positive\" else \"Negative\")",
          "\t\t\t\telse let s = Text.Lower(Text.From(v)) in",
          "\t\t\t\t\tif List.Contains({\"true\",\"1\",\"like\",\"thumbsup\",\"thumbs up\",\"up\",\"positive\",\"helpful\",\"yes\",\"good\",\"smile\"}, s) then \"Positive\"",
          "\t\t\t\t\telse if List.Contains({\"false\",\"0\",\"dislike\",\"thumbsdown\",\"thumbs down\",\"down\",\"negative\",\"unhelpful\",\"no\",\"bad\",\"frown\"}, s) then \"Negative\"",
          "\t\t\t\t\telse null,",
          "\t\texecMs = (t) =>",
          "\t\t\t\tlet",
          "\t\t\t\t\ts = Text.From(t),",
          "\t\t\t\t\tparts = Text.Split(s, \":\")",
          "\t\t\t\tin",
          "\t\t\t\t\tif List.Count(parts) = 3 then",
          "\t\t\t\t\t\t(try (Number.From(parts{0})*3600 + Number.From(parts{1})*60 + Number.From(parts{2})) * 1000 otherwise 0)",
          "\t\t\t\t\telse 0,",
          "\t\tRec = Table.AddColumn(Base, \"S\", each",
          "\t\t\t\tlet",
          "\t\t\t\t\tacts = [acts],",
          "\t\t\t\t\tmsgs = List.Select(acts, each (try [type] otherwise \"\") = \"message\"),",
          "\t\t\t\t\tuserMsgs = List.Select(msgs, each roleOf(_) = \"user\"),",
          "\t\t\t\t\tbotMsgs = List.Select(msgs, each roleOf(_) = \"bot\"),",
          "\t\t\t\t\tfirstUser = if List.Count(userMsgs) > 0 then userMsgs{0} else null,",
          "\t\t\t\t\tuserIdRaw = if firstUser = null then null else",
          "\t\t\t\t\t\t\tlet fr = fld(firstUser, \"from\", null)",
          "\t\t\t\t\t\t\tin if fr = null then null else (let a = fld(fr, \"aadObjectId\", null) in if a <> null then a else fld(fr, \"id\", null)),",
          "userUpnRaw = if firstUser = null then null else let fr2 = fld(firstUser, \"from\", null), cand = if fr2 = null then {} else List.Select({fld(fr2,\"userPrincipalName\",null), fld(fr2,\"upn\",null), fld(fr2,\"email\",null), fld(fr2,\"mail\",null), fld(fr2,\"id\",null)}, each _ <> null and Text.Contains(Text.From(_), \"@\") and not Text.Contains(Text.Lower(Text.From(_)), \"@thread.\") and not Text.Contains(Text.Lower(Text.From(_)), \"@unq.gbl\")) in if List.Count(cand) > 0 then Text.Lower(Text.Trim(Text.From(cand{0}))) else null,",
          "\t\t\t\t\t// agent identity",
          "\t\t\t\t\tconnected = List.Distinct(List.RemoveNulls(List.Transform(acts, each",
          "\t\t\t\t\t\t\tif fld(_, \"valueType\", \"\") = \"ConnectedAgentInitializeTraceData\" then",
          "\t\t\t\t\t\t\t\tlet v = fld(_, \"value\", null) in if v = null then null else (let sn = fld(v, \"connectedAgentBotSchemaName\", null) in if sn <> null then sn else fld(v, \"botSchemaName\", null))",
          "\t\t\t\t\t\t\telse null))),",
          "\t\t\t\t\tprimaryAgent = List.First(List.RemoveNulls(List.Transform(acts, each",
          "\t\t\t\t\t\t\tlet v = fld(_, \"value\", null) in",
          "\t\t\t\t\t\t\tif fld(_, \"valueType\", \"\") = \"ConnectedAgentInitializeTraceData\" and v <> null then fld(v, \"parentBotSchemaName\", null)",
          "\t\t\t\t\t\t\telse if v <> null then (let b = fld(v, \"botSchemaName\", null) in if b <> null then b else fld(v, \"parentBotSchemaName\", null))",
          "\t\t\t\t\t\t\telse null)), null),",
          "\t\t\t\t\t// cost / latency / plan steps",
          "\t\t\t\t\tplanActs = List.Select(acts, each (let v = fld(_, \"value\", null) in v <> null and v is record and Record.HasFields(v, \"displayedCost\"))),",
          "\t\t\t\t\tcost = List.Sum(List.Transform(planActs, each try Number.From(fld(fld(_, \"value\", []), \"displayedCost\", 0)) otherwise 0)),",
          "\t\t\t\t\tplanSteps = List.Count(planActs),",
          "\t\t\t\t\tlatency = List.Sum(List.Transform(planActs, each execMs(fld(fld(_, \"value\", []), \"executionTime\", null)))),",
          "\t\t\t\t\t// knowledge",
          "\t\t\t\t\tktrace = List.Select(acts, each fld(_, \"valueType\", \"\") = \"KnowledgeTraceData\"),",
          "\t\t\t\t\tkSearched = List.AnyTrue(List.Transform(ktrace, each fld(fld(_, \"value\", []), \"isKnowledgeSearched\", false) = true)),",
          "\t\t\t\t\tkAnswered = List.AnyTrue(List.Transform(ktrace, each fld(fld(_, \"value\", []), \"completionState\", \"\") = \"Answered\")),",
          "\t\t\t\t\tkSources = List.Sum(List.Transform(ktrace, each List.Count(fld(fld(_, \"value\", []), \"citedKnowledgeSources\", {})))),",
          "\t\t\t\t\t// grounding",
          "\t\t\t\t\tgInternal = List.AnyTrue(List.Transform(acts, each",
          "\t\t\t\t\t\t\tlet vt = fld(_, \"valueType\", \"\"), nm = Text.From(fld(_, \"name\", \"\")), gv = fld(_, \"value\", []) in",
          "\t\t\t\t\t\t\t(vt = \"KnowledgeTraceData\" and fld(gv, \"isKnowledgeSearched\", false) = true)",
          "\t\t\t\t\t\t\tor (Text.Contains(nm, \"UniversalSearch\") and fld(gv, \"knowledgeSources\", null) <> null))),",
          "\t\t\t\t\tgExternal = List.AnyTrue(List.Transform(acts, each",
          "\t\t\t\t\t\t\tlet nm = Text.Lower(Text.From(fld(_, \"name\", \"\"))) in",
          "\t\t\t\t\t\t\t(Text.Contains(nm, \"web\") and Text.Contains(nm, \"search\")))),",
          "\t\t\t\t\tgrounding = if gInternal and gExternal then \"Mixed (Internal+Web)\" else if gExternal then \"External (Web)\" else if gInternal then \"Internal\" else \"Ungrounded\",",
          "\t\t\t\t\t// errors",
          "\t\t\t\t\terrs = List.Transform(List.Select(acts, each fld(_, \"valueType\", \"\") = \"ErrorTraceData\"), each fld(fld(_, \"value\", []), \"errorCode\", \"Unknown\")),",
          "\t\t\t\t\t// feedback",
          "\t\t\t\t\tfbOffered = List.Count(List.Select(acts, each (let cd = fld(_, \"channelData\", null) in cd <> null and cd is record and Record.HasFields(cd, \"feedbackLoop\")))),",
          "\t\t\t\t\tverdict = List.First(List.RemoveNulls(List.Transform(acts, each",
          "\t\t\t\t\t\t\tlet cd = fld(_, \"channelData\", []), fl = fld(cd, \"feedbackLoop\", []) in",
          "\t\t\t\t\t\t\tif fl is record then verdictOf(let a = fld(fl, \"value\", null) in if a <> null then a else (let b = fld(fl, \"reaction\", null) in if b <> null then b else fld(fl, \"vote\", null))) else null)), null),",
          "\t\t\t\t\tcomment = List.First(List.RemoveNulls(List.Transform(acts, each",
          "\t\t\t\t\t\t\tlet cd = fld(_, \"channelData\", []), fl = fld(cd, \"feedbackLoop\", []) in",
          "\t\t\t\t\t\t\tif fl is record then (let t = fld(fl, \"feedbackText\", null) in if t <> null then t else fld(fl, \"text\", null)) else null)), null),",
          "\t\t\t\t\t// timing",
          "\t\t\t\t\ttsList = List.RemoveNulls(List.Transform(acts, each fld(_, \"timestampMs\", null))),",
          "\t\t\t\t\tfirstTs = if List.Count(tsList) > 0 then List.Min(tsList) else null,",
          "\t\t\t\t\tlastTs = if List.Count(tsList) > 0 then List.Max(tsList) else null,",
          "\t\t\t\t\tdurMs = if firstTs <> null and lastTs <> null then lastTs - firstTs else null,",
          "\t\t\t\t\tstartUtc = if firstTs <> null then #datetime(1970,1,1,0,0,0) + #duration(0,0,0,firstTs/1000) else (try DateTime.From([conversationstarttime]) otherwise null),",
          "\t\t\t\t\tfirstPrompt = if List.Count(userMsgs) > 0 then Text.Start(Text.From(fld(userMsgs{0}, \"text\", \"\")), 500) else \"\"",
          "\t\t\t\tin",
          "\t\t\t\t\t[",
          "\t\t\t\t\t\tconversation_id = [conversationtranscriptid],",
          "\t\t\t\t\t\tsession_start_utc = startUtc,",
          "\t\t\t\t\t\tsession_duration_ms = durMs,",
          "\t\t\t\t\t\tuser_id_hash = if userIdRaw = null or userIdRaw = \"\" then null else Text.From(userIdRaw),",
          "user_upn = userUpnRaw,",
          "\t\t\t\t\t\tprimary_agent_schema = (let h = try [agent_schema_hint] otherwise null in if h <> null and h <> \"\" then h else primaryAgent),",
          "\t\t\t\t\t\tconnected_agent_schemas = if List.Count(connected) > 0 then Text.Combine(List.Transform(connected, Text.From), \"|\") else null,",
          "\t\t\t\t\t\tconnected_agent_count = List.Count(connected),",
          "\t\t\t\t\t\tmsg_count = List.Count(msgs),",
          "\t\t\t\t\t\tuser_msg_count = List.Count(userMsgs),",
          "\t\t\t\t\t\tbot_msg_count = List.Count(botMsgs),",
          "\t\t\t\t\t\tplan_step_count = planSteps,",
          "\t\t\t\t\t\ttotal_displayed_cost = cost,",
          "\t\t\t\t\t\ttotal_latency_ms = latency,",
          "\t\t\t\t\t\tknowledge_searched = kSearched,",
          "\t\t\t\t\t\tknowledge_answered = kAnswered,",
          "\t\t\t\t\t\tknowledge_sources_count = kSources,",
          "\t\t\t\t\t\terror_count = List.Count(errs),",
          "\t\t\t\t\t\tfirst_error_code = if List.Count(errs) > 0 then errs{0} else null,",
          "\t\t\t\t\t\tfeedback_offered_count = fbOffered,",
          "\t\t\t\t\t\tfeedback_submitted = if verdict <> null then 1 else 0,",
          "\t\t\t\t\t\tfeedback_verdict = verdict,",
          "\t\t\t\t\t\tfeedback_comment = comment,",
          "\t\t\t\t\t\tfirst_user_prompt = firstPrompt,",
          "\t\t\t\t\t\tgrounding_source = grounding,",
          "\t\t\t\t\t\tsession_outcome_explicit = null,",
          "\t\t\t\t\t\tsession_outcome_reason_explicit = null,",
          "\t\t\t\t\t\tis_authenticated = (userIdRaw <> null and userIdRaw <> \"\"),",
          "\t\t\t\t\t\tis_returning_user = null,",
          "\t\t\t\t\t\tprimary_topic_derived = null",
          "\t\t\t\t\t]),",
          "\t\tCols = {\"conversation_id\",\"session_start_utc\",\"session_duration_ms\",\"user_id_hash\",\"user_upn\",\"primary_agent_schema\",\"connected_agent_schemas\",\"connected_agent_count\",\"msg_count\",\"user_msg_count\",\"bot_msg_count\",\"plan_step_count\",\"total_displayed_cost\",\"total_latency_ms\",\"knowledge_searched\",\"knowledge_answered\",\"knowledge_sources_count\",\"error_count\",\"first_error_code\",\"feedback_offered_count\",\"feedback_submitted\",\"feedback_verdict\",\"feedback_comment\",\"first_user_prompt\",\"grounding_source\",\"session_outcome_explicit\",\"session_outcome_reason_explicit\",\"is_authenticated\",\"is_returning_user\",\"primary_topic_derived\"},",
          "\t\tExpanded = Table.ExpandRecordColumn(Rec, \"S\", Cols),",
          "\t\tOut = Table.SelectColumns(Expanded, Cols),",
          "\t\t// is_returning_user: user appears in more than one conversation",
          "\t\tCounts = Table.Group(Table.SelectRows(Out, each [user_id_hash] <> null), {\"user_id_hash\"}, {{\"n\", each Table.RowCount(_), Int64.Type}}),",
          "\t\tReturnSet = List.Buffer(Table.SelectRows(Counts, each [n] > 1)[user_id_hash]),",
          "\t\tWithReturn = Table.ReplaceValue(Out, each [is_returning_user], each (if [user_id_hash] <> null and List.Contains(ReturnSet, [user_id_hash]) then true else false), Replacer.ReplaceValue, {\"is_returning_user\"})",
          "\tin",
          "\t\tWithReturn"
        ],
        "lineageTag": "1a2b3c4d-dv01-4107-8107-000000000107",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "Parse_Turns",
        "description": [
          "M port of build_turns(): one row per message activity, with per-turn intent + knowledge (keyed by",
          "replyToId -> message id) and per-turn submitted feedback. Output matches agent_turns Delta contract."
        ],
        "kind": "m",
        "expression": [
          "() as table =>",
          "\tlet",
          "\t\tBase = ParsedBase(),",
          "\t\tfld = (r, n, d) => if r is record and Record.HasFields(r, n) then Record.Field(r, n) else d,",
          "\t\troleOf = (a) =>",
          "\t\t\t\tlet rl = fld(fld(a, \"from\", [role = null]), \"role\", null)",
          "\t\t\t\tin if rl = 0 or rl = \"user\" then \"user\" else if rl = 1 or rl = \"bot\" then \"bot\" else \"other\",",
          "\t\tverdictOf = (v) =>",
          "\t\t\t\tif v = null then null",
          "\t\t\t\telse if v is logical then (if v then \"Positive\" else \"Negative\")",
          "\t\t\t\telse if v is number then (if v > 0 then \"Positive\" else \"Negative\")",
          "\t\t\t\telse let s = Text.Lower(Text.From(v)) in",
          "\t\t\t\t\tif List.Contains({\"true\",\"1\",\"like\",\"thumbsup\",\"thumbs up\",\"up\",\"positive\",\"helpful\",\"yes\",\"good\",\"smile\"}, s) then \"Positive\"",
          "\t\t\t\t\telse if List.Contains({\"false\",\"0\",\"dislike\",\"thumbsdown\",\"thumbs down\",\"down\",\"negative\",\"unhelpful\",\"no\",\"bad\",\"frown\"}, s) then \"Negative\"",
          "\t\t\t\t\telse null,",
          "\t\tisoOf = (ms) => if ms = null then null else #datetime(1970,1,1,0,0,0) + #duration(0,0,0,ms/1000),",
          "\t\tPerConv = Table.AddColumn(Base, \"T\", each",
          "\t\t\t\tlet",
          "\t\t\t\t\tacts = [acts],",
          "\t\t\t\t\tconvId = [conversationtranscriptid],",
          "\t\t\t\t\t// intent + knowledge maps keyed by replyToId",
          "\t\t\t\t\tintents = List.Select(acts, each fld(_, \"valueType\", \"\") = \"IntentRecognition\"),",
          "\t\t\t\t\tknows = List.Select(acts, each fld(_, \"valueType\", \"\") = \"KnowledgeTraceData\"),",
          "\t\t\t\t\tlookupIntent = (mid) =>",
          "\t\t\t\t\t\t\tlet hit = List.First(List.Select(intents, each fld(_, \"replyToId\", null) = mid), null)",
          "\t\t\t\t\t\t\tin if hit = null then [it = null, ii = null, isc = null] else let v = fld(hit, \"value\", []) in [it = fld(v, \"intentTitle\", null), ii = fld(v, \"intentId\", null), isc = fld(fld(v, \"intentScore\", []), \"score\", null)],",
          "\t\t\t\t\tlookupKnow = (mid) =>",
          "\t\t\t\t\t\t\tlet hit = List.First(List.Select(knows, each fld(_, \"replyToId\", null) = mid), null)",
          "\t\t\t\t\t\t\tin if hit = null then [ks = null, ka = null, src = null] else let v = fld(hit, \"value\", []) in [ks = (fld(v, \"isKnowledgeSearched\", false) = true), ka = (fld(v, \"completionState\", \"\") = \"Answered\"), src = Text.Combine(List.Transform(fld(v, \"citedKnowledgeSources\", {}), Text.From), \"|\")],",
          "\t\t\t\t\tmsgs = List.Select(acts, each (try [type] otherwise \"\") = \"message\"),",
          "\t\t\t\t\trows = List.Transform(msgs, each",
          "\t\t\t\t\t\t\tlet",
          "\t\t\t\t\t\t\t\ta = _,",
          "\t\t\t\t\t\t\t\trole = roleOf(a),",
          "\t\t\t\t\t\t\t\tmid = fld(a, \"id\", null),",
          "\t\t\t\t\t\t\t\tit = lookupIntent(mid),",
          "\t\t\t\t\t\t\t\tkn = lookupKnow(mid),",
          "\t\t\t\t\t\t\t\tcd = fld(a, \"channelData\", []),",
          "\t\t\t\t\t\t\t\tfbOffered = (cd is record and Record.HasFields(cd, \"feedbackLoop\")),",
          "\t\t\t\t\t\t\t\tfl = fld(cd, \"feedbackLoop\", []),",
          "\t\t\t\t\t\t\t\tverdict = if fl is record then verdictOf(let x = fld(fl, \"value\", null) in if x <> null then x else (let y = fld(fl, \"reaction\", null) in if y <> null then y else fld(fl, \"vote\", null))) else null,",
          "\t\t\t\t\t\t\t\tcomment = if fl is record then (let t = fld(fl, \"feedbackText\", null) in if t <> null then t else fld(fl, \"text\", null)) else null,",
          "\t\t\t\t\t\t\t\tfr = fld(a, \"from\", null),",
          "\t\t\t\t\t\t\t\tfromId = if fr = null then null else (let x = fld(fr, \"aadObjectId\", null) in if x <> null then x else fld(fr, \"id\", null))",
          "\t\t\t\t\t\t\tin",
          "\t\t\t\t\t\t\t\t[",
          "\t\t\t\t\t\t\t\t\tconversation_id = convId,",
          "\t\t\t\t\t\t\t\t\tturn_id = mid,",
          "\t\t\t\t\t\t\t\t\tturn_timestamp_utc = isoOf(fld(a, \"timestampMs\", null)),",
          "\t\t\t\t\t\t\t\t\tturn_role = role,",
          "\t\t\t\t\t\t\t\t\tturn_channel = fld(a, \"channelId\", null),",
          "\t\t\t\t\t\t\t\t\tfrom_user_hash = if role = \"user\" and fromId <> null then Text.From(fromId) else null,",
          "\t\t\t\t\t\t\t\t\ttext_preview_500 = Text.Start(Text.From(fld(a, \"text\", \"\")), 500),",
          "\t\t\t\t\t\t\t\t\ttext_length = Text.Length(Text.From(fld(a, \"text\", \"\"))),",
          "\t\t\t\t\t\t\t\t\tintent_title = it[it],",
          "\t\t\t\t\t\t\t\t\tintent_id = it[ii],",
          "\t\t\t\t\t\t\t\t\tintent_score = it[isc],",
          "\t\t\t\t\t\t\t\t\tknowledge_searched = kn[ks],",
          "\t\t\t\t\t\t\t\t\tknowledge_answered = kn[ka],",
          "\t\t\t\t\t\t\t\t\tknowledge_sources = kn[src],",
          "\t\t\t\t\t\t\t\t\tfeedback_offered = fbOffered,",
          "\t\t\t\t\t\t\t\t\tfeedback_verdict = verdict,",
          "\t\t\t\t\t\t\t\t\tfeedback_comment = comment",
          "\t\t\t\t\t\t\t\t])",
          "\t\t\t\tin",
          "\t\t\t\t\trows),",
          "\t\tCols = {\"conversation_id\",\"turn_id\",\"turn_timestamp_utc\",\"turn_role\",\"turn_channel\",\"from_user_hash\",\"text_preview_500\",\"text_length\",\"intent_title\",\"intent_id\",\"intent_score\",\"knowledge_searched\",\"knowledge_answered\",\"knowledge_sources\",\"feedback_offered\",\"feedback_verdict\",\"feedback_comment\"},",
          "\t\tListed = Table.SelectColumns(PerConv, {\"T\"}),",
          "\t\tExpanded = Table.ExpandListColumn(Listed, \"T\"),",
          "\t\tFiltered = Table.SelectRows(Expanded, each [T] <> null),",
          "\t\tRecCol = Table.ExpandRecordColumn(Filtered, \"T\", Cols),",
          "\t\tOut = Table.SelectColumns(RecCol, Cols)",
          "\tin",
          "\t\tOut"
        ],
        "lineageTag": "1a2b3c4d-dv01-4108-8108-000000000108",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "Parse_Errors",
        "description": "M port of build_errors(): one row per ErrorTraceData activity. Matches agent_errors Delta contract.",
        "kind": "m",
        "expression": [
          "() as table =>",
          "\tlet",
          "\t\tBase = ParsedBase(),",
          "\t\tfld = (r, n, d) => if r is record and Record.HasFields(r, n) then Record.Field(r, n) else d,",
          "\t\tisoOf = (ms) => if ms = null then null else #datetime(1970,1,1,0,0,0) + #duration(0,0,0,ms/1000),",
          "\t\tPerConv = Table.AddColumn(Base, \"E\", each",
          "\t\t\t\tlet",
          "\t\t\t\t\tconvId = [conversationtranscriptid],",
          "\t\t\t\t\terrActs = List.Select([acts], each fld(_, \"valueType\", \"\") = \"ErrorTraceData\")",
          "\t\t\t\tin",
          "\t\t\t\t\tList.Transform(errActs, each",
          "\t\t\t\t\t\tlet v = fld(_, \"value\", []) in",
          "\t\t\t\t\t\t[",
          "\t\t\t\t\t\t\tconversation_id = convId,",
          "\t\t\t\t\t\t\terror_timestamp_utc = isoOf(fld(_, \"timestampMs\", null)),",
          "\t\t\t\t\t\t\terror_code = fld(v, \"errorCode\", null),",
          "\t\t\t\t\t\t\terror_sub_code = fld(v, \"errorSubCode\", null),",
          "\t\t\t\t\t\t\terror_message = Text.Start(Text.From(fld(v, \"errorMessage\", \"\")), 500),",
          "\t\t\t\t\t\t\tis_user_error = (fld(v, \"isUserError\", false) = true)",
          "\t\t\t\t\t\t])),",
          "\t\tCols = {\"conversation_id\",\"error_timestamp_utc\",\"error_code\",\"error_sub_code\",\"error_message\",\"is_user_error\"},",
          "\t\tListed = Table.SelectColumns(PerConv, {\"E\"}),",
          "\t\tExpanded = Table.ExpandListColumn(Listed, \"E\"),",
          "\t\tFiltered = Table.SelectRows(Expanded, each [E] <> null),",
          "\t\tRecCol = Table.ExpandRecordColumn(Filtered, \"E\", Cols),",
          "\t\tOut = Table.SelectColumns(RecCol, Cols)",
          "\tin",
          "\t\tOut"
        ],
        "lineageTag": "1a2b3c4d-dv01-4109-8109-000000000109",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "Parse_SubAgents",
        "description": [
          "M port of build_subagents(): one row per ConnectedAgent initialize/completed trace. Matches",
          "agent_subagents Delta contract."
        ],
        "kind": "m",
        "expression": [
          "() as table =>",
          "\tlet",
          "\t\tBase = ParsedBase(),",
          "\t\tfld = (r, n, d) => if r is record and Record.HasFields(r, n) then Record.Field(r, n) else d,",
          "\t\tisoOf = (ms) => if ms = null then null else #datetime(1970,1,1,0,0,0) + #duration(0,0,0,ms/1000),",
          "\t\tPerConv = Table.AddColumn(Base, \"G\", each",
          "\t\t\t\tlet",
          "\t\t\t\t\tconvId = [conversationtranscriptid],",
          "\t\t\t\t\tsaActs = List.Select([acts], each List.Contains({\"ConnectedAgentInitializeTraceData\",\"ConnectedAgentCompletedTraceData\"}, fld(_, \"valueType\", \"\")))",
          "\t\t\t\tin",
          "\t\t\t\t\tList.Transform(saActs, each",
          "\t\t\t\t\t\tlet vt = fld(_, \"valueType\", \"\"), v = fld(_, \"value\", []), uid = fld(v, \"userId\", null) in",
          "\t\t\t\t\t\t[",
          "\t\t\t\t\t\t\tconversation_id = convId,",
          "\t\t\t\t\t\t\tinvocation_timestamp_utc = isoOf(fld(_, \"timestampMs\", null)),",
          "\t\t\t\t\t\t\tevent_type = if Text.EndsWith(vt, \"InitializeTraceData\") then \"initialize\" else \"completed\",",
          "\t\t\t\t\t\t\tparent_agent_schema = fld(v, \"parentBotSchemaName\", null),",
          "\t\t\t\t\t\t\tconnected_agent_schema = let x = fld(v, \"connectedAgentBotSchemaName\", null) in if x <> null then x else fld(v, \"botSchemaName\", null),",
          "\t\t\t\t\t\t\tdialog_schema = fld(v, \"dialogSchemaName\", null),",
          "\t\t\t\t\t\t\tuser_id_hash = if uid = null or uid = \"\" then null else Text.From(uid),",
          "\t\t\t\t\t\t\tplan_step_id = fld(v, \"planStepId\", null)",
          "\t\t\t\t\t\t])),",
          "\t\tCols = {\"conversation_id\",\"invocation_timestamp_utc\",\"event_type\",\"parent_agent_schema\",\"connected_agent_schema\",\"dialog_schema\",\"user_id_hash\",\"plan_step_id\"},",
          "\t\tListed = Table.SelectColumns(PerConv, {\"G\"}),",
          "\t\tExpanded = Table.ExpandListColumn(Listed, \"G\"),",
          "\t\tFiltered = Table.SelectRows(Expanded, each [G] <> null),",
          "\t\tRecCol = Table.ExpandRecordColumn(Filtered, \"G\", Cols),",
          "\t\tOut = Table.SelectColumns(RecCol, Cols)",
          "\tin",
          "\t\tOut"
        ],
        "lineageTag": "1a2b3c4d-dv01-410a-810a-00000000010a",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "Parse_Performance",
        "description": [
          "M port of build_agent_performance(): one row per conversation with the per-conversation KPI fact",
          "(outcome, implied success, topics, durations, ESS UPN). Matches the agent_performance Delta contract",
          "(39 source columns). Drives the Quality & Performance / Agent Evaluation pages."
        ],
        "kind": "m",
        "expression": [
          "() as table =>",
          "\tlet",
          "\t\tBase = ParsedBase(),",
          "\t\tfld = (r, n, d) => if r is record and Record.HasFields(r, n) then Record.Field(r, n) else d,",
          "\t\troleOf = (a) =>",
          "\t\t\t\tlet rl = fld(fld(a, \"from\", [role = null]), \"role\", null)",
          "\t\t\t\tin if rl = 0 or rl = \"user\" then \"user\" else if rl = 1 or rl = \"bot\" then \"bot\" else \"other\",",
          "\t\tisoOf = (ms) => if ms = null then null else #datetime(1970,1,1,0,0,0) + #duration(0,0,0,ms/1000),",
          "\t\texecMs = (t) =>",
          "\t\t\t\tlet s = Text.From(t), parts = Text.Split(s, \":\")",
          "\t\t\t\tin if List.Count(parts) = 3 then (try (Number.From(parts{0})*3600 + Number.From(parts{1})*60 + Number.From(parts{2})) * 1000 otherwise 0) else 0,",
          "\t\ttxt = (a) => Text.Start(Text.From(fld(a, \"text\", \"\")), 500),",
          "\t\tRec = Table.AddColumn(Base, \"P\", each",
          "\t\t\t\tlet",
          "\t\t\t\t\tacts = [acts],",
          "\t\t\t\t\tmsgs = List.Select(acts, each (try [type] otherwise \"\") = \"message\"),",
          "\t\t\t\t\tuserMsgs = List.Select(msgs, each roleOf(_) = \"user\"),",
          "\t\t\t\t\tbotMsgs = List.Select(msgs, each roleOf(_) = \"bot\"),",
          "\t\t\t\t\tconnected = List.Distinct(List.RemoveNulls(List.Transform(acts, each",
          "\t\t\t\t\t\t\tif fld(_, \"valueType\", \"\") = \"ConnectedAgentInitializeTraceData\" then",
          "\t\t\t\t\t\t\t\tlet v = fld(_, \"value\", null) in if v = null then null else (let sn = fld(v, \"connectedAgentBotSchemaName\", null) in if sn <> null then sn else fld(v, \"botSchemaName\", null))",
          "\t\t\t\t\t\t\telse null))),",
          "\t\t\t\t\tprimaryAgent = List.First(List.RemoveNulls(List.Transform(acts, each",
          "\t\t\t\t\t\t\tlet v = fld(_, \"value\", null) in",
          "\t\t\t\t\t\t\tif fld(_, \"valueType\", \"\") = \"ConnectedAgentInitializeTraceData\" and v <> null then fld(v, \"parentBotSchemaName\", null)",
          "\t\t\t\t\t\t\telse if v <> null then (let b = fld(v, \"botSchemaName\", null) in if b <> null then b else fld(v, \"parentBotSchemaName\", null))",
          "\t\t\t\t\t\t\telse null)), null),",
          "\t\t\t\t\tintentActs = List.Select(acts, each fld(_, \"valueType\", \"\") = \"IntentRecognition\"),",
          "\t\t\t\t\ttopics = List.Distinct(List.RemoveNulls(List.Transform(intentActs, each fld(fld(_, \"value\", []), \"intentTitle\", null)))),",
          "\t\t\t\t\tlastIntentId = List.Last(List.RemoveNulls(List.Transform(intentActs, each fld(fld(_, \"value\", []), \"intentId\", null)))),",
          "\t\t\t\t\terrActs = List.Select(acts, each fld(_, \"valueType\", \"\") = \"ErrorTraceData\"),",
          "\t\t\t\t\tsysError = List.AnyTrue(List.Transform(errActs, each fld(fld(_, \"value\", []), \"isUserError\", false) <> true)),",
          "\t\t\t\t\tuserError = List.AnyTrue(List.Transform(errActs, each fld(fld(_, \"value\", []), \"isUserError\", false) = true)),",
          "\t\t\t\t\ttraceCount = List.Count(List.Select(acts, each (try [type] otherwise \"\") = \"trace\")),",
          "\t\t\t\t\teventCount = List.Count(List.Select(acts, each (try [type] otherwise \"\") = \"event\")),",
          "\t\t\t\t\tplanActs = List.Select(acts, each (let v = fld(_, \"value\", null) in v <> null and v is record and Record.HasFields(v, \"executionTime\"))),",
          "\t\t\t\t\tplanSteps = List.Count(planActs),",
          "\t\t\t\t\tlatencyTotal = List.Sum(List.Transform(planActs, each execMs(fld(fld(_, \"value\", []), \"executionTime\", null)))),",
          "\t\t\t\t\tavgLatency = if planSteps > 0 then Number.RoundDown(latencyTotal / planSteps) else 0,",
          "\t\t\t\t\ttsList = List.RemoveNulls(List.Transform(acts, each fld(_, \"timestampMs\", null))),",
          "\t\t\t\t\tfirstTs = if List.Count(tsList) > 0 then List.Min(tsList) else null,",
          "\t\t\t\t\tlastTs = if List.Count(tsList) > 0 then List.Max(tsList) else null,",
          "\t\t\t\t\tdurationS = if firstTs <> null and lastTs <> null then Number.RoundDown((lastTs - firstTs) / 1000) else 0,",
          "\t\t\t\t\tupnFromVars = List.First(List.RemoveNulls(List.Transform(acts, each",
          "\t\t\t\t\t\t\tlet v = fld(_, \"value\", []), vars = fld(v, \"variables\", []) in",
          "\t\t\t\t\t\t\tif vars is record then (let u = fld(vars, \"ESS_UserContext_UPN\", null) in if u <> null then u else fld(vars, \"Var_ESS_UserContext_UPN\", null)) else null)), null),",
          "\t\t\t\t\tupnFromAssign = List.First(List.RemoveNulls(List.Transform(acts, each",
          "\t\t\t\t\t\t\tif fld(_, \"valueType\", \"\") = \"VariableAssignment\" then",
          "\t\t\t\t\t\t\t\tlet v = fld(_, \"value\", []), nm = fld(v, \"name\", null) in",
          "\t\t\t\t\t\t\t\tif nm = \"ESS_UserContext_UPN\" or nm = \"Var_ESS_UserContext_UPN\" then fld(v, \"newValue\", null) else null",
          "\t\t\t\t\t\t\telse null)), null),",
          "\t\t\t\t\tupnFromSender = List.First(List.RemoveNulls(List.Transform(userMsgs, each",
          "\t\t\t\t\t\t\tlet fr = fld(_, \"from\", []), fid = fld(fr, \"id\", null) in",
          "\t\t\t\t\t\t\tif fid <> null and Text.Contains(Text.From(fid), \"@\") then Text.From(fid) else null)), null),",
          "\t\t\t\t\tupn = if upnFromVars <> null then upnFromVars else if upnFromAssign <> null then upnFromAssign else upnFromSender,",
          "\t\t\t\t\tengaged = (List.Count(topics) > 0) or (List.Count(botMsgs) > 0),",
          "\t\t\t\t\tsessionType = if engaged then \"Engaged\" else \"Unengaged\",",
          "\t\t\t\t\toutcome = if List.Count(connected) > 0 then \"Escalated\"",
          "\t\t\t\t\t\t\t  else if (not engaged) or (List.Count(userMsgs) > 0 and List.Count(botMsgs) = 0) or (sysError and List.Count(botMsgs) = 0) then \"Abandoned\"",
          "\t\t\t\t\t\t\t  else \"Resolved\",",
          "\t\t\t\t\toutcomeReason = if sysError then \"SystemError\" else if userError then \"UserError\" else if outcome = \"Escalated\" then \"Escalated\" else if outcome = \"Abandoned\" then \"Abandoned\" else \"Completed\",",
          "\t\t\t\t\timpliedSuccess = if outcome = \"Resolved\" and not sysError then \"TRUE\" else \"FALSE\",",
          "\t\t\t\t\tstartDt = if firstTs <> null then isoOf(firstTs) else (try DateTime.From([conversationstarttime]) otherwise null),",
          "\t\t\t\t\tendDt = if lastTs <> null then isoOf(lastTs) else null",
          "\t\t\t\tin",
          "\t\t\t\t\t[",
          "\t\t\t\t\t\tConversationTranscriptId = [conversationtranscriptid],",
          "\t\t\t\t\t\tConversationStartTime = (try DateTime.From([conversationstarttime]) otherwise startDt),",
          "\t\t\t\t\t\tSchemaVersion = null,",
          "\t\t\t\t\t\tBotName = (let h = try [agent_schema_hint] otherwise null in if h <> null and h <> \"\" then h else (if primaryAgent = null then \"\" else primaryAgent)),",
          "\t\t\t\t\t\tBotId = null,",
          "\t\t\t\t\t\tAADTenantId = null,",
          "\t\t\t\t\t\tBatchId = null,",
          "\t\t\t\t\t\tSessionStartTimeUtc = startDt,",
          "\t\t\t\t\t\tSessionEndTimeUtc = endDt,",
          "\t\t\t\t\t\tSessionType = sessionType,",
          "\t\t\t\t\t\tSessionOutcome = outcome,",
          "\t\t\t\t\t\tTurnCount = List.Count(msgs),",
          "\t\t\t\t\t\tOutcomeReason = outcomeReason,",
          "\t\t\t\t\t\tImpliedSuccess = impliedSuccess,",
          "\t\t\t\t\t\tLastUserIntentId = lastIntentId,",
          "\t\t\t\t\t\tIsDesignMode = \"FALSE\",",
          "\t\t\t\t\t\tLocale = null,",
          "\t\t\t\t\t\tUserMessageCount = List.Count(userMsgs),",
          "\t\t\t\t\t\tBotMessageCount = List.Count(botMsgs),",
          "\t\t\t\t\t\tTotalMessageCount = List.Count(msgs),",
          "\t\t\t\t\t\tFirstUserMessage = if List.Count(userMsgs) > 0 then txt(userMsgs{0}) else \"\",",
          "\t\t\t\t\t\tLastUserMessage = if List.Count(userMsgs) > 0 then txt(List.Last(userMsgs)) else \"\",",
          "\t\t\t\t\t\tFirstBotMessage = if List.Count(botMsgs) > 0 then txt(botMsgs{0}) else \"\",",
          "\t\t\t\t\t\tLastBotMessage = if List.Count(botMsgs) > 0 then txt(List.Last(botMsgs)) else \"\",",
          "\t\t\t\t\t\tTopicsTriggered = if List.Count(topics) > 0 then Text.Combine(List.Transform(topics, Text.From), \"|\") else \"\",",
          "\t\t\t\t\t\tTopicCount = List.Count(topics),",
          "\t\t\t\t\t\tPrimaryTopic = if List.Count(topics) > 0 then topics{0} else \"\",",
          "\t\t\t\t\t\tDurationSeconds = durationS,",
          "\t\t\t\t\t\tAverageLatencyMs = avgLatency,",
          "\t\t\t\t\t\tVar_ESS_UserContext_UPN = upn,",
          "\t\t\t\t\t\tVar_ESS_Message_Disclaimer = \"\",",
          "\t\t\t\t\t\tVar_ESS_UserContext_RefreshInterval_Hours = \"\",",
          "\t\t\t\t\t\tVar_ESS_UserContext_Conversation_Initialized = \"\",",
          "\t\t\t\t\t\tAllVariables = \"\",",
          "\t\t\t\t\t\tTotalActivityCount = List.Count(acts),",
          "\t\t\t\t\t\tTraceActivityCount = traceCount,",
          "\t\t\t\t\t\tEventActivityCount = eventCount,",
          "\t\t\t\t\t\tStatusCode = if outcome = \"Resolved\" then 1 else 0,",
          "\t\t\t\t\t\tStateCode = 1,",
          "\t\t\t\t\t\tFirstErrorCode = if List.Count(errActs) > 0 then fld(fld(errActs{0}, \"value\", []), \"errorCode\", null) else null,",
          "\t\t\t\t\t\tErrorCategory = null,",
          "\t\t\t\t\t\tIsAuthenticated = if List.Count(userMsgs) > 0 and (let fr = fld(userMsgs{0}, \"from\", []) in fld(fr, \"aadObjectId\", null) <> null) then \"TRUE\" else \"FALSE\",",
          "\t\t\t\t\t\tMultiAgentSession = if List.Count(connected) > 0 then \"TRUE\" else \"FALSE\",",
          "\t\t\t\t\t\tSessionOutcomeExplicit = null,",
          "\t\t\t\t\t\tSessionOutcomeReasonExplicit = null,",
          "\t\t\t\t\t\tGenerativeResponseCount = List.Count(List.Select(acts, each fld(_, \"valueType\", \"\") = \"GenerativeAIResponseTraceData\" or fld(_, \"valueType\", \"\") = \"GenerativeResponseTraceData\")),",
          "\t\t\t\t\t\tLLMCallCount = null,",
          "\t\t\t\t\t\tPromptTokenCount = null,",
          "\t\t\t\t\t\tCompletionTokenCount = null,",
          "\t\t\t\t\t\tTotalTokenCount = null,",
          "\t\t\t\t\t\tPluginCallCount = null,",
          "\t\t\t\t\t\tPluginSuccessCount = null,",
          "\t\t\t\t\t\tTopicsStarted = List.Count(topics),",
          "\t\t\t\t\t\tTopicsCompleted = null,",
          "\t\t\t\t\t\tTopicCompletionRate = null,",
          "\t\t\t\t\t\tPrimaryTopicDwellMs = null,",
          "\t\t\t\t\t\tTotalTopicDwellMs = null",
          "\t\t\t\t\t]),",
          "\t\tCols = {\"ConversationTranscriptId\",\"ConversationStartTime\",\"SchemaVersion\",\"BotName\",\"BotId\",\"AADTenantId\",\"BatchId\",\"SessionStartTimeUtc\",\"SessionEndTimeUtc\",\"SessionType\",\"SessionOutcome\",\"TurnCount\",\"OutcomeReason\",\"ImpliedSuccess\",\"LastUserIntentId\",\"IsDesignMode\",\"Locale\",\"UserMessageCount\",\"BotMessageCount\",\"TotalMessageCount\",\"FirstUserMessage\",\"LastUserMessage\",\"FirstBotMessage\",\"LastBotMessage\",\"TopicsTriggered\",\"TopicCount\",\"PrimaryTopic\",\"DurationSeconds\",\"AverageLatencyMs\",\"Var_ESS_UserContext_UPN\",\"Var_ESS_Message_Disclaimer\",\"Var_ESS_UserContext_RefreshInterval_Hours\",\"Var_ESS_UserContext_Conversation_Initialized\",\"AllVariables\",\"TotalActivityCount\",\"TraceActivityCount\",\"EventActivityCount\",\"StatusCode\",\"StateCode\",\"FirstErrorCode\",\"ErrorCategory\",\"IsAuthenticated\",\"MultiAgentSession\",\"SessionOutcomeExplicit\",\"SessionOutcomeReasonExplicit\",\"GenerativeResponseCount\",\"LLMCallCount\",\"PromptTokenCount\",\"CompletionTokenCount\",\"TotalTokenCount\",\"PluginCallCount\",\"PluginSuccessCount\",\"TopicsStarted\",\"TopicsCompleted\",\"TopicCompletionRate\",\"PrimaryTopicDwellMs\",\"TotalTopicDwellMs\"},",
          "\t\tExpanded = Table.ExpandRecordColumn(Rec, \"P\", Cols),",
          "\t\tOut = Table.SelectColumns(Expanded, Cols)",
          "\tin",
          "\t\tOut"
        ],
        "lineageTag": "1a2b3c4d-dv01-410b-810b-00000000010b",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "CsvBinary",
        "description": [
          "Helper: fetch the binary for a canonical CSV by base name, auto-detecting the source of",
          "CSV Folder Path. If it starts with \"https://\" it's treated as a SharePoint site URL and the",
          "file is located with SharePoint.Files (matched on file name, anywhere in the site — the five",
          "canonical names are unique). Otherwise it's a local / synced / UNC folder read with",
          "File.Contents. SharePoint URLs refresh in the Service cloud-to-cloud (OAuth2, no gateway);",
          "local/synced folders need an on-premises data gateway."
        ],
        "kind": "m",
        "expression": [
          "(fileName as text) as binary =>",
          "\tlet",
          "Root = if #\"CSV Folder Path\" = null then \"\" else Text.From(#\"CSV Folder Path\"),",
          "IsSharePoint = if Root = \"\" then error \"CSV Folder Path is empty. Set it to the folder holding the CSV files, or change Source Mode.\" else Text.StartsWith(Text.Lower(Root), \"https://\"),",
          "\t\tTarget = fileName & \".csv\",",
          "\t\tBin =",
          "\t\t\tif IsSharePoint then",
          "\t\t\t\tlet",
          "\t\t\t\t\tSite = Text.TrimEnd(Root, \"/\"),",
          "\t\t\t\t\tFiles = SharePoint.Files(Site, [ApiVersion = 15]),",
          "\t\t\t\t\tMatch = Table.SelectRows(Files, each Text.Lower([Name]) = Text.Lower(Target)){0}[Content]",
          "\t\t\t\tin",
          "\t\t\t\t\tMatch",
          "\t\t\telse",
          "\t\t\t\tFile.Contents(Text.TrimEnd(Root, \"\\\") & \"\\\" & Target)",
          "\tin",
          "\t\tBin"
        ],
        "lineageTag": "1a2b3c4d-dv01-4113-8113-000000000113",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "CsvFromPath",
        "kind": "m",
        "expression": [
          "(path as text) as table =>",
          "    let",
          "        IsSharePoint = Text.StartsWith(Text.Lower(path), \"https://\"),",
          "        Bin = if IsSharePoint then Web.Contents(path) else File.Contents(path),",
          "        Doc = Csv.Document(Bin, [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
          "        Prom = Table.PromoteHeaders(Doc, [PromoteAllScalars = true])",
          "    in Prom"
        ],
        "lineageTag": "1a2b3c4d-dv01-4114-8114-000000000114",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      },
      {
        "name": "NormAgentKey",
        "description": [
          "Helper: reduce an agent name OR schema name to a comparison key, so the credit",
          "export (\"Payroll Helper\") can be matched to the transcript schema",
          "(\"cr9a2_payrollAgent\"). Splits camelCase and punctuation, drops the generic",
          "suffix nouns agent names end in, then concatenates what is left."
        ],
        "kind": "m",
        "expression": [
          "(name as any) as text =>",
          "\tlet",
          "\t\ts0 = if name = null then \"\" else Text.From(name),",
          "\t\t// drop a publisher prefix like cr9a2_ / msdyn_ before anything else",
          "\t\ts1 = if Text.Contains(s0, \"_\") then Text.AfterDelimiter(s0, \"_\") else s0,",
          "\t\tchars = Text.ToList(s1),",
          "\t\tn = List.Count(chars),",
          "\t\tisUp = (c) => c <> \"\" and c = Text.Upper(c) and c <> Text.Lower(c),",
          "\t\tisLowDigit = (c) => c <> \"\" and ((c = Text.Lower(c) and c <> Text.Upper(c)) or (c >= \"0\" and c <= \"9\")),",
          "\t\tspaced = Text.Combine(List.Transform(List.Positions(chars), (i) =>",
          "\t\t\tlet c = chars{i}, prev = if i = 0 then \"\" else chars{i-1} in",
          "\t\t\t(if i > 0 and isUp(c) and isLowDigit(prev) then \" \" else \"\") & c)),",
          "\t\tlower = Text.Lower(spaced),",
          "\t\tonlyAlnum = Text.Combine(List.Transform(Text.ToList(lower), each",
          "\t\t\tif (_ >= \"a\" and _ <= \"z\") or (_ >= \"0\" and _ <= \"9\") then _ else \" \")),",
          "\t\twords = List.Select(Text.Split(onlyAlnum, \" \"), each _ <> \"\"),",
          "\t\tnoise = {\"agent\", \"bot\", \"helper\", \"assistant\", \"guide\", \"advisor\", \"copilot\", \"the\", \"and\", \"for\", \"my\"},",
          "\t\tkept = List.Select(words, each not List.Contains(noise, _)),",
          "\t\tfinal = if List.Count(kept) = 0 then words else kept",
          "\tin",
          "\t\tText.Combine(final, \"\")"
        ],
        "lineageTag": "ae0expr0norm-0001-0000-0000-000000000091"
      },
      {
        "name": "AgentNameOverrides",
        "description": [
          "EDIT ME: manual agent-name overrides for cases the automatic key cannot match -",
          "typically when the display name carries extra words (\"Travel & Expense Agent\"",
          "vs the cr9a2_travelAgent schema). Left column is exactly as it appears in the",
          "credit export; right column is the agent schema name from the transcripts.",
          "Anything matched automatically does not need an entry here."
        ],
        "kind": "m",
        "expression": [
          "#table(",
          "\ttype table [credit_agent_name = text, agent_schema = text],",
          "\t{",
          "\t\t{\"Travel & Expense Agent\", \"cr9a2_travelAgent\"}",
          "\t}",
          ")"
        ],
        "lineageTag": "ae0expr0ovr-00001-0000-0000-000000000092"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Fabric SQL Endpoint\",\"Lakehouse Name\",\"FabricTable\",\"Chat + Agent Org Data\",\"Agent Catalogue\",\"Agent Sessions\",\"Agent Turns\",\"Agent Errors\",\"Agent Sub-Agent Calls\",\"Agent Performance\",\"Agent Variables\",\"Credit Consumption (Agent)\",\"Credit Consumption (User)\",\"Credit Consumption (Tenant)\",\"EmptyTable\",\"Conversation Transcripts (Raw)\",\"Dataverse Diagnostic\",\"Source Mode\",\"Dataverse Url\",\"DataverseEntity\",\"CSV Folder Path\",\"CsvTable\",\"CsvTableNorm\",\"RawTranscripts\",\"ParsedBase\",\"Parse_Sessions\",\"Parse_Turns\",\"Parse_Errors\",\"Parse_SubAgents\",\"Parse_Performance\",\"CsvBinary\",\"CsvFromPath\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"MCP-PBIModeling\",\"DevMode\",\"TMDL-Extension\"]"
      }
    ]
  }
