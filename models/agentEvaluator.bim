        "partitions": [
          {
            "name": "Chat + Agent Org Data",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Accepts a SharePoint URL (https://...) or a local file path (c:\\... or \\\\server\\...).",
                "    PromotedHeaders = if #\"Source Mode\" <> \"Fabric\" then CsvTable(\"copilot_org_data\") else FabricTable(\"copilot_org_data\"),",
                "    #\"Trimmed Column Names\" = Table.TransformColumnNames(PromotedHeaders, each Text.Trim(_)),",
                "",
                "    // Used ONLY to normalize *column names* for detection",
                "    Normalize = (s as text) as text =>",
                "        Text.Lower(Text.Remove(s, {\" \", \"_\", \"-\", \".\", \"(\", \")\", \"[\", \"]\"})),",
                "",
                "    ColumnNames = Table.ColumnNames(#\"Trimmed Column Names\"),",
                "",
                "    // Find PersonID/UPN variant column name",
                "    colPersonId =",
                "        List.First(",
                "            List.Select(",
                "                ColumnNames,",
                "                (c) => List.Contains({\"userprincipalname\", \"upn\", \"personid\"}, Normalize(c))",
                "            ),",
                "            null",
                "        ),",
                "",
                "    // Rename to canonical PersonId",
                "    RenamedPersonId =",
                "        if colPersonId <> null then",
                "            Table.RenameColumns(",
                "                #\"Trimmed Column Names\",",
                "                {{colPersonId, \"PersonId\"}},",
                "                MissingField.Ignore",
                "            )",
                "        else",
                "            #\"Trimmed Column Names\",",
                "",
                "    // Find Department variant column name",
                "    colDepartment =",
                "        List.First(",
                "            List.Select(",
                "                Table.ColumnNames(RenamedPersonId),",
                "                (c) => Normalize(c) = \"department\"",
                "            ),",
                "            null",
                "        ),",
                "",
                "    // Rename Department to Organization (if exists)",
                "    RenamedColumns =",
                "        if colDepartment <> null then",
                "            Table.RenameColumns(",
                "                RenamedPersonId,",
                "                {{colDepartment, \"Organization\"}},",
                "                MissingField.Ignore",
                "            )",
                "        else",
                "            RenamedPersonId,",
                "",
                "    // Normalize *values* for joins (safe for UPN/email): lower + trim only.",
                "    // Idempotent: if the source Delta table already has PersonId_Normalized",
                "    // (older pre-normalized ingester output), keep it instead of re-adding.",
                "    AddPersonIdNormalized =",
                "        if Table.HasColumns(RenamedColumns, \"PersonId_Normalized\") then",
                "            RenamedColumns",
                "        else if Table.HasColumns(RenamedColumns, \"PersonId\") then",
                "            Table.AddColumn(",
                "                RenamedColumns,",
                "                \"PersonId_Normalized\",",
                "                each try Text.Lower(Text.Trim(Text.From([PersonId]))) otherwise null,",
                "                type text",
                "            )",
                "        else",
                "            RenamedColumns,",
                "",
                "    // Ensure TotalEmployees exists",
                "    WithTotalEmployees =",
                "        if Table.HasColumns(AddPersonIdNormalized, \"TotalEmployees\") then",
                "            AddPersonIdNormalized",
                "        else",
                "            Table.AddColumn(",
                "                AddPersonIdNormalized,",
                "                \"TotalEmployees\",",
                "                each Table.RowCount(AddPersonIdNormalized)",
                "            ),",
                "",
                "    // Normalise JobTitle casing (Entra exports as \"jobTitle\", calc columns reference \"JobTitle\")",
                "    RenamedJobTitle =",
                "        if Table.HasColumns(WithTotalEmployees, \"jobTitle\") then",
                "            Table.RenameColumns(WithTotalEmployees, {{\"jobTitle\", \"JobTitle\"}}, MissingField.Ignore)",
                "        else",
                "            WithTotalEmployees,",
                "",
                "    // ROBUSTNESS: the model declares sourceColumns id / UserId / displayName / officeLocation /",
                "    // managerUPN / Function / Manager_UserId / Location that NOT every customer org export contains",
                "    // (e.g. SyntheticOrgData, viva-org lack \"id\"). Guarantee each exists so the model never errors",
                "    // \"column cannot be found\". \"id\" is a relationship key (Agent Sessions/Performance -> Org.id), so",
                "    // default it to PersonId when absent; the rest default to null.",
                "    EnsureOptionalCols =",
                "        let",
                "            addNull = (t as table, c as text) as table => if Table.HasColumns(t, c) then t else Table.AddColumn(t, c, each null, type text),",
                "            e0 = if Table.HasColumns(RenamedJobTitle, \"id\") then RenamedJobTitle",
                "                 else Table.AddColumn(RenamedJobTitle, \"id\", each (if Table.HasColumns(RenamedJobTitle, \"PersonId\") then [PersonId] else null), type text),",
                "            e1 = addNull(e0, \"UserId\"),",
                "            e2 = addNull(e1, \"displayName\"),",
                "            e3 = addNull(e2, \"officeLocation\"),",
                "            e4 = addNull(e3, \"managerUPN\"),",
                "            e5 = addNull(e4, \"Function\"),",
                "            e6 = addNull(e5, \"Manager_UserId\"),",
                "            e7 = addNull(e6, \"Location\"),",
                "            e8 = addNull(e7, \"companyName\"),",
                "            e9 = addNull(e8, \"country\"),",
                "            e10 = addNull(e9, \"usageLocation\"),",
                "            e11 = addNull(e10, \"Organization\"),",
                "            e12 = addNull(e11, \"JobTitle\")",
                "        in e12,",
                "",
                "        // Keep ALL columns from the source CSV (customer org hierarchy, management path, etc. depend on this)",
                "    Keyed = Table.AddColumn(EnsureOptionalCols, \"Org Join Key\", each if [PersonId_Normalized] <> null and [PersonId_Normalized] <> \"\" then [PersonId_Normalized] else (if [id] = null then null else Text.Lower(Text.From([id]))), type text),",
                "    Result = Keyed",
                "in",
                "    Result"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
