              "expression": [
                "",
                "DATATABLE (",
                "    \"Currency Choice\", STRING,",
                "    \"Symbol\", STRING,",
                "    \"Code\", STRING,",
                "    \"SortOrder\", INTEGER,",
                "    {",
                "        { \"GBP (£)\", \"£\", \"GBP\", 1 },",
                "        { \"USD ($)\", \"$\", \"USD\", 2 },",
                "        { \"EUR (€)\", \"€\", \"EUR\", 3 }",
