          {
            "type": "calculatedTableColumn",
            "name": "Credit (min)",
            "dataType": "double",
            "isNameInferred": false,
            "description": "LAYER 3 credit — extra minutes saved each time the agent performs this action within a conversation (on top of the topic base). Indicative; tune per customer.",
            "sourceColumn": "[Credit (min)]",
            "lineageTag": "a7c7a520-col0-0001-000000000002",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Rationale",
            "dataType": "string",
            "isNameInferred": false,
            "description": "What the activity represents and why it saves time.",
            "sourceColumn": "[Rationale]",
            "lineageTag": "a7c7a520-col0-0001-000000000003",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Activity Credit Map",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE(",
                "    \"Activity\", STRING,",
                "    \"Credit (min)\", DOUBLE,",
                "    \"Rationale\", STRING,",
                "    {",
                "        {\"Knowledge lookup\", 4, \"Agent searched & cited internal knowledge the user would otherwise have hunted for\"},",
                "        {\"Tool / plugin action\", 8, \"Agent completed a transaction (e.g. raised a ticket, reset access) the user would have done manually\"},",
                "        {\"Generative answer\", 5, \"Agent drafted a generative response the user would otherwise have written or researched\"},",
                "        {\"Multi-step process\", 6, \"Agent ran a multi-step plan to completion, saving the user navigating each step\"}",
                "    }",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "a7c7a520000142000900"
          }
        ]
      },
      {
        "name": "Hourly Rate (Saving)",
        "lineageTag": "a7c7a530-0001-4a00-9000-000000000001",
