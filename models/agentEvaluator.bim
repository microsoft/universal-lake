        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR _dates =",
                "    DISTINCT(",
                "        UNION(",
                "            SELECTCOLUMNS('Agent Sessions', \"d\", 'Agent Sessions'[Session Start Date]),",
                "            SELECTCOLUMNS('Agent Performance', \"d\", 'Agent Performance'[InteractionDate])",
                "        )",
                "    )",
                "VAR MinDate = MINX(_dates, [d])",
                "VAR MaxDate = MAXX(_dates, [d])",
                "// Defensive fallbacks: if the source tables are empty or all dates are",
                "// blank, CALENDAR(BLANK, BLANK) errors with \"start date can not be later",
                "// than end date\". Anchor the range on a sensible default.",
                "VAR SafeMin = COALESCE(MinDate, DATE(2024, 1, 1))",
                "VAR SafeMax = IF(ISBLANK(MaxDate) || MaxDate < SafeMin, SafeMin, MaxDate)",
                "RETURN",
                "ADDCOLUMNS(",
                "    CALENDAR(SafeMin, SafeMax),",
                "    \"Year\", YEAR([Date]),",
                "    \"Year-Month\", FORMAT([Date], \"YYYY-MM\"),",
                "    \"Month Name\", FORMAT([Date], \"MMMM\"),",
                "    \"Month Number\", MONTH([Date]),",
                "    \"Quarter\", \"Q\" & QUARTER([Date]),",
                "    \"Quarter Number\", QUARTER([Date]),",
                "    \"Week Number\", WEEKNUM([Date], 2),",
                "    \"Week Start\", [Date] - WEEKDAY([Date], 2) + 1,",
                "    \"Day Name\", FORMAT([Date], \"dddd\"),",
                "    \"Day Number\", DAY([Date]),",
                "    \"Is Weekend\", WEEKDAY([Date], 1) IN {1, 7}",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "9e947f92b0f04a85b13bffee9d5781e3"
          }
        ]
