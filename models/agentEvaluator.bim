              }
            ]
          },
          {
            "name": "Usage_Date",
            "dataType": "dateTime",
            "sourceColumn": "Usage_Date",
            "formatString": "General Date",
            "lineageTag": "cc0003tn-col0-0001-000000000009",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Credit Consumption (Tenant)",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Cols = {\"BillingPlan_Id\", \"BillingPlan_Name\", \"Environment_Id\", \"Environment_Name\", \"Capacity_Type\", \"Entitled_Quantity\", \"Prepaid_Consumed_Quantity\", \"Pay_as_you_go_Consumed_Quantity\", \"Usage_Date\"},",
                "    Promoted = ",
                "        // Outside Fabric, read <CSV Folder Path>\\credit_consumption_tenant.csv when present.",
                "        // Missing file -> the original empty shape, so the file stays optional.",
                "        if #\"Source Mode\" = \"Fabric\" then (try FabricTable(\"credit_consumption_tenant\") otherwise EmptyTable(Cols))",
                "        else (try Table.SelectColumns(CsvTable(\"credit_consumption_tenant\"), Cols, MissingField.UseNull)",
                "              otherwise EmptyTable(Cols)),",
                "    Typed = Table.TransformColumnTypes(Promoted, {",
                "        {\"BillingPlan_Id\", type text},",
                "        {\"BillingPlan_Name\", type text},",
                "        {\"Environment_Id\", type text},",
                "        {\"Environment_Name\", type text},",
                "        {\"Capacity_Type\", type text},",
                "        {\"Entitled_Quantity\", Int64.Type},",
                "        {\"Prepaid_Consumed_Quantity\", Int64.Type},",
                "        {\"Pay_as_you_go_Consumed_Quantity\", Int64.Type},",
                "        {\"Usage_Date\", type datetime}",
                "    }, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Prepaid Consumed",
            "description": "Prepaid credits consumed (entitlement / committed capacity).",
            "expression": "SUM('Credit Consumption (Tenant)'[Prepaid_Consumed_Quantity])",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0003tn-meas-0001-000000000001"
          },
          {
            "name": "PAYG Consumed",
            "description": "Pay-as-you-go credits consumed (overage billed to Azure).",
            "expression": "SUM('Credit Consumption (Tenant)'[Pay_as_you_go_Consumed_Quantity])",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0003tn-meas-0001-000000000002"
          },
          {
            "name": "Entitled Capacity",
            "description": "Entitled (purchased) message capacity.",
            "expression": "SUM('Credit Consumption (Tenant)'[Entitled_Quantity])",
            "formatString": "#,0",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0003tn-meas-0001-000000000003"
          },
          {
            "name": "Prepaid Utilisation %",
            "description": "Prepaid utilisation: prepaid consumed / entitled. >100% means PAYG overage is in play.",
            "expression": "DIVIDE([Prepaid Consumed], [Entitled Capacity])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0003tn-meas-0001-000000000004"
          },
          {
            "name": "Billing Period",
            "description": [
              "Coverage window of the loaded credit-consumption export, inferred from the",
              "tenant Usage_Date (min–max). Stands in for a date slicer: the per-agent and",
              "per-user exports carry no date, so this states the period the figures cover."
            ],
            "expression": "IF ( ISBLANK ( MIN ( 'Credit Consumption (Tenant)'[Usage_Date] ) ), \"No billing export loaded\", FORMAT ( MIN ( 'Credit Consumption (Tenant)'[Usage_Date] ), \"d MMM\" ) & \" – \" & FORMAT ( MAX ( 'Credit Consumption (Tenant)'[Usage_Date] ), \"d MMM yyyy\" ) )",
            "displayFolder": "💳 Billing (Actuals)",
            "lineageTag": "cc0003tn-meas-period0001"
          },
          {
            "name": "Total Consumed Credits (Tenant)",
            "expression": [
              "[Prepaid Consumed] + [PAYG Consumed]",
              ""
            ],
            "formatString": "0",
            "lineageTag": "e7e034d9-8291-4a9c-b67e-44ffd06e6c49"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Environment",
        "lineageTag": "e0000001-env0-0001-0001-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Environment_Id",
            "dataType": "string",
            "isNameInferred": true,
            "description": [
              "Environment key (Power Platform environment ID). Shared dimension so the three",
              "Credit Consumption tables (Agent, Tenant, User) cross-filter by environment."
            ],
            "sourceColumn": "[Environment_Id]",
            "lineageTag": "e0000001-env0-0001-0001-000000000002",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Environment_Name",
            "dataType": "string",
            "isNameInferred": true,
            "description": "Display environment name for slicers and visuals.",
            "sourceColumn": "[Environment_Name]",
            "lineageTag": "e0000001-env0-0001-0001-000000000003",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Environment",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "VAR AllEnv =",
                "    UNION (",
                "        SELECTCOLUMNS (",
                "            FILTER ( VALUES ( 'Credit Consumption (Agent)'[Environment_Id] ), NOT ISBLANK ( 'Credit Consumption (Agent)'[Environment_Id] ) ),",
                "            \"Environment_Id\", 'Credit Consumption (Agent)'[Environment_Id]",
                "        ),",
                "        SELECTCOLUMNS (",
                "            FILTER ( VALUES ( 'Credit Consumption (Tenant)'[Environment_Id] ), NOT ISBLANK ( 'Credit Consumption (Tenant)'[Environment_Id] ) ),",
                "            \"Environment_Id\", 'Credit Consumption (Tenant)'[Environment_Id]",
                "        )",
                "    )",
                "VAR Keys = DISTINCT ( SELECTCOLUMNS ( AllEnv, \"Environment_Id\", [Environment_Id] ) )",
                "RETURN",
                "    ADDCOLUMNS (",
                "        Keys,",
                "        \"Environment_Name\",",
                "            VAR eid = [Environment_Id]",
                "            RETURN",
                "                COALESCE (",
                "                    MAXX ( FILTER ( 'Credit Consumption (Agent)', 'Credit Consumption (Agent)'[Environment_Id] = eid ), 'Credit Consumption (Agent)'[Environment_Name] ),",
                "                    MAXX ( FILTER ( 'Credit Consumption (Tenant)', 'Credit Consumption (Tenant)'[Environment_Id] = eid ), 'Credit Consumption (Tenant)'[Environment_Name] ),",
                "                    [Environment_Id]",
                "                )",
                "    )",
                ""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "e0000001env000010001000000000001"
          }
        ]
      },
