      {
        "name": "Agent Task Value Map",
        "lineageTag": "a7c7a510-0001-4a00-9000-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Topic",
            "dataType": "string",
            "isNameInferred": false,
            "description": "The conversation topic this row maps. Joins to Agent Performance[Topic (resolved)]. '*Default*' is the fallback for any topic not explicitly listed.",
            "sourceColumn": "[Topic]",
            "lineageTag": "a7c7a510-col0-0001-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Base Handle (min)",
            "dataType": "double",
            "isNameInferred": false,
            "description": "LAYER 1 base — estimated minutes a human (e.g. service-desk / HR shared-services agent) would take to handle one request of this topic, end-to-end. Editable; tune per customer. Indicative only.",
            "sourceColumn": "[Base Handle (min)]",
            "lineageTag": "a7c7a510-col0-0001-000000000002",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Confidence",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[Confidence]",
            "lineageTag": "a7c7a510-col0-0001-000000000003",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Source",
            "dataType": "string",
            "isNameInferred": false,
            "description": "Benchmark source / rationale for the base estimate. Shown for transparency.",
            "sourceColumn": "[Source]",
            "lineageTag": "a7c7a510-col0-0001-000000000004",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Low (min)",
            "dataType": "double",
            "isNameInferred": false,
            "description": [
              "Confidence in the base estimate (High / Medium / Low). Drives the confidence badge in narratives.",
              "Cautious end of the published handle-time range for this topic."
            ],
            "sourceColumn": "[Low (min)]",
            "formatString": "#,0.#",
            "lineageTag": "a7c7a510-col0-0001-000000000005",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "High (min)",
            "dataType": "double",
            "isNameInferred": false,
            "description": "Generous end of the published handle-time range for this topic.",
            "sourceColumn": "[High (min)]",
            "formatString": "#,0.#",
            "lineageTag": "a7c7a510-col0-0001-000000000006",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Agent Task Value Map",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE(",
                "    \"Topic\", STRING,",
                "    \"Base Handle (min)\", DOUBLE,",
                "    \"Low (min)\", DOUBLE,",
                "    \"High (min)\", DOUBLE,",
                "    \"Confidence\", STRING,",
                "    \"Source\", STRING,",
                "    {",
                "        {\"Leave & Absence\", 8, 5.2, 12.4, \"Medium\", \"HR shared-services AHT for leave / absence queries\"},",
                "        {\"Pay & Payroll\", 10, 6.5, 15.5, \"Low-Medium\", \"HR / payroll shared-services AHT for pay / payroll queries\"},",
                "        {\"Benefits & Pension\", 10, 6.5, 15.5, \"Low-Medium\", \"HR shared-services AHT for benefits / pension queries\"},",
                "        {\"Recruitment & Hiring\", 12, 7.8, 18.6, \"Low-Medium\", \"HR / TA handle time for recruitment / hiring queries\"},",
                "        {\"Onboarding & Joiner\", 12, 7.8, 18.6, \"Low-Medium\", \"HR shared-services AHT for onboarding / new-joiner queries\"},",
                "        {\"IT, Access & Devices\", 15, 9.8, 23.2, \"Medium\", \"IT service-desk AHT for access/password/MFA resets and device requests (HDI / MetricNet benchmarks)\"},",
                "        {\"Software & Applications\", 10, 6.5, 15.5, \"Medium\", \"IT service-desk AHT for software / application / licensing queries (HDI)\"},",
                "        {\"Policy, Contracts & Compliance\", 12, 7.8, 18.6, \"Low-Medium\", \"Estimated knowledge-lookup time for policy / contract / compliance questions\"},",
                "        {\"Facilities & Workplace\", 8, 5.2, 12.4, \"Low-Medium\", \"Facilities / workplace shared-services handle time\"},",
                "        {\"People & Directory\", 5, 3.2, 7.8, \"Medium\", \"Quick directory / contact lookup\"},",
                "        {\"Customer, Sales & Orders\", 12, 7.8, 18.6, \"Low-Medium\", \"Customer-service / sales-ops handle time for customer / order queries\"},",
                "        {\"Finance & Procurement\", 12, 7.8, 18.6, \"Low-Medium\", \"Finance / procurement shared-services handle time\"},",
                "        {\"Data, Reporting & Analytics\", 10, 6.5, 15.5, \"Low-Medium\", \"Analyst handle time for a report / data lookup\"},",
                "        {\"Technical & Engineering\", 18, 11.7, 27.9, \"Low-Medium\", \"Engineering / technical handle time for a network / systems request\"},",
                "        {\"*Default*\", 8, 5.2, 12.4, \"Low\", \"Conservative fallback for any unmapped topic (matches ESS flat assumption)\"}",
                "    }",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "a7c7a510000142000900"
          }
        ]
      },
      {
