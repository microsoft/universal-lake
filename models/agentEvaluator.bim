            "name": "Anatomy",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE (",
                "    \"Stage\", STRING,",
                "    \"Order\", INTEGER,",
                "    {",
                "        { \"They asked\", 1 },",
                "        { \"Back & forth\", 2 },",
                "        { \"Knowledge\", 3 },",
                "        { \"Help\", 4 },",
                "        { \"Errors\", 5 },",
                "        { \"Ended\", 6 }",
                "    }",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "AnatomyStages"
          }
        ]
      }
    ],
