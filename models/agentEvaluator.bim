        ]
      },
      {
        "name": "Knowledge Citations",
        "lineageTag": "kc000000-0000-0000-0000-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "conversation_id",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[conversation_id]",
            "lineageTag": "kc000000-col0-0000-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "turn_id",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[turn_id]",
            "lineageTag": "kc000000-col0-0000-000000000002",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "topic_derived",
            "dataType": "string",
            "isNameInferred": false,
            "description": "The agent-derived conversation topic (carried from 'Agent Turns'[topic_derived]) so knowledge usage can be sliced by topic.",
            "sourceColumn": "[topic_derived]",
            "lineageTag": "kc000000-col0-0000-000000000003",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "knowledge_answered",
            "dataType": "boolean",
            "isNameInferred": false,
            "sourceColumn": "[knowledge_answered]",
            "lineageTag": "kc000000-col0-0000-000000000004",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "source_type",
            "dataType": "string",
            "isNameInferred": false,
            "description": "Source category: 'File' (uploaded document), 'SharePoint / Topic' (SharePoint URL or topic-backed knowledge), or 'Other'.",
            "sourceColumn": "[source_type]",
            "lineageTag": "kc000000-col0-0000-000000000005",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "is_file",
            "dataType": "boolean",
            "isNameInferred": false,
            "description": "TRUE when the cited source is an uploaded file.",
            "sourceColumn": "[is_file]",
            "lineageTag": "kc000000-col0-0000-000000000006",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "source_label",
            "dataType": "string",
            "isNameInferred": false,
            "description": "Cleaned, human-readable source name (filename for files; topic/SharePoint label otherwise).",
            "sourceColumn": "[source_label]",
            "lineageTag": "kc000000-col0-0000-000000000007",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "source_raw",
            "dataType": "string",
            "isNameInferred": false,
            "description": "Raw source identifier as emitted by the transcript parser (for audit / troubleshooting).",
            "sourceColumn": "[source_raw]",
            "lineageTag": "kc000000-col0-0000-000000000008",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Topic (conversation)",
            "dataType": "string",
            "description": [
              "GENERIC TOPIC of this citation's conversation — the customer-agnostic 'Topic (lead)' of the",
              "conversation's dominant activity (from 'Activity Events'). Lets the Knowledge page be sliced by topic",
              "even though the native topic_derived export field is empty. Falls back to \"Untitled / system chat\"."
            ],
            "expression": [
              "VAR _cid = 'Knowledge Citations'[conversation_id]",
              "VAR _topic =",
              "    CALCULATE (",
              "        MAX ( 'Activity Events'[Topic (lead)] ),",
              "        FILTER ( ALL ( 'Activity Events' ), 'Activity Events'[conversation_id] = _cid && 'Activity Events'[Is Primary Activity] = 1 )",
              "    )",
              "RETURN COALESCE ( _topic, \"Untitled / system chat\" )"
            ],
            "lineageTag": "kc000000-col0-0000-000000000010",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Knowledge Citations",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR Exploded =",
                "    GENERATE(",
                "        FILTER('Agent Turns', LEN('Agent Turns'[knowledge_sources]) > 0),",
                "        VAR s = 'Agent Turns'[knowledge_sources]",
                "        VAR n = 1 + (LEN(s) - LEN(SUBSTITUTE(s, \"|\", \"\")))",
                "        RETURN ADDCOLUMNS(GENERATESERIES(1, n), \"seg\", PATHITEM(s, [Value]))",
                "    )",
                "RETURN",
                "    SELECTCOLUMNS(",
                "        Exploded,",
                "        \"conversation_id\", 'Agent Turns'[conversation_id],",
                "        \"turn_id\", 'Agent Turns'[turn_id],",
                "        \"topic_derived\", 'Agent Turns'[topic_derived],",
                "        \"knowledge_answered\", 'Agent Turns'[knowledge_answered],",
                "        \"source_raw\", [seg],",
                "        \"source_type\", IF(CONTAINSSTRING([seg], \".file.\"), \"File\", IF(CONTAINSSTRING([seg], \".topic.\"), \"SharePoint / Topic\", \"Other\")),",
                "        \"is_file\", IF(CONTAINSSTRING([seg], \".file.\"), TRUE(), FALSE()),",
                "        \"source_label\",",
                "            VAR seg2 = [seg]",
                "            VAR afterFile = IF(CONTAINSSTRING(seg2, \".file.\"), MID(seg2, FIND(\".file.\", seg2) + 6, 999), BLANK())",
                "            VAR afterTopic = IF(CONTAINSSTRING(seg2, \".topic.\"), MID(seg2, FIND(\".topic.\", seg2) + 7, 999), BLANK())",
                "            VAR body = COALESCE(afterFile, afterTopic, seg2)",
                "            VAR low = LOWER(body)",
                "            VAR exts = { \".pdf\", \".docx\", \".doc\", \".pptx\", \".ppt\", \".xlsx\", \".xls\", \".csv\", \".txt\", \".md\", \".html\", \".htm\", \".json\", \".aspx\", \".one\" }",
                "            VAR extHits = FILTER(ADDCOLUMNS(exts, \"pos\", IFERROR(FIND([Value], low), 0), \"len\", LEN([Value])), [pos] > 0)",
                "            VAR firstExt = MINX(extHits, [pos])",
                "            VAR extLen = MAXX(FILTER(extHits, [pos] = firstExt), [len])",
                "            RETURN",
                "                IF(NOT ISBLANK(afterFile) && NOT ISBLANK(firstExt), LEFT(afterFile, firstExt + extLen - 1),",
                "                    IF(NOT ISBLANK(firstExt), LEFT(body, firstExt + extLen - 1),",
                "                        LEFT(body, IFERROR(FIND(\"_\", body) - 1, LEN(body)))))",
                "    )"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Knowledge Citation Count",
            "description": "One row per (turn × cited knowledge source). Exploded from 'Agent Turns'[knowledge_sources] (the transcript KnowledgeTraceData.citedKnowledgeSources list, pipe-delimited). Lets you see which knowledge files / SharePoint sources the agent actually cited in its answers.",
            "expression": "COUNTROWS('Knowledge Citations')",
            "formatString": "#,0",
            "displayFolder": "📚 Knowledge",
            "lineageTag": "kc000000-meas-0000-000000000001"
          },
          {
            "name": "Distinct Knowledge Sources Cited",
            "description": "Distinct knowledge sources (files + SharePoint/topic) cited in the current selection.",
            "expression": "DISTINCTCOUNT('Knowledge Citations'[source_label])",
            "formatString": "#,0",
            "displayFolder": "📚 Knowledge",
            "lineageTag": "kc000000-meas-0000-000000000002"
          },
          {
            "name": "Distinct Knowledge Files Cited",
            "description": "Distinct uploaded knowledge FILES cited (excludes SharePoint/topic sources).",
            "expression": "CALCULATE(DISTINCTCOUNT('Knowledge Citations'[source_label]), 'Knowledge Citations'[is_file] = TRUE())",
            "formatString": "#,0",
            "displayFolder": "📚 Knowledge",
            "lineageTag": "kc000000-meas-0000-000000000003"
          },
          {
            "name": "File Citation Count",
            "description": "Citation events that point at an uploaded file (a file may be cited many times).",
            "expression": "CALCULATE(COUNTROWS('Knowledge Citations'), 'Knowledge Citations'[is_file] = TRUE())",
            "formatString": "#,0",
            "displayFolder": "📚 Knowledge",
            "lineageTag": "kc000000-meas-0000-000000000004"
          },
          {
            "name": "Knowledge-Grounded Conversations",
            "description": "Conversations where the agent cited at least one knowledge source (grounded answers).",
            "expression": "DISTINCTCOUNT('Knowledge Citations'[conversation_id])",
            "formatString": "#,0",
            "displayFolder": "📚 Knowledge",
            "lineageTag": "kc000000-meas-0000-000000000005"
          },
          {
            "name": "Avg Sources per Grounded Answer",
            "description": "Average number of distinct sources cited per grounded answer-turn.",
            "expression": [
              "DIVIDE(",
              "    [Knowledge Citation Count],",
              "    DISTINCTCOUNT('Knowledge Citations'[turn_id])",
              ")"
            ],
            "formatString": "#,0.0",
            "displayFolder": "📚 Knowledge",
            "lineageTag": "kc000000-meas-0000-000000000006"
          },
          {
            "name": "Top Cited Source",
            "description": "The single most-cited knowledge source label in the current selection.",
            "expression": [
              "VAR _t =",
              "    TOPN(",
              "        1,",
              "        SUMMARIZE('Knowledge Citations', 'Knowledge Citations'[source_label]),",
              "        CALCULATE(COUNTROWS('Knowledge Citations')), DESC",
              "    )",
              "RETURN",
              "    MAXX(_t, 'Knowledge Citations'[source_label])"
            ],
            "displayFolder": "📚 Knowledge",
            "lineageTag": "kc000000-meas-0000-000000000007"
          },
          {
            "name": "📚 Knowledge Story (Live)",
            "description": "Dynamic headline for the Knowledge Files page. Degrades gracefully when no citations are in scope.",
            "expression": [
              "VAR _files = [Distinct Knowledge Files Cited]",
              "VAR _srcs = [Distinct Knowledge Sources Cited]",
              "VAR _cites = [Knowledge Citation Count]",
              "VAR _topf = [Top Cited Source]",
              "VAR _conv = [Knowledge-Grounded Conversations]",
              "RETURN",
              "    IF(",
              "        _cites = 0,",
              "        \"No knowledge citations in the current selection. Knowledge grounding lights up when agents cite uploaded files or SharePoint sources in their answers — confirm the transcript export carries KnowledgeTraceData.\",",
              "        \"Agents grounded \" & _conv & \" conversation(s) in \" & _srcs & \" distinct knowledge source(s)\"",
              "            & IF(_files > 0, \" (\" & _files & \" uploaded file\" & IF(_files = 1, \"\", \"s\") & \")\", \"\")",
              "            & \" across \" & _cites & \" citation(s). Most-cited: \" & _topf & \".\"",
              "    )"
            ],
            "displayFolder": "📚 Knowledge",
            "lineageTag": "kc000000-meas-0000-000000000009"
          },
          {
            "name": "SharePoint Citation Count",
            "description": "Citation events that point at a SharePoint / topic-backed knowledge source (complement of File Citation Count). Used as the second series in the source-mix bar.",
            "expression": "CALCULATE(COUNTROWS('Knowledge Citations'), 'Knowledge Citations'[is_file] = FALSE())",
            "formatString": "#,0",
            "displayFolder": "📚 Knowledge",
            "lineageTag": "kc000000-meas-0000-000000000010"
          },
          {
            "name": "📂 Knowledge Insight (Live)",
            "description": "Second insight headline for the Knowledge Files page: file-vs-SharePoint mix and grounding coverage.",
            "expression": [
              "VAR _file = [File Citation Count]",
              "VAR _sp = [SharePoint Citation Count]",
              "VAR _tot = _file + _sp",
              "VAR _conv = [Knowledge-Grounded Conversations]",
              "VAR _avg = [Avg Sources per Grounded Answer]",
              "RETURN",
              "    IF(",
              "        _tot = 0,",
              "        \"No cited sources in scope. When agents ground answers, this shows the split between uploaded files and SharePoint / topic sources.\",",
              "        \"Of \" & _tot & \" citation(s), \" & FORMAT(DIVIDE(_file, _tot), \"0%\") & \" hit uploaded files and \"",
              "            & FORMAT(DIVIDE(_sp, _tot), \"0%\") & \" hit SharePoint / topic sources. Agents averaged \"",
              "            & FORMAT(_avg, \"0.0\") & \" source(s) per grounded answer across \" & _conv & \" conversation(s).\"",
              "    )"
            ],
            "displayFolder": "📚 Knowledge",
            "lineageTag": "kc000000-meas-0000-000000000011"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "kc0000000000142000900"
          }
        ]
      },
      {
        "name": "Studio Activity Value Map",
        "lineageTag": "5a000000-0000-0000-0000-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Activity",
            "dataType": "string",
            "isNameInferred": false,
            "description": "The Studio-native agent activity, detected from conversation transcripts. Editable. This is the Copilot-Studio analogue of the Purview 'Human Time Estimates' behaviour table.",
            "sourceColumn": "[Activity]",
            "lineageTag": "5a000000-col0-0000-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Detection",
            "dataType": "string",
            "isNameInferred": false,
            "description": "How this activity is detected in the transcript (the Studio signal). Shown for transparency.",
            "sourceColumn": "[Detection]",
            "lineageTag": "5a000000-col0-0000-000000000002",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
