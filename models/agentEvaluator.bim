      {
        "name": "Conversation Transcripts (Raw)",
        "lineageTag": "1a2b3c4d-dv01-7001-9001-000000000201",
        "columns": [
          {
            "name": "conversationtranscriptid",
            "dataType": "string",
            "description": "Dataverse primary key of the conversation transcript row.",
            "sourceColumn": "conversationtranscriptid",
            "lineageTag": "1a2b3c4d-dv01-7001-9001-000000000202",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "conversationstarttime",
            "dataType": "dateTime",
            "description": "Conversation start time (Dataverse conversationstarttime).",
            "sourceColumn": "conversationstarttime",
            "formatString": "General Date",
            "lineageTag": "1a2b3c4d-dv01-7001-9001-000000000203",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "name",
            "dataType": "string",
            "description": "Transcript display name.",
            "sourceColumn": "name",
            "lineageTag": "1a2b3c4d-dv01-7001-9001-000000000204",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "content_length",
            "dataType": "int64",
            "description": [
              "Length (characters) of the raw JSON content blob — the key sanity check that the native",
              "Dataverse connector is exposing the big `content` field (TDS/SQL endpoint would truncate it)."
            ],
            "sourceColumn": "content_length",
            "formatString": "0",
            "lineageTag": "1a2b3c4d-dv01-7001-9001-000000000205",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "content_preview",
            "dataType": "string",
            "description": "First 500 characters of the JSON content (PII-safe preview) so you can eyeball the structure.",
            "sourceColumn": "content_preview",
            "lineageTag": "1a2b3c4d-dv01-7001-9001-000000000206",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Conversation Transcripts (Raw)",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Empty = #table({\"conversationtranscriptid\", \"conversationstarttime\", \"name\", \"content_length\", \"content_preview\"}, {}),",
                "    Output =",
                "        if #\"Source Mode\" = \"Dataverse\" or #\"Source Mode\" = \"TranscriptCSV\" then",
                "            let",
                "                // Source-agnostic raw transcripts (Dataverse Web API or local CSV).",
                "                Src = RawTranscripts(),",
                "                // Coerce start time to datetime (CSV returns text; Dataverse returns datetime).",
                "                WithDt = Table.AddColumn(Src, \"_start\", each",
                "                        let t = try Text.From([conversationstarttime]) otherwise null",
                "                        in if t = null then null else (try DateTime.FromText(t) otherwise (try DateTime.From(DateTimeZone.FromText(t)) otherwise null)), type datetime),",
                "                WithLen = Table.AddColumn(WithDt, \"content_length\", each if [content] = null then 0 else Text.Length(Text.From([content])), Int64.Type),",
                "                WithPrev = Table.AddColumn(WithLen, \"content_preview\", each if [content] = null then null else Text.Start(Text.From([content]), 500), type text),",
                "                Ren = Table.RenameColumns(WithPrev, {{\"_start\", \"start_dt\"}}),",
                "                Final = Table.SelectColumns(Ren, {\"conversationtranscriptid\", \"start_dt\", \"name\", \"content_length\", \"content_preview\"}, MissingField.UseNull),",
                "                Typed = Table.TransformColumnTypes(Table.RenameColumns(Final, {{\"start_dt\", \"conversationstarttime\"}}), {{\"conversationstarttime\", type datetime}, {\"content_length\", Int64.Type}, {\"conversationtranscriptid\", type text}, {\"name\", type text}, {\"content_preview\", type text}})",
                "            in",
                "                Typed",
                "        else",
                "            Empty",
                "in",
                "    Output"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Dataverse Diagnostic",
        "lineageTag": "1a2b3c4d-dv01-7002-9002-000000000301",
        "columns": [
          {
            "name": "entity",
            "dataType": "string",
            "description": "Entity set tested.",
            "sourceColumn": "entity",
            "lineageTag": "1a2b3c4d-dv01-7002-9002-000000000302",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "row_count",
            "dataType": "string",
            "description": [
              "Row count returned (capped at 5000) via the proven OData.Feed path. If systemusers > 0 but",
              "conversationtranscripts = 0, the connector works and the environment simply has no transcripts."
            ],
            "sourceColumn": "row_count",
            "lineageTag": "1a2b3c4d-dv01-7002-9002-000000000303",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "note",
            "dataType": "string",
            "description": "Status / note for the test.",
            "sourceColumn": "note",
            "lineageTag": "1a2b3c4d-dv01-7002-9002-000000000304",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Dataverse Diagnostic",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Empty = #table({\"entity\", \"row_count\", \"note\"}, {}),",
                "    Output =",
                "        if #\"Source Mode\" = \"Dataverse\" then",
                "            let",
                "                Base = Text.TrimEnd(#\"Dataverse Url\", \"/\") & \"/api/data/v9.2/\",",
                "                CountOf = (entitySet as text, idCol as text) as record =>",
                "                    let",
                "                        Url = Base & entitySet & \"?$select=\" & idCol & \"&$top=5000\",",
                "                        Probe = try OData.Feed(Url, null, [Implementation = \"2.0\", ODataVersion = 4]),",
                "                        Ok = Probe[HasError] = false,",
                "                        Cnt = if Ok then Table.RowCount(Probe[Value]) else null,",
                "                        Note = if Ok then (if Cnt = 5000 then \"OK (capped at 5000 - more exist)\" else \"OK\")",
                "                               else \"ERROR - \" & Text.From(try Probe[Error][Message] otherwise \"request failed\")",
                "                    in",
                "                        [count = Cnt, note = Note],",
                "                    Transcripts = CountOf(\"conversationtranscripts\", \"conversationtranscriptid\"),",
                "                    Users = CountOf(\"systemusers\", \"systemuserid\"),",
                "                    Rows = #table(",
                "                        {\"entity\", \"row_count\", \"note\"},",
                "                        {",
                "                            {\"conversationtranscripts\", Transcripts[count], Transcripts[note]},",
                "                            {\"systemusers (control)\", Users[count], Users[note]}",
                "                        }",
                "                    ),",
                "                    Typed = Table.TransformColumnTypes(Rows, {{\"row_count\", Int64.Type}})",
                "                in",
                "                    Typed",
                "        else",
                "            Empty",
                "in",
                "    Output"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Agent Name Map",
        "lineageTag": "ae0anm000-0001-0001-0001-000000000001",
        "columns": [
          {
            "name": "credit_agent_name",
            "dataType": "string",
            "description": "The agent name exactly as it appears in the credit / billing export.",
            "isKey": true,
            "sourceColumn": "credit_agent_name",
            "lineageTag": "ae0anm000-col0-0001-0001-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "agent_schema",
            "dataType": "string",
            "description": "The matching agent schema name from the conversation transcripts.",
            "sourceColumn": "agent_schema",
            "lineageTag": "ae0anm000-col0-0001-0001-000000000002",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "match_type",
            "dataType": "string",
            "description": [
              "Auto = matched on the normalised key. Override = taken from AgentNameOverrides.",
              "Unmatched = credit exists but no transcript agent could be identified, so its",
              "cost cannot be attributed. Surfaced on the Value vs Cost page deliberately."
            ],
            "sourceColumn": "match_type",
            "lineageTag": "ae0anm000-col0-0001-0001-000000000003",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "match_key",
            "dataType": "string",
            "description": "The comparison key both sides were reduced to - kept for troubleshooting.",
            "sourceColumn": "match_key",
            "lineageTag": "ae0anm000-col0-0001-0001-000000000004",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Agent Name Map",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "\t// Credit-side names, read the same way the credit table reads them.",
                "\tCreditCols = {\"Agent_Name\"},",
                "\tCreditRaw =",
                "\t\tif #\"Source Mode\" = \"Fabric\" then EmptyTable(CreditCols)",
                "\t\telse (try Table.SelectColumns(CsvTable(\"credit_consumption_agent\"), CreditCols, MissingField.UseNull)",
                "\t\t\t  otherwise EmptyTable(CreditCols)),",
                "\tCreditNames = List.Distinct(List.RemoveNulls(List.Transform(",
                "\t\tTable.Column(CreditRaw, \"Agent_Name\"), each if _ = null then null else Text.From(_)))),",
                "",
                "\t// Transcript-side schemas, from the same source Agent Catalogue uses.",
                "\tSessions =",
                "\t\tif #\"Source Mode\" <> \"Fabric\" then Parse_Sessions()",
                "\t\telse (try FabricTable(\"agent_sessions\") otherwise EmptyTable({\"primary_agent_schema\"})),",
                "\tSchemas = List.Distinct(List.RemoveNulls(List.Transform(",
                "\t\tTable.Column(Sessions, \"primary_agent_schema\"), each if _ = null then null else Text.From(_)))),",
                "\tSchemaKeys = List.Transform(Schemas, each [schema = _, key = NormAgentKey(_)]),",
                "",
                "\tOvr = AgentNameOverrides,",
                "",
                "\tRows = List.Transform(CreditNames, (cname) =>",
                "\t\tlet",
                "\t\t\tovRows = Table.SelectRows(Ovr, each [credit_agent_name] = cname),",
                "\t\t\tovSchema = if Table.RowCount(ovRows) > 0 then ovRows{0}[agent_schema] else null,",
                "\t\t\tckey = NormAgentKey(cname),",
                "\t\t\thits = List.Select(SchemaKeys, (r) => r[key] = ckey),",
                "\t\t\tautoSchema = if List.Count(hits) = 1 then hits{0}[schema] else null,",
                "\t\t\tchosen = if ovSchema <> null then ovSchema else autoSchema,",
                "\t\t\tmtype = if ovSchema <> null then \"Override\"",
                "\t\t\t\t\telse if autoSchema <> null then \"Auto\"",
                "\t\t\t\t\telse \"Unmatched\"",
                "\t\tin",
                "\t\t\t[credit_agent_name = cname, agent_schema = chosen,",
                "\t\t\t match_type = mtype, match_key = ckey]),",
                "",
                "\tT = Table.FromRecords(Rows, type table [",
                "\t\tcredit_agent_name = text, agent_schema = text,",
                "\t\tmatch_type = text, match_key = text])",
                "in",
                "\tT"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Agents Unmatched",
            "expression": "COALESCE ( CALCULATE ( COUNTROWS ( 'Agent Name Map' ), 'Agent Name Map'[match_type] = \"Unmatched\" ), 0 )",
            "formatString": "#,0",
            "displayFolder": "Cost",
            "lineageTag": "ae0anm000-mea0-0001-0001-000000000012"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Group By",
        "description": [
          "Field parameter. Switches the breakdown dimension on every \"by organisation\"",
          "visual, so one chart serves every cut of the org. Add a row to the partition",
          "below and it appears in the Group by slicer on every page.",
          "",
          "The org columns are the canonical names the Chat + Agent Org Data query",
          "normalises arbitrary CSV headers onto (department -> Organization,",
          "UPN / userPrincipalName -> PersonId, and so on), so this list is stable",
          "whatever the customer's export happens to call its columns. Attributes their",
          "export does not carry simply resolve to one blank group."
        ],
        "lineageTag": "ae0grpby0-0001-0001-0001-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Group By",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[Value1]",
            "sortByColumn": "Group By Order",
            "lineageTag": "ae0grpby0-col0-0001-0001-000000000001",
            "summarizeBy": "none",
            "relatedColumnDetails": {
              "groupByColumns": [
                {
                  "groupingColumn": "Group By Fields"
                }
              ]
            },
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Group By Fields",
            "dataType": "string",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[Value2]",
            "sortByColumn": "Group By Order",
            "lineageTag": "ae0grpby0-col0-0001-0001-000000000002",
            "summarizeBy": "none",
            "extendedProperties": [
              {
                "type": "json",
                "name": "ParameterMetadata",
                "value": {
                  "version": 3,
                  "kind": 2
                }
              }
            ],
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "Group By Order",
            "dataType": "int64",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[Value3]",
            "formatString": "0",
            "lineageTag": "ae0grpby0-col0-0001-0001-000000000003",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Group By",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "{",
                "    (\"Agent\", NAMEOF('Agent Name Map'[credit_agent_name]), 0),",
                "    (\"Department\", NAMEOF('Chat + Agent Org Data'[Organization]), 1),",
                "    (\"Job title\", NAMEOF('Chat + Agent Org Data'[JobTitle]), 2),",
                "    (\"Office\", NAMEOF('Chat + Agent Org Data'[officeLocation]), 3),",
                "    (\"Country\", NAMEOF('Chat + Agent Org Data'[country]), 4),",
                "    (\"Usage location\", NAMEOF('Chat + Agent Org Data'[usageLocation]), 5),",
                "    (\"Function\", NAMEOF('Chat + Agent Org Data'[Function]), 6),",
                "    (\"Location\", NAMEOF('Chat + Agent Org Data'[Location]), 7),",
                "    (\"Company\", NAMEOF('Chat + Agent Org Data'[companyName]), 8),",
                "    (\"Topic theme\", NAMEOF('Agent Performance'[Topic Theme]), 9),",
                "    (\"Topic\", NAMEOF('Agent Performance'[Topic (resolved)]), 10),",
                "    (\"Outcome\", NAMEOF('Agent Performance'[Outcome (Detailed)]), 11)",
                "}"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "GroupByParameter"
          }
        ]
      },
      {
