          {
            "type": "calculated",
            "name": "From",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": [
              "Reliable origin signal: turns carrying a user hash came from a person; others are agent/system.",
              "NOTE: the raw turn_role/text mapping is imperfect on some channels (being refined in the parser),",
              "so we surface the hash-based origin which is unambiguous."
            ],
            "expression": [
              "VAR _inf = 'Agent Turns'[role_inferred]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        _inf = \"user\", \"👤 Person\",",
              "        _inf = \"bot\", \"🤖 Agent\",",
              "        NOT(ISBLANK('Agent Turns'[from_user_hash])) && 'Agent Turns'[from_user_hash] <> \"\", \"👤 Person\",",
              "        \"🤖 Agent\"",
              "    )"
            ],
            "lineageTag": "ag0002tu-col0-0001-000000000031",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Message (clean)",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Message text with the most common Copilot Studio markup tokens stripped for readability.",
            "expression": [
              "VAR raw = 'Agent Turns'[text_preview_500]",
              "VAR s1 = SUBSTITUTE(raw, \"<div>\", \"\")",
              "VAR s2 = SUBSTITUTE(s1, \"</div>\", \"\")",
              "VAR s3 = SUBSTITUTE(s2, \"<m-official>\", \"\")",
              "VAR s4 = SUBSTITUTE(s3, \"</m-official>\", \"\")",
              "VAR s5 = SUBSTITUTE(s4, \"<m-faded>\", \"\")",
              "VAR s6 = SUBSTITUTE(s5, \"</m-faded>\", \"\")",
              "VAR s7 = SUBSTITUTE(s6, \"<br>\", \" \")",
              "VAR s8 = SUBSTITUTE(s7, \"<br/>\", \" \")",
              "VAR s9 = SUBSTITUTE(s8, \"**\", \"\")",
              "RETURN TRIM(s9)"
            ],
            "lineageTag": "ag0002tu-col0-0001-000000000032",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Topic",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": [
              "Business topic for the message. Prefers the parser's `topic_derived` (notebook cell 5b) when present;",
              "otherwise falls back to in-model keyword classification of the cleaned text so the page works even",
              "before the enriched parser is re-run. Noise buckets are prefixed 🚫 so they can be excluded."
            ],
            "expression": [
              "VAR parserTopic = 'Agent Turns'[topic_derived]",
              "VAR m = LOWER('Agent Turns'[Message (clean)])",
              "VAR NB = UNICHAR(128683)",
              "VAR fallback =",
              "\tSWITCH(",
              "\t    TRUE(),",
              "\t    ISBLANK(m) || m = \"\", NB & \" Empty\",",
              "\t    LEFT(m, 1) = \"/\", NB & \" Command\",",
              "\t    m IN {\"hi\",\"hey\",\"hello\",\"test\",\"ok\",\"thanks\",\"thank you\",\"yes\",\"no\",\"hiya\"}, NB & \" Greeting\",",
              "\t    CONTAINSSTRING(m, \"something unexpected happened\") || CONTAINSSTRING(m, \"error code\") || CONTAINSSTRING(m, \"systemerror\"), NB & \" Error / System\",",
              "\t    CONTAINSSTRING(m, \"what can you do\") || CONTAINSSTRING(m, \"what this agent can do\") || CONTAINSSTRING(m, \"example of what\") || CONTAINSSTRING(m, \"categories and example\"), NB & \" Capability probe\",",
              "\t    CONTAINSSTRING(m,\"leave\") || CONTAINSSTRING(m,\"holiday\") || CONTAINSSTRING(m,\"vacation\") || CONTAINSSTRING(m,\"time off\") || CONTAINSSTRING(m,\"day off\") || CONTAINSSTRING(m,\"absence\") || CONTAINSSTRING(m,\"sick\") || CONTAINSSTRING(m,\"paternity\") || CONTAINSSTRING(m,\"maternity\") || CONTAINSSTRING(m,\"parental\") || CONTAINSSTRING(m,\"carer\") || CONTAINSSTRING(m,\"compassionate\") || CONTAINSSTRING(m,\"bereavement\") || CONTAINSSTRING(m,\"sabbatical\") || CONTAINSSTRING(m,\"phased return\"), \"Leave & Absence\",",
              "\t    CONTAINSSTRING(m,\"payslip\") || CONTAINSSTRING(m,\"pay slip\") || CONTAINSSTRING(m,\"payroll\") || CONTAINSSTRING(m,\"salary\") || CONTAINSSTRING(m,\"wage\") || CONTAINSSTRING(m,\"pay rise\") || CONTAINSSTRING(m,\"pay review\") || CONTAINSSTRING(m,\"bonus\") || CONTAINSSTRING(m,\"commission\") || CONTAINSSTRING(m,\"overtime\") || CONTAINSSTRING(m,\"expense\") || CONTAINSSTRING(m,\"reimburse\") || CONTAINSSTRING(m,\"allowance\") || CONTAINSSTRING(m,\"tax code\") || CONTAINSSTRING(m,\"p60\") || CONTAINSSTRING(m,\"p45\"), \"Pay & Payroll\",",
              "\t    CONTAINSSTRING(m,\"benefit\") || CONTAINSSTRING(m,\"pension\") || CONTAINSSTRING(m,\"retirement\") || CONTAINSSTRING(m,\"insurance\") || CONTAINSSTRING(m,\"healthcare\") || CONTAINSSTRING(m,\"dental\") || CONTAINSSTRING(m,\"perk\") || CONTAINSSTRING(m,\"discount\") || CONTAINSSTRING(m,\"cycle to work\") || CONTAINSSTRING(m,\"share scheme\") || CONTAINSSTRING(m,\"wellbeing\") || CONTAINSSTRING(m,\"well-being\") || CONTAINSSTRING(m,\"childcare\"), \"Benefits & Pension\",",
              "\t    CONTAINSSTRING(m,\"recruit\") || CONTAINSSTRING(m,\"hiring\") || CONTAINSSTRING(m,\"interview\") || CONTAINSSTRING(m,\"candidate\") || CONTAINSSTRING(m,\"vacancy\") || CONTAINSSTRING(m,\"job role\") || CONTAINSSTRING(m,\"job description\") || CONTAINSSTRING(m,\"applicant\") || CONTAINSSTRING(m,\"offer letter\") || CONTAINSSTRING(m,\"referral\") || CONTAINSSTRING(m,\"secondment\"), \"Recruitment & Hiring\",",
              "\t    CONTAINSSTRING(m,\"onboard\") || CONTAINSSTRING(m,\"new joiner\") || CONTAINSSTRING(m,\"new starter\") || CONTAINSSTRING(m,\"induction\") || CONTAINSSTRING(m,\"starter\") || CONTAINSSTRING(m,\"first day\") || CONTAINSSTRING(m,\"probation\") || CONTAINSSTRING(m,\"employment letter\") || CONTAINSSTRING(m,\"right to work\"), \"Onboarding & Joiner\",",
              "\t    CONTAINSSTRING(m,\"password\") || CONTAINSSTRING(m,\"login\") || CONTAINSSTRING(m,\"log in\") || CONTAINSSTRING(m,\"sign in\") || CONTAINSSTRING(m,\"log on\") || CONTAINSSTRING(m,\"access\") || CONTAINSSTRING(m,\"permission\") || CONTAINSSTRING(m,\"mfa\") || CONTAINSSTRING(m,\"2fa\") || CONTAINSSTRING(m,\"authenticator\") || CONTAINSSTRING(m,\"vpn\") || CONTAINSSTRING(m,\"reset\") || CONTAINSSTRING(m,\"unlock\") || CONTAINSSTRING(m,\"locked out\") || CONTAINSSTRING(m,\"email\") || CONTAINSSTRING(m,\"mailbox\") || CONTAINSSTRING(m,\"network\") || CONTAINSSTRING(m,\"wifi\") || CONTAINSSTRING(m,\"wi-fi\") || CONTAINSSTRING(m,\"device\") || CONTAINSSTRING(m,\"laptop\") || CONTAINSSTRING(m,\"printer\") || CONTAINSSTRING(m,\"service desk\") || CONTAINSSTRING(m,\"help desk\") || CONTAINSSTRING(m,\"helpdesk\") || CONTAINSSTRING(m,\"ticket\") || CONTAINSSTRING(m,\"incident\") || CONTAINSSTRING(m,\"outage\"), \"IT, Access & Devices\",",
              "\t    CONTAINSSTRING(m,\"software\") || CONTAINSSTRING(m,\"application\") || CONTAINSSTRING(m,\"install\") || CONTAINSSTRING(m,\"licen\") || CONTAINSSTRING(m,\"subscription\") || CONTAINSSTRING(m,\"upgrade\") || CONTAINSSTRING(m,\"excel\") || CONTAINSSTRING(m,\"word\") || CONTAINSSTRING(m,\"powerpoint\") || CONTAINSSTRING(m,\"teams\") || CONTAINSSTRING(m,\"sharepoint\") || CONTAINSSTRING(m,\"onedrive\") || CONTAINSSTRING(m,\"power bi\") || CONTAINSSTRING(m,\"sap\") || CONTAINSSTRING(m,\"salesforce\"), \"Software & Applications\",",
              "\t    CONTAINSSTRING(m,\"policy\") || CONTAINSSTRING(m,\"policies\") || CONTAINSSTRING(m,\"procedure\") || CONTAINSSTRING(m,\"code of conduct\") || CONTAINSSTRING(m,\"compliance\") || CONTAINSSTRING(m,\"regulation\") || CONTAINSSTRING(m,\"contract\") || CONTAINSSTRING(m,\"terms and condition\") || CONTAINSSTRING(m,\"gdpr\") || CONTAINSSTRING(m,\"data protection\") || CONTAINSSTRING(m,\"legal\") || CONTAINSSTRING(m,\"audit\") || CONTAINSSTRING(m,\"governance\") || CONTAINSSTRING(m,\"notice period\") || CONTAINSSTRING(m,\"redundan\") || CONTAINSSTRING(m,\"disciplinary\") || CONTAINSSTRING(m,\"grievance\") || CONTAINSSTRING(m,\"medical retirement\") || CONTAINSSTRING(m,\"flexible working\") || CONTAINSSTRING(m,\"working from home\") || CONTAINSSTRING(m,\"hybrid\"), \"Policy, Contracts & Compliance\",",
              "\t    CONTAINSSTRING(m,\"office\") || CONTAINSSTRING(m,\"building\") || CONTAINSSTRING(m,\"desk\") || CONTAINSSTRING(m,\"parking\") || CONTAINSSTRING(m,\"car park\") || CONTAINSSTRING(m,\"meeting room\") || CONTAINSSTRING(m,\"facilities\") || CONTAINSSTRING(m,\"attendance\") || CONTAINSSTRING(m,\"badge\") || CONTAINSSTRING(m,\"access card\") || CONTAINSSTRING(m,\"id card\") || CONTAINSSTRING(m,\"canteen\") || CONTAINSSTRING(m,\"maintenance\") || CONTAINSSTRING(m,\"health and safety\") || CONTAINSSTRING(m,\"first aid\") || CONTAINSSTRING(m,\"reception\"), \"Facilities & Workplace\",",
              "\t    CONTAINSSTRING(m,\"who is\") || CONTAINSSTRING(m,\"who's\") || CONTAINSSTRING(m,\"contact details\") || CONTAINSSTRING(m,\"directory\") || CONTAINSSTRING(m,\"org chart\") || CONTAINSSTRING(m,\"organisation chart\") || CONTAINSSTRING(m,\"organization chart\") || CONTAINSSTRING(m,\"reporting line\") || CONTAINSSTRING(m,\"line manager\") || CONTAINSSTRING(m,\"phone number\") || CONTAINSSTRING(m,\"email address\") || CONTAINSSTRING(m,\"find someone\"), \"People & Directory\",",
              "\t    CONTAINSSTRING(m,\"customer\") || CONTAINSSTRING(m,\"client\") || CONTAINSSTRING(m,\"sales\") || CONTAINSSTRING(m,\"invoice\") || CONTAINSSTRING(m,\"billing\") || CONTAINSSTRING(m,\"account manager\") || CONTAINSSTRING(m,\"crm\") || CONTAINSSTRING(m,\"quote\") || CONTAINSSTRING(m,\"opportunity\") || CONTAINSSTRING(m,\"complaint\") || CONTAINSSTRING(m,\"refund\") || CONTAINSSTRING(m,\"delivery\") || CONTAINSSTRING(m,\"tariff\"), \"Customer, Sales & Orders\",",
              "\t    CONTAINSSTRING(m,\"purchase\") || CONTAINSSTRING(m,\"procurement\") || CONTAINSSTRING(m,\"supplier\") || CONTAINSSTRING(m,\"vendor\") || CONTAINSSTRING(m,\"budget\") || CONTAINSSTRING(m,\"finance\") || CONTAINSSTRING(m,\"cost centre\") || CONTAINSSTRING(m,\"cost center\") || CONTAINSSTRING(m,\"purchase order\") || CONTAINSSTRING(m,\"expense claim\") || CONTAINSSTRING(m,\"forecast\"), \"Finance & Procurement\",",
              "\t    CONTAINSSTRING(m,\"report\") || CONTAINSSTRING(m,\"dashboard\") || CONTAINSSTRING(m,\"metric\") || CONTAINSSTRING(m,\"kpi\") || CONTAINSSTRING(m,\"analytics\") || CONTAINSSTRING(m,\"figures\") || CONTAINSSTRING(m,\"statistics\") || CONTAINSSTRING(m,\"export\"), \"Data, Reporting & Analytics\",",
              "\t    CONTAINSSTRING(m,\"api\") || CONTAINSSTRING(m,\"deployment\") || CONTAINSSTRING(m,\"server\") || CONTAINSSTRING(m,\"database\") || CONTAINSSTRING(m,\"integration\") || CONTAINSSTRING(m,\"configuration\") || CONTAINSSTRING(m,\"fibre\") || CONTAINSSTRING(m,\"ethernet\") || CONTAINSSTRING(m,\"cable\") || CONTAINSSTRING(m,\"broadband\") || CONTAINSSTRING(m,\"connectivity\") || CONTAINSSTRING(m,\"engineering\"), \"Technical & Engineering\",",
              "\t    \"Other\"",
              "\t)",
              "RETURN IF ( NOT ( ISBLANK ( parserTopic ) ) && parserTopic <> \"\", parserTopic, fallback )"
            ],
            "lineageTag": "ag0002tu-col0-0001-000000000033",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Response Seconds",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "VAR conv = 'Agent Turns'[conversation_id]",
              "VAR ts = 'Agent Turns'[turn_timestamp_utc]",
              "VAR prevUser =",
              "    CALCULATE (",
              "        MAX ( 'Agent Turns'[turn_timestamp_utc] ),",
              "        ALLEXCEPT ( 'Agent Turns', 'Agent Turns'[conversation_id] ),",
              "        'Agent Turns'[turn_role] = \"user\",",
              "        'Agent Turns'[turn_timestamp_utc] < ts",
              "    )",
              "RETURN",
              "    IF (",
              "        'Agent Turns'[turn_role] = \"bot\" && NOT ISBLANK ( prevUser ),",
              "        DATEDIFF ( prevUser, ts, SECOND )",
              "    )"
            ],
            "formatString": "#,0.0",
            "lineageTag": "ae0turns0resp-0001-0000-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Agent Turns",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Promoted = if #\"Source Mode\" <> \"Fabric\" then Parse_Turns() else if true then (try FabricTable(\"agent_turns\") otherwise EmptyTable({\"conversation_id\", \"turn_id\", \"turn_timestamp_utc\", \"turn_role\", \"turn_channel\", \"from_user_hash\", \"text_preview_500\", \"text_length\", \"intent_title\", \"intent_id\", \"intent_score\", \"knowledge_searched\", \"knowledge_answered\", \"knowledge_sources\", \"feedback_offered\", \"feedback_verdict\", \"feedback_comment\"})) else EmptyTable({\"conversation_id\", \"turn_id\", \"turn_timestamp_utc\", \"turn_role\", \"turn_channel\", \"from_user_hash\", \"text_preview_500\", \"text_length\", \"intent_title\", \"intent_id\", \"intent_score\", \"knowledge_searched\", \"knowledge_answered\", \"knowledge_sources\", \"feedback_offered\", \"feedback_verdict\", \"feedback_comment\"}),",
                "    // Null-safe: add the enrichment columns when the parser (cell 5b) hasn't produced them yet,",
                "    // so the model loads cleanly before the notebook is re-run, then lights up automatically after.",
                "    Ensured = List.Accumulate({\"topic_derived\", \"role_inferred\", \"role_mismatch\"}, Promoted, (st, c) => if List.Contains(Table.ColumnNames(st), c) then st else Table.AddColumn(st, c, each null, type text)),",
                "    Typed = Table.TransformColumnTypes(Ensured, {",
                "        {\"conversation_id\", type text},",
                "        {\"turn_id\", type text},",
                "        {\"turn_timestamp_utc\", type datetime},",
                "        {\"turn_role\", type text},",
                "        {\"turn_channel\", type text},",
                "        {\"from_user_hash\", type text},",
                "        {\"text_preview_500\", type text},",
                "        {\"text_length\", Int64.Type},",
                "        {\"intent_title\", type text},",
                "        {\"intent_id\", type text},",
                "        {\"intent_score\", type number},",
                "        {\"knowledge_searched\", type logical},",
                "        {\"knowledge_answered\", type logical},",
                "        {\"knowledge_sources\", type text},",
                "        {\"feedback_offered\", type logical},",
                "        {\"feedback_verdict\", type text},",
                "        {\"feedback_comment\", type text},",
                "        {\"topic_derived\", type text},",
                "        {\"role_inferred\", type text},",
                "        {\"role_mismatch\", type text}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Turns",
            "description": "Total messages (user + bot) across all sessions in scope.",
            "expression": "COUNTROWS('Agent Turns')",
            "formatString": "#,0",
            "displayFolder": "📚 Prompt Quality",
            "lineageTag": "ag0002tu-meas-0001-000000000001"
          },
          {
            "name": "Avg Prompt Length (chars)",
            "description": "Average user prompt length (characters).",
            "expression": "CALCULATE(AVERAGE('Agent Turns'[text_length]), 'Agent Turns'[turn_role] = \"user\")",
            "formatString": "#,0",
            "displayFolder": "📚 Prompt Quality",
            "lineageTag": "ag0002tu-meas-0001-000000000003"
          },
          {
            "name": "Multi-Turn Conversations",
            "description": "Conversations that have more than one captured turn (a genuine back-and-forth).",
            "expression": [
              "VAR perConvo = ADDCOLUMNS(VALUES('Agent Turns'[conversation_id]), \"@t\", CALCULATE(COUNTROWS('Agent Turns')))",
              "RETURN COUNTROWS(FILTER(perConvo, [@t] > 1))"
            ],
            "formatString": "#,0",
            "displayFolder": "💬 Transcript",
            "lineageTag": "ag0002tu-meas-0001-000000000020"
          },
          {
            "name": "Conversations with Agent Reply",
            "description": "Conversations where at least one agent-side (no user hash) turn was captured.",
            "expression": "CALCULATE(DISTINCTCOUNT('Agent Turns'[conversation_id]), ISBLANK('Agent Turns'[from_user_hash]) || 'Agent Turns'[from_user_hash] = \"\")",
            "formatString": "#,0",
            "displayFolder": "💬 Transcript",
            "lineageTag": "ag0002tu-meas-0001-000000000021"
          },
          {
            "name": "Conversations Captured",
            "description": "Conversations that have at least one captured turn.",
            "expression": "DISTINCTCOUNT('Agent Turns'[conversation_id])",
            "formatString": "#,0",
            "displayFolder": "💬 Transcript",
            "lineageTag": "ag0002tu-meas-0001-000000000022"
          },
          {
            "name": "Distinct Topics",
            "description": "Distinct business topics seen (excluding 🚫 noise buckets) in the current filter.",
            "expression": "CALCULATE(DISTINCTCOUNT('Agent Turns'[Topic]), NOT(CONTAINSSTRING('Agent Turns'[Topic], UNICHAR(128683))))",
            "formatString": "#,0",
            "displayFolder": "🗂 Topics (Transcript)",
            "lineageTag": "ag0002tu-meas-0001-000000000030"
          },
          {
            "name": "Turn Thumbs Up",
            "description": "Turn-level thumbs-up reactions (transcript-native). Slices by topic_derived, so it powers CSAT-by-topic.",
            "expression": "CALCULATE ( COUNTROWS ( 'Agent Turns' ), 'Agent Turns'[feedback_verdict] = \"Positive\" )",
            "formatString": "#,0",
            "displayFolder": "😊 CSAT (Transcript)",
            "lineageTag": "ag0002tu-meas-0001-000000000040"
          },
          {
            "name": "Turn Thumbs Down",
            "description": "Turn-level thumbs-down reactions (transcript-native).",
            "expression": "CALCULATE ( COUNTROWS ( 'Agent Turns' ), 'Agent Turns'[feedback_verdict] = \"Negative\" )",
            "formatString": "#,0",
            "displayFolder": "😊 CSAT (Transcript)",
            "lineageTag": "ag0002tu-meas-0001-000000000041"
          },
          {
            "name": "Turn CSAT %",
            "description": "Transcript CSAT % = thumbs-up / (up + down) at turn grain. Connects CSAT to topic and agent. Blank until the export carries reactions.",
            "expression": [
              "DIVIDE (",
              "    [Turn Thumbs Up],",
              "    [Turn Thumbs Up] + [Turn Thumbs Down]",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "😊 CSAT (Transcript)",
            "lineageTag": "ag0002tu-meas-0001-000000000043"
          },
          {
            "name": "😊 CSAT Story (Live)",
            "description": "Dynamic CSAT headline. Degrades gracefully when no reactions are present in scope.",
            "expression": [
              "VAR _up = [Turn Thumbs Up]",
              "VAR _dn = [Turn Thumbs Down]",
              "VAR _tot = _up + _dn",
              "VAR _csat = DIVIDE ( _up, _tot )",
              "RETURN",
              "    IF (",
              "        _tot = 0,",
              "        \"No thumbs reactions in the current selection. CSAT lights up when the transcript export carries user reactions (feedback_verdict).\",",
              "        \"Users gave \" & _tot & \" reaction(s): \" & FORMAT ( _csat, \"0%\" ) & \" positive (\" & _up & \" 👍 / \" & _dn & \" 👎).\"",
              "    )"
            ],
            "displayFolder": "😊 CSAT (Transcript)",
            "lineageTag": "ag0002tu-meas-0001-000000000044"
          },
          {
            "name": "Turns Offered Feedback",
            "description": "Turns where the agent OFFERED a feedback prompt (transcript-native). Denominator for turn-level submission rate.",
            "expression": "CALCULATE ( COUNTROWS ( 'Agent Turns' ), 'Agent Turns'[feedback_offered] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "😊 CSAT (Transcript)",
            "lineageTag": "ag0002tu-meas-0001-000000000047"
          },
          {
            "name": "Avg Response Time (sec)",
            "description": [
              "Seconds between a user's message and the agent's reply.",
              "Derived from turn timestamps - the wait the user actually experienced."
            ],
            "expression": "AVERAGE ( 'Agent Turns'[Response Seconds] )",
            "formatString": "#,0.0",
            "displayFolder": "Response time",
            "lineageTag": "ae0m0resp0avg-0001-0000-0000-000000000091"
          },
          {
            "name": "Median Response Time (sec)",
            "description": "Median is the fairer headline - a handful of very slow replies drag the mean.",
            "expression": "MEDIAN ( 'Agent Turns'[Response Seconds] )",
            "formatString": "#,0.0",
            "displayFolder": "Response time",
            "lineageTag": "ae0m0resp0med-0001-0000-0000-000000000092"
          },
          {
            "name": "Replies Over 10s %",
            "description": [
              "Share of replies that kept the user waiting more than ten seconds -",
              "the point at which people typically start to disengage."
            ],
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( 'Agent Turns' ), 'Agent Turns'[Response Seconds] > 10 ),",
              "    CALCULATE ( COUNTROWS ( 'Agent Turns' ), NOT ISBLANK ( 'Agent Turns'[Response Seconds] ) ),",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "Response time",
            "lineageTag": "ae0m0resp0slow-001-0000-0000-000000000094"
          },
          {
            "name": "◆ Response Read",
            "description": "Median plus a plain-English band, and a flag when the tail is long.",
            "expression": [
              "VAR med = [Median Response Time (sec)]",
              "VAR slow = [Replies Over 10s %]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( med ),",
              "        \"No reply timings captured.\",",
              "        FORMAT ( med, \"0.0\" ) & \"s typical · \"",
              "            & SWITCH ( TRUE (),",
              "                med <= 2, \"Instant\",",
              "                med <= 5, \"Comfortable\",",
              "                med <= 10, \"Noticeable\",",
              "                \"Too slow\" )",
              "            & IF ( slow > 0.1, \" · \" & FORMAT ( slow, \"0%\" ) & \" over 10s\", \"\" )",
              "    )"
            ],
            "displayFolder": "Response time",
            "lineageTag": "ae0m0resp0read-001-0000-0000-000000000095"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Agent Errors",
