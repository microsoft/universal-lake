          {
            "type": "calculated",
            "name": "Conversation Intent",
            "dataType": "string",
            "isDataTypeInferred": true,
            "description": "Concatenated NLU intent titles recognised across this conversation's turns (from Agent Turns). A stronger, structured classification signal than raw message text. Blank when no intents were logged.",
            "expression": [
              "VAR _cid = 'Agent Performance'[ConversationTranscriptId]",
              "RETURN",
              "    CONCATENATEX(",
              "        FILTER(",
              "            ALL('Agent Turns'),",
              "            'Agent Turns'[conversation_id] = _cid && NOT ISBLANK('Agent Turns'[intent_title])",
              "        ),",
              "        'Agent Turns'[intent_title], \" | \"",
              "    )"
            ],
            "lineageTag": "ap0topic-col0-0001-000000000010",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Escalation Type",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "VAR msg = LOWER ( COALESCE ( 'Agent Performance'[LastUserMessage], \"\" ) )",
              "VAR askedForHuman =",
              "    CONTAINSSTRING ( msg, \"human\" )",
              "        || CONTAINSSTRING ( msg, \"real person\" )",
              "        || CONTAINSSTRING ( msg, \"representative\" )",
              "        || CONTAINSSTRING ( msg, \"speak to someone\" )",
              "        || CONTAINSSTRING ( msg, \"talk to someone\" )",
              "        || CONTAINSSTRING ( msg, \"speak to a person\" )",
              "        || CONTAINSSTRING ( msg, \"live agent\" )",
              "        || CONTAINSSTRING ( msg, \"transfer me\" )",
              "        || CONTAINSSTRING ( msg, \"escalate\" )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        'Agent Performance'[SessionOutcome] <> \"Escalated\", \"Not escalated\",",
              "        'Agent Performance'[OutcomeReason] = \"SystemError\", \"System - Unintended\",",
              "        askedForHuman, \"User Requested\",",
              "        \"System - Intended\"",
              "    )"
            ],
            "lineageTag": "ae0esc0type-0001-0000-0000-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Outcome (Detailed)",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    'Agent Performance'[SessionType] = \"Unengaged\", \"Unengaged\",",
              "    'Agent Performance'[SessionOutcome] = \"Escalated\",",
              "        \"Escalated - \" & SUBSTITUTE ( 'Agent Performance'[Escalation Type], \"System - \", \"\" ),",
              "    'Agent Performance'[SessionOutcome] = \"Abandoned\", \"Abandoned\",",
              "    \"Resolved\"",
              ")"
            ],
            "lineageTag": "ae0out0detail-001-0000-0000-000000000002",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Agent Performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // CT-derived agent performance, produced by the transcript parser",
                "    // (parse_copilot_transcripts.py / Copilot_Agent_Transcript_Parser.ipynb)",
                "    // alongside agent_sessions.csv etc. in the same Lakehouse folder.",
                "    PromotedHeaders = if #\"Source Mode\" <> \"Fabric\" then Parse_Performance() else if true then (try FabricTable(\"agent_performance\") otherwise EmptyTable({\"ConversationTranscriptId\", \"ConversationStartTime\", \"SchemaVersion\", \"BotName\", \"BotId\", \"AADTenantId\", \"BatchId\", \"SessionStartTimeUtc\", \"SessionEndTimeUtc\", \"SessionType\", \"SessionOutcome\", \"TurnCount\", \"OutcomeReason\", \"ImpliedSuccess\", \"LastUserIntentId\", \"IsDesignMode\", \"Locale\", \"UserMessageCount\", \"BotMessageCount\", \"TotalMessageCount\", \"FirstUserMessage\", \"LastUserMessage\", \"FirstBotMessage\", \"LastBotMessage\", \"TopicsTriggered\", \"TopicCount\", \"PrimaryTopic\", \"DurationSeconds\", \"AverageLatencyMs\", \"Var_ESS_UserContext_UPN\", \"Var_ESS_Message_Disclaimer\", \"Var_ESS_UserContext_RefreshInterval_Hours\", \"Var_ESS_UserContext_Conversation_Initialized\", \"AllVariables\", \"TotalActivityCount\", \"TraceActivityCount\", \"EventActivityCount\", \"StatusCode\", \"StateCode\"})) else EmptyTable({\"ConversationTranscriptId\", \"ConversationStartTime\", \"SchemaVersion\", \"BotName\", \"BotId\", \"AADTenantId\", \"BatchId\", \"SessionStartTimeUtc\", \"SessionEndTimeUtc\", \"SessionType\", \"SessionOutcome\", \"TurnCount\", \"OutcomeReason\", \"ImpliedSuccess\", \"LastUserIntentId\", \"IsDesignMode\", \"Locale\", \"UserMessageCount\", \"BotMessageCount\", \"TotalMessageCount\", \"FirstUserMessage\", \"LastUserMessage\", \"FirstBotMessage\", \"LastBotMessage\", \"TopicsTriggered\", \"TopicCount\", \"PrimaryTopic\", \"DurationSeconds\", \"AverageLatencyMs\", \"Var_ESS_UserContext_UPN\", \"Var_ESS_Message_Disclaimer\", \"Var_ESS_UserContext_RefreshInterval_Hours\", \"Var_ESS_UserContext_Conversation_Initialized\", \"AllVariables\", \"TotalActivityCount\", \"TraceActivityCount\", \"EventActivityCount\", \"StatusCode\", \"StateCode\"}),",
                "    ChangedTypes = Table.TransformColumnTypes(",
                "        PromotedHeaders,",
                "        {",
                "            {\"TurnCount\", Int64.Type},",
                "            {\"UserMessageCount\", Int64.Type},",
                "            {\"BotMessageCount\", Int64.Type},",
                "            {\"TotalMessageCount\", Int64.Type},",
                "            {\"TopicCount\", Int64.Type},",
                "            {\"DurationSeconds\", Int64.Type},",
                "            {\"AverageLatencyMs\", Int64.Type},",
                "            {\"TotalActivityCount\", Int64.Type},",
                "            {\"TraceActivityCount\", Int64.Type},",
                "            {\"EventActivityCount\", Int64.Type},",
                "            {\"StatusCode\", Int64.Type},",
                "            {\"StateCode\", Int64.Type}",
                "        }",
                "    ),",
                "    // Tolerant typing for enrichment metrics (text -> number). List.Select keeps only",
                "    // columns that exist, so it is safe when \"Include\"='Exclude'.",
                "    TypedEnrichment = Table.TransformColumns(",
                "        ChangedTypes,",
                "        List.Select(",
                "            {",
                "                {\"TopicsStarted\", each try Int64.From(_) otherwise null, Int64.Type},",
                "                {\"TopicsCompleted\", each try Int64.From(_) otherwise null, Int64.Type},",
                "                {\"TopicCompletionRate\", each try Number.From(_) otherwise null, type number},",
                "                {\"PrimaryTopicDwellMs\", each try Int64.From(_) otherwise null, Int64.Type},",
                "                {\"TotalTopicDwellMs\", each try Int64.From(_) otherwise null, Int64.Type},",
                "                {\"LLMCallCount\", each try Int64.From(_) otherwise null, Int64.Type},",
                "                {\"PromptTokenCount\", each try Int64.From(_) otherwise null, Int64.Type},",
                "                {\"CompletionTokenCount\", each try Int64.From(_) otherwise null, Int64.Type},",
                "                {\"TotalTokenCount\", each try Int64.From(_) otherwise null, Int64.Type},",
                "                {\"PluginCallCount\", each try Int64.From(_) otherwise null, Int64.Type},",
                "                {\"PluginSuccessCount\", each try Int64.From(_) otherwise null, Int64.Type},",
                "                {\"GenerativeResponseCount\", each try Int64.From(_) otherwise null, Int64.Type}",
                "            },",
                "            each Table.HasColumns(ChangedTypes, _{0})",
                "        )",
                "    ),",
                "    FixedSessionStartTimeUtc = Table.TransformColumns(",
                "        TypedEnrichment,",
                "        {{\"SessionStartTimeUtc\", each try DateTime.From(_) otherwise null, type nullable datetime}}",
                "    ),",
                "    AddedInteractionDate = Table.AddColumn(",
                "        FixedSessionStartTimeUtc,",
                "        \"InteractionDate\",",
                "        each if [SessionStartTimeUtc] <> null then Date.From([SessionStartTimeUtc]) else null,",
                "        type nullable date",
                "    ),",
                "    AddedWeekStart = Table.AddColumn(",
                "        AddedInteractionDate,",
                "        \"weekstart\",",
                "        each if [InteractionDate] <> null then Date.ToText(Date.StartOfWeek([InteractionDate]), \"MM/dd/yyyy\") else null,",
                "        type nullable text",
                "    )",
                "in",
                "    AddedWeekStart"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Conversations",
            "expression": "COUNTROWS('Agent Performance')",
            "formatString": "#,0",
            "displayFolder": "Agent KPIs",
            "lineageTag": "e4a91aa9-b95f-494b-8538-ec1515db44e5"
          },
          {
            "name": "Abandonment Rate",
            "expression": [
              "DIVIDE(",
              "    CALCULATE(",
              "        COUNTROWS('Agent Performance'),",
              "        'Agent Performance'[SessionOutcome] = \"Abandoned\"",
              "    ),",
              "    COUNTROWS('Agent Performance'),",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "Agent KPIs",
            "lineageTag": "2464f6a3-c461-42bc-94cd-f5f828635fee"
          },
          {
            "name": "Resolution Rate",
            "expression": [
              "DIVIDE(",
              "    CALCULATE(",
              "        COUNTROWS('Agent Performance'),",
              "        'Agent Performance'[SessionOutcome] = \"Resolved\"",
              "    ),",
              "    COUNTROWS('Agent Performance'),",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "Agent KPIs",
            "lineageTag": "e49bd491-1a0a-4114-9b19-22c4e5bb18f2"
          },
          {
            "name": "Unique Users",
            "expression": "DISTINCTCOUNT('Agent Performance'[Var_ESS_UserContext_UPN])",
            "formatString": "#,0",
            "displayFolder": "Agent KPIs",
            "lineageTag": "64c70052-af52-498e-a35f-ddca55f4940a"
          },
          {
            "name": "Implied Success %",
            "description": [
              "% of conversations the orchestrator flagged as impliedSuccess=TRUE. The reliable",
              "proxy-satisfaction signal when explicit thumbs are too sparse for a CSAT."
            ],
            "expression": [
              "DIVIDE(",
              "    CALCULATE(",
              "        COUNTROWS('Agent Performance'),",
              "        FILTER('Agent Performance', UPPER('Agent Performance'[ImpliedSuccess] & \"\") = \"TRUE\")",
              "    ),",
              "    COUNTROWS('Agent Performance'),",
              "    0",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Agent KPIs",
            "lineageTag": "e49bd491-1a0a-4114-9b19-22c4e5bb1900"
          },
          {
            "name": "Avg Bot Response Time",
            "expression": "AVERAGE('Agent Performance'[AverageLatencyMs])",
            "formatString": "#,0 \"ms\"",
            "displayFolder": "Agent Performance",
            "lineageTag": "9de05fa2-9b96-4379-be5d-fd41280196a7"
          },
          {
            "name": "Escalation Rate",
            "expression": [
              "DIVIDE(",
              "    CALCULATE(",
              "        COUNTROWS('Agent Performance'),",
              "        'Agent Performance'[SessionOutcome] = \"Escalated\"",
              "    ),",
              "    COUNTROWS('Agent Performance'),",
              "    0",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "Agent KPIs",
            "lineageTag": "e484b66c-978b-42ed-8f63-71488721da77"
          },
          {
            "name": "Avg Turns to Resolve",
            "description": "Avg turns needed to resolve — lower = better prompt clarity",
            "expression": [
              "CALCULATE(",
              "    AVERAGE('Agent Performance'[TurnCount]),",
              "    'Agent Performance'[SessionOutcome] = \"Resolved\"",
              ")"
            ],
            "formatString": "0.0",
            "displayFolder": "🧠 Prompt Quality",
            "lineageTag": "b1c2d3e4-0001-0001-0003-000000000001"
          },
          {
            "name": "Avg Prompt Quality Score",
            "description": "Avg Prompt Quality Score across current filter context (0–100)",
            "expression": "AVERAGE('Agent Performance'[PromptQualityScore])",
            "formatString": "0.0",
            "displayFolder": "🧠 Prompt Quality",
            "lineageTag": "b1c2d3e4-0001-0001-0001-000000000001"
          },
          {
            "name": "🧠 Agent Prompt Quality Insight",
            "description": "Dynamic narrative: how prompt characteristics correlate with session outcomes",
            "expression": [
              "VAR EngagedCount = CALCULATE(COUNTROWS('Agent Performance'), 'Agent Performance'[SessionType] = \"Engaged\")",
              "VAR ResolvedCount = CALCULATE(COUNTROWS('Agent Performance'), 'Agent Performance'[SessionOutcome] = \"Resolved\")",
              "VAR AbandonedCount = CALCULATE(COUNTROWS('Agent Performance'), 'Agent Performance'[SessionOutcome] = \"Abandoned\")",
              "VAR AvgScore = [Avg Prompt Quality Score]",
              "",
              "// Prompt length analysis",
              "VAR AvgLenResolved = CALCULATE(AVERAGE('Agent Performance'[PromptLength]), 'Agent Performance'[SessionOutcome] = \"Resolved\")",
              "VAR AvgLenAbandoned = CALCULATE(AVERAGE('Agent Performance'[PromptLength]), 'Agent Performance'[SessionOutcome] = \"Abandoned\")",
              "",
              "// Turn efficiency",
              "VAR AvgTurnsResolved = CALCULATE(AVERAGE('Agent Performance'[TurnCount]), 'Agent Performance'[SessionOutcome] = \"Resolved\")",
              "VAR AvgTurnsAbandoned = CALCULATE(AVERAGE('Agent Performance'[TurnCount]), 'Agent Performance'[SessionOutcome] = \"Abandoned\")",
              "",
              "// Quick resolution rate (resolved in ≤ 3 turns)",
              "VAR QuickResolve = CALCULATE(COUNTROWS('Agent Performance'), 'Agent Performance'[SessionOutcome] = \"Resolved\", 'Agent Performance'[TurnCount] <= 3)",
              "VAR QuickResolvePct = DIVIDE(QuickResolve, ResolvedCount, 0)",
              "",
              "// Score line",
              "VAR ScoreLine = \"Avg score: \" & FORMAT(AvgScore, \"0.0\") & \"/100 across \" & FORMAT(EngagedCount, \"#,0\") & \" engaged sessions.\"",
              "",
              "// Prompt length insight",
              "VAR LengthLine =",
              "    IF(NOT ISBLANK(AvgLenResolved) && NOT ISBLANK(AvgLenAbandoned),",
              "        IF(AvgLenResolved > AvgLenAbandoned * 1.15,",
              "            \" Resolved prompts avg \" & FORMAT(AvgLenResolved, \"#,0\") & \" chars vs \" & FORMAT(AvgLenAbandoned, \"#,0\") & \" for abandoned — more detail helps.\",",
              "            IF(AvgLenAbandoned > AvgLenResolved * 1.15,",
              "                \" Abandoned prompts are longer (avg \" & FORMAT(AvgLenAbandoned, \"#,0\") & \" chars) — complex queries may exceed agent capability.\",",
              "                \" Prompt length similar across outcomes (~\" & FORMAT(AvgLenResolved, \"#,0\") & \" chars).\"",
              "            )",
              "        ),",
              "        \"\"",
              "    )",
              "",
              "// Turn insight",
              "VAR TurnLine =",
              "    IF(NOT ISBLANK(AvgTurnsResolved),",
              "        \" Resolved sessions avg \" & FORMAT(AvgTurnsResolved, \"0.0\") & \" turns\" &",
              "        IF(NOT ISBLANK(AvgTurnsAbandoned),",
              "            \" vs \" & FORMAT(AvgTurnsAbandoned, \"0.0\") & \" for abandoned.\", \".\"),",
              "        \"\"",
              "    )",
              "",
              "// Quick resolution insight",
              "VAR QuickLine =",
              "    IF(ResolvedCount > 0,",
              "        \" \" & FORMAT(QuickResolvePct, \"0%\") & \" of resolutions happened within 3 turns.\",",
              "        \"\"",
              "    )",
              "",
              "RETURN",
              "IF(EngagedCount = 0, \"No engaged sessions in current selection.\",",
              "    ScoreLine & LengthLine & TurnLine & QuickLine",
              ")"
            ],
            "displayFolder": "🧠 Prompt Quality",
            "lineageTag": "b1c2d3e4-0001-0001-0004-000000000001"
          },
          {
            "name": "🧠 Prompt Quality by Type",
            "description": "Prompt quality broken down by conversation type — shows which categories have best/worst quality",
            "expression": [
              "VAR TypeStats =",
              "    ADDCOLUMNS(",
              "        FILTER(VALUES('Agent Performance'[ConversationType]), [ConversationType] <> \"🚫 Unengaged\"),",
              "        \"AvgScore\", CALCULATE(AVERAGE('Agent Performance'[PromptQualityScore])),",
              "        \"Total\", CALCULATE(COUNTROWS('Agent Performance')),",
              "        \"ResRate\", DIVIDE(",
              "            CALCULATE(COUNTROWS('Agent Performance'), 'Agent Performance'[SessionOutcome] = \"Resolved\"),",
              "            CALCULATE(COUNTROWS('Agent Performance')), 0)",
              "    )",
              "VAR BestType = TOPN(1, FILTER(TypeStats, [Total] >= 2), [AvgScore], DESC)",
              "VAR WorstType = TOPN(1, FILTER(TypeStats, [Total] >= 2), [AvgScore], ASC)",
              "VAR BestName = MAXX(BestType, [ConversationType])",
              "VAR BestScore = MAXX(BestType, [AvgScore])",
              "VAR WorstName = MAXX(WorstType, [ConversationType])",
              "VAR WorstScore = MAXX(WorstType, [AvgScore])",
              "RETURN",
              "IF(COUNTROWS(TypeStats) = 0, \"No data.\",",
              "    \"Best: \" & BestName & \" (score \" & FORMAT(BestScore, \"0.0\") & \") | \" &",
              "    \"Weakest: \" & WorstName & \" (score \" & FORMAT(WorstScore, \"0.0\") & \")\"",
              ")"
            ],
            "displayFolder": "🧠 Prompt Quality",
            "lineageTag": "b1c2d3e4-0001-0001-0005-000000000001"
          },
          {
            "name": "Avg Turns",
            "description": "Average turns across all conversations (effort signal) — used on Conversation Analysis",
            "expression": "AVERAGE('Agent Performance'[TurnCount])",
            "formatString": "0.0",
            "displayFolder": "Agent KPIs",
            "lineageTag": "c0a1b2c3-0002-0001-0001-000000000001"
          },
          {
            "name": "🧠 Topic Resolution Insight",
            "description": "Dynamic narrative theming conversation topics by resolution — strongest, weakest, and most-escalated topics",
            "expression": [
              "VAR T =",
              "    ADDCOLUMNS(",
              "        FILTER(",
              "            VALUES('Agent Performance'[Topic (resolved)]),",
              "            CALCULATE([Total Conversations]) >= 5",
              "                && ( NOT (CONTAINSSTRING('Agent Performance'[Topic (resolved)], UNICHAR(128683))) && 'Agent Performance'[Topic (resolved)] <> \"Other\" )",
              "        ),",
              "        \"Res\", DIVIDE([Resolved Conversations], CALCULATE([Total Conversations], 'Agent Performance'[SessionType] = \"Engaged\")),",
              "        \"Esc\", [Escalation Rate]",
              "    )",
              "VAR Best = TOPN(1, T, [Res], DESC)",
              "VAR Worst = TOPN(1, T, [Res], ASC)",
              "VAR EscR = TOPN(1, T, [Esc], DESC)",
              "RETURN",
              "IF(",
              "    COUNTROWS(T) = 0, \"Not enough conversations to theme topics in this selection.\",",
              "    \"✅ \" & MAXX(Best, 'Agent Performance'[Topic (resolved)]) & \" resolves best (\" & FORMAT(MAXX(Best, [Res]) + 0, \"0%\") & \" of engaged). \" &",
              "    \"⚠️ \" & MAXX(Worst, 'Agent Performance'[Topic (resolved)]) & \" is the biggest drag (\" & FORMAT(MAXX(Worst, [Res]) + 0, \"0%\") & \"). \" &",
              "    \"🔁 \" & MAXX(EscR, 'Agent Performance'[Topic (resolved)]) & \" escalates most (\" & FORMAT(MAXX(EscR, [Esc]) + 0, \"0%\") & \").\"",
              ")"
            ],
            "displayFolder": "🗂 Topics",
            "lineageTag": "c0a1b2c3-0002-0001-0002-000000000001"
          },
          {
            "name": "Resolved Conversations",
            "description": "Conversations the agent resolved on its own.",
            "expression": "CALCULATE([Total Conversations], 'Agent Performance'[SessionOutcome] = \"Resolved\")",
            "formatString": "#,0",
            "displayFolder": "🗂 Topics",
            "lineageTag": "ap0topic-meas-0001-000000000001"
          },
          {
            "name": "Escalated Conversations",
            "description": "Conversations handed off to a human.",
            "expression": "CALCULATE([Total Conversations], 'Agent Performance'[SessionOutcome] = \"Escalated\")",
            "formatString": "#,0",
            "displayFolder": "🗂 Topics",
            "lineageTag": "ap0topic-meas-0001-000000000002"
          },
          {
            "name": "Abandoned Conversations",
            "description": "Conversations the user dropped without a resolution.",
            "expression": "CALCULATE([Total Conversations], 'Agent Performance'[SessionOutcome] = \"Abandoned\")",
            "formatString": "#,0",
            "displayFolder": "🗂 Topics",
            "lineageTag": "ap0topic-meas-0001-000000000003"
          },
          {
            "name": "Deflection Rate",
            "description": [
              "Of conversations that reached a clear outcome (resolved OR escalated to a",
              "human), the share the agent contained itself. Drives \"Best Self-Served Topics\"."
            ],
            "expression": "DIVIDE([Resolved Conversations], [Resolved Conversations] + [Escalated Conversations])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "🗂 Topics",
            "lineageTag": "ap0topic-meas-0001-000000000004"
          },
          {
            "name": "🧠 Conversation Summary",
            "expression": [
              "VAR Total = [Total Conversations]",
              "VAR Engaged = CALCULATE([Total Conversations], 'Agent Performance'[SessionType] = \"Engaged\")",
              "VAR EngPct = DIVIDE(Engaged, Total)",
              "VAR ResEng = DIVIDE(CALCULATE([Resolved Conversations], 'Agent Performance'[SessionType] = \"Engaged\"), Engaged) + 0",
              "VAR EscEng = DIVIDE(CALCULATE([Escalated Conversations], 'Agent Performance'[SessionType] = \"Engaged\"), Engaged) + 0",
              "VAR T =",
              "    ADDCOLUMNS(",
              "        FILTER(",
              "            VALUES('Agent Performance'[Topic (resolved)]),",
              "            ( NOT (CONTAINSSTRING('Agent Performance'[Topic (resolved)], UNICHAR(128683))) && 'Agent Performance'[Topic (resolved)] <> \"Other\" )",
              "        ),",
              "        \"V\", [Total Conversations],",
              "        \"A\", [Escalation Rate]",
              "    )",
              "VAR TopTopic = MAXX(TOPN(1, T, [V], DESC), 'Agent Performance'[Topic (resolved)])",
              "VAR TopVol = MAXX(TOPN(1, T, [V], DESC), [V])",
              "VAR WorstTopic = MAXX(TOPN(1, FILTER(T, [V] >= 5), [A], DESC), 'Agent Performance'[Topic (resolved)])",
              "RETURN",
              "IF(",
              "    Total = 0, \"No conversations in this selection.\",",
              "    FORMAT(Total, \"#,0\") & \" conversations, \" & FORMAT(EngPct, \"0%\") & \" engaged. \" &",
              "    \"Among engaged: \" & FORMAT(ResEng, \"0%\") & \" resolved, \" & FORMAT(EscEng, \"0%\") & \" escalated. \" &",
              "    \"Busiest topic: \" & TopTopic & \" (\" & FORMAT(TopVol, \"#,0\") & \" convs). \" &",
              "    \"Most escalated: \" & WorstTopic & \".\"",
              ")"
            ],
            "displayFolder": "🗂 Topics",
            "lineageTag": "ap0topic-meas-0001-000000000010"
          },
          {
            "name": "Engaged Rate",
            "description": "% of conversations that became engaged (the user sent a real message and the agent worked the request), vs unengaged drop-offs. Engaged = SessionType \"Engaged\".",
            "expression": "DIVIDE(CALCULATE(COUNTROWS('Agent Performance'), 'Agent Performance'[SessionType] = \"Engaged\"), COUNTROWS('Agent Performance'))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "🗂 Topics",
            "lineageTag": "ap0topic-meas-eng-00000000000001"
          },
          {
            "name": "Est Minutes Saved (L1 Topic)",
            "description": "LAYER 1 — estimated human minutes saved, topic base only. Sums each RESOLVED conversation's topic base-handle time (Agent Task Value Map), with the *Default* fallback for unmapped topics. Junk/system topics (🚫 / ⚠) earn nothing.",
            "expression": [
              "VAR _default = LOOKUPVALUE('Agent Task Value Map'[Base Handle (min)], 'Agent Task Value Map'[Topic], \"*Default*\")",
              "RETURN",
              "SUMX(",
              "    FILTER('Agent Performance', 'Agent Performance'[SessionOutcome] = \"Resolved\"),",
              "    VAR _t = 'Agent Performance'[Topic (resolved)]",
              "    VAR _isJunk = CONTAINSSTRING(_t, UNICHAR(128683)) || CONTAINSSTRING(_t, UNICHAR(9888))",
              "    VAR _base = COALESCE(LOOKUPVALUE('Agent Task Value Map'[Base Handle (min)], 'Agent Task Value Map'[Topic], _t), _default)",
              "    RETURN IF(_isJunk, 0, _base)",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "💰 Value & Savings",
            "lineageTag": "ap0value-meas-0001-000000000001"
          },
          {
            "name": "Est Minutes Saved (Full)",
            "description": [
              "FULL model — Layers 1+2+3 combined: topic base × turn complexity, plus activity credits. The headline minutes-saved figure.",
              "One sourced layer only. See Agent Task Value Map for the per-topic benchmark",
              "and its citation. The turn multiplier and activity credits were removed:",
              "the first rewards friction, the second double-counts the topic AHT."
            ],
            "expression": "[Est Minutes Saved (L1 Topic)]",
            "formatString": "#,0",
            "displayFolder": "💰 Value & Savings",
            "lineageTag": "ap0value-meas-0001-000000000004"
          },
          {
            "name": "Est Tickets Deflected",
            "description": "Estimated tickets / requests deflected = conversations the agent resolved (a human would otherwise have handled).",
            "expression": "[Resolved Conversations]",
            "formatString": "#,0",
            "displayFolder": "💰 Value & Savings",
            "lineageTag": "ap0value-meas-0001-000000000005"
          },
          {
            "name": "Est Hours Saved",
            "description": "Estimated human hours saved (Full model ÷ 60). Respects all slicers.",
            "expression": "DIVIDE([Est Minutes Saved (Full)], 60)",
            "formatString": "#,0.0",
            "displayFolder": "💰 Value & Savings",
            "lineageTag": "ap0value-meas-0001-000000000006"
          },
          {
            "name": "Est Cost Saved",
            "description": "Estimated cost saved = hours saved × selected hourly rate.",
            "expression": "[Est Hours Saved] * [Hourly Rate Value]",
            "formatString": "\\£#,0",
            "displayFolder": "💰 Value & Savings",
            "lineageTag": "ap0value-meas-0001-000000000007"
          },
          {
            "name": "Avg Minutes Saved per Deflection",
            "description": "Average minutes saved per resolved conversation (Full model). A read on per-deflection value.",
            "expression": "DIVIDE([Est Minutes Saved (Full)], [Est Tickets Deflected])",
            "formatString": "#,0.0",
            "displayFolder": "💰 Value & Savings",
            "lineageTag": "ap0value-meas-0001-000000000008"
          },
          {
            "name": "💰 Value Story (Live)",
            "description": "Dynamic value headline (template-safe). Bind into a text box via fx ▸ Values or a Card.",
            "expression": [
              "VAR _tix = [Est Tickets Deflected]",
              "VAR _hrs = [Est Hours Saved]",
              "VAR _cost = [Est Cost Saved]",
              "VAR _avg = [Avg Minutes Saved per Deflection]",
              "RETURN",
              "IF(_tix = 0, \"No resolved conversations in this selection — no estimated savings yet.\",",
              "    \"The agent deflected \" & FORMAT(_tix, \"#,0\") & \" request\" & IF(_tix = 1, \"\", \"s\") & \", saving an estimated \" &",
              "    FORMAT(_hrs, \"#,0.0\") & \" human hours (~\" & FORMAT(_avg, \"#,0\") & \" min each) — about \" &",
              "    FORMAT(_cost, \"\\£#,0\") & \" at the selected rate. Figures are indicative, topic- and activity-weighted.\")"
            ],
            "displayFolder": "💰 Value & Savings",
            "lineageTag": "ap0value-meas-0001-000000000009"
          },
          {
            "name": "⭐ Reporting Window",
            "expression": [
              "VAR d1 = MIN( 'Agent Performance'[InteractionDate] )",
              "VAR d2 = MAX( 'Agent Performance'[InteractionDate] )",
              "RETURN",
              "IF(",
              "    ISBLANK( d1 ),",
              "    \"No conversations loaded\",",
              "    FORMAT( d1, \"d MMM yyyy\" ) & \"  —  \" & FORMAT( d2, \"d MMM yyyy\" ) &",
              "    \"   (\" & FORMAT( DATEDIFF( d1, d2, DAY ) + 1, \"#,0\" ) & \" days)\"",
              ")"
            ],
            "displayFolder": "Start Here",
            "lineageTag": "aeSH5236508763-0000-0000-0000-000000000000"
          },
          {
            "name": "⭐ Agents in Scope",
            "expression": [
              "VAR n = DISTINCTCOUNT( 'Agent Performance'[BotName] )",
              "RETURN",
              "IF( n = 0, \"No agents\", FORMAT( n, \"#,0\" ) & IF( n = 1, \" agent\", \" agents\" ) & \" evaluated\" )"
            ],
            "displayFolder": "Start Here",
            "lineageTag": "aeSH5909487420-0000-0000-0000-000000000000"
          },
          {
            "name": "⭐ Verdict: Adoption",
            "description": [
              "Reach and stickiness, not raw volume: a big agent nobody returns to",
              "is not adopted. Value and judgement in one string so the card is one field."
            ],
            "expression": [
              "VAR ret = [Returning User Rate]",
              "VAR users = [Unique Users]",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    [Total Conversations] = 0, \"⚪  No data\",",
              "    ret >= 0.60, FORMAT( ret, \"0%\" ) & \" return  ·  🟢 Healthy\",",
              "    ret >= 0.35, FORMAT( ret, \"0%\" ) & \" return  ·  🟡 Building\",",
              "                 FORMAT( ret, \"0%\" ) & \" return  ·  🔴 Shallow\"",
              ")"
            ],
            "displayFolder": "Start Here",
            "lineageTag": "aeSH9149728491-0000-0000-0000-000000000000"
          },
          {
            "name": "⭐ Verdict: Performance",
            "description": "70% resolution is the working benchmark.",
            "expression": [
              "VAR res = [Resolution Rate]",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    [Total Conversations] = 0, \"⚪  No data\",",
              "    res >= 0.70, FORMAT( res, \"0.0%\" ) & \" resolved  ·  🟢 Meeting target\",",
              "    res >= 0.55, FORMAT( res, \"0.0%\" ) & \" resolved  ·  🟡 Below target\",",
              "                 FORMAT( res, \"0.0%\" ) & \" resolved  ·  🔴 Underperforming\"",
              ")"
            ],
            "displayFolder": "Start Here",
            "lineageTag": "aeSH7812249481-0000-0000-0000-000000000000"
          },
          {
            "name": "⭐ Verdict: Quality",
            "description": "Did the agent answer, and did the user agree.",
            "expression": [
              "VAR grounded = [Answered from Knowledge %]",
              "VAR gaps     = [Knowledge Gap Rate]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        [Total Conversations] = 0, \"⚪  No data\",",
              "        grounded >= 0.7, FORMAT ( grounded, \"0%\" ) & \" grounded  ·  🟢 Answers are checkable\",",
              "        grounded >= 0.45, FORMAT ( grounded, \"0%\" ) & \" grounded  ·  🟡 Half unverifiable\",",
              "        FORMAT ( grounded, \"0%\" ) & \" grounded  ·  🔴 Mostly unverifiable\"",
              "    )"
            ],
            "displayFolder": "Start Here",
            "lineageTag": "aeSH1014934151-0000-0000-0000-000000000000"
          },
          {
            "name": "⭐ Verdict: Impact",
            "expression": [
              "VAR n   = [Self-Served Conversations]",
              "VAR pct = DIVIDE ( n, [Total Conversations], 0 )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        [Total Conversations] = 0, \"⚪  No data\",",
              "        pct >= 0.7, FORMAT ( n, \"#,0\" ) & \" self-served  ·  🟢 Most of the demand\",",
              "        pct >= 0.5, FORMAT ( n, \"#,0\" ) & \" self-served  ·  🟡 Over half the demand\",",
              "        FORMAT ( n, \"#,0\" ) & \" self-served  ·  🔴 Under half the demand\"",
              "    )"
            ],
            "displayFolder": "Start Here",
            "lineageTag": "aeSH5880896538-0000-0000-0000-000000000000"
          },
          {
            "name": "⭐ Focus 1: Weakest Agent",
            "description": [
              "Lowest resolution rate among agents with enough volume to judge.",
              "LOOKUPVALUE (not RELATED): Agent Performance has no direct relationship",
              "to Agent Catalogue, so the display name is resolved explicitly."
            ],
            "expression": [
              "VAR T =",
              "    ADDCOLUMNS(",
              "        FILTER(",
              "            VALUES( 'Agent Performance'[BotName] ),",
              "            [Total Conversations] >= 20",
              "        ),",
              "        \"@res\", [Resolution Rate],",
              "        \"@vol\", [Total Conversations]",
              "    )",
              "VAR Worst  = MINX( T, [@res] )",
              "VAR Schema = MAXX( TOPN( 1, T, [@res], ASC ), 'Agent Performance'[BotName] )",
              "VAR Vol    = MAXX( TOPN( 1, T, [@res], ASC ), [@vol] )",
              "VAR Who    =",
              "    COALESCE(",
              "        LOOKUPVALUE( 'Agent Catalogue'[agent_display_name], 'Agent Catalogue'[agent_schema], Schema ),",
              "        Schema",
              "    )",
              "RETURN",
              "IF(",
              "    ISBLANK( Schema ),",
              "    \"Not enough volume yet to rank agents.\",",
              "Who & \" — \" & FORMAT( Worst, \"0%\" ) & \" resolved of \" & FORMAT( Vol, \"#,0\" )",
              ")"
            ],
            "displayFolder": "Start Here",
            "lineageTag": "aeSH2464333964-0000-0000-0000-000000000000"
          },
          {
            "name": "⭐ Focus 2: Knowledge Gap",
            "description": "Searches that found nothing are the clearest content backlog signal.",
            "expression": [
              "VAR searched = [Knowledge Search Rate]",
              "VAR answered = [Knowledge Answered Rate]",
              "VAR gap = [Knowledge Gap Rate]",
              "RETURN",
              "IF(",
              "    ISBLANK( searched ) || searched = 0,",
              "    \"No knowledge searches recorded in this period.\",",
              "    \"📚 \" & FORMAT( answered, \"0%\" ) & \" of knowledge searches return an answer\" &",
              "    IF(",
              "        gap > 0.15,",
              "        \" — a \" & FORMAT( gap, \"0%\" ) & \" content gap worth closing.\",",
              "        \" — coverage looks healthy.\"",
              "    )",
              ")"
            ],
            "displayFolder": "Start Here",
            "lineageTag": "aeSH5752219891-0000-0000-0000-000000000000"
          },
          {
            "name": "⭐ Focus 3: Where Users Give Up",
            "description": "Abandonment concentrated in one agent is a fixable defect, not noise.",
            "expression": [
              "VAR T =",
              "    ADDCOLUMNS(",
              "        FILTER( VALUES( 'Agent Performance'[BotName] ), [Total Conversations] >= 20 ),",
              "        \"@ab\", [Abandonment Rate]",
              "    )",
              "VAR Worst  = MAXX( T, [@ab] )",
              "VAR Schema = MAXX( TOPN( 1, T, [@ab], DESC ), 'Agent Performance'[BotName] )",
              "VAR Who    =",
              "    COALESCE(",
              "        LOOKUPVALUE( 'Agent Catalogue'[agent_display_name], 'Agent Catalogue'[agent_schema], Schema ),",
              "        Schema",
              "    )",
              "RETURN",
              "IF(",
              "    ISBLANK( Schema ),",
              "    \"Not enough volume yet to locate abandonment.\",",
              "Who & \" — \" & FORMAT( Worst, \"0%\" ) & \" give up\"",
              ")"
            ],
            "displayFolder": "Start Here",
            "lineageTag": "aeSH6413760590-0000-0000-0000-000000000000"
          },
          {
            "name": "Escalated: System Intended",
            "description": [
              "Handoffs to a connected agent with no error and no user request -",
              "the agent routing exactly as it was designed to. Not a failure."
            ],
            "expression": "CALCULATE ( [Total Conversations], 'Agent Performance'[Escalation Type] = \"System - Intended\" )",
            "formatString": "#,0",
            "displayFolder": "Outcomes",
            "lineageTag": "ae0m0esc0int-0001-0000-0000-000000000011"
          },
          {
            "name": "Escalated: System Unintended",
            "description": [
              "Handoffs forced by a system error. This is the escalation number",
              "that actually represents a defect worth fixing."
            ],
            "expression": "CALCULATE ( [Total Conversations], 'Agent Performance'[Escalation Type] = \"System - Unintended\" )",
            "formatString": "#,0",
            "displayFolder": "Outcomes",
            "lineageTag": "ae0m0esc0uni-0001-0000-0000-000000000012"
          },
          {
            "name": "Escalated: User Requested",
            "description": [
              "The user explicitly asked for a human. Preference, not malfunction -",
              "though a high number may signal low trust in the agent."
            ],
            "expression": "CALCULATE ( [Total Conversations], 'Agent Performance'[Escalation Type] = \"User Requested\" )",
            "formatString": "#,0",
            "displayFolder": "Outcomes",
            "lineageTag": "ae0m0esc0req-0001-0000-0000-000000000013"
          },
          {
            "name": "Unintended Escalation Rate",
            "description": [
              "The honest escalation-failure rate: error-driven handoffs over all",
              "conversations. Use this instead of the headline Escalation Rate."
            ],
            "expression": "DIVIDE ( COALESCE ( [Escalated: System Unintended], 0 ), [Total Conversations], 0 )",
            "formatString": "0.0%",
            "displayFolder": "Outcomes",
            "lineageTag": "ae0m0esc0rate-001-0000-0000-000000000014"
          },
          {
            "name": "Intended Share of Escalations",
            "description": [
              "Share of escalations that were by design or on request.",
              "High = the headline escalation rate is overstating failure."
            ],
            "expression": "DIVIDE ( COALESCE ( [Escalated: System Intended], 0 ) + COALESCE ( [Escalated: User Requested], 0 ), [Escalated Conversations], 0 )",
            "formatString": "0.0%",
            "displayFolder": "Outcomes",
            "lineageTag": "ae0m0esc0shr-0001-0000-0000-000000000015"
          },
          {
            "name": "Unengaged Conversations",
            "description": [
              "Sessions that never really started. The parser files these under",
              "Abandoned, but never-started and gave-up are different problems."
            ],
            "expression": [
              "COALESCE (",
              "    CALCULATE ( [Total Conversations], 'Agent Performance'[SessionType] = \"Unengaged\" ),",
              "    0",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Outcomes",
            "lineageTag": "ae0m0uneng-00001-0000-0000-000000000016"
          },
          {
            "name": "Failing Conversations",
            "description": [
              "Conversations that genuinely went wrong: an error forced a handoff, or",
              "an engaged user gave up. Excludes designed handoffs and never-started sessions."
            ],
            "expression": [
              "CALCULATE (",
              "    [Total Conversations],",
              "    'Agent Performance'[Outcome (Detailed)] IN { \"Escalated - Unintended\", \"Abandoned\" }",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Outcomes",
            "lineageTag": "ae0m0fail0cnt-001-0000-0000-000000000018"
          },
          {
            "name": "True Failure Rate",
            "description": [
              "Failures over conversations that actually started.",
              "The number to take to a steering group."
            ],
            "expression": "DIVIDE ( COALESCE ( [Failing Conversations], 0 ), [Total Conversations] - COALESCE ( [Unengaged Conversations], 0 ), 0 )",
            "formatString": "0.0%",
            "displayFolder": "Outcomes",
            "lineageTag": "ae0m0fail0rate-01-0000-0000-000000000019"
          },
          {
            "name": "⭐ Escalation Verdict",
            "description": "Plain-English read on whether escalation is a problem or a design.",
            "expression": [
              "VAR esc = [Escalated Conversations]",
              "VAR unint = [Escalated: System Unintended]",
              "VAR intended = [Escalated: System Intended]",
              "VAR req = [Escalated: User Requested]",
              "VAR share = DIVIDE ( intended + req, esc, 0 )",
              "RETURN",
              "    IF (",
              "        esc = 0,",
              "        \"No escalations in this window.\",",
              "        FORMAT ( esc, \"#,0\" ) & \" escalations, \"",
              "& FORMAT ( share, \"0%\" ) & \" by design. Only \"",
              "& FORMAT ( unint, \"#,0\" ) & \" from a system error.\"",
              "    )"
            ],
            "displayFolder": "Outcomes",
            "lineageTag": "ae0m0esc0verd-001-0000-0000-000000000020"
          },
          {
            "name": "Est Hours Lost",
            "description": [
              "Rough handling time burned by conversations that failed -",
              "failures x the same per-conversation minutes used for savings."
            ],
            "expression": [
              "DIVIDE (",
              "    [Failing Conversations]",
              "        * COALESCE ( [Avg Minutes Saved per Deflection], 8 ),",
              "    60,",
              "    0",
              ")"
            ],
            "formatString": "#,0.0",
            "displayFolder": "Improve",
            "lineageTag": "ae0m0hrs0lost-001-0000-0000-000000000031"
          },
          {
            "name": "⭐ Top Fix",
            "description": [
              "The single highest-return fix: ranked by absolute failures,",
              "not by worst percentage on a topic nobody uses."
            ],
            "expression": [
              "VAR tbl =",
              "    ADDCOLUMNS (",
              "        FILTER ( VALUES ( 'Agent Performance'[Topic (resolved)] ), [Total Conversations] >= 5 ),",
              "        \"@fail\", [Failing Conversations],",
              "        \"@rate\", [True Failure Rate]",
              "    )",
              "VAR top1 = TOPN ( 1, tbl, [@fail], DESC )",
              "VAR nm = MAXX ( top1, 'Agent Performance'[Topic (resolved)] )",
              "VAR n = MAXX ( top1, [@fail] )",
              "VAR r = MAXX ( top1, [@rate] )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( nm ) || n = 0,",
              "        \"No failing topic with enough volume to rank.\",",
              "        nm & \" — \" & FORMAT ( n, \"#,0\" ) & \" failed, \"",
              "& FORMAT ( r, \"0%\" ) & \" of that topic\"",
              "    )"
            ],
            "displayFolder": "Improve",
            "lineageTag": "ae0m0top0fix-0001-0000-0000-000000000032"
          },
          {
            "name": "⭐ Backlog Summary",
            "description": "Framing line for the fix backlog.",
            "expression": [
              "VAR tbl =",
              "    ADDCOLUMNS (",
              "        FILTER ( VALUES ( 'Agent Performance'[Topic (resolved)] ), [Total Conversations] >= 5 ),",
              "        \"@fail\", [Failing Conversations]",
              "    )",
              "VAR hot = COUNTROWS ( FILTER ( tbl, [@fail] >= 10 ) )",
              "VAR tot = [Failing Conversations]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( tot ) || tot = 0,",
              "        \"Nothing is failing at volume - the backlog is clear.\",",
              "        FORMAT ( tot, \"#,0\" ) & \" failing conversations across \"",
              "            & FORMAT ( COALESCE ( hot, 0 ), \"#,0\" )",
              "            & \" topics with 10+ failures each. Fix top-down: the list is sorted by volume, so row one is the biggest win.\"",
              "    )"
            ],
            "displayFolder": "Improve",
            "lineageTag": "ae0m0backlog-0001-0000-0000-000000000033"
          },
          {
            "name": "Theme Health %",
            "description": "Share of started conversations in this theme the agent resolved itself.",
            "expression": "DIVIDE ( [Resolved Conversations], [Total Conversations] - COALESCE ( [Unengaged Conversations], 0 ), 0 )",
            "formatString": "0.0%",
            "displayFolder": "Themes",
            "lineageTag": "ae0m0theme0hp-001-0000-0000-000000000041"
          },
          {
            "name": "Friction Score",
            "description": [
              "0-100, higher is worse. Blends give-up rate (60%) with how many turns",
              "it takes (40%). Finds themes that technically resolve but exhaust people."
            ],
            "expression": [
              "VAR ab = DIVIDE ( [Abandoned Conversations], [Total Conversations] - COALESCE ( [Unengaged Conversations], 0 ), 0 )",
              "VAR turnLoad = MIN ( DIVIDE ( [Avg Turns], 10, 0 ), 1 )",
              "RETURN",
              "    ROUND ( ( ab * 0.6 + turnLoad * 0.4 ) * 100, 0 )"
            ],
            "formatString": "#,0",
            "displayFolder": "Themes",
            "lineageTag": "ae0m0friction-0001-0000-0000-000000000042"
          },
          {
            "name": "⭐ Theme Verdict",
            "description": "Which theme costs users the most effort.",
            "expression": [
              "VAR tbl =",
              "    ADDCOLUMNS (",
              "        FILTER ( VALUES ( 'Agent Performance'[Topic Theme] ), [Total Conversations] >= 5 ),",
              "        \"@fric\", [Friction Score],",
              "        \"@vol\", [Total Conversations]",
              "    )",
              "VAR worst = TOPN ( 1, tbl, [@fric], DESC )",
              "VAR nm = MAXX ( worst, 'Agent Performance'[Topic Theme] )",
              "VAR f = MAXX ( worst, [@fric] )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( nm ),",
              "        \"Not enough volume to rank themes.\",",
              "        \"Highest-friction theme is \" & nm & \" (friction \" & FORMAT ( f, \"#,0\" )",
              "            & \"/100). Users get there but have to work for the answer.\"",
              "    )"
            ],
            "displayFolder": "Themes",
            "lineageTag": "ae0m0theme0v-00001-0000-0000-000000000043"
          },
          {
            "name": "Conversations per User",
            "description": "Repeat use. Around 1 means people tried it once and did not come back.",
            "expression": "DIVIDE ( [Total Conversations], [Unique Users], 0 )",
            "formatString": "#,0.0",
            "displayFolder": "Adoption",
            "lineageTag": "ae0m0convperuser-01-0000-0000-000000000051"
          },
          {
            "name": "⭐ Adoption Verdict",
            "description": "Plain-English read on whether the agents have actually landed.",
            "expression": [
              "VAR u = [Unique Users]",
              "VAR c = [Total Conversations]",
              "VAR a = [Agents Evaluated]",
              "VAR per = DIVIDE ( c, u, 0 )",
              "RETURN",
              "    IF (",
              "        u = 0,",
              "        \"No identified users - check ESS_UserContext_UPN is being set on the agent.\",",
              "        FORMAT ( u, \"#,0\" ) & \" people used \" & FORMAT ( a, \"#,0\" ) & \" agents across \"",
              "            & FORMAT ( c, \"#,0\" ) & \" conversations, \"",
              "            & FORMAT ( per, \"0.0\" ) & \" each. \"",
              "            & IF ( per >= 3, \"Repeat use - it has stuck.\", \"Mostly one-off use so far.\" )",
              "    )"
            ],
            "displayFolder": "Adoption",
            "lineageTag": "ae0m0adopt0verd-01-0000-0000-000000000053"
          },
          {
            "name": "Cost per Resolved Conversation",
            "description": [
              "What it actually costs to get a question answered. The number to compare",
              "against the cost of a human handling the same request."
            ],
            "expression": "DIVIDE ( [Billable Credit Cost (Agent)], [Resolved Conversations], 0 )",
            "formatString": "\\£#,0.00",
            "displayFolder": "ROI",
            "lineageTag": "ae0m0costperres-01-0000-0000-000000000062"
          },
          {
            "name": "⭐ ROI Verdict",
            "description": "Plain-English read on whether the agents pay for themselves.",
            "expression": [
              "VAR cost = [Billable Credit Cost (Agent)]",
              "VAR val = [Est Cost Saved]",
              "VAR mult = DIVIDE ( val, cost, 0 )",
              "VAR unmatched = [Agents Unmatched]",
              "RETURN",
              "    IF (",
              "        cost = 0,",
              "        \"No billed credit in this window - load the credit export to see cost.\",",
              "        FORMAT ( val, \"#,0\" ) & \" saved against \" & FORMAT ( cost, \"#,0\" )",
              "            & \" spent, a \" & FORMAT ( mult, \"0.0\" ) & \"x return. \"",
              "            & IF (",
              "                unmatched > 0,",
              "                FORMAT ( unmatched, \"#,0\" ) & \" agents unmatched - cost understated.\",",
              "                IF ( mult >= 3, \"Comfortably paying for itself.\",",
              "                     IF ( mult >= 1, \"Positive, but thin.\", \"Costing more than it saves.\" ) )",
              "            )",
              "    )"
            ],
            "displayFolder": "ROI",
            "lineageTag": "ae0m0roiverdict-01-0000-0000-000000000065"
          },
          {
            "name": "Agents Evaluated",
            "expression": "DISTINCTCOUNT( 'Agent Performance'[BotName] )",
            "formatString": "#,0",
            "displayFolder": "Start Here",
            "lineageTag": "aeSH0000000001-0000-0000-0000-000000000001"
          },
          {
            "name": "Est Minutes Saved (Low)",
            "description": "Cautious end of the published handle-time range.",
            "expression": [
              "VAR _default = LOOKUPVALUE ( 'Agent Task Value Map'[Low (min)], 'Agent Task Value Map'[Topic], \"*Default*\" )",
              "RETURN",
              "    SUMX (",
              "        FILTER ( 'Agent Performance', 'Agent Performance'[SessionOutcome] = \"Resolved\" ),",
              "        VAR _t = 'Agent Performance'[Topic (resolved)]",
              "        VAR _isJunk = CONTAINSSTRING ( _t, UNICHAR ( 128683 ) ) || CONTAINSSTRING ( _t, UNICHAR ( 9888 ) )",
              "        VAR _base = COALESCE ( LOOKUPVALUE ( 'Agent Task Value Map'[Low (min)], 'Agent Task Value Map'[Topic], _t ), _default )",
              "        RETURN IF ( _isJunk, 0, _base )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Value",
            "lineageTag": "ae0m0minlow-00001-0000-0000-000000000071"
          },
          {
            "name": "Est Minutes Saved (High)",
            "description": "Generous end of the published handle-time range.",
            "expression": [
              "VAR _default = LOOKUPVALUE ( 'Agent Task Value Map'[High (min)], 'Agent Task Value Map'[Topic], \"*Default*\" )",
              "RETURN",
              "    SUMX (",
              "        FILTER ( 'Agent Performance', 'Agent Performance'[SessionOutcome] = \"Resolved\" ),",
              "        VAR _t = 'Agent Performance'[Topic (resolved)]",
              "        VAR _isJunk = CONTAINSSTRING ( _t, UNICHAR ( 128683 ) ) || CONTAINSSTRING ( _t, UNICHAR ( 9888 ) )",
              "        VAR _base = COALESCE ( LOOKUPVALUE ( 'Agent Task Value Map'[High (min)], 'Agent Task Value Map'[Topic], _t ), _default )",
              "        RETURN IF ( _isJunk, 0, _base )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Value",
            "lineageTag": "ae0m0minhigh-0001-0000-0000-000000000072"
          },
          {
            "name": "Est Hours Saved (Low)",
            "expression": "DIVIDE ( [Est Minutes Saved (Low)], 60 )",
            "formatString": "#,0",
            "displayFolder": "Value",
            "lineageTag": "ae0m0hrslow-00001-0000-0000-000000000073"
          },
          {
            "name": "Est Hours Saved (High)",
            "expression": "DIVIDE ( [Est Minutes Saved (High)], 60 )",
            "formatString": "#,0",
            "displayFolder": "Value",
            "lineageTag": "ae0m0hrshigh-0001-0000-0000-000000000074"
          },
          {
            "name": "⭐ Hours Saved Range",
            "description": "The honest headline: a range, not a false-precision point estimate.",
            "expression": "\"\" & FORMAT ( [Est Hours Saved (Low)], \"#,0\" ) & \" – \" & FORMAT ( [Est Hours Saved (High)], \"#,0\" ) & \" hrs\"",
            "displayFolder": "Value",
            "lineageTag": "ae0m0hrsrange-001-0000-0000-000000000077"
          },
          {
            "name": "⭐ Value Basis",
            "description": "Leads with the count, which is a fact, then the range, which is an estimate.",
            "expression": [
              "VAR resolved = [Resolved Conversations]",
              "VAR mid = [Est Hours Saved]",
              "RETURN",
              "    IF (",
              "        resolved = 0,",
              "        \"No resolved conversations in this window.\",",
              "        FORMAT ( resolved, \"#,0\" ) & \" conversations resolved with no human involved. At published \"",
              "            & \"service-desk handle times that is \" & FORMAT ( [Est Hours Saved (Low)], \"#,0\" ) & \"–\"",
              "            & FORMAT ( [Est Hours Saved (High)], \"#,0\" ) & \" hours of effort avoided.\"",
              "    )"
            ],
            "displayFolder": "Value",
            "lineageTag": "ae0m0valbasis-001-0000-0000-000000000078"
          },
          {
            "name": "◆ Friction Read",
            "description": "Friction with a plain-English band, so the number does not need explaining.",
            "expression": [
              "VAR f = [Friction Score]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( f ),",
              "        \"—\",",
              "        FORMAT ( f, \"#,0\" ) & \"/100 · \"",
              "            & SWITCH ( TRUE (),",
              "                f >= 50, \"Hard work\",",
              "                f >= 35, \"Some effort\",",
              "                f >= 20, \"Reasonable\",",
              "                \"Easy\" )",
              "    )"
            ],
            "displayFolder": "Reads",
            "lineageTag": "ae0m0fricread-001-0000-0000-000000000081"
          },
          {
            "name": "◆ Resolution Read",
            "description": "70% is the working benchmark for a self-service agent.",
            "expression": [
              "VAR r = [Resolution Rate]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( r ),",
              "        \"—\",",
              "        FORMAT ( r, \"0.0%\" ) & \" · \"",
              "            & SWITCH ( TRUE (),",
              "                r >= 0.8, \"Strong\",",
              "                r >= 0.7, \"On target\",",
              "                r >= 0.55, \"Below target\",",
              "                \"Weak\" )",
              "    )"
            ],
            "displayFolder": "Reads",
            "lineageTag": "ae0m0resread-0001-0000-0000-000000000082"
          },
          {
            "name": "◆ Effort Read",
            "description": "How many exchanges before the user gets an answer.",
            "expression": [
              "VAR t = [Avg Turns to Resolve]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( t ),",
              "        \"—\",",
              "        FORMAT ( t, \"0.0\" ) & \" turns · \"",
              "            & SWITCH ( TRUE (),",
              "                t <= 3, \"Quick\",",
              "                t <= 6, \"Acceptable\",",
              "                t <= 10, \"Laboured\",",
              "                \"Exhausting\" )",
              "    )"
            ],
            "displayFolder": "Reads",
            "lineageTag": "ae0m0effread-0001-0000-0000-000000000083"
          },
          {
            "name": "◆ Cost Read",
            "description": "Compare against what a human costs to handle the same request.",
            "expression": [
              "VAR c = [Cost per Resolved Conversation]",
              "RETURN",
              "    IF (",
              "        c = 0 || ISBLANK ( c ),",
              "        \"—\",",
              "        FORMAT ( c, \"0.00\" ) & \" each · \"",
              "            & SWITCH ( TRUE (),",
              "                c <= 1, \"Very cheap\",",
              "                c <= 3, \"Cheap\",",
              "                c <= 6, \"Watch it\",",
              "                \"Expensive\" )",
              "    )"
            ],
            "displayFolder": "Reads",
            "lineageTag": "ae0m0costread-001-0000-0000-000000000084"
          },
          {
            "name": "◆ Theme Coverage",
            "description": "Guards against the failure this page had: a giant bar labelled Other.",
            "expression": [
              "VAR total = [Total Conversations]",
              "VAR other = CALCULATE ( [Total Conversations], 'Agent Performance'[Topic Theme] IN { \"Other\", \"Untagged\" } )",
              "VAR share = DIVIDE ( other, total, 0 )",
              "RETURN",
              "    IF (",
              "        total = 0,",
              "        \"No conversations in this window.\",",
              "        FORMAT ( 1 - share, \"0%\" ) & \" of conversations fall into a named theme. \"",
              "            & IF (",
              "                share > 0.25,",
              "                \"The rest are unclassified — widen the theme keywords to sharpen this page.\",",
              "                \"Theme coverage is good.\"",
              "            )",
              "    )"
            ],
            "displayFolder": "Reads",
            "lineageTag": "ae0m0themecov-001-0000-0000-000000000085"
          },
          {
            "name": "Ticket Cost Benchmark",
            "description": [
              "What one human-handled contact costs, fully loaded.",
              "Industry service-desk benchmarks run £12-25 for Tier 1.",
              "Change this to your own figure - it drives the whole value story."
            ],
            "expression": "25",
            "formatString": "\\£#,0",
            "displayFolder": "3 Value",
            "lineageTag": "0000aaaa-0000-4000-a000-0000000000c1"
          },
          {
            "name": "Deflected Conversations",
            "description": "Conversations the agent closed with no human involved.",
            "expression": "[Resolved Conversations]",
            "formatString": "#,0",
            "displayFolder": "3 Value",
            "lineageTag": "0000aaaa-0000-4000-a000-0000000000c2"
          },
          {
            "name": "Deflection Value",
            "description": "The cost of the tickets that never reached a human.",
            "expression": "[Deflected Conversations] * [Ticket Cost Benchmark]",
            "formatString": "\\£#,0",
            "displayFolder": "3 Value",
            "lineageTag": "0000aaaa-0000-4000-a000-0000000000c3"
          },
          {
            "name": "Breakeven Minutes",
            "description": [
              "Minutes each resolved conversation must save to pay for itself.",
              "A condition, not a verdict - compare it against what you believe."
            ],
            "expression": [
              "DIVIDE (",
              "    [Cost per Resolved Conversation],",
              "    [Hourly Rate Value],",
              "    0",
              ") * 60"
            ],
            "formatString": "#,0.0",
            "displayFolder": "3 Value",
            "lineageTag": "0000aaaa-0000-4000-a000-0000000000c6"
          },
          {
            "name": "◆ Breakeven Read",
            "expression": [
              "VAR be = [Breakeven Minutes]",
              "VAR act = DIVIDE ( [Est Minutes Saved (Full)], [Resolved Conversations], 0 )",
              "RETURN",
              "    IF (",
              "        [Resolved Conversations] = 0,",
              "        \"No resolved conversations in this window.\",",
              "        \"Must save \" & FORMAT ( be, \"0.0\" ) & \" min per conversation to pay for itself. \"",
              "            & IF ( act >= be,",
              "                   \"At \" & FORMAT ( act, \"0.0\" ) & \" min assumed, it clears that.\",",
              "                   \"At \" & FORMAT ( act, \"0.0\" ) & \" min assumed, it does not.\" )",
              "    )"
            ],
            "lineageTag": "0000aaaa-0000-4000-a000-0000000000c7"
          },
          {
            "name": "◆ Deflection Read",
            "expression": [
              "VAR n = [Deflected Conversations]",
              "VAR val = [Deflection Value]",
              "VAR cost = [Billable Credit Cost (Agent)]",
              "VAR mult = DIVIDE ( val, cost, 0 )",
              "RETURN",
              "    IF (",
              "        cost = 0,",
              "        \"No billed credit in this window.\",",
              "        FORMAT ( n, \"#,0\" ) & \" closed without a human: \" & FORMAT ( val, \"\\£#,0\" )",
              "            & \" avoided for \" & FORMAT ( cost, \"\\£#,0\" ) & \". \"",
              "            & SWITCH ( TRUE (),",
              "                mult >= 3, \"Comfortably worth running.\",",
              "                mult >= 1, \"Positive, but thin.\",",
              "                \"Costs more than it deflects.\" )",
              "    )"
            ],
            "lineageTag": "0000aaaa-0000-4000-a000-0000000000c8"
          },
          {
            "name": "Self-Served Conversations",
            "description": "Finished without a human being involved at any point.",
            "expression": "[Resolved Conversations]",
            "formatString": "#,0",
            "displayFolder": "3 Value",
            "lineageTag": "ae0new09-0000-4000-a000-000000000009"
          },
          {
            "name": "◆ What Users Got",
            "expression": [
              "VAR n = [Total Conversations]",
              "VAR selfserved = [Self-Served Conversations]",
              "VAR pct = DIVIDE ( selfserved, n, 0 )",
              "RETURN",
              "    IF (",
              "        n = 0,",
              "        \"No conversations in this window.\",",
              "        FORMAT ( selfserved, \"#,0\" ) & \" of \" & FORMAT ( n, \"#,0\" ) & \" finished with no human involved (\"",
              "            & FORMAT ( pct, \"0.0%\" ) & \"). \"",
              "            & SWITCH ( TRUE (),",
              "                pct >= 0.7, \"Most people are getting what they came for.\",",
              "                pct >= 0.5, \"More than half are getting what they came for.\",",
              "                \"Fewer than half are getting what they came for.\" )",
              "    )"
            ],
            "displayFolder": "3 Value",
            "lineageTag": "ae0new10-0000-4000-a000-000000000010"
          },
          {
            "name": "◆ Value Footnote",
            "description": [
              "Deliberately a footnote, not a verdict. The counts above stand on their own;",
              "this line only exists for people who need a currency figure."
            ],
            "expression": [
              "\"At \" & FORMAT ( [Ticket Cost Benchmark], \"\\£0\" ) & \" a human contact, that is \"",
              "    & FORMAT ( [Deflection Value], \"\\£#,0\" ) & \" avoided. Set your own rate.\""
            ],
            "displayFolder": "3 Value",
            "lineageTag": "ae0new11-0000-4000-a000-000000000011"
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
