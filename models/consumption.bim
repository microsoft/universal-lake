          },
          {
            "name": "GitHub Rate",
            "dataType": "double",
            "sourceColumn": "GitHub Rate",
            "formatString": "\\$#,0.0000",
            "lineageTag": "5e770002-0007-4001-8001-000000000007",
            "summarizeBy": "none"
          },
          {
            "name": "GitHub Business Seat",
            "dataType": "double",
            "sourceColumn": "GitHub Business Seat",
            "formatString": "\\$#,0",
            "lineageTag": "5e770002-0008-4001-8001-000000000008",
            "summarizeBy": "none"
          },
          {
            "name": "GitHub Enterprise Seat",
            "dataType": "double",
            "sourceColumn": "GitHub Enterprise Seat",
            "formatString": "\\$#,0",
            "lineageTag": "5e770002-0009-4001-8001-000000000009",
            "summarizeBy": "none"
          },
          {
            "name": "GitHub Change Date",
            "dataType": "dateTime",
            "sourceColumn": "GitHub Change Date",
            "formatString": "dd mmm yyyy",
            "lineageTag": "5e770002-0010-4001-8001-000000000010",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "GitHub Business Standard",
            "dataType": "int64",
            "sourceColumn": "GitHub Business Standard",
            "formatString": "#,0",
            "lineageTag": "5e770002-0011-4001-8001-000000000011",
            "summarizeBy": "none"
          },
          {
            "name": "GitHub Enterprise Standard",
            "dataType": "int64",
            "sourceColumn": "GitHub Enterprise Standard",
            "formatString": "#,0",
            "lineageTag": "5e770002-0012-4001-8001-000000000012",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Settings",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // ONE ROW, ONE PLACE. Everything commercial the report knows.",
                "    //",
                "    // On the Fabric path each value can come from a `commercial_terms`",
                "    // table in the Lakehouse. Where that table supplies a value it",
                "    // wins; where it does not, the parameter below is used. So a",
                "    // pipeline can publish the customer's ACTUAL negotiated rate -",
                "    // derived from Azure Cost Management as cost / quantity - without",
                "    // anyone retyping it, and a customer with no such pipeline is",
                "    // unaffected. See docs/COMMERCIAL-TERMS.md.",
                "    //",
                "    // The last three are GitHub's published allowance change, not a",
                "    // customer term, which is why they are constants here. Edit them",
                "    // if GitHub revises the rates, or if your agreement has no change",
                "    // pending: set the date to one already past and the two values to",
                "    // your current entitlement, and the report says so instead of",
                "    // forecasting a cliff.",
                "    Rate        = TermOrDefault(\"credit_rate\", CreditRate),",
                "    PrepaidRate = TermOrDefault(\"prepaid_credit_rate\", PrepaidCreditRate),",
                "    Balance     = TermOrDefault(\"prepaid_credit_balance\", PrepaidCreditBalance),",
                "    BusSeat     = TermOrDefault(\"github_business_seat\", GitHubBusinessSeatPrice),",
                "    EntSeat     = TermOrDefault(\"github_enterprise_seat\", GitHubEnterpriseSeatPrice),",
                "    Source = #table(",
                "        type table [",
                "            #\"Cowork Rate\" = number, #\"Cowork Prepaid Rate\" = number,",
                "            #\"Studio Rate\" = number, #\"Studio Prepaid Rate\" = number,",
                "            #\"Pack Balance\" = number,",
                "            #\"GitHub Rate\" = number, #\"GitHub Business Seat\" = number,",
                "            #\"GitHub Enterprise Seat\" = number,",
                "            #\"GitHub Change Date\" = date,",
                "            #\"GitHub Business Standard\" = Int64.Type,",
                "            #\"GitHub Enterprise Standard\" = Int64.Type",
                "        ],",
                "        {",
                "            {",
                "                Rate,        PrepaidRate,",
                "                Rate,        PrepaidRate,",
                "                Balance,",
                "                Rate,        BusSeat,",
                "                EntSeat,",
                "                #date(2026, 9, 1),",
                "                1900,",
                "                3900",
                "            }",
                "        }",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Cowork PAYG Rate Value",
            "description": [
              "Cowork pay-as-you-go rate in force. Keeps its original name so every",
              "measure that already prices against it is unaffected by the move."
            ],
            "expression": "MAX( 'Settings'[Cowork Rate] )",
            "formatString": "\\$#,0.0000",
            "displayFolder": "Commercial inputs",
            "lineageTag": "288ee1ae-6431-4487-95d4-8901f8feaedf"
          },
          {
            "name": "Cowork Prepaid Rate Value",
            "description": "Cowork prepaid rate in force. Only bites when a pack balance is set.",
            "expression": "MAX( 'Settings'[Cowork Prepaid Rate] )",
            "formatString": "\\$#,0.0000",
            "displayFolder": "Commercial inputs",
            "lineageTag": "c0000003-0002-4001-8001-000000000002"
          },
          {
            "name": "Cowork Prepaid Discount %",
            "description": "How much cheaper a prepaid credit is than a pay-as-you-go one.",
            "expression": "DIVIDE( [Cowork PAYG Rate Value] - [Cowork Prepaid Rate Value], [Cowork PAYG Rate Value] )",
            "formatString": "0.0%",
            "displayFolder": "Commercial inputs",
            "lineageTag": "c0000003-0003-4001-8001-000000000003"
          },
          {
            "name": "Studio PAYG Rate Value",
            "description": "Copilot Studio pay-as-you-go rate in force.",
            "expression": "MAX( 'Settings'[Studio Rate] )",
            "formatString": "\\$#,0.000",
            "displayFolder": "Commercial inputs",
            "lineageTag": "cc0004cu-meas-0001-000000000001"
          },
          {
            "name": "Studio Prepaid Rate Value",
            "description": [
              "Copilot Studio prepaid rate in force. This one matters even with no pack",
              "balance entered, because the Studio export reports the prepaid and",
              "pay-as-you-go split as measured fact rather than as an assumption."
            ],
            "expression": "MAX( 'Settings'[Studio Prepaid Rate] )",
            "formatString": "\\$#,0.0000",
            "displayFolder": "Commercial inputs",
            "lineageTag": "c0000006-0002-4001-8001-000000000002"
          },
          {
            "name": "Studio Prepaid Discount %",
            "description": "Discount the prepaid Studio rate earns against pay-as-you-go.",
            "expression": "DIVIDE( [Studio PAYG Rate Value] - [Studio Prepaid Rate Value], [Studio PAYG Rate Value] )",
            "formatString": "0.0%",
            "displayFolder": "Commercial inputs",
            "lineageTag": "c0000006-0003-4001-8001-000000000003"
          },
          {
            "name": "Studio Effective Rate",
            "description": [
              "Blended Studio rate actually achieved across the measured prepaid and",
              "pay-as-you-go split."
            ],
            "expression": [
              "",
              "DIVIDE(",
              "    [Studio Prepaid Consumed] * [Studio Prepaid Rate Value] + [Studio PAYG Consumed] * [Studio PAYG Rate Value],",
              "    [Studio Prepaid Consumed] + [Studio PAYG Consumed]",
              ")",
              ""
            ],
            "formatString": "\\$#,0.0000",
            "displayFolder": "Commercial inputs",
            "lineageTag": "c0000006-0005-4001-8001-000000000005"
          },
          {
            "name": "Cowork Capacity Pack Balance Value",
            "description": [
              "Prepaid Capacity Pack credits available to draw down. The Cost page",
              "slicer overrides the deployment setting, so a reader can model buying a",
              "pack without changing the tenant's configuration."
            ],
            "expression": [
              "",
              "VAR WhatIf = SELECTEDVALUE( 'Capacity Pack Balance'[Capacity Pack Balance] )",
              "RETURN IF( ISBLANK( WhatIf ), MAX( 'Settings'[Pack Balance] ), WhatIf )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Commercial inputs",
            "lineageTag": "c0000005-0002-4001-8001-000000000002"
          },
          {
            "name": "Rates In Use",
            "description": [
              "One line a reader can check the figures against, since the rates are no",
              "longer visible as slicers."
            ],
            "expression": [
              "",
              "\"Cowork \" & FORMAT( [Cowork PAYG Rate Value], \"$0.0000\" )",
              "    & \"   Studio \" & FORMAT( [Studio PAYG Rate Value], \"$0.0000\" )",
              "    & \"   Prepaid pack \" & FORMAT( [Cowork Capacity Pack Balance Value], \"#,0\" ) & \" credits\"",
              ""
            ],
            "displayFolder": "Commercial inputs",
            "lineageTag": "5e770002-0007-4001-8001-000000000007"
          },
          {
            "name": "All Credits /mo",
            "description": "All three products' monthly credit run rate added together.",
            "expression": "[Cowork Credits /mo] + [GHCP Credits /mo] + [Studio Credits /mo]",
            "formatString": "#,0",
            "displayFolder": "All products",
            "lineageTag": "9f22f508-23a5-4c35-88f1-b61e2d1acc6b"
          },
          {
            "name": "All Cost /mo",
            "description": [
              "All three products' monthly cost added together. Cowork and Studio are",
              "credit consumption; GitHub is mostly seats, which is why it dominates."
            ],
            "expression": "[Cowork Cost /mo] + [GHCP Cost /mo] + [Studio Cost /mo]",
            "formatString": "\\$#,0",
            "displayFolder": "All products",
            "lineageTag": "d8ea1502-9139-40e9-854e-df682392ee59"
          },
          {
            "name": "Source Windows",
            "description": [
              "States the window each product was exported over, so nobody reads the",
              "combined figures as like-for-like actuals."
            ],
            "expression": [
              "",
              "// Products with no data are left out entirely rather than shown as an",
              "// empty window, so a customer holding one product sees only that one.",
              "VAR CwHas = [Cowork Total Credits Used] > 0",
              "VAR GhHas = [GHCP Credits Used] > 0",
              "VAR StHas = [Studio Consumed Credits (Tenant)] > 0",
              "VAR Cw = IF( CwHas, \"Cowork \" & FORMAT( [Cowork Period Weeks], \"#,0\" ) & \" weeks\" )",
              "VAR Gh = IF( GhHas, \"GitHub \" & FORMAT( [GHCP Months Observed], \"#,0\" ) & \" months\" )",
              "VAR St = IF( StHas, \"Studio \" & FORMAT( [Studio Days Observed], \"#,0\" ) & \" days\" )",
              "VAR Sep = \"   |   \"",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        NOT ( CwHas || GhHas || StHas ), \"No consumption data loaded.\",",
              "        CwHas && GhHas && StHas, Cw & Sep & Gh & Sep & St,",
              "        CwHas && GhHas,          Cw & Sep & Gh,",
              "        CwHas && StHas,          Cw & Sep & St,",
              "        GhHas && StHas,          Gh & Sep & St,",
              "        CwHas,                   Cw,",
              "        GhHas,                   Gh,",
              "        St",
              "    )",
              ""
            ],
            "displayFolder": "All products",
            "lineageTag": "7c8af8ce-cb6d-421a-baa3-a759ebd9214a"
          },
          {
            "name": "All Products Headline",
            "description": "One line on what the combined page can and cannot tell you.",
            "expression": [
              "",
              "// VAR name avoids Top: TOPN aside, Top itself is reserved, and a colliding",
              "// VAR name breaks every query on the model rather than just this measure.",
              "VAR CW = [Cowork Credits /mo]",
              "VAR GH = [GHCP Credits /mo]",
              "VAR ST = [Studio Credits /mo]",
              "VAR Total = CW + GH + ST",
              "VAR Leader =",
              "    SWITCH(",
              "        TRUE(),",
              "        CW >= GH && CW >= ST, \"Cowork / WorkIQ\",",
              "        GH >= ST,             \"GitHub Copilot\",",
              "        \"Copilot Studio\"",
              "    )",
              "VAR LeaderShare = DIVIDE( MAX( CW, MAX( GH, ST ) ), Total )",
              "RETURN",
              "    IF(",
              "        Total = 0,",
              "        \"No consumption in this selection.\",",
              "        Leader & \" accounts for \" & FORMAT( LeaderShare, \"0%\" )",
              "            & \" of the monthly credit run rate. Each product is exported over a \"",
              "            & \"different window, so every figure here is normalised to a month \"",
              "            & \"rather than a raw total.\"",
              "    )",
              ""
            ],
            "displayFolder": "All products",
            "lineageTag": "f70f6f68-e0ae-4b17-a2d0-c8c7a849c1d0"
          },
          {
            "name": "Combined Caveat",
            "description": [
              "Why the combined figures understate Copilot Studio. Adapts to whether any",
              "unattributed Studio credits are actually present in this tenant's export."
            ],
            "expression": [
              "",
              "VAR Tenant = [Studio Consumed Credits (Tenant)]",
              "VAR Attributed = [Studio Total Credits Used]",
              "VAR Gap = Tenant - Attributed",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK( Tenant ) || Tenant = 0,",
              "            \"No Copilot Studio data loaded, so these figures cover the other \"",
              "                & \"products only.\",",
              "        Gap > 0,",
              "            \"Studio counts only credits attributed to a named user. Its agent and \"",
              "                & \"environment exports carry no person, so about \"",
              "                & FORMAT( Gap, \"#,0\" ) & \" credits (\"",
              "                & FORMAT( DIVIDE( Gap, Tenant ), \"0%\" )",
              "                & \" of Studio usage) sit outside the per-person and per-department \"",
              "                & \"views on this page.\",",
              "        \"Studio counts only credits attributed to a named user. All Studio \"",
              "            & \"credits in this export carry a person, so nothing is missing here.\"",
              "    )",
              ""
            ],
            "displayFolder": "All products",
            "lineageTag": "eaba0aed-a90c-4322-81f3-573fa80fd757"
          },
          {
            "name": "GitHub Rate Value",
            "description": [
              "GitHub Copilot pay-as-you-go rate per AI credit, once the included",
              "allowance is exhausted."
            ],
            "expression": "MAX( 'Settings'[GitHub Rate] )",
            "formatString": "\\$#,0.0000",
            "displayFolder": "Commercial inputs",
            "lineageTag": "gh000003-0001-4001-8001-000000000001"
          },
          {
            "name": "GitHub Business Seat Value",
            "description": "Monthly list price of a Copilot Business seat.",
            "expression": "MAX( 'Settings'[GitHub Business Seat] )",
            "formatString": "\\$#,0",
            "displayFolder": "Commercial inputs",
            "lineageTag": "gh000003-0002-4001-8001-000000000002"
          },
          {
            "name": "GitHub Enterprise Seat Value",
            "description": "Monthly list price of a Copilot Enterprise seat.",
            "expression": "MAX( 'Settings'[GitHub Enterprise Seat] )",
            "formatString": "\\$#,0",
            "displayFolder": "Commercial inputs",
            "lineageTag": "gh000003-0003-4001-8001-000000000003"
          },
          {
            "name": "GitHub Allowance Change Date",
            "description": "The date the included GitHub AI credit allowance changes.",
            "expression": "MAX( 'Settings'[GitHub Change Date] )",
            "formatString": "dd mmm yyyy",
            "displayFolder": "Commercial inputs",
            "lineageTag": "gh000003-0004-4001-8001-000000000004"
          },
          {
            "name": "GitHub Business Standard Value",
            "description": "Included credits per Copilot Business seat from the change date.",
            "expression": "MAX( 'Settings'[GitHub Business Standard] )",
            "formatString": "#,0",
            "displayFolder": "Commercial inputs",
            "lineageTag": "gh000003-0005-4001-8001-000000000005"
          },
          {
            "name": "GitHub Enterprise Standard Value",
            "description": "Included credits per Copilot Enterprise seat from the change date.",
            "expression": "MAX( 'Settings'[GitHub Enterprise Standard] )",
            "formatString": "#,0",
            "displayFolder": "Commercial inputs",
            "lineageTag": "gh000003-0006-4001-8001-000000000006"
          },
          {
            "name": "Org Filter Name",
            "description": [
              "The org attribute currently grouping the report, or blank when the reader",
              "has not chosen one.",
              "",
              "ISFILTERED, not ISEMPTY: the question is whether a SELECTION is in force,",
              "not whether the table has rows. An unfiltered Group By table is full of",
              "rows and would read as \"filtered\" to any test based on emptiness."
            ],
            "expression": [
              "IF(",
              "    ISFILTERED( 'Group By'[Attribute] ) || ISFILTERED( 'Group By'[Group] ),",
              "    IF(",
              "        HASONEVALUE( 'Group By'[Attribute] ),",
              "        VALUES( 'Group By'[Attribute] ),",
              "        \"the current grouping\"",
              "    ),",
              "    BLANK()",
              ")"
            ],
            "isHidden": true,
            "displayFolder": "Attribution",
            "lineageTag": "a7710001-0002-4001-8001-000000000002"
          },
          {
            "name": "Not Filtered Note",
            "description": [
              "Caption for any visual whose table carries no person, so an org selection",
              "cannot reach it. Blank when nothing is selected, so the caption appears",
              "only when it is actually needed and the page stays quiet otherwise.",
              "",
              "Deliberately a measure rather than static text: static text would either",
              "always show - training readers to ignore it - or never show, which is how",
              "a report ends up lying."
            ],
            "expression": [
              "VAR Chosen = [Org Filter Name]",
              "RETURN",
              "    IF(",
              "        ISBLANK( Chosen ),",
              "        BLANK(),",
              "        \"Tenant total - not filtered by \" & Chosen",
              "    )"
            ],
            "displayFolder": "Attribution",
            "lineageTag": "a7710001-0003-4001-8001-000000000003"
          },
          {
            "name": "Unattributed Spend Note",
            "description": [
              "How much Azure AI spend carries no department tag, named rather than hidden.",
              "",
              "Azure tags are not inherited from resource group or subscription, and",
              "enabling inheritance is not retrospective, so untagged spend is the normal",
              "state rather than an error. A dashboard that silently drops it understates",
              "cost; one that silently includes it misattributes cost. This says which.",
              "",
              "Tests for empty string as well as blank. A CSV round-trip turns a missing",
              "tag into \"\" rather than null, so ISBLANK alone counts every untagged row",
              "as tagged and the measure reports 0% - which is exactly the false",
              "reassurance it exists to prevent."
            ],
            "expression": [
              "VAR Total  = [Foundry Cost]",
              "VAR Tagged =",
              "    CALCULATE(",
              "        [Foundry Cost],",
              "        REMOVEFILTERS( 'AzureAiSpend'[DepartmentTag] ),",
              "        NOT ISBLANK( 'AzureAiSpend'[DepartmentTag] ),",
              "        'AzureAiSpend'[DepartmentTag] <> \"\"",
              "    )",
              "VAR Untagged = Total - Tagged",
              "RETURN",
              "    IF(",
              "        Untagged <= 0 || ISBLANK( Total ),",
              "        BLANK(),",
              "        FORMAT( DIVIDE( Untagged, Total ), \"0%\" ) & \" of spend carries no department tag\"",
              "    )"
            ],
            "displayFolder": "Attribution",
            "lineageTag": "a7710001-0004-4001-8001-000000000004"
          },
          {
            "name": "Foundry Cost /mo (All)",
            "description": [
              "Azure AI Foundry's monthly run rate, for the all-products view.",
              "",
              "Cost only. Foundry bills in tokens, not Copilot credits, so there is",
              "deliberately no matching credits measure - adding tokens to a credit",
              "count would produce a number with no meaning."
            ],
            "expression": "[Foundry Cost /mo]",
            "formatString": "\\$#,0",
            "displayFolder": "All products",
            "lineageTag": "a7710002-0001-4001-8001-000000000001"
          },
          {
            "name": "All Cost /mo (incl Foundry)",
            "description": [
              "Every product's monthly cost, Foundry included.",
              "",
              "Replaces the three-product total on this page. Dollars are dollars,",
              "so unlike credits these genuinely add up.",
              "",
              "Foundry is added ONLY at the total. It has no person dimension, so",
              "inside a group it would contribute the whole tenant figure to every",
              "row - a six-group table would then sum to three times the headline.",
              "ISINSCOPE tells a row apart from the total line."
            ],
            "expression": [
              "VAR Three = [Cowork Cost /mo] + [GHCP Cost /mo] + [Studio Cost /mo]",
              "VAR F = [Foundry Cost /mo]",
              "RETURN",
              "    IF(",
              "        ISINSCOPE( 'Group By'[Group] ),",
              "        Three,",
              "        Three + F",
              "    )"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "All products",
            "lineageTag": "a7710002-0002-4001-8001-000000000002"
          },
          {
            "name": "Unattributed Cost /mo",
            "description": [
              "The gap between the headline cost and what the by-group table can show.",
              "",
              "The table breaks cost down by org attribute. Foundry cannot appear in",
              "it - Cost Management is resource-grained and carries no person - so",
              "without this line the table's total would silently disagree with the",
              "KPI above it, which is worse than showing a number you cannot slice.",
              "",
              "ONLY AT THE TOTAL. The first version returned the same figure in every",
              "row, so a six-group table added it six times and summed to three times",
              "the headline - a worse discrepancy than the one it was fixing.",
              "ISINSCOPE tells a row apart from the total line.",
              "",
              "Blank when there is no Foundry data, so a customer without Azure AI",
              "never sees a row explaining an absence."
            ],
            "expression": [
              "VAR F = [Foundry Cost /mo]",
              "RETURN",
              "    IF(",
              "        ISINSCOPE( 'Group By'[Group] ) || ISBLANK( F ) || F = 0,",
              "        BLANK(),",
              "        F",
              "    )"
            ],
            "formatString": "\\$#,0",
            "displayFolder": "All products",
            "lineageTag": "a7710002-0003-4001-8001-000000000003"
          },
          {
            "name": "Unattributed Cost Note",
            "description": [
              "One line explaining why the table beneath the KPIs does not add up to",
              "the headline cost.",
              "",
              "This replaces an 'Unattributed' column, which was blank on every row",
              "and populated only on the total - a reader met the blanks first and",
              "had to work out why. A sentence answers the question directly.",
              "",
              "Sits beneath the table so the reader meets it at the moment the",
              "numbers stop agreeing, rather than after drawing a conclusion.",
              "",
              "Blank when there is no Foundry data, so a customer without Azure AI",
              "never sees an explanation for an absence."
            ],
            "expression": [
              "VAR F = [Foundry Cost /mo]",
              "VAR Total = [All Cost /mo (incl Foundry)]",
              "RETURN",
              "    IF(",
              "        ISBLANK( F ) || F = 0,",
              "        BLANK(),",
              "        \"Table shows \" & FORMAT( [All Cost /mo], \"$#,0\" ) & \". \"",
              "            & \"Azure AI Foundry \" & FORMAT( F, \"$#,0\" ) & \"/mo (\"",
              "            & FORMAT( DIVIDE( F, Total ), \"0%\" )",
              "            & \" of the total above) is billed per resource, not per \"",
              "            & \"person, so it cannot be split by this grouping.\"",
              "    )"
            ],
            "displayFolder": "All products",
            "lineageTag": "a7710002-0004-4001-8001-000000000004"
          },
          {
            "name": "Reporting Start",
            "expression": "MIN('Reporting Date'[Date])",
            "formatString": "yyyy-mm-dd",
            "displayFolder": "Reporting consistency",
            "lineageTag": "7534e8d7-55b9-4d24-806e-1b08b2f4f286"
          },
          {
            "name": "Reporting End",
            "expression": "MAX('Reporting Date'[Date])",
            "formatString": "yyyy-mm-dd",
            "displayFolder": "Reporting consistency",
            "lineageTag": "d82267d1-bc67-4afe-bb42-c2b998da1238"
          },
          {
            "name": "Reporting Window",
            "expression": "FORMAT([Reporting Start], \"d MMM yyyy\") & \" - \" & FORMAT([Reporting End], \"d MMM yyyy\")",
            "displayFolder": "Reporting consistency",
            "lineageTag": "992df741-12ce-4347-be20-64055c2601f6"
          },
          {
            "name": "Reporting Cowork Credits",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(SUM('CreditsWeekly'[CreditsUsed]), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('CreditsWeekly'[MetricDate]),",
              "        'CreditsWeekly'[MetricDate] >= Lo && 'CreditsWeekly'[MetricDate] <= Hi)))"
            ],
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "6f26c246-b28c-4980-90b5-72d8beee4815"
          },
          {
            "name": "Reporting Cowork Cost",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(SUM('CreditsWeekly'[CreditsUsed]) * [Cowork PAYG Rate Value], REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('CreditsWeekly'[MetricDate]),",
              "        'CreditsWeekly'[MetricDate] >= Lo && 'CreditsWeekly'[MetricDate] <= Hi)))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Reporting consistency",
            "lineageTag": "d00ef58a-7c29-4821-8cb3-0ae90083c5ad"
          },
          {
            "name": "Reporting Cowork Rows",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(COUNTROWS('CreditsWeekly'), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('CreditsWeekly'[MetricDate]),",
              "        'CreditsWeekly'[MetricDate] >= Lo && 'CreditsWeekly'[MetricDate] <= Hi)))"
            ],
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "7a0f6650-5dfe-48e5-92c7-c5005e3ecbfa"
          },
          {
            "name": "Reporting Studio Credits",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(SUM('Credit Consumption (Tenant)'[Prepaid_Consumed_Quantity]) + SUM('Credit Consumption (Tenant)'[Pay_as_you_go_Consumed_Quantity]), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('Credit Consumption (Tenant)'[Usage_Date]),",
              "        'Credit Consumption (Tenant)'[Usage_Date] >= Lo && 'Credit Consumption (Tenant)'[Usage_Date] <= Hi)))"
            ],
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "c4aa471c-82c8-4e7a-87bd-978bb1f101bf"
          },
          {
            "name": "Reporting Studio Cost",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(SUM('Credit Consumption (Tenant)'[Prepaid_Consumed_Quantity]) * [Studio Prepaid Rate Value] + SUM('Credit Consumption (Tenant)'[Pay_as_you_go_Consumed_Quantity]) * [Studio PAYG Rate Value], REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('Credit Consumption (Tenant)'[Usage_Date]),",
              "        'Credit Consumption (Tenant)'[Usage_Date] >= Lo && 'Credit Consumption (Tenant)'[Usage_Date] <= Hi)))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Reporting consistency",
            "lineageTag": "ff631cca-817a-44d3-84df-c48cbb29e11c"
          },
          {
            "name": "Reporting Studio Rows",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(COUNTROWS('Credit Consumption (Tenant)'), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('Credit Consumption (Tenant)'[Usage_Date]),",
              "        'Credit Consumption (Tenant)'[Usage_Date] >= Lo && 'Credit Consumption (Tenant)'[Usage_Date] <= Hi)))"
            ],
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "5dc40181-d0df-4d7e-a219-8b48e2fe24ce"
          },
          {
            "name": "Reporting GitHub Credits",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(SUM('GitHub Usage'[Credits]), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('GitHub Usage'[Usage_Date]),",
              "        'GitHub Usage'[Usage_Date] >= Lo && 'GitHub Usage'[Usage_Date] <= Hi)))"
            ],
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "5200f918-10c2-4b0c-a9e1-c21aca701c7e"
          },
          {
            "name": "Reporting GitHub Cost",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(SUM('GitHub Usage'[Net_Amount]), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('GitHub Usage'[Usage_Date]),",
              "        'GitHub Usage'[Usage_Date] >= Lo && 'GitHub Usage'[Usage_Date] <= Hi)))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Reporting consistency",
            "lineageTag": "161eb718-396b-43b2-9cdc-34916b40af75"
          },
          {
            "name": "Reporting GitHub Rows",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(COUNTROWS('GitHub Usage'), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('GitHub Usage'[Usage_Date]),",
              "        'GitHub Usage'[Usage_Date] >= Lo && 'GitHub Usage'[Usage_Date] <= Hi)))"
            ],
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "a4bd9cfa-f01d-420e-a02d-915a9edf7b22"
          },
          {
            "name": "Reporting Foundry Credits",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(BLANK(), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('AzureAiSpend'[UsageDate]),",
              "        'AzureAiSpend'[UsageDate] >= Lo && 'AzureAiSpend'[UsageDate] <= Hi)), KEEPFILTERS('AzureAiSpend'[ServiceName] = \"Foundry Models\"))"
            ],
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "1ca1200b-f158-4563-9b33-12486df664be"
          },
          {
            "name": "Reporting Foundry Cost",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(SUM('AzureAiSpend'[Cost]), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('AzureAiSpend'[UsageDate]),",
              "        'AzureAiSpend'[UsageDate] >= Lo && 'AzureAiSpend'[UsageDate] <= Hi)), KEEPFILTERS('AzureAiSpend'[ServiceName] = \"Foundry Models\"))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Reporting consistency",
            "lineageTag": "a65409c3-c519-4fcb-a142-031e55656968"
          },
          {
            "name": "Reporting Foundry Rows",
            "expression": [
              "VAR Lo = [Reporting Start]",
              "VAR Hi = [Reporting End]",
              "RETURN CALCULATE(COUNTROWS('AzureAiSpend'), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(FILTER(ALL('AzureAiSpend'[UsageDate]),",
              "        'AzureAiSpend'[UsageDate] >= Lo && 'AzureAiSpend'[UsageDate] <= Hi)), KEEPFILTERS('AzureAiSpend'[ServiceName] = \"Foundry Models\"))"
            ],
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "e997d9c9-2093-4b0a-8c0f-0feff3f07c8d"
          },
          {
            "name": "Reporting Product Credits",
            "expression": [
              "SWITCH(SELECTEDVALUE('Reporting Product'[Product]), \"Cowork / Work IQ\", [Reporting Cowork Credits],",
              "\"Copilot Studio\", [Reporting Studio Credits],",
              "\"GitHub Copilot\", [Reporting GitHub Credits],",
              "\"Azure AI Foundry\", [Reporting Foundry Credits])"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Reporting consistency",
            "lineageTag": "b6a6527e-5ffd-41df-9ce4-ca794a99c40b"
          },
          {
            "name": "Reporting Product Cost",
            "expression": [
              "SWITCH(SELECTEDVALUE('Reporting Product'[Product]), \"Cowork / Work IQ\", [Reporting Cowork Cost],",
              "\"Copilot Studio\", [Reporting Studio Cost],",
              "\"GitHub Copilot\", [Reporting GitHub Cost],",
              "\"Azure AI Foundry\", [Reporting Foundry Cost])"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Reporting consistency",
            "lineageTag": "7778e3bf-4617-4c96-968a-01f744b8b7ce"
          },
          {
            "name": "Reporting Cost Basis",
            "expression": [
              "SWITCH(SELECTEDVALUE('Reporting Product'[Product]),",
              "\"Cowork / Work IQ\", \"PAYG reference value; before prepaid capacity\",",
              "\"Copilot Studio\", \"Tenant quantities x configured prepaid/PAYG rates\",",
              "\"GitHub Copilot\", \"Export net usage amount; excludes seat subscriptions\",",
              "\"Azure AI Foundry\", \"Azure export cost in billing currency\")"
            ],
            "displayFolder": "Reporting consistency",
            "lineageTag": "97781b27-886a-44a9-9075-08ce493f0b45"
          },
          {
            "name": "Reporting Coverage",
            "expression": [
              "SWITCH(SELECTEDVALUE('Reporting Product'[Product]),",
              "\"Cowork / Work IQ\",",
              "    VAR Lo = CALCULATE(MIN('CreditsWeekly'[MetricDate]), REMOVEFILTERS())",
              "    VAR Hi = CALCULATE(MAX('CreditsWeekly'[MetricDate]), REMOVEFILTERS())",
              "    RETURN IF(ISBLANK(Lo), \"No source loaded\",",
              "        IF([Reporting Cowork Rows] = 0, \"No rows in selected dates; not confirmed zero\",",
              "            IF(Lo > [Reporting Start] || Hi < [Reporting End], \"Partial date coverage\", \"Date span covered\"))",
              "        & \" | source \" & FORMAT(Lo,\"yyyy-MM-dd\") & \" to \" & FORMAT(Hi,\"yyyy-MM-dd\")),",
              "\"Copilot Studio\",",
              "    VAR Lo = CALCULATE(MIN('Credit Consumption (Tenant)'[Usage_Date]), REMOVEFILTERS())",
              "    VAR Hi = CALCULATE(MAX('Credit Consumption (Tenant)'[Usage_Date]), REMOVEFILTERS())",
              "    RETURN IF(ISBLANK(Lo), \"No source loaded\",",
              "        IF([Reporting Studio Rows] = 0, \"No rows in selected dates; not confirmed zero\",",
              "            IF(Lo > [Reporting Start] || Hi < [Reporting End], \"Partial date coverage\", \"Date span covered\"))",
              "        & \" | source \" & FORMAT(Lo,\"yyyy-MM-dd\") & \" to \" & FORMAT(Hi,\"yyyy-MM-dd\")),",
              "\"GitHub Copilot\",",
              "    VAR Lo = CALCULATE(MIN('GitHub Usage'[Usage_Date]), REMOVEFILTERS())",
              "    VAR Hi = CALCULATE(MAX('GitHub Usage'[Usage_Date]), REMOVEFILTERS())",
              "    RETURN IF(ISBLANK(Lo), \"No source loaded\",",
              "        IF([Reporting GitHub Rows] = 0, \"No rows in selected dates; not confirmed zero\",",
              "            IF(Lo > [Reporting Start] || Hi < [Reporting End], \"Partial date coverage\", \"Date span covered\"))",
              "        & \" | source \" & FORMAT(Lo,\"yyyy-MM-dd\") & \" to \" & FORMAT(Hi,\"yyyy-MM-dd\")),",
              "\"Azure AI Foundry\",",
              "    VAR Lo = CALCULATE(MIN('AzureAiSpend'[UsageDate]), REMOVEFILTERS())",
              "    VAR Hi = CALCULATE(MAX('AzureAiSpend'[UsageDate]), REMOVEFILTERS())",
              "    RETURN IF(ISBLANK(Lo), \"No source loaded\",",
              "        IF([Reporting Foundry Rows] = 0, \"No rows in selected dates; not confirmed zero\",",
              "            IF(Lo > [Reporting Start] || Hi < [Reporting End], \"Partial date coverage\", \"Date span covered\"))",
              "        & \" | source \" & FORMAT(Lo,\"yyyy-MM-dd\") & \" to \" & FORMAT(Hi,\"yyyy-MM-dd\")))"
            ],
            "displayFolder": "Reporting consistency",
            "lineageTag": "6f2a47bf-c7d2-469d-8f1e-1f3f6a19da74"
          },
          {
            "name": "Reporting Caveat",
            "expression": "\"One date window applies to all dated sources on this page. Cowork uses whole weekly records dated within the window, not daily proration. Studio user/agent snapshots cannot be date-aligned and are excluded. Credits are product-specific units; cost bases differ, so no misleading grand total is shown.\"",
            "displayFolder": "Reporting consistency",
            "lineageTag": "ea337606-26e7-4725-bc64-fea60662311d"
          },
          {
            "name": "Studio Snapshot Note",
            "expression": [
              "VAR AgentRows = COUNTROWS('Credit Consumption (Agent)')",
              "VAR UserRows = COUNTROWS('Credit Consumption (User)')",
              "RETURN \"Date controls affect tenant totals only. User and agent detail is an undated export snapshot; costs are rate estimates, not an allocation of the selected-period PAYG bill. \"",
              "& IF(AgentRows = 0, \"No matching agent-detail rows: model/feature breakdown is unavailable. \", \"\")",
              "& IF(UserRows = 0, \"No matching user-detail rows. \", \"\")"
            ],
            "displayFolder": "Reporting consistency",
            "lineageTag": "25b35d32-ccaf-4067-a874-05131474353a"
          },
          {
            "name": "Azure Import Note",
            "expression": [
              "VAR UnknownRows = CALCULATE(COUNTROWS('AzureAiSpend'),",
              "    'AzureAiSpend'[ServiceName] = \"Not provided\")",
              "VAR Curr = CONCATENATEX(VALUES('AzureAiSpend'[Currency]), 'AzureAiSpend'[Currency], \", \")",
              "RETURN \"Azure cost currency: \" & IF(Curr = \"\", \"not supplied (no conversion assumed)\", Curr)",
              "    & IF(UnknownRows > 0, \". \" & FORMAT(UnknownRows,\"#,0\") & \" rows lack a service; Foundry/Studio allocation is unavailable.\", \"\")"
            ],
            "displayFolder": "Reporting consistency",
            "lineageTag": "cb009681-0dcf-4b1a-8fd4-3420b26a1cc9"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Cowork Period",
        "description": [
          "How much history the Cowork pages cover. Viva exports weekly snapshots, so",
          "the options are whole weeks rather than arbitrary dates - a day-level date",
          "picker would mostly select nothing.",
          "",
          "\"Current period\" is the four trailing weeks that make up a billing period,",
          "which is what every cost figure means by default."
        ],
        "lineageTag": "7a880001-0001-4001-8001-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Period",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[Period]",
            "sortByColumn": "Period Order",
            "lineageTag": "7a880001-0002-4001-8001-000000000002",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Period Order",
            "dataType": "int64",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[Period Order]",
            "formatString": "0",
            "lineageTag": "7a880001-0003-4001-8001-000000000003",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Weeks",
            "dataType": "int64",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[Weeks]",
            "formatString": "0",
            "lineageTag": "7a880001-0004-4001-8001-000000000004",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Cowork Period",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "// The window options are built from the history that is actually loaded,",
                "// so the labels cannot drift from the data. A tenant with six weeks of",
                "// export sees \"Current period (4 weeks)\" and \"All history (6 weeks)\";",
                "// one with a year sees all three. Options wider than the available",
                "// history are dropped rather than shown and silently clamped.",
                "//",
                "// VAR names avoid All and Filter: both are DAX functions, and a",
                "// colliding VAR name breaks every query on the model.",
                "VAR MaxWeeks =",
                "    COUNTROWS( DISTINCT( 'CreditsWeekly'[Week Index] ) )",
                "VAR Narrower =",
                "    FILTER(",
                "        UNION(",
                "            ROW( \"Period\", \"Current period (4 weeks)\", \"Period Order\", 1, \"Weeks\", 4 ),",
                "            ROW( \"Period\", \"Last 8 weeks\", \"Period Order\", 2, \"Weeks\", 8 )",
                "        ),",
                "        [Weeks] < MaxWeeks",
                "    )",
                "VAR Everything =",
                "    ROW(",
                "        \"Period\", \"All history (\" & FORMAT( MaxWeeks, \"#,0\" ) & \" weeks)\",",
                "        \"Period Order\", 3,",
                "        \"Weeks\", MaxWeeks",
                "    )",
                "RETURN",
                "    UNION( Narrower, Everything )",
                ""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Cowork Period Weeks",
            "description": [
              "Weeks of history in scope. Defaults to the four-week billing period, so",
              "every existing figure is unchanged until someone widens the window."
            ],
            "expression": [
              "",
              "VAR Picked = SELECTEDVALUE( 'Cowork Period'[Weeks] )",
              "RETURN IF( ISBLANK( Picked ), 4, Picked )",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Period",
            "lineageTag": "7a880001-0005-4001-8001-000000000005"
          },
          {
            "name": "Cowork Period Label",
            "description": "Names the window in prose, for chart subtitles and narrative cards.",
            "expression": [
              "",
              "VAR W = [Cowork Period Weeks]",
              "VAR MaxWeeks = MAXX( ALL( 'Cowork Period' ), 'Cowork Period'[Weeks] )",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        W = 4,          \"the current billing period\",",
              "        W >= MaxWeeks,  \"all history\",",
              "        \"the last \" & W & \" weeks\"",
              "    )",
              ""
            ],
            "displayFolder": "Period",
            "lineageTag": "7a880001-0006-4001-8001-000000000006"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "CoworkPeriodCreditLensViva"
          }
        ]
      },
      {
        "name": "Studio Period",
        "description": [
          "How much history the Studio pages cover. The Studio export is daily, and",
          "only the tenant-level file carries a date - the per-agent and per-user files",
          "have no date column at all, so those visuals always show the full extract.",
          "The period control therefore scopes the tenant-level trend and entitlement",
          "figures only, which is why it says so on the page."
        ],
        "lineageTag": "7a880002-0001-4001-8001-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Period",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[Period]",
            "sortByColumn": "Period Order",
            "lineageTag": "7a880002-0002-4001-8001-000000000002",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Period Order",
            "dataType": "int64",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[Period Order]",
            "formatString": "0",
            "lineageTag": "7a880002-0003-4001-8001-000000000003",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Days",
            "dataType": "int64",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[Days]",
            "formatString": "0",
            "lineageTag": "7a880002-0004-4001-8001-000000000004",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Studio Period",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE(",
                "    \"Period\", STRING, \"Period Order\", INTEGER, \"Days\", INTEGER,",
                "    {",
                "        { \"Last 7 days\",         1, 7 },",
                "        { \"All available days\",  2, 0 }",
                "    }",
                ")"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Studio Period Days",
            "description": "Days of history in scope. Zero means everything that was exported.",
            "expression": [
              "",
              "VAR Picked = SELECTEDVALUE( 'Studio Period'[Days] )",
              "RETURN IF( ISBLANK( Picked ), 0, Picked )",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Period",
            "lineageTag": "7a880002-0005-4001-8001-000000000005"
          },
          {
            "name": "Studio Period Start",
            "description": "The earliest usage date still in scope, for measures to filter against.",
            "expression": [
              "",
              "// WindowDays rather than Days, for readability. Note DAYS is in fact",
              "// a legal VAR name - probed against the engine - whereas DATE,",
              "// EARLIER and EARLIEST are not. An earlier version of this comment",
              "// claimed DAY was the problem; it is not.",
              "VAR WindowDays = [Studio Period Days]",
              "VAR Latest =",
              "    CALCULATE(",
              "        MAX( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "        REMOVEFILTERS( 'Credit Consumption (Tenant)'[Usage_Date] )",
              "    )",
              "RETURN",
              "    IF(",
              "        WindowDays = 0,",
              "        CALCULATE(",
              "            MIN( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "            REMOVEFILTERS( 'Credit Consumption (Tenant)'[Usage_Date] )",
              "        ),",
              "        Latest - WindowDays + 1",
              "    )",
              ""
            ],
            "formatString": "yyyy-mm-dd",
            "displayFolder": "Period",
            "lineageTag": "7a880002-0006-4001-8001-000000000006"
          },
          {
            "name": "Studio Period Label",
            "expression": [
              "",
              "VAR WindowDays = [Studio Period Days]",
              "RETURN IF( WindowDays = 0, \"all available days\", \"the last \" & WindowDays & \" days\" )",
              ""
            ],
            "displayFolder": "Period",
            "lineageTag": "7a880002-0007-4001-8001-000000000007"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "StudioPeriodCreditLensViva"
          }
        ]
      },
      {
        "name": "Growth Scenario",
        "description": [
          "What growth rate the twelve-month projection should assume.",
          "",
          "\"Fitted from history\" is the default and the honest answer - it uses the",
          "rate measured from the weekly history under whatever filters are applied.",
          "The other options are what-ifs for testing a different assumption, and are",
          "deliberately a short named list rather than a slider: a slider cannot",
          "express \"put it back how it was\"."
        ],
        "lineageTag": "9c990001-0001-4001-8001-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Scenario",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[Scenario]",
            "sortByColumn": "Scenario Order",
            "lineageTag": "9c990001-0002-4001-8001-000000000002",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Scenario Order",
            "dataType": "int64",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[Scenario Order]",
            "formatString": "0",
            "lineageTag": "9c990001-0003-4001-8001-000000000003",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Rate",
            "dataType": "double",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[Rate]",
            "formatString": "0.0%",
            "lineageTag": "9c990001-0004-4001-8001-000000000004",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Growth Scenario",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "// Rate is ignored for the fitted option - the measure branches on the",
                "// scenario name rather than on a sentinel value.",
                "DATATABLE(",
                "    \"Scenario\", STRING, \"Scenario Order\", INTEGER, \"Rate\", DOUBLE,",
                "    {",
                "        { \"Fitted from history\",     1,  0.0  },",
                "        { \"Flat - no growth\",        2,  0.0  },",
                "        { \"Grow 10% a month\",        3,  0.10 },",
                "        { \"Grow 20% a month\",        4,  0.20 },",
                "        { \"Grow 30% a month\",        5,  0.30 },",
                "        { \"Decline 10% a month\",     6, -0.10 }",
                "    }",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "GrowthScenarioCreditLensViva"
          }
        ]
      },
      {
        "name": "Agent Action Group",
        "description": [
          "The five recommended agent actions, as an axis for the Agents by",
          "Recommended Action chart. Disconnected by design - it is filtered by the",
          "measure rather than by a relationship.",
          "",
          "Labels must stay character-identical to the Agent Action measure."
        ],
        "lineageTag": "300369ef-9da9-4c86-b2a3-b1cfe8f45816",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Action",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Action]",
            "sortByColumn": "Action Order",
            "lineageTag": "58a05d4e-b06e-40d4-a3a4-fd0edcb0e922",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Action Order",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Action Order]",
            "lineageTag": "718b5c38-6beb-440b-8a07-5890c602e71d"
          }
        ],
        "partitions": [
          {
            "name": "Agent Action Group",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "// Agent Action is a measure, not a column -- it depends on Agent Credit",
                "// Share %, which is a share of whatever is currently filtered. So it cannot",
                "// be frozen into a calculated column the way Cowork's Seat Action is.",
                "//",
                "// This disconnected list gives the chart an axis to sit on. Agents in Action",
                "// then counts agents whose live action matches each label, so the bar chart",
                "// keeps responding to the period, environment, agent and product slicers and",
                "// always agrees with the Agent Action Queue table.",
                "//",
                "// These strings must match the Agent Action measure exactly, character for",
                "// character -- the match is done on the label itself.",
                "DATATABLE(",
                "    \"Action\", STRING,",
                "    \"Action Order\", INTEGER,",
                "    {",
                "        { \"1. Review - high volume, mostly billed\",   1 },",
                "        { \"2. Investigate - almost all billed\",       2 },",
                "        { \"3. Monitor - high volume, well covered\",   3 },",
                "        { \"4. Healthy - low volume, no action needed\", 4 },",
                "        { \"5. Unused - retire or promote\",            5 }",
                "    }",
                ")",
                ""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Agents in Action",
            "description": [
              "Number of agents whose current recommended action matches this label.",
              "Mirrors User Count on the Cowork seat chart.",
              "",
              "Counts agents from the per-agent export rather than the agent bridge. The",
              "bridge also carries agents seen only in the per-user export, and those have",
              "no agent-grain consumption to classify - they would land in \"Unused\" purely",
              "because they are missing from this file."
            ],
            "expression": [
              "",
              "VAR Lbl = SELECTEDVALUE( 'Agent Action Group'[Action] )",
              "RETURN",
              "    COUNTROWS(",
              "        FILTER(",
              "            VALUES( 'Credit Consumption (Agent)'[Agent_Name] ),",
              "            ISBLANK( Lbl ) || [Agent Action] = Lbl",
              "        )",
              "    )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "82586775-4ab6-4355-a1a5-07d4099cf3cd"
          },
          {
            "name": "Credits in Action",
            "description": [
              "Credits consumed by the agents sitting in this recommended action, for use",
              "as a tooltip on the Agents by Recommended Action chart."
            ],
            "expression": [
              "",
              "// The blank test lives inside FILTER rather than in an IF around it,",
              "// because IF cannot return a table expression here.",
              "VAR Lbl = SELECTEDVALUE( 'Agent Action Group'[Action] )",
              "VAR Scoped =",
              "    FILTER(",
              "        VALUES( 'Credit Consumption (Agent)'[Agent_Name] ),",
              "        ISBLANK( Lbl ) || [Agent Action] = Lbl",
              "    )",
              "RETURN",
              "    SUMX( Scoped, [Studio Consumed Credits (Agent)] )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "4306514e-e240-4a00-b55c-d10d5b7d9434"
          },
          {
            "name": "Cost in Action",
            "description": [
              "Billable cost of the agents sitting in this recommended action, so the",
              "chart can show what each group is worth in money as well as headcount."
            ],
            "expression": [
              "",
              "VAR Lbl = SELECTEDVALUE( 'Agent Action Group'[Action] )",
              "VAR Scoped =",
              "    FILTER(",
              "        VALUES( 'Credit Consumption (Agent)'[Agent_Name] ),",
              "        ISBLANK( Lbl ) || [Agent Action] = Lbl",
              "    )",
              "RETURN",
              "    SUMX( Scoped, [Billable Credit Cost (Agent)] )",
              ""
            ],
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "14db8bd9-9167-48bc-86dd-81c060f33dae"
          }
        ]
      },
      {
        "name": "GitHub Usage",
        "lineageTag": "gh100001-0001-0001-0001-000000000001",
        "columns": [
          {
            "name": "Usage_Date",
            "dataType": "dateTime",
            "sourceColumn": "Usage_Date",
            "formatString": "yyyy-mm-dd",
            "lineageTag": "gh100001-col0-0001-000000000001",
            "summarizeBy": "none"
          },
          {
            "name": "Username",
            "dataType": "string",
            "sourceColumn": "Username",
            "lineageTag": "gh100001-col0-0001-000000000002",
            "summarizeBy": "none"
          },
          {
            "name": "Sku",
            "dataType": "string",
            "sourceColumn": "Sku",
            "lineageTag": "gh100001-col0-0001-000000000003",
            "summarizeBy": "none"
          },
          {
            "name": "Model",
            "dataType": "string",
            "sourceColumn": "Model",
            "lineageTag": "gh100001-col0-0001-000000000004",
            "summarizeBy": "none"
          },
          {
            "name": "Credits",
            "dataType": "double",
            "sourceColumn": "Credits",
            "formatString": "#,0",
            "lineageTag": "gh100001-col0-0001-000000000005",
            "summarizeBy": "sum"
          },
          {
            "name": "Gross_Amount",
            "dataType": "double",
            "sourceColumn": "Gross_Amount",
            "formatString": "\\$#,0.00",
            "lineageTag": "gh100001-col0-0001-000000000006",
            "summarizeBy": "sum"
          },
          {
            "name": "Discount_Amount",
            "dataType": "double",
            "sourceColumn": "Discount_Amount",
            "formatString": "\\$#,0.00",
            "lineageTag": "gh100001-col0-0001-000000000007",
            "summarizeBy": "sum"
          },
          {
            "name": "Net_Amount",
            "dataType": "double",
            "sourceColumn": "Net_Amount",
            "formatString": "\\$#,0.00",
            "lineageTag": "gh100001-col0-0001-000000000008",
            "summarizeBy": "sum"
          },
          {
            "name": "Cost_Centre",
            "dataType": "string",
            "sourceColumn": "Cost_Centre",
            "lineageTag": "gh100001-col0-0001-000000000009",
            "summarizeBy": "none"
          },
          {
            "name": "Organization",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Organization",
            "lineageTag": "gh100001-col0-0001-000000000010",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Usage Type",
            "dataType": "string",
            "description": [
              "Coding agent work is billed under its own SKU. Splitting it out separates",
              "interactive chat from autonomous agent runs, which behave very differently."
            ],
            "expression": [
              "IF(",
              "    CONTAINSSTRING( 'GitHub Usage'[Sku], \"coding_agent\" ),",
              "    \"Coding agent\",",
              "    \"Chat and inline\"",
              ")"
            ],
            "lineageTag": "gh100001-col0-0001-000000000011",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Model Tier",
            "dataType": "string",
            "description": [
              "Model names churn every few months; the tier does not. Grouping on tier",
              "keeps trend analysis stable across model releases."
            ],
            "expression": [
              "VAR m = LOWER( 'GitHub Usage'[Model] )",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        CONTAINSSTRING( m, \"opus\" ) || CONTAINSSTRING( m, \"codex\" )",
              "            || CONTAINSSTRING( m, \"gpt-5.5\" ) || CONTAINSSTRING( m, \"sol\" )",
              "            || CONTAINSSTRING( m, \"pro\" ),          \"3. Powerful\",",
              "        CONTAINSSTRING( m, \"mini\" ) || CONTAINSSTRING( m, \"nano\" )",
              "            || CONTAINSSTRING( m, \"haiku\" ) || CONTAINSSTRING( m, \"flash\" )",
              "            || CONTAINSSTRING( m, \"luna\" ),         \"1. Lightweight\",",
              "        \"2. Versatile\"",
              "    )"
            ],
            "lineageTag": "gh100001-col0-0001-000000000012",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "GitHub Usage",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "\t// A missing table is a supported state: this product's pages",
                "\t// come up empty and nothing else is affected.",
                "\tTbl = GetTable(\"github_ai_usage\"),",
                "\tResult =",
                "\t\tif Tbl = null then",
                "\t\t\t#table(type table [#\"Usage_Date\" = datetime, #\"Username\" = text, #\"Sku\" = text, #\"Model\" = text, #\"Credits\" = number, #\"Gross_Amount\" = number, #\"Discount_Amount\" = number, #\"Net_Amount\" = number, #\"Cost_Centre\" = text, #\"Organization\" = text], {})",
                "\t\telse",
                "\t\t\tlet",
                "\t\t\t\tKept = Table.SelectColumns(Tbl, {\"usage_date\", \"username\", \"sku\", \"model\", \"quantity\", \"gross_amount\", \"discount_amount\", \"net_amount\", \"cost_center_name\", \"organization\"}, MissingField.UseNull),",
                "\t\t\t\tRenamed = Table.RenameColumns(Kept, {{\"usage_date\", \"Usage_Date\"}, {\"username\", \"Username\"}, {\"sku\", \"Sku\"}, {\"model\", \"Model\"}, {\"quantity\", \"Credits\"}, {\"gross_amount\", \"Gross_Amount\"}, {\"discount_amount\", \"Discount_Amount\"}, {\"net_amount\", \"Net_Amount\"}, {\"cost_center_name\", \"Cost_Centre\"}, {\"organization\", \"Organization\"}}),",
                "\t\tTyped = Table.TransformColumnTypes(Renamed, {{\"Usage_Date\", type datetime}})",
                "\t\t\tin",
                "\t\t\t\tTyped",
                "in",
                "\tResult"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "GHCP Credits Used",
            "description": [
              "AI credits consumed through GitHub Copilot in the selected period.",
              "Code completions and next-edit suggestions are unlimited on every paid plan",
              "and never appear here, so completion volume is not a cost driver."
            ],
            "expression": [
              "",
              "// KEEPFILTERS, not a bare FILTER. Without it the period window REPLACES the",
              "// date context a chart axis supplies, so every point returns the whole-period",
              "// total and the trend renders flat.",
              "VAR FromDate = [GHCP Period Start]",
              "RETURN",
              "CALCULATE(",
              "    SUM( 'GitHub Usage'[Credits] ),",
              "    KEEPFILTERS(",
              "        FILTER(",
              "            ALL( 'GitHub Usage'[Usage_Date] ),",
              "            'GitHub Usage'[Usage_Date] >= FromDate",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "GHCP\\Consumption",
            "lineageTag": "dac0348b-46eb-462f-a109-0c93271c5252"
          },
          {
            "name": "GHCP Active Developers",
            "description": "Developers who consumed at least one AI credit in the selected period.",
            "expression": [
              "",
              "VAR FromDate = [GHCP Period Start]",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT( 'GitHub Usage'[Username] ),",
              "    KEEPFILTERS(",
              "        FILTER(",
              "            ALL( 'GitHub Usage'[Usage_Date] ),",
              "            'GitHub Usage'[Usage_Date] >= FromDate",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "GHCP\\Consumption",
            "lineageTag": "16d2d5ec-58f8-44f7-a469-6fd03f5ee7ac"
          },
          {
            "name": "GHCP Licensed Developers",
            "description": "Developers holding a Copilot seat, whether or not they used it.",
            "expression": "COUNTROWS( ALL( 'GitHub User' ) )",
            "formatString": "#,0",
            "displayFolder": "GHCP\\Consumption",
            "lineageTag": "e5056a60-ee40-479d-bd1b-4fdb2caef8e0"
          },
          {
            "name": "GHCP Credits per Developer",
            "description": "Average credits per active developer.",
            "expression": "DIVIDE( [GHCP Credits Used], [GHCP Active Developers] )",
            "formatString": "#,0",
            "displayFolder": "GHCP\\Consumption",
            "lineageTag": "234eb461-8588-43a9-9e0c-809792f8815e"
          },
          {
            "name": "GHCP Gross Value",
            "description": [
              "What the consumption would be worth with no allowance behind it.",
              "",
              "NOT a cost. Most or all of it is absorbed by the credits included with",
              "the seats, so it is shown as \"Usage value (not billed)\" rather than",
              "sitting in a cost row where it would read as a bill."
            ],
            "expression": [
              "",
              "VAR FromDate = [GHCP Period Start]",
              "RETURN",
              "CALCULATE(",
              "    SUM( 'GitHub Usage'[Gross_Amount] ),",
              "    KEEPFILTERS(",
              "        FILTER(",
              "            ALL( 'GitHub Usage'[Usage_Date] ),",
              "            'GitHub Usage'[Usage_Date] >= FromDate",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "GHCP\\Cost",
            "lineageTag": "75ab27d5-a5e0-439e-b5cd-6cbe989001ae"
          },
          {
            "name": "GHCP Allowance Absorbed",
            "description": [
              "The portion of consumption absorbed by the included allowance and therefore",
              "never billed. GitHub computes this server-side, so unlike the Cowork prepaid",
              "split it is measured rather than assumed."
            ],
            "expression": [
              "",
              "VAR FromDate = [GHCP Period Start]",
              "RETURN",
              "CALCULATE(",
              "    SUM( 'GitHub Usage'[Discount_Amount] ),",
              "    KEEPFILTERS(",
              "        FILTER(",
              "            ALL( 'GitHub Usage'[Usage_Date] ),",
              "            'GitHub Usage'[Usage_Date] >= FromDate",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "GHCP\\Cost",
            "lineageTag": "e422994e-dec4-4cd7-926e-aea1362a0e0d"
          },
          {
            "name": "GHCP Overage Cost",
            "description": [
              "Credit consumption beyond the shared pool, billed pay-as-you-go at",
              "the rate in Settings. GitHub calls this overage; it is the same mechanism as",
              "Cowork pay-as-you-go, so the report uses one term for both."
            ],
            "expression": [
              "",
              "VAR FromDate = [GHCP Period Start]",
              "RETURN",
              "CALCULATE(",
              "    SUM( 'GitHub Usage'[Net_Amount] ),",
              "    KEEPFILTERS(",
              "        FILTER(",
              "            ALL( 'GitHub Usage'[Usage_Date] ),",
              "            'GitHub Usage'[Usage_Date] >= FromDate",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "GHCP\\Cost",
            "lineageTag": "8220bfbe-5cf9-490f-932b-e59f83f41bbd"
          },
          {
            "name": "GHCP Overage Share %",
            "description": "Share of consumption that fell outside the included allowance.",
            "expression": "DIVIDE( [GHCP Overage Cost], [GHCP Gross Value] )",
            "formatString": "0.0%",
            "displayFolder": "GHCP\\Cost",
            "lineageTag": "210c0d37-cb80-4fdc-bbb7-13b9cd740b21"
          },
          {
            "name": "GHCP Days Observed",
            "description": [
              "Distinct days on which any GitHub Copilot consumption was recorded, within",
              "the selected period."
            ],
            "expression": [
              "",
              "VAR FromDate = [GHCP Period Start]",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT( 'GitHub Usage'[Usage_Date] ),",
              "    KEEPFILTERS(",
              "        FILTER(",
              "            ALL( 'GitHub Usage'[Usage_Date] ),",
              "            'GitHub Usage'[Usage_Date] >= FromDate",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "GHCP\\Consumption",
            "lineageTag": "9156828e-e476-4e6f-adc0-3b2bcc085064"
          },
          {
            "name": "GHCP Total Cost",
            "description": "Total cost of running GitHub Copilot: seats plus any credit overage.",
            "expression": "[GHCP Seat Cost (Monthly)] + [GHCP Overage Cost]",
            "formatString": "\\$#,0",
            "displayFolder": "GHCP\\Cost",
            "lineageTag": "195a0d05-1fc7-4b83-99c6-e0a428840508"
          },
          {
            "name": "GHCP Latest Month Credits",
            "description": [
              "Credits consumed in the most recent complete month inside the selected",
              "period. The basis for every forward-looking figure on the forecast page."
            ],
            "expression": [
              "",
              "VAR FromDate = [GHCP Period Start]",
              "VAR Scoped =",
              "    FILTER( ALL( 'GitHub Usage'[Usage_Date] ), 'GitHub Usage'[Usage_Date] >= FromDate )",
              "VAR LastDay = MAXX( Scoped, 'GitHub Usage'[Usage_Date] )",
              "RETURN",
              "CALCULATE(",
              "    SUM( 'GitHub Usage'[Credits] ),",
              "    KEEPFILTERS(",
              "        FILTER(",
              "            ALL( 'GitHub Usage'[Usage_Date] ),",
              "            YEAR( 'GitHub Usage'[Usage_Date] ) = YEAR( LastDay )",
              "                && MONTH( 'GitHub Usage'[Usage_Date] ) = MONTH( LastDay )",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "GHCP\\Forecast",
            "lineageTag": "992a907a-c86b-449b-a93f-6ed7dedd1dc5"
          },
          {
            "name": "GHCP Overage From September",
            "description": [
              "What the latest month's consumption would cost once the promotional",
              "allowance ends on 1 September 2026 - same usage, smaller pool.",
              "",
              "This is the single most useful number on the page: a tenant reviewing a",
              "zero-overage bill today has no other way to see it coming."
            ],
            "expression": [
              "",
              "VAR Usage = [GHCP Latest Month Credits]",
              "VAR PoolSep = [GHCP Pool From September]",
              "RETURN MAX( 0, Usage - PoolSep ) * [GitHub Rate Value]",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "GHCP\\Forecast",
            "lineageTag": "a7da3285-9c44-4218-987e-a4393a1f1ad1"
          },
          {
            "name": "GHCP Observed Growth %",
            "description": [
              "Observed month-on-month growth in credit consumption, fitted across the",
              "selected period. Blank when only one month is in scope - a single point",
              "cannot describe a trend."
            ],
            "expression": [
              "",
              "// VAR names avoid First and Last: both are DAX functions, and a colliding",
              "// VAR name breaks every query on the model rather than just this measure.",
              "VAR FromDate = [GHCP Period Start]",
              "VAR Scoped =",
              "    FILTER( ALL( 'GitHub Usage'[Usage_Date] ), 'GitHub Usage'[Usage_Date] >= FromDate )",
              "VAR MonthKeys =",
              "    ADDCOLUMNS(",
              "        Scoped,",
              "        \"@ym\", YEAR( 'GitHub Usage'[Usage_Date] ) * 12",
              "                 + MONTH( 'GitHub Usage'[Usage_Date] )",
              "    )",
              "VAR FirstMonth = MINX( MonthKeys, [@ym] )",
              "VAR LastMonth  = MAXX( MonthKeys, [@ym] )",
              "VAR Span = LastMonth - FirstMonth",
              "VAR FirstVal =",
              "    CALCULATE(",
              "        SUM( 'GitHub Usage'[Credits] ),",
              "        KEEPFILTERS(",
              "            FILTER(",
              "                ALL( 'GitHub Usage'[Usage_Date] ),",
              "                YEAR( 'GitHub Usage'[Usage_Date] ) * 12",
              "                    + MONTH( 'GitHub Usage'[Usage_Date] ) = FirstMonth",
              "            )",
              "        )",
              "    )",
              "VAR LastVal =",
              "    CALCULATE(",
              "        SUM( 'GitHub Usage'[Credits] ),",
              "        KEEPFILTERS(",
              "            FILTER(",
              "                ALL( 'GitHub Usage'[Usage_Date] ),",
              "                YEAR( 'GitHub Usage'[Usage_Date] ) * 12",
              "                    + MONTH( 'GitHub Usage'[Usage_Date] ) = LastMonth",
              "            )",
              "        )",
              "    )",
              "RETURN",
              "    IF( Span > 0 && FirstVal > 0, ( LastVal / FirstVal ) ^ ( 1 / Span ) - 1 )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "GHCP\\Forecast",
            "lineageTag": "19ffecfe-a965-4ff3-8280-172d70912c14"
          },
          {
            "name": "GHCP Seats With No Credit Use",
            "description": [
              "Seats held by developers who consumed no credits at all in the period.",
              "Completions are unlimited and unmetered, so a developer can be genuinely",
              "productive and still appear here - treat it as a prompt to check, not proof",
              "the seat is wasted."
            ],
            "expression": "[GHCP Licensed Developers] - [GHCP Active Developers]",
            "formatString": "#,0",
            "displayFolder": "GHCP\\Optimisation",
            "lineageTag": "f65f08aa-d55d-4406-84d5-a38f32f3ff8d"
          },
          {
            "name": "GHCP Seat Cost With No Credit Use",
            "description": [
              "Monthly seat cost carried by developers who consumed no credits in the",
              "selected period."
            ],
            "expression": [
              "",
              "VAR FromDate = [GHCP Period Start]",
              "VAR Active =",
              "    CALCULATETABLE(",
              "        VALUES( 'GitHub Usage'[Username] ),",
              "        KEEPFILTERS(",
              "            FILTER(",
              "                ALL( 'GitHub Usage'[Usage_Date] ),",
              "                'GitHub Usage'[Usage_Date] >= FromDate",
              "            )",
              "        )",
              "    )",
              "RETURN",
              "SUMX(",
              "    FILTER( ALL( 'GitHub User' ), NOT ( 'GitHub User'[Username] IN Active ) ),",
              "    IF( 'GitHub User'[Plan] = \"Copilot Enterprise\", 39, 19 )",
              ")",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "GHCP\\Optimisation",
            "lineageTag": "d85a12ca-34a7-4497-95eb-02013e675a44"
          },
          {
            "name": "GHCP Powerful Model Share %",
            "description": [
              "Share of credits spent on the most expensive model tier. High-end models",
              "cost roughly ten times a lightweight one per token, so a large share here is",
              "the biggest single lever on credit consumption."
            ],
            "expression": [
              "",
              "DIVIDE(",
              "    CALCULATE( [GHCP Credits Used], 'GitHub Usage'[Model Tier] = \"3. Powerful\" ),",
              "    CALCULATE( [GHCP Credits Used], ALL( 'GitHub Usage'[Model Tier] ) )",
              ")",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "GHCP\\Optimisation",
            "lineageTag": "b0a7495b-12cb-4235-8e0f-88cf7c72a08f"
          },
          {
            "name": "GHCP Coding Agent Share %",
            "description": [
              "Share of credits consumed by autonomous coding agent runs rather than",
              "interactive chat. Agent work is billed under its own SKU and behaves very",
              "differently - it runs unattended, so it scales with jobs, not with people."
            ],
            "expression": [
              "",
              "DIVIDE(",
              "    CALCULATE( [GHCP Credits Used], 'GitHub Usage'[Usage Type] = \"Coding agent\" ),",
              "    CALCULATE( [GHCP Credits Used], ALL( 'GitHub Usage'[Usage Type] ) )",
              ")",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "GHCP\\Optimisation",
            "lineageTag": "58e62cde-0bff-4103-8d88-eaef0a0087a2"
          },
          {
            "name": "GHCP Top 10% Share",
            "description": [
              "Share of credits consumed by the heaviest 10% of developers. A high figure",
              "means pool pressure is driven by a small group, so enablement or guardrails",
              "aimed at them move the number more than anything org-wide."
            ],
            "expression": [
              "",
              "VAR PerDev =",
              "    ADDCOLUMNS( VALUES( 'GitHub Usage'[Username] ), \"@c\", [GHCP Credits Used] )",
              "VAR Total = SUMX( PerDev, [@c] )",
              "VAR HowMany = ROUNDUP( COUNTROWS( PerDev ) * 0.1, 0 )",
              "VAR TopSlice = TOPN( HowMany, PerDev, [@c], DESC )",
              "RETURN DIVIDE( SUMX( TopSlice, [@c] ), Total )",
              ""
            ],
            "formatString": "0%",
            "displayFolder": "GHCP\\Optimisation",
            "lineageTag": "61c7bb5f-3e00-4a34-9473-5441a53f3451"
          },
          {
            "name": "GHCP Cost per Developer",
            "description": "Monthly cost of a seat plus its share of any overage.",
            "expression": "DIVIDE( [GHCP Total Cost], [GHCP Licensed Developers] )",
            "formatString": "\\$#,0.00",
            "displayFolder": "GHCP\\Optimisation",
            "lineageTag": "a057ec6f-30d1-4866-975e-f1c9591697fd"
          },
          {
            "name": "GHCP Cost Headline",
            "description": [
              "One line stating where GitHub Copilot cost actually sits, so the page opens",
              "with a sentence rather than a number."
            ],
            "expression": [
              "",
              "VAR Seats = [GHCP Seat Cost (Monthly)]",
              "VAR Over  = [GHCP Overage Cost]",
              "VAR Months = MAX( 1, [GHCP Months Observed] )",
              "VAR AbsorbedMonthly = DIVIDE( [GHCP Allowance Absorbed], Months )",
              "RETURN",
              "    IF(",
              "        ISBLANK( Seats ) || Seats = 0,",
              "        \"No GitHub Copilot seats in this selection.\",",
              "        \"Seats cost \" & FORMAT( Seats, \"$#,0\" ) & \" a month, pay-as-you-go credits \"",
              "            & FORMAT( Over, \"$#,0\" ) & \". The allowance absorbs about \"",
              "            & FORMAT( AbsorbedMonthly, \"$#,0\" ) & \" of consumption a month.\"",
              "    )",
              ""
            ],
            "displayFolder": "GHCP\\Narrative",
            "lineageTag": "267f64a1-99fb-4b70-a7cc-2404607e5133"
          },
          {
            "name": "GHCP September Cliff",
            "description": [
              "What happens to the included AI credit allowance when the published rates",
              "change. Reads the date and the standard allowances from 'GHCP Allowance",
              "Change', says nothing is pending if this tenant is already on standard",
              "rates, and switches to past tense once the date has passed.",
              "",
              "VAR names avoid Today and Lead: both are DAX functions, and a colliding",
              "VAR name breaks every query on the model rather than just this measure."
            ],
            "expression": [
              "",
              "VAR Pool     = [GHCP Monthly Pool]",
              "VAR PoolNext = [GHCP Pool From September]",
              "VAR Usage    = [GHCP Latest Month Credits]",
              "VAR OverNext = [GHCP Overage From September]",
              "VAR Growth   = [GHCP Growth Applied %]",
              "VAR ChangeDate =",
              "    [GitHub Allowance Change Date]",
              "VAR IsPending = ChangeDate > TODAY()",
              "VAR DateTxt = FORMAT( ChangeDate, \"d mmmm yyyy\" )",
              "VAR ProjOver = MAX( 0, Usage * POWER( 1 + Growth, 2 ) - PoolNext ) * [GitHub Rate Value]",
              "VAR Preamble =",
              "    IF(",
              "        IsPending,",
              "        \"From \" & DateTxt & \" the allowance falls \",",
              "        \"Since \" & DateTxt & \" the allowance has fallen \"",
              "    )",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK( Usage ) || Usage = 0,",
              "            \"No GitHub Copilot consumption in this selection.\",",
              "        Pool = PoolNext,",
              "            \"This tenant is already on the standard included allowance of \"",
              "                & FORMAT( Pool, \"#,0\" ) & \" credits a month, so no change is pending.\",",
              "        Preamble & FORMAT( ABS( [GHCP Pool Change %] ), \"0%\" )",
              "            & \", from \" & FORMAT( Pool, \"#,0\" ) & \" to \" & FORMAT( PoolNext, \"#,0\" )",
              "            & \". At current volumes that turns a \" & FORMAT( [GHCP Overage Cost], \"$#,0\" )",
              "            & \" credit bill into \" & FORMAT( OverNext, \"$#,0\" ) & \" a month\"",
              "            & IF(",
              "                Growth > 0,",
              "                \" - and nearer \" & FORMAT( ProjOver, \"$#,0\" ) & \" if the \"",
              "                    & FORMAT( Growth, \"0%\" ) & \" monthly growth holds.\",",
              "                \".\"",
              "              )",
              "    )",
              ""
            ],
            "displayFolder": "GHCP\\Narrative",
            "lineageTag": "1d8afac0-38fd-4be2-a2a2-3439d73bc80b"
          },
          {
            "name": "GHCP Basis Note",
            "description": "Plain statement of what the GHCP figures rest on and what they exclude.",
            "expression": [
              "",
              "VAR d = [GHCP Days Observed]",
              "RETURN",
              "    \"Based on \" & FORMAT( d, \"#,0\" ) & \" days of billed credit usage. \"",
              "        & \"Code completions and next-edit suggestions are unlimited on every paid plan \"",
              "        & \"and are not billed, so they never appear here.\"",
              ""
            ],
            "displayFolder": "GHCP\\Narrative",
            "lineageTag": "084ae758-f4f0-4229-bdbd-4fe96b63cc38"
          },
          {
            "name": "GHCP Concentration Summary",
            "description": "Where credit consumption is concentrated, in words.",
            "expression": [
              "",
              "VAR Share = [GHCP Top 10% Share]",
              "VAR Powerful = [GHCP Powerful Model Share %]",
              "RETURN",
              "    IF(",
              "        ISBLANK( Share ),",
              "        \"No GitHub Copilot consumption in this selection.\",",
              "        \"The heaviest 10% of developers account for \" & FORMAT( Share, \"0%\" )",
              "            & \" of credits, and \" & FORMAT( Powerful, \"0%\" )",
              "            & \" of all credits go to top-tier models.\"",
              "    )",
              ""
            ],
            "displayFolder": "GHCP\\Narrative",
            "lineageTag": "efb3e596-61f7-4da5-9c3f-7761fe7cf98c"
          },
          {
            "name": "GHCP Months Observed",
            "description": [
              "Distinct calendar months present in the selected period. Counting days and",
              "dividing by 28 overstates the monthly rate, because the export only carries",
              "working days - about 20 a month, not 28."
            ],
            "expression": [
              "",
              "VAR FromDate = [GHCP Period Start]",
              "VAR Scoped =",
              "    CALCULATETABLE(",
              "        VALUES( 'GitHub Usage'[Usage_Date] ),",
              "        KEEPFILTERS(",
              "            FILTER(",
              "                ALL( 'GitHub Usage'[Usage_Date] ),",
              "                'GitHub Usage'[Usage_Date] >= FromDate",
              "            )",
              "        )",
              "    )",
              "RETURN",
              "    COUNTROWS(",
              "        SUMMARIZE(",
              "            ADDCOLUMNS(",
              "                Scoped,",
              "                \"@ym\", YEAR( 'GitHub Usage'[Usage_Date] ) * 12",
              "                         + MONTH( 'GitHub Usage'[Usage_Date] )",
              "            ),",
              "            [@ym]",
              "        )",
              "    )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "GHCP\\Consumption",
            "lineageTag": "a8c8c564-48dd-42d1-846a-8d84a088edb5"
          },
          {
            "name": "GHCP Credits /mo",
            "description": [
              "GitHub Copilot credits normalised to a month, from the calendar months",
              "actually present in the selection."
            ],
            "expression": "DIVIDE( [GHCP Credits Used], MAX( 1, [GHCP Months Observed] ) )",
            "formatString": "#,0",
            "displayFolder": "All products",
            "lineageTag": "53bb6c87-402f-458d-a608-97546e95ff47"
          },
          {
            "name": "GHCP Cost /mo",
            "description": [
              "GitHub Copilot cost normalised to a month: seats plus any credit overage.",
              "Seats are already a monthly figure; overage is averaged over the months in",
              "the selection."
            ],
            "expression": [
              "",
              "[GHCP Seat Cost (Monthly)]",
              "    + DIVIDE( [GHCP Overage Cost], MAX( 1, [GHCP Months Observed] ) )",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "All products",
            "lineageTag": "1897d4a9-f65d-4c90-bc9a-e3d210edadac"
          },
          {
            "name": "GHCP Latest Usage Date",
            "description": [
              "The last day on which any GitHub Copilot credit was drawn, within the",
              "selected period. Anchors the projection - month 1 is the month after this."
            ],
            "expression": [
              "",
              "VAR FromDate = [GHCP Period Start]",
              "RETURN",
              "    MAXX(",
              "        FILTER(",
              "            ALL( 'GitHub Usage'[Usage_Date] ),",
              "            'GitHub Usage'[Usage_Date] >= FromDate",
              "        ),",
              "        'GitHub Usage'[Usage_Date]",
              "    )",
              ""
            ],
            "formatString": "dd mmm yyyy",
            "isHidden": true,
            "lineageTag": "a54d1aef-374a-4de3-8ad4-8b5fed3781a2"
          },
          {
            "name": "GHCP Growth Applied %",
            "description": [
              "The month-on-month growth rate used by the forecast. Follows the Growth",
              "Assumption slicer; with no selection, or on \"Fitted from history\", it uses",
              "the rate actually observed in this tenant's own usage."
            ],
            "expression": [
              "",
              "VAR Chosen = SELECTEDVALUE( 'Growth Scenario'[Scenario], \"Fitted from history\" )",
              "VAR Rate   = SELECTEDVALUE( 'Growth Scenario'[Rate] )",
              "RETURN",
              "    IF( Chosen = \"Fitted from history\", COALESCE( [GHCP Observed Growth %], 0 ), Rate )",
              ""
            ],
            "formatString": "0.0%",
            "lineageTag": "523acffd-824c-4e9c-99d2-b073c352365f"
          },
          {
            "name": "GHCP Month Credits",
            "description": [
              "Projected credits for month N of the next twelve, growing the most recent",
              "full month at the chosen rate."
            ],
            "expression": [
              "",
              "VAR m = SELECTEDVALUE( 'Projection Month'[Value] )",
              "VAR g = [GHCP Growth Applied %]",
              "RETURN",
              "    IF( m >= 1 && m <= 12, [GHCP Latest Month Credits] * POWER( 1 + g, m ) )",
              ""
            ],
            "formatString": "#,0",
            "lineageTag": "dcfb7652-274b-4125-a82a-b8f3ab648f37"
          },
          {
            "name": "GHCP Month Pool",
            "description": [
              "The included credit allowance that applies in projection month N. Steps",
              "down automatically for months at or beyond the allowance change date held",
              "in Settings."
            ],
            "expression": [
              "",
              "VAR m = SELECTEDVALUE( 'Projection Month'[Value] )",
              "VAR Anchor = [GHCP Latest Usage Date]",
              "VAR ProjMonth = EOMONTH( Anchor, m )",
              "VAR ChangeDate = [GitHub Allowance Change Date]",
              "RETURN",
              "    IF(",
              "        m >= 1 && m <= 12,",
              "        IF( ProjMonth >= ChangeDate, [GHCP Pool From September], [GHCP Monthly Pool] )",
              "    )",
              ""
            ],
            "formatString": "#,0",
            "lineageTag": "1eb4839d-30b3-4800-8d81-ea9e63603240"
          },
          {
            "name": "GHCP Month Credit Cost",
            "description": [
              "Projected pay-as-you-go credit spend in projection month N: whatever the",
              "month's credits exceed that month's allowance, at the published rate."
            ],
            "expression": [
              "",
              "VAR m = SELECTEDVALUE( 'Projection Month'[Value] )",
              "VAR Credits = [GHCP Month Credits]",
              "VAR Pool = [GHCP Month Pool]",
              "VAR CreditRate = [GitHub Rate Value]",
              "RETURN",
              "    IF( m >= 1 && m <= 12, MAX( 0, Credits - Pool ) * CreditRate )",
              ""
            ],
            "formatString": "$#,0",
            "lineageTag": "4a8ee1dd-7115-4b7a-a032-04ea93cf2bb2"
          },
          {
            "name": "GHCP Month Cost",
            "description": [
              "Projected total spend in projection month N - seats plus any credits drawn",
              "beyond that month's allowance."
            ],
            "expression": [
              "",
              "VAR m = SELECTEDVALUE( 'Projection Month'[Value] )",
              "RETURN",
              "    IF( m >= 1 && m <= 12, [GHCP Seat Cost (Monthly)] + [GHCP Month Credit Cost] )",
              ""
            ],
            "formatString": "$#,0",
            "lineageTag": "4bd84139-e1ee-47a9-80d5-d46225acf734"
          },
          {
            "name": "GHCP Year Credits",
            "description": "Total projected credits across the next twelve months.",
            "expression": [
              "",
              "VAR g = [GHCP Growth Applied %]",
              "VAR Base = [GHCP Latest Month Credits]",
              "RETURN",
              "    SUMX( GENERATESERIES( 1, 12, 1 ), Base * POWER( 1 + g, [Value] ) )",
              ""
            ],
            "formatString": "#,0",
            "lineageTag": "8205c6b5-2a69-448b-ae35-d6a56640b667"
          },
          {
            "name": "GHCP Year Cost",
            "description": [
              "Total projected spend across the next twelve months - twelve months of",
              "seats, plus credits beyond the allowance applying in each month."
            ],
            "expression": [
              "",
              "VAR g = [GHCP Growth Applied %]",
              "VAR Base = [GHCP Latest Month Credits]",
              "VAR Seats = [GHCP Seat Cost (Monthly)]",
              "VAR Anchor = [GHCP Latest Usage Date]",
              "VAR ChangeDate = [GitHub Allowance Change Date]",
              "VAR PoolNow = [GHCP Monthly Pool]",
              "VAR PoolNext = [GHCP Pool From September]",
              "VAR CreditRate = [GitHub Rate Value]",
              "RETURN",
              "    SUMX(",
              "        GENERATESERIES( 1, 12, 1 ),",
              "        VAR m = [Value]",
              "        VAR Credits = Base * POWER( 1 + g, m )",
              "        VAR Pool = IF( EOMONTH( Anchor, m ) >= ChangeDate, PoolNext, PoolNow )",
              "        RETURN Seats + MAX( 0, Credits - Pool ) * CreditRate",
              "    )",
              ""
            ],
            "formatString": "$#,0",
            "lineageTag": "fd6f167a-179e-46ec-b961-bea8a6fad8f0"
          },
          {
            "name": "GHCP Forecast Summary",
            "description": [
              "Plain-English summary of the GitHub Copilot forecast. Every figure is read",
              "from the model, including how much history the fitted rate is based on."
            ],
            "expression": [
              "",
              "VAR g      = [GHCP Growth Applied %]",
              "VAR Cost   = [GHCP Year Cost]",
              "VAR Seats  = [GHCP Seat Cost (Monthly)] * 12",
              "VAR Cred   = Cost - Seats",
              "VAR Months = [GHCP Months Observed]",
              "VAR Usage  = [GHCP Latest Month Credits]",
              "VAR IsFitted =",
              "    SELECTEDVALUE( 'Growth Scenario'[Scenario], \"Fitted from history\" )",
              "        = \"Fitted from history\"",
              "VAR Basis =",
              "    IF(",
              "        IsFitted,",
              "        \"Fitted from \" & FORMAT( Months, \"#,0\" )",
              "            & IF( Months = 1, \" month\", \" months\" ) & \" of history, usage is growing \"",
              "            & FORMAT( g, \"0.0%\" ) & \" a month\",",
              "        \"Using your rate of \" & FORMAT( g, \"0.0%\" ) & \" a month\"",
              "    )",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK( Usage ) || Usage = 0,",
              "            \"No GitHub Copilot consumption in this selection.\",",
              "        ISBLANK( g ),",
              "            \"Not enough history yet to project forward.\",",
              "        Basis & \". The next twelve months come to \"",
              "            & FORMAT( Cost, \"$#,0\" ) & \" - seats \" & FORMAT( Seats, \"$#,0\" )",
              "            & \", credits \" & FORMAT( Cred, \"$#,0\" ) & \".\"",
              "    )",
              ""
            ],
            "displayFolder": "GHCP\\Narrative",
            "lineageTag": "5e770002-0002-4002-8002-000000000101"
          },
          {
            "name": "GHCP Year Credit Share %",
            "description": [
              "How much of the twelve-month projection is credits drawn beyond the",
              "included allowance, as opposed to fixed seat cost."
            ],
            "expression": [
              "",
              "VAR Cost = [GHCP Year Cost]",
              "VAR Seats = [GHCP Seat Cost (Monthly)] * 12",
              "RETURN DIVIDE( Cost - Seats, Cost )",
              ""
            ],
            "formatString": "0%",
            "displayFolder": "GHCP\\Forecast",
            "lineageTag": "5e770002-0002-4002-8002-000000000102"
          },
          {
            "name": "GHCP Forecast Confidence",
            "description": [
              "Confidence in the GitHub Copilot projection, based on how many months of",
              "history the fitted growth rate has to work with."
            ],
            "expression": [
              "",
              "VAR Months = [GHCP Months Observed]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        Months >= 9, \"High\",",
              "        Months >= 5, \"Moderate\",",
              "        Months >= 2, \"Low\",",
              "        \"Insufficient history\"",
              "    )",
              ""
            ],
            "displayFolder": "GHCP\\Forecast",
            "lineageTag": "5e770002-0002-4002-8002-000000000103"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "GitHub User",
        "lineageTag": "gh200001-0001-0001-0001-000000000001",
        "columns": [
          {
            "name": "Username",
            "dataType": "string",
            "sourceColumn": "Username",
            "lineageTag": "gh200001-col0-0001-000000000001",
            "summarizeBy": "none"
          },
          {
            "name": "UserPrincipalName",
            "dataType": "string",
            "sourceColumn": "UserPrincipalName",
            "lineageTag": "gh200001-col0-0001-000000000002",
            "summarizeBy": "none"
          },
          {
            "name": "Developer",
            "dataType": "string",
            "sourceColumn": "Developer",
            "lineageTag": "gh200001-col0-0001-000000000003",
            "summarizeBy": "none"
          },
          {
            "name": "Plan",
            "dataType": "string",
            "sourceColumn": "Plan",
            "lineageTag": "gh200001-col0-0001-000000000004",
            "summarizeBy": "none"
          },
          {
            "name": "Included_Credits",
            "dataType": "int64",
            "description": [
              "Credits included with this user's plan each month. These are pooled",
              "enterprise-wide, not reserved per person -- one developer's unused",
              "allowance covers another's excess."
            ],
            "sourceColumn": "Included_Credits",
            "formatString": "#,0",
            "lineageTag": "gh200001-col0-0001-000000000005",
            "summarizeBy": "sum"
          },
          {
            "type": "calculated",
            "name": "Included_Credits_From_Sep",
            "dataType": "int64",
            "description": [
              "The allowance that applies from the change date held in 'GHCP Allowance",
              "Change'. Resolved by plan rather than by matching the current value, so a",
              "tenant on non-standard entitlements still maps correctly."
            ],
            "expression": [
              "VAR Ent =",
              "    [GitHub Enterprise Standard Value]",
              "VAR Bus =",
              "    [GitHub Business Standard Value]",
              "RETURN",
              "    IF( 'GitHub User'[Plan] = \"Copilot Enterprise\", Ent, Bus )"
            ],
            "formatString": "#,0",
            "lineageTag": "gh200001-col0-0001-000000000006",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "GitHub User",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "\t// A missing table is a supported state: this product's pages",
                "\t// come up empty and nothing else is affected.",
                "\tTbl = GetTable(\"github_user_map\"),",
                "\tResult =",
                "\t\tif Tbl = null then",
                "\t\t\t#table(type table [#\"Username\" = text, #\"UserPrincipalName\" = text, #\"Developer\" = text, #\"Plan\" = text, #\"Included_Credits\" = Int64.Type], {})",
                "\t\telse",
                "\t\t\tlet",
                "\t\t\t\tKept = Table.SelectColumns(Tbl, {\"username\", \"user_principal_name\", \"display_name\", \"plan\", \"included_credits\"}, MissingField.UseNull),",
                "\t\t\t\tRenamed = Table.RenameColumns(Kept, {{\"username\", \"Username\"}, {\"user_principal_name\", \"UserPrincipalName\"}, {\"display_name\", \"Developer\"}, {\"plan\", \"Plan\"}, {\"included_credits\", \"Included_Credits\"}}),",
                "\t\tTyped = Table.TransformColumnTypes(Renamed, {{\"Included_Credits\", Int64.Type}})",
                "\t\t\tin",
                "\t\t\t\tTyped",
                "in",
                "\tResult"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "GHCP Seat Cost (Monthly)",
            "description": [
              "Seat cost per month. Copilot Business is $19 a seat, Enterprise $39.",
              "For most tenants this dwarfs credit overage, so a cost page that shows only",
              "credits misses where the money actually goes."
            ],
            "expression": [
              "",
              "VAR Ent = [GitHub Enterprise Seat Value]",
              "VAR Bus = [GitHub Business Seat Value]",
              "RETURN",
              "SUMX(",
              "    'GitHub User',",
              "    IF( 'GitHub User'[Plan] = \"Copilot Enterprise\", Ent, Bus )",
              ")",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "GHCP\\Cost",
            "lineageTag": "b1192095-fc25-4bcf-99dd-a0145ef7734c"
          },
          {
            "name": "GHCP Monthly Pool",
            "description": [
              "Credits included with the seats held, pooled enterprise-wide.",
              "",
              "This is a pool, not a per-person entitlement. One developer's unused",
              "allowance covers another's excess, so there is no such thing as a developer",
              "being individually over their limit."
            ],
            "expression": "SUM( 'GitHub User'[Included_Credits] )",
            "formatString": "#,0",
            "displayFolder": "GHCP\\Allowance",
            "lineageTag": "e8fcc7a2-e73f-4170-a862-2c455e6b8485"
          },
          {
            "name": "GHCP Pool From September",
            "description": [
              "The pool that applies from the allowance change date, using the standard",
              "per-plan entitlements. Both the date and the entitlements are parameters -",
              "see Settings."
            ],
            "expression": "SUM( 'GitHub User'[Included_Credits_From_Sep] )",
            "formatString": "#,0",
            "displayFolder": "GHCP\\Allowance",
            "lineageTag": "d2a6504b-ae5b-41ea-b946-46ea6cd8486e"
          },
          {
            "name": "GHCP Pool Change %",
            "description": [
              "How far the pool changes at the allowance change date. Zero when the",
              "tenant is already on the standard entitlement."
            ],
            "expression": "DIVIDE( [GHCP Pool From September], [GHCP Monthly Pool] ) - 1",
            "formatString": "0%",
            "displayFolder": "GHCP\\Allowance",
            "lineageTag": "eb61234c-a307-4702-bc5c-2ccc127823b6"
          },
          {
            "name": "GHCP Pool Headroom",
            "description": [
              "Credits left in this month's pool at the latest month's consumption.",
              "Negative would mean the pool is already exhausted."
            ],
            "expression": "[GHCP Monthly Pool] - [GHCP Latest Month Credits]",
            "formatString": "#,0",
            "displayFolder": "GHCP\\Allowance",
            "lineageTag": "db3a4354-d3e0-4552-9252-12ff68c9e402"
          },
          {
            "name": "GHCP Pool Used %",
            "description": "How much of the shared pool the latest month consumed.",
            "expression": "DIVIDE( [GHCP Latest Month Credits], [GHCP Monthly Pool] )",
            "formatString": "0.0%",
            "displayFolder": "GHCP\\Allowance",
            "lineageTag": "22fe026b-1328-4905-bdff-3b96518a8fdf"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "GHCP Period",
        "description": [
          "How much history the GitHub Copilot pages cover. Whole calendar months,",
          "because the AI credit pool resets on the 1st of each month."
        ],
        "lineageTag": "a1d409f1-59bd-47fc-97a5-be738a953056",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Period",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Period]",
            "sortByColumn": "Period Order",
            "lineageTag": "94d26e5e-1bc9-408b-baf9-40855479160a",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Period Order",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Period Order]",
            "lineageTag": "f0186f11-47cd-40eb-a7e7-3188cca8a146"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Months",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Months]",
            "lineageTag": "d94692b5-4499-440a-bce0-eb23f22030cd"
          }
        ],
        "partitions": [
          {
            "name": "GHCP Period",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "// GitHub pools credits per CALENDAR MONTH -- the allowance resets at 00:00 UTC",
                "// on the 1st and nothing carries over. So the period unit here is whole",
                "// months, not the rolling day windows the Studio pages use. A 45-day window",
                "// would straddle two resets and make every pool comparison meaningless.",
                "DATATABLE(",
                "    \"Period\", STRING,",
                "    \"Period Order\", INTEGER,",
                "    \"Months\", INTEGER,",
                "    {",
                "        { \"Latest month\",            1, 1 },",
                "        { \"Last 2 months\",           2, 2 },",
                "        { \"All history (3 months)\",  3, 0 }",
                "    }",
                ")",
                ""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "GHCP Period Months",
            "description": [
              "Whole calendar months of history in scope. Zero means everything exported.",
              "Defaults to zero so every existing figure is unchanged until someone",
              "narrows the window."
            ],
            "expression": [
              "",
              "VAR Picked = SELECTEDVALUE( 'GHCP Period'[Months] )",
              "RETURN IF( ISBLANK( Picked ), 0, Picked )",
              ""
            ],
            "formatString": "0",
            "displayFolder": "GHCP\\Period",
            "lineageTag": "58610be3-3e47-4021-887d-9ebc5dd66e02"
          },
          {
            "name": "GHCP Period Start",
            "description": [
              "First date still in scope, for measures to filter against.",
              "",
              "Snaps to the 1st of a month rather than counting days back, because the",
              "credit pool resets on the 1st - a window that starts mid-month would be",
              "compared against a full month's allowance."
            ],
            "expression": [
              "",
              "VAR MonthsBack = [GHCP Period Months]",
              "VAR LatestDay =",
              "    CALCULATE(",
              "        MAX( 'GitHub Usage'[Usage_Date] ),",
              "        REMOVEFILTERS( 'GitHub Usage'[Usage_Date] )",
              "    )",
              "VAR EarliestDay =",
              "    CALCULATE(",
              "        MIN( 'GitHub Usage'[Usage_Date] ),",
              "        REMOVEFILTERS( 'GitHub Usage'[Usage_Date] )",
              "    )",
              "RETURN",
              "    IF( MonthsBack = 0, EarliestDay, EOMONTH( LatestDay, -MonthsBack ) + 1 )",
              ""
            ],
            "formatString": "yyyy-mm-dd",
            "displayFolder": "GHCP\\Period",
            "lineageTag": "4f7983ed-6f06-47fd-8c98-346caf0fb484"
          },
          {
            "name": "GHCP Period Label",
            "description": "Names the window in prose, for subtitles and narrative cards.",
            "expression": [
              "",
              "VAR MonthsBack = [GHCP Period Months]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        MonthsBack = 0, \"all available history\",",
              "        MonthsBack = 1, \"the latest month\",",
              "        \"the last \" & MonthsBack & \" months\"",
              "    )",
              ""
            ],
            "displayFolder": "GHCP\\Period",
            "lineageTag": "b64f29e4-b2df-48b0-b4ac-389f37b28059"
          },
          {
            "name": "GHCP Billing Period",
            "description": [
              "Coverage window of the figures on the page, so a reader never has to guess",
              "what 'credits' refers to. Mirrors the Billing period tag on the Studio",
              "pages."
            ],
            "expression": [
              "",
              "VAR FromDate = [GHCP Period Start]",
              "VAR Scoped =",
              "    FILTER( ALL( 'GitHub Usage'[Usage_Date] ), 'GitHub Usage'[Usage_Date] >= FromDate )",
              "VAR Lo = MINX( Scoped, 'GitHub Usage'[Usage_Date] )",
              "VAR Hi = MAXX( Scoped, 'GitHub Usage'[Usage_Date] )",
              "RETURN",
              "    IF(",
              "        ISBLANK( Lo ),",
              "        \"No usage export loaded\",",
              "        FORMAT( Lo, \"d MMM\" ) & \" – \" & FORMAT( Hi, \"d MMM yyyy\" )",
              "    )",
              ""
            ],
            "displayFolder": "GHCP\\Period",
            "lineageTag": "89520c29-6999-4ec0-8bb0-bdde325e8839"
          }
        ]
      },
      {
        "name": "AzureAiSpend",
        "lineageTag": "9f8a1e2e-2967-4378-b3bd-ad8764bce18f",
        "columns": [
          {
            "name": "UsageQuantity",
            "dataType": "double",
            "description": [
              "Millions of tokens for Foundry rows, credits for Copilot Studio rows.",
              "Deliberately not aggregated by default: the two units are not",
              "commensurable and a total across both would be meaningless."
            ],
            "sourceColumn": "UsageQuantity",
            "formatString": "#,0.000",
            "lineageTag": "af000001-0009-4001-8001-000000000009",
            "summarizeBy": "none"
          },
          {
            "name": "UsageDate",
            "dataType": "dateTime",
            "sourceColumn": "UsageDate",
            "formatString": "yyyy-mm-dd",
            "lineageTag": "af000001-0001-4001-8001-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "ServiceName",
            "dataType": "string",
            "sourceColumn": "ServiceName",
            "lineageTag": "af000001-0002-4001-8001-000000000002",
            "summarizeBy": "none"
          },
          {
            "name": "Meter",
            "dataType": "string",
            "sourceColumn": "Meter",
            "lineageTag": "af000001-0003-4001-8001-000000000003",
            "summarizeBy": "none"
          },
          {
            "name": "Model",
            "dataType": "string",
            "description": [
              "Model name parsed out of the meter, so charts can group by model rather",
              "than by meter - \"GPT 5\" instead of \"GPT 5 Inpt Glbl 1M Tokens\" and",
              "\"GPT 5 outpt Glbl 1M Tokens\" as two unrelated series."
            ],
            "sourceColumn": "Model",
            "lineageTag": "af000001-0004-4001-8001-000000000004",
            "summarizeBy": "none"
          },
          {
            "name": "TokenDirection",
            "dataType": "string",
            "description": [
              "Input or Output, parsed from the meter. Output tokens cost several times",
              "input, so the split is the first thing to look at when spend rises."
            ],
            "sourceColumn": "TokenDirection",
            "lineageTag": "af000001-0005-4001-8001-000000000005",
            "summarizeBy": "none"
          },
          {
            "name": "ResourceName",
            "dataType": "string",
            "sourceColumn": "ResourceName",
            "lineageTag": "af000001-0006-4001-8001-000000000006",
            "summarizeBy": "none"
          },
          {
            "name": "ResourceGroup",
            "dataType": "string",
            "sourceColumn": "ResourceGroup",
            "lineageTag": "af000001-0007-4001-8001-000000000007",
            "summarizeBy": "none"
          },
          {
            "name": "Cost",
            "dataType": "double",
            "sourceColumn": "Cost",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "af000001-0008-4001-8001-000000000008",
            "summarizeBy": "sum"
          },
          {
            "name": "DepartmentTag",
            "dataType": "string",
            "description": [
              "Department from an Azure resource tag, when someone set one.",
              "",
              "This is the ONLY route from Azure spend to an org dimension - Cost",
              "Management is resource-grained and carries no person at all. Tags are",
              "not inherited from resource group or subscription and enabling",
              "inheritance is not retrospective, so a large share of spend having no",
              "tag is the normal case rather than a fault."
            ],
            "sourceColumn": "DepartmentTag",
            "lineageTag": "af000001-000a-4001-8001-00000000000a",
            "summarizeBy": "none"
          },
          {
            "name": "Currency",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Currency",
            "lineageTag": "af000001-000b-4001-8001-00000000000b",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "AzureAiSpend",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Raw = GetTable(\"azure_ai_spend\"),",
                "    Normalize = ((Source as table, Specs as list, Required as list) as table =>",
                "let",
                "    Key = (s as text) as text => Text.Lower(Text.Select(s, {\"a\"..\"z\", \"A\"..\"Z\", \"0\"..\"9\"})),",
                "    Columns = List.Buffer(Table.ColumnNames(Source)),",
                "    Pick = (spec as list) as nullable text =>",
                "        let",
                "            Candidates = List.Transform({spec{0}} & spec{1}, (alias) =>",
                "                if List.Contains(Columns, alias) then {alias}",
                "                else List.Select(Columns, each Key(_) = Key(alias))),",
                "            Best = List.First(List.Select(Candidates, each not List.IsEmpty(_)), {})",
                "        in",
                "            if List.Count(Best) > 1 then error Error.Record(\"AmbiguousExportColumn\",",
                "                \"Several headers have the same priority. Keep one or use the exact canonical header.\",",
                "                [Column = spec{0}, Candidates = Best])",
                "            else List.First(Best, null),",
                "    Bindings = List.Buffer(List.Transform(Specs, each Pick(_))),",
                "    Names = List.Transform(Specs, each _{0}),",
                "    Missing = List.Select(Required, (c) => Bindings{List.PositionOf(Names, c)} = null),",
                "    Result =",
                "        if List.Count(List.Distinct(Names)) <> List.Count(Names)",
                "            or not List.IsEmpty(List.Difference(Required, Names)) then",
                "            error Error.Record(\"InvalidColumnSpecs\", \"Canonical names must be unique and required names must be specified.\", null)",
                "        else if List.Count(List.RemoveNulls(Bindings)) <> List.Count(List.Distinct(List.RemoveNulls(Bindings))) then",
                "            error Error.Record(\"OverlappingColumnAliases\", \"One input column cannot populate multiple canonical columns.\", null)",
                "        else if not List.IsEmpty(Missing) and not Table.IsEmpty(Source) then",
                "            error Error.Record(\"UnsupportedExportSchema\",",
                "                \"Required columns are missing from this row-level export.\",",
                "                [MissingColumns = Missing, AvailableColumns = Columns])",
                "        else",
                "            Value.ReplaceMetadata(Table.FromColumns(List.Transform(Bindings, (c) =>",
                "                if c = null then List.Repeat({null}, Table.RowCount(Source))",
                "                else Table.Column(Source, c)), Names),",
                "                [ColumnBindings = Record.FromList(Bindings, Names)])",
                "in",
                "    Result",
                "),",
                "    ParseExportDate = ((Values as list) as function =>",
                "let",
                "    Blank = (v as any) as logical => v = null or (Value.Is(v, type text) and Text.Trim(v) = \"\"),",
                "    Parse = (v as any, culture as text) as datetime =>",
                "        if Blank(v) then error Error.Record(\"MissingExportDate\", \"A dated row has no date.\", null)",
                "        else if Value.Is(v, type datetimezone) then DateTimeZone.RemoveZone(v)",
                "        else if Value.Is(v, type datetime) then v",
                "        else if Value.Is(v, type date) then DateTime.From(v)",
                "        else",
                "            let",
                "                s = Text.Trim(Text.From(v, \"en-US\")),",
                "                Compact = Text.Length(s) = 8 and Text.Select(s, {\"0\"..\"9\"}) = s,",
                "                Iso = Text.Length(s) >= 10 and Text.Middle(s, 4, 1) = \"-\"",
                "                    and Text.Middle(s, 7, 1) = \"-\" and Text.Select(Text.Start(s, 4), {\"0\"..\"9\"}) = Text.Start(s, 4),",
                "                Tail = if Text.Length(s) > 10 then Text.Range(s, 10) else \"\",",
                "                Zoned = Iso and (Text.EndsWith(Text.Upper(s), \"Z\") or Text.Contains(Tail, \"+\") or Text.Contains(Tail, \"-\"))",
                "            in",
                "                if Compact then #datetime(Number.FromText(Text.Start(s, 4)), Number.FromText(Text.Middle(s, 4, 2)),",
                "                    Number.FromText(Text.End(s, 2)), 0, 0, 0)",
                "                else if Value.Is(v, type number) then error Error.Record(\"InvalidExportDate\", \"Numeric dates must use yyyyMMdd, not serial dates.\", null)",
                "                else if Zoned then DateTimeZone.RemoveZone(DateTimeZone.FromText(s, [Culture = \"en-US\"]))",
                "                else DateTime.FromText(s, [Culture = if Iso then \"en-US\" else culture]),",
                "    // Try only the two supported date orders; failures are inspected, never converted to null.",
                "    Attempts = List.Buffer(List.Transform(Values, each [US = try Parse(_, \"en-US\"), GB = try Parse(_, \"en-GB\")])),",
                "    Invalid = List.AnyTrue(List.Transform(Attempts, each [US][HasError] and [GB][HasError])),",
                "    USValid = List.AllTrue(List.Transform(Attempts, each not [US][HasError])),",
                "    GBValid = List.AllTrue(List.Transform(Attempts, each not [GB][HasError])),",
                "    Same = if USValid and GBValid then List.AllTrue(List.Transform(Attempts, each [US][Value] = [GB][Value])) else false,",
                "    Culture =",
                "        if Invalid then error Error.Record(\"InvalidExportDate\", \"A date is missing or invalid. No rows were discarded.\", null)",
                "        else if not USValid and not GBValid then error Error.Record(\"MixedExportDateOrder\",",
                "            \"The column mixes day-first and month-first dates. Supply consistent dates or ISO yyyy-MM-dd.\", null)",
                "        else if USValid and GBValid and not Same then error Error.Record(\"AmbiguousExportDate\",",
                "            \"Day/month order cannot be inferred from this column. Supply ISO yyyy-MM-dd.\", null)",
                "        else if USValid then \"en-US\" else \"en-GB\",",
                "    Convert = (v as any) as datetime => Parse(v, Culture)",
                "in",
                "    Convert",
                "),",
                "    Key = (s as text) as text => Text.Lower(Text.Select(s, {\"a\"..\"z\", \"A\"..\"Z\", \"0\"..\"9\"})),",
                "    Empty = #table(type table [UsageDate=date, ServiceName=text, Meter=text, Model=text,",
                "        TokenDirection=text, ResourceName=text, ResourceGroup=text, Cost=number,",
                "        UsageQuantity=number, DepartmentTag=text, Currency=text], {}),",
                "    Result = if Raw = null then Empty else",
                "        let",
                "            Headers = Table.ColumnNames(Raw),",
                "            CurrencyCosts = List.Select(Headers, each Text.StartsWith(Text.Lower(Text.Trim(_)), \"cost (\")",
                "                and Text.EndsWith(Text.Trim(_), \")\") and Text.Length(Text.BetweenDelimiters(_, \"(\", \")\")) = 3),",
                "            Costs = {\"CostInBillingCurrency\", \"BilledCost\", \"PreTaxCost\", \"CostUSD\"} & CurrencyCosts,",
                "            PickedCost = Value.Metadata(Named)[ColumnBindings][Cost],",
                "            CostCurrency = if PickedCost = null then null",
                "                else if Key(PickedCost) = \"costusd\" then \"USD\"",
                "                else if List.Contains(CurrencyCosts, PickedCost)",
                "                    then Text.Upper(Text.BetweenDelimiters(PickedCost, \"(\", \")\")) else null,",
                "            Named = Normalize(Raw, {",
                "                {\"UsageDate\", {\"Date\", \"BillingDate\", \"UsageDateTime\"}},",
                "                {\"ServiceName\", {\"Service\", \"ConsumedService\"}},",
                "                {\"Meter\", {\"MeterName\"}},",
                "                {\"ResourceName\", {\"Resource\", \"ResourceId\"}},",
                "                {\"ResourceGroup\", {\"ResourceGroupName\"}},",
                "                {\"Cost\", Costs},",
                "                {\"UsageQuantity\", {\"Quantity\"}},",
                "                {\"DepartmentTag\", {\"Department\", \"TagDepartment\"}},",
                "                {\"Currency\", {\"BillingCurrency\", \"BillingCurrencyCode\", \"CurrencyCode\"}},",
                "                {\"Model\", {}}, {\"TokenDirection\", {}}",
                "            }, {\"UsageDate\", \"Cost\"}),",
                "            ReadDate = ParseExportDate(Named[UsageDate]),",
                "            ToDate = (v as any) as date => Date.From(ReadDate(v)),",
                "            ToCost = (v as any) as number =>",
                "                if v = null or Text.Trim(Text.From(v)) = \"\" then",
                "                    error Error.Record(\"InvalidCost\", \"An Azure cost row has no cost value.\", null)",
                "                else if Value.Is(v, type number) then v",
                "                else Number.FromText(Text.Trim(Text.From(v)), \"en-US\"),",
                "            Typed = Table.TransformColumns(Named, {",
                "                {\"UsageDate\", ToDate, type date}, {\"Cost\", ToCost, type number},",
                "                {\"UsageQuantity\", each if _ = null or _ = \"\" then null",
                "                    else if Value.Is(_, type number) then _ else Number.FromText(Text.From(_), \"en-US\"), type nullable number},",
                "                {\"Currency\", each if _ = null or Text.Trim(Text.From(_)) = \"\" then CostCurrency",
                "                    else Text.Upper(Text.Trim(Text.From(_))), type nullable text}",
                "            }),",
                "            Buffered = Table.Buffer(Typed),",
                "            Currencies = List.Distinct(List.RemoveNulls(Buffered[Currency])),",
                "            CurrencyHeaders = List.Select(Headers, each List.Contains(",
                "                {\"currency\", \"billingcurrency\", \"billingcurrencycode\", \"currencycode\"}, Key(_))),",
                "            CurrencyText = (v as any) as nullable text =>",
                "                if v = null or Text.Trim(Text.From(v)) = \"\" then null else Text.Upper(Text.Trim(Text.From(v))),",
                "            CurrencyConflicts = List.AnyTrue(List.Transform(Table.ToRecords(Raw), (r) =>",
                "                List.Count(List.Distinct(List.RemoveNulls(",
                "                    List.Transform(CurrencyHeaders, each CurrencyText(Record.Field(r, _))) & {CostCurrency}))) > 1)),",
                "            CurrencyCostCodes = List.Distinct(List.Transform(CurrencyCosts,",
                "                each Text.Upper(Text.BetweenDelimiters(_, \"(\", \")\")))),",
                "            Checked =",
                "                if PickedCost <> null and List.Contains(CurrencyCosts, PickedCost)",
                "                    and List.Count(CurrencyCostCodes) > 1 then error Error.Record(\"AmbiguousCostCurrency\",",
                "                        \"Multiple currency-specific cost columns exist. Select one explicitly as Cost with its Currency.\", null)",
                "                else if CurrencyConflicts then error Error.Record(\"ConflictingCurrency\",",
                "                    \"Currency columns or the selected cost header disagree.\", null)",
                "                else if List.Count(Currencies) > 1 then error Error.Record(\"MixedCurrencies\",",
                "                    \"This report cannot add different currencies. Export one billing currency at a time.\", null)",
                "                else if not List.IsEmpty(Currencies) and List.NonNullCount(Buffered[Currency]) <> Table.RowCount(Buffered) then",
                "                    error Error.Record(\"UnknownCurrency\", \"Known and unknown currency charges cannot be combined.\", null)",
                "                else if CostCurrency <> null and not List.IsEmpty(Currencies) and Currencies{0} <> CostCurrency then",
                "                    error Error.Record(\"ConflictingCurrency\", \"The cost column currency disagrees with the currency column.\", null)",
                "                else Buffered,",
                "            MeterWords = (m as nullable text) as list =>",
                "                if m = null then {} else List.Select(Text.Split(",
                "                    Text.Replace(Text.Replace(Text.Lower(m), \"-\", \" \"), \"_\", \" \"), \" \"), each _ <> \"\"),",
                "            DirectionWords = {\"inp\",\"inpt\",\"input\",\"inputs\",\"opt\",\"outp\",\"outpt\",\"output\",\"outputs\",",
                "                \"cach\",\"cachd\",\"cache\",\"cached\",\"cd\",\"cchd\"},",
                "            Direction = (m as nullable text) as text =>",
                "                let ws = MeterWords(m) in",
                "                if List.ContainsAny(ws, {\"cach\",\"cachd\",\"cache\",\"cached\",\"cd\",\"cchd\"}) then \"Cached\"",
                "                else if List.ContainsAny(ws, {\"inp\",\"inpt\",\"input\",\"inputs\"}) then \"Input\"",
                "                else if List.ContainsAny(ws, {\"opt\",\"outp\",\"outpt\",\"output\",\"outputs\"}) then \"Output\" else \"Other\",",
                "            ModelLabel = (ws as list) as text =>",
                "                let first = ws{0}, digits = {\"0\"..\"9\"}",
                "                in if first = \"gpt\" then Text.Combine({\"GPT\"} & List.Skip(ws, 1), \"-\")",
                "                    else if List.Contains(digits, Text.Start(first, 1)) then Text.Combine({\"GPT\"} & ws, \"-\")",
                "                    else if Text.Start(first, 1) = \"o\" and List.Contains(digits, Text.Middle(first, 1, 1)) then Text.Combine(ws, \"-\")",
                "                    else Text.Proper(Text.Combine(ws, \" \")),",
                "            ModelOf = (m as nullable text) as text =>",
                "                let ws = MeterWords(m),",
                "                    i = List.PositionOf(List.Transform(ws, each List.Contains(DirectionWords, _)), true)",
                "                in if m = null or Text.Trim(m) = \"\" then \"Not provided\"",
                "                    else if i <= 0 then m else ModelLabel(List.FirstN(ws, i)),",
                "            WithDerived = Table.FromRecords(List.Transform(Table.ToRecords(Checked), (r) =>",
                "                Record.TransformFields(r, {",
                "                    {\"Model\", each if _ = null or Text.Trim(Text.From(_)) = \"\" then ModelOf(r[Meter]) else Text.From(_)},",
                "                    {\"TokenDirection\", each if _ = null or Text.Trim(Text.From(_)) = \"\" then Direction(r[Meter]) else Text.From(_)},",
                "                    {\"ServiceName\", each if _ = null or Text.Trim(Text.From(_)) = \"\" then \"Not provided\"",
                "                        else if List.Contains({\"azure openai\",\"azure ai foundry\",\"azure ai foundry models\",\"foundry models\"},",
                "                            Text.Lower(Text.Trim(Text.From(_)))) then \"Foundry Models\"",
                "                        else if List.Contains({\"copilot studio\", \"microsoft copilot studio\", \"power virtual agents\", \"microsoft power virtual agents\"},",
                "                            Text.Lower(Text.Trim(Text.From(_)))) then \"Microsoft Copilot Studio\" else Text.From(_)}",
                "                })), Table.ColumnNames(Checked), MissingField.UseNull),",
                "            Final = Table.TransformColumnTypes(WithDerived, {",
                "                {\"UsageDate\", type date}, {\"Cost\", type number}, {\"UsageQuantity\", type number},",
                "                {\"ServiceName\", type text}, {\"Meter\", type text}, {\"Model\", type text},",
                "                {\"TokenDirection\", type text}, {\"ResourceName\", type text}, {\"ResourceGroup\", type text},",
                "                {\"DepartmentTag\", type text}, {\"Currency\", type text}",
                "            })",
                "        in Final",
                "in",
                "    Result"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Foundry Cost",
            "description": [
              "All Azure AI Foundry model spend. Excludes the Copilot Studio rows that",
              "share this table, which belong to the Studio pages."
            ],
            "expression": [
              "// The period gate lives here rather than on each derived measure:",
              "// Input Cost, Output Cost, Output Share, Cost per 1M, Daily Run",
              "// Rate and Cost /mo all descend from this one, so they inherit it.",
              "//",
              "// KEEPFILTERS on the date predicate matters. A bare",
              "// FILTER(ALL(UsageDate), ...) REPLACES the date context a chart",
              "// axis supplies, so every point on the weekly trend would return",
              "// the whole-period total and the line would render flat.",
              "VAR FromDate = [Foundry Period Start]",
              "RETURN",
              "CALCULATE(",
              "    SUM( 'AzureAiSpend'[Cost] ),",
              "    KEEPFILTERS( 'AzureAiSpend'[ServiceName] = \"Foundry Models\" ),",
              "    KEEPFILTERS(",
              "        FILTER( ALL( 'AzureAiSpend'[UsageDate] ),",
              "                'AzureAiSpend'[UsageDate] >= FromDate )",
              "    )",
              ")"
            ],
            "formatString": "\\$#,0.00",
            "displayFolder": "Foundry",
            "lineageTag": "af000002-0001-4001-8001-000000000001"
          },
          {
            "name": "Foundry Input Cost",
            "expression": "CALCULATE( [Foundry Cost], KEEPFILTERS( 'AzureAiSpend'[TokenDirection] = \"Input\" ) )",
            "formatString": "\\$#,0.00",
            "displayFolder": "Foundry",
            "lineageTag": "af000002-0002-4001-8001-000000000002"
          },
          {
            "name": "Foundry Output Cost",
            "expression": "CALCULATE( [Foundry Cost], KEEPFILTERS( 'AzureAiSpend'[TokenDirection] = \"Output\" ) )",
            "formatString": "\\$#,0.00",
            "displayFolder": "Foundry",
            "lineageTag": "af000002-0003-4001-8001-000000000003"
          },
          {
            "name": "Foundry Output Cost Share %",
            "description": [
              "Output tokens cost several times input, so a rising share here explains",
              "a rising bill that token counts alone would not."
            ],
            "expression": "DIVIDE( [Foundry Output Cost], [Foundry Cost] )",
            "formatString": "0.0%",
            "displayFolder": "Foundry",
            "lineageTag": "af000002-0004-4001-8001-000000000004"
          },
          {
            "name": "Foundry Tokens (M)",
            "description": [
              "Millions of tokens billed. Azure bills older token meters per 1K tokens",
              "and newer ones per 1M (their names say \"1M Tokens\"), so each row is",
              "converted; meters that aren't tokens (pages, images, hours) are left out.",
              "Foundry rows only - Copilot Studio rows in this table carry credits in",
              "the same column, and adding the two would produce a number with no meaning."
            ],
            "expression": [
              "// UsageQuantity is in each meter's own unit: thousands of tokens for older",
              "// meters, millions for newer ones, which say \"1M Tokens\" in their name.",
              "VAR FromDate = [Foundry Period Start]",
              "RETURN",
              "CALCULATE(",
              "    SUMX(",
              "        'AzureAiSpend',",
              "        'AzureAiSpend'[UsageQuantity]",
              "            * SWITCH( TRUE(),",
              "                CONTAINSSTRING( 'AzureAiSpend'[Meter], \"1M Token\" ), 1,",
              "                CONTAINSSTRING( 'AzureAiSpend'[Meter], \"Token\" ), 0.001,",
              "                0 )",
              "    ),",
              "    KEEPFILTERS( 'AzureAiSpend'[ServiceName] = \"Foundry Models\" ),",
              "    KEEPFILTERS(",
              "        FILTER( ALL( 'AzureAiSpend'[UsageDate] ),",
              "                'AzureAiSpend'[UsageDate] >= FromDate )",
              "    )",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Foundry",
            "lineageTag": "af000002-0005-4001-8001-000000000005"
          },
          {
            "name": "Foundry Cost per 1M Tokens",
            "expression": "DIVIDE( [Foundry Cost], [Foundry Tokens (M)] )",
            "formatString": "\\$#,0.00",
            "displayFolder": "Foundry",
            "lineageTag": "af000002-0006-4001-8001-000000000006"
          },
          {
            "name": "Foundry Days Observed",
            "description": [
              "Days with Foundry spend INSIDE the selected window. Gated for the same",
              "reason as the cost: Daily Run Rate divides one by the other, and a",
              "scoped cost over an unscoped day count would understate the run rate",
              "by the length of the whole extract."
            ],
            "expression": [
              "VAR FromDate = [Foundry Period Start]",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT( 'AzureAiSpend'[UsageDate] ),",
              "    KEEPFILTERS( 'AzureAiSpend'[ServiceName] = \"Foundry Models\" ),",
              "    KEEPFILTERS(",
              "        FILTER( ALL( 'AzureAiSpend'[UsageDate] ),",
              "                'AzureAiSpend'[UsageDate] >= FromDate )",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Foundry",
            "lineageTag": "af000002-0007-4001-8001-000000000007"
          },
          {
            "name": "Foundry Daily Run Rate",
            "expression": "DIVIDE( [Foundry Cost], [Foundry Days Observed] )",
            "formatString": "\\$#,0.00",
            "displayFolder": "Foundry",
            "lineageTag": "af000002-0008-4001-8001-000000000008"
          },
          {
            "name": "Foundry Cost /mo",
            "expression": "[Foundry Daily Run Rate] * 30",
            "formatString": "\\$#,0.00",
            "displayFolder": "Foundry",
            "lineageTag": "af000002-0009-4001-8001-000000000009"
          },
          {
            "name": "Studio PAYG Billed (Azure)",
            "description": [
              "What Azure actually billed for Copilot Studio pay-as-you-go.",
              "",
              "The Studio pages compute their PAYG cost as quantity x a rate the",
              "customer types into a parameter. This is the invoice. The two should",
              "agree, and when they do not it is the parameter that is wrong -",
              "which is otherwise a completely silent error, because every figure",
              "derived from a wrong rate still looks entirely plausible."
            ],
            "expression": [
              "VAR Lo = [Studio Period Start]",
              "VAR Hi = CALCULATE(MAX('Credit Consumption (Tenant)'[Usage_Date]), REMOVEFILTERS('Credit Consumption (Tenant)'[Usage_Date]))",
              "RETURN CALCULATE(SUM('AzureAiSpend'[Cost]), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS('AzureAiSpend'[ServiceName] = \"Microsoft Copilot Studio\"),",
              "    KEEPFILTERS(FILTER(ALL('AzureAiSpend'[UsageDate]), 'AzureAiSpend'[UsageDate] >= Lo && 'AzureAiSpend'[UsageDate] <= Hi)))"
            ],
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio reconciliation",
            "lineageTag": "af000003-0001-4001-8001-000000000001"
          },
          {
            "name": "Studio PAYG Credits (Azure)",
            "expression": [
              "VAR Lo = [Studio Period Start]",
              "VAR Hi = CALCULATE(MAX('Credit Consumption (Tenant)'[Usage_Date]), REMOVEFILTERS('Credit Consumption (Tenant)'[Usage_Date]))",
              "RETURN CALCULATE(SUM('AzureAiSpend'[UsageQuantity]), REMOVEFILTERS('Date'),",
              "    KEEPFILTERS('AzureAiSpend'[ServiceName] = \"Microsoft Copilot Studio\"),",
              "    KEEPFILTERS(FILTER(ALL('AzureAiSpend'[UsageDate]), 'AzureAiSpend'[UsageDate] >= Lo && 'AzureAiSpend'[UsageDate] <= Hi)))"
            ],
            "formatString": "#,0",
            "displayFolder": "Studio reconciliation",
            "lineageTag": "af000003-0002-4001-8001-000000000002"
          },
          {
            "name": "Studio Rate Implied by Azure",
            "description": [
              "The rate Azure actually charged, derived rather than assumed. Compare",
              "with StudioRatePerCredit - a gap means the parameter is wrong."
            ],
            "expression": "DIVIDE( [Studio PAYG Billed (Azure)], [Studio PAYG Credits (Azure)] )",
            "formatString": "\\$0.0000",
            "displayFolder": "Studio reconciliation",
            "lineageTag": "af000003-0003-4001-8001-000000000003"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "AzureAiTokens",
        "lineageTag": "34f0d797-4a2b-488a-a31f-efd568632cb2",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "formatString": "yyyy-mm-dd",
            "lineageTag": "at000001-0001-4001-8001-000000000001",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "ResourceName",
            "dataType": "string",
            "sourceColumn": "ResourceName",
            "lineageTag": "at000001-0002-4001-8001-000000000002",
            "summarizeBy": "none"
          },
          {
            "name": "ResourceGroup",
            "dataType": "string",
            "sourceColumn": "ResourceGroup",
            "lineageTag": "at000001-0003-4001-8001-000000000003",
            "summarizeBy": "none"
          },
          {
            "name": "Deployment",
            "dataType": "string",
            "sourceColumn": "Deployment",
            "lineageTag": "at000001-0004-4001-8001-000000000004",
            "summarizeBy": "none"
          },
          {
            "name": "Metric",
            "dataType": "string",
            "sourceColumn": "Metric",
            "lineageTag": "at000001-0005-4001-8001-000000000005",
            "summarizeBy": "none"
          },
          {
            "name": "Value",
            "dataType": "double",
            "description": [
              "Token counts for the token metrics, a percentage for PTU utilisation.",
              "Not summable across metrics, hence summarizeBy: none."
            ],
            "sourceColumn": "Value",
            "formatString": "#,0.00",
            "lineageTag": "at000001-0006-4001-8001-000000000006",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "AzureAiTokens",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "\tRaw = GetTable(\"azure_ai_tokens\"),",
                "\t\tEmpty = #table(",
                "\t\t\ttype table [Date = date, ResourceName = text, ResourceGroup = text,",
                "\t\t\t\t\t\tDeployment = text, Metric = text, Value = number], {}),",
                "\tResult =",
                "\t\tif Raw = null or Table.IsEmpty(Raw) then Empty",
                "\t\telse",
                "\t\t\tlet",
                "\t\t\t\tCols = Table.ColumnNames(Raw),",
                "\t\t\t\tKey = (n as text) as text => Text.Lower(Text.Remove(n, {\" \", \"_\", \"-\"})),",
                "\t\t\t\tFind = (aliases as list) as nullable text =>",
                "\t\t\t\t\tList.First(List.Select(Cols, each List.Contains(aliases, Key(_))), null),",
                "\t\t\t\tRen = List.RemoveNulls({",
                "\t\t\t\t\tif Find({\"date\",\"timestamp\"}) <> null then {Find({\"date\",\"timestamp\"}), \"Date\"} else null,",
                "\t\t\t\t\tif Find({\"resourcename\",\"resource\"}) <> null then {Find({\"resourcename\",\"resource\"}), \"ResourceName\"} else null,",
                "\t\t\t\t\tif Find({\"resourcegroup\"}) <> null then {Find({\"resourcegroup\"}), \"ResourceGroup\"} else null,",
                "\t\t\t\t\tif Find({\"deployment\",\"deploymentname\"}) <> null then {Find({\"deployment\",\"deploymentname\"}), \"Deployment\"} else null,",
                "\t\t\t\t\tif Find({\"metric\",\"metricname\"}) <> null then {Find({\"metric\",\"metricname\"}), \"Metric\"} else null,",
                "\t\t\t\t\tif Find({\"value\",\"total\"}) <> null then {Find({\"value\",\"total\"}), \"Value\"} else null",
                "\t\t\t\t}),",
                "\t\t\t\tNamed = Table.RenameColumns(Raw, Ren, MissingField.Ignore),",
                "\t\t\t\tWant = {\"Date\",\"ResourceName\",\"ResourceGroup\",\"Deployment\",\"Metric\",\"Value\"},",
                "\t\t\t\tFilled = List.Accumulate(Want, Named, (t, c) =>",
                "\t\t\t\t\tif List.Contains(Table.ColumnNames(t), c) then t",
                "\t\t\t\t\telse Table.AddColumn(t, c, each null, type text)),",
                "\t\t\t\tKept = Table.SelectColumns(Filled, Want, MissingField.UseNull),",
                "\t\t\t\tTyped = Table.TransformColumnTypes(Kept, {",
                "\t\t\t\t\t{\"Date\", type date}, {\"ResourceName\", type text},",
                "\t\t\t\t\t{\"ResourceGroup\", type text}, {\"Deployment\", type text},",
                "\t\t\t\t\t{\"Metric\", type text}, {\"Value\", type number}",
                "\t\t\t\t})",
                "\t\t\tin",
                "\t\t\t\tTyped",
                "in",
                "\tResult"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Prompt Tokens",
            "expression": [
              "VAR FromDate = [Foundry Period Start]",
              "RETURN",
              "CALCULATE( SUM( 'AzureAiTokens'[Value] ),",
              "           KEEPFILTERS( 'AzureAiTokens'[Metric] IN { \"InputTokens\", \"ProcessedPromptTokens\" } ),",
              "           KEEPFILTERS(",
              "               FILTER( ALL( 'AzureAiTokens'[Date] ),",
              "                       'AzureAiTokens'[Date] >= FromDate )",
              "           ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Tokens",
            "lineageTag": "at000002-0001-4001-8001-000000000001"
          },
          {
            "name": "Generated Tokens",
            "expression": [
              "VAR FromDate = [Foundry Period Start]",
              "RETURN",
              "CALCULATE( SUM( 'AzureAiTokens'[Value] ),",
              "           KEEPFILTERS( 'AzureAiTokens'[Metric] IN { \"OutputTokens\", \"GeneratedTokens\" } ),",
              "           KEEPFILTERS(",
              "               FILTER( ALL( 'AzureAiTokens'[Date] ),",
              "                       'AzureAiTokens'[Date] >= FromDate )",
              "           ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Tokens",
            "lineageTag": "at000002-0002-4001-8001-000000000002"
          },
          {
            "name": "Total Tokens",
            "expression": "[Prompt Tokens] + [Generated Tokens]",
            "formatString": "#,0",
            "displayFolder": "Tokens",
            "lineageTag": "at000002-0003-4001-8001-000000000003"
          },
          {
            "name": "AI Requests",
            "expression": [
              "VAR FromDate = [Foundry Period Start]",
              "RETURN",
              "CALCULATE( SUM( 'AzureAiTokens'[Value] ),",
              "           KEEPFILTERS( 'AzureAiTokens'[Metric] IN { \"TotalCalls\", \"ModelRequests\", \"AzureOpenAIRequests\" } ),",
              "           KEEPFILTERS(",
              "               FILTER( ALL( 'AzureAiTokens'[Date] ),",
              "                       'AzureAiTokens'[Date] >= FromDate )",
              "           ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Tokens",
            "lineageTag": "at000002-0004-4001-8001-000000000004"
          },
          {
            "name": "Tokens per Request",
            "expression": "DIVIDE( [Total Tokens], [AI Requests] )",
            "formatString": "#,0",
            "displayFolder": "Tokens",
            "lineageTag": "at000002-0005-4001-8001-000000000005"
          },
          {
            "name": "PTU Utilisation %",
            "description": [
              "Mean utilisation of provisioned throughput.",
              "",
              "AVERAGE, not SUM - it is a percentage. Summing it across days produces",
              "a number in the thousands that looks like a catastrophe.",
              "",
              "This is the commercially important measure on the page. Provisioned",
              "capacity is paid for whether it is used or not, so idle PTU is the",
              "Azure equivalent of an unassigned GitHub Copilot seat: real money,",
              "invisible on a spend chart, and recoverable."
            ],
            "expression": [
              "VAR FromDate = [Foundry Period Start]",
              "RETURN",
              "CALCULATE( AVERAGE( 'AzureAiTokens'[Value] ),",
              "           KEEPFILTERS( 'AzureAiTokens'[Metric] IN { \"ProvisionedUtilization\", \"AzureOpenAIProvisionedManagedUtilizationV2\" } ),",
              "           KEEPFILTERS(",
              "               FILTER( ALL( 'AzureAiTokens'[Date] ),",
              "                       'AzureAiTokens'[Date] >= FromDate )",
              "           ) )"
            ],
            "formatString": "0.0\"%\"",
            "displayFolder": "Provisioned capacity",
            "lineageTag": "at000002-0006-4001-8001-000000000006"
          },
          {
            "name": "Has Provisioned Capacity",
            "description": [
              "Blank when no provisioned deployment exists, so the card can be hidden",
              "rather than reading 0% and implying total waste."
            ],
            "expression": [
              "IF(",
              "    CALCULATE( COUNTROWS( 'AzureAiTokens' ),",
              "               KEEPFILTERS( 'AzureAiTokens'[Metric] IN { \"ProvisionedUtilization\", \"AzureOpenAIProvisionedManagedUtilizationV2\" } ) ) > 0,",
              "    TRUE(),",
              "    BLANK()",
              ")"
            ],
            "displayFolder": "Provisioned capacity",
            "lineageTag": "at000002-0007-4001-8001-000000000007"
          },
          {
            "name": "PTU Verdict",
            "description": [
              "Plain-language verdict on provisioned capacity, using the same",
              "thresholds as the GitHub seat pages so the two read consistently."
            ],
            "expression": [
              "VAR U = [PTU Utilisation %]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK( [Has Provisioned Capacity] ), BLANK(),",
              "        U < 30,  \"Under 30% - provisioned capacity is largely idle. Consider reducing PTU or moving to standard.\",",
              "        U < 60,  \"Moderate - there is headroom to absorb growth without buying more.\",",
              "        U < 85,  \"Healthy utilisation.\",",
              "        \"Above 85% - close to the ceiling. Expect throttling at peak.\"",
              "    )"
            ],
            "displayFolder": "Provisioned capacity",
            "lineageTag": "at000002-0008-4001-8001-000000000008"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Foundry Period",
        "description": [
          "How much history the Foundry page covers.",
          "",
          "Rolling days rather than the whole calendar months the GitHub pages use.",
          "GitHub pools credits per month and resets on the 1st, so a part-month",
          "window there would be compared against a full month's allowance. Azure",
          "meters Foundry continuously with no reset, so days are the honest unit -",
          "the same reasoning as the Studio period control."
        ],
        "lineageTag": "af880002-0001-4001-8001-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Period",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[Period]",
            "sortByColumn": "Period Order",
            "lineageTag": "af880002-0002-4001-8001-000000000002",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Period Order",
            "dataType": "int64",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[Period Order]",
            "formatString": "0",
            "lineageTag": "af880002-0003-4001-8001-000000000003",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Days",
            "dataType": "int64",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[Days]",
            "formatString": "0",
            "lineageTag": "af880002-0004-4001-8001-000000000004",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Foundry Period",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE(",
                "    \"Period\", STRING, \"Period Order\", INTEGER, \"Days\", INTEGER,",
                "    {",
                "        { \"Last 7 days\",         1,  7 },",
                "        { \"Last 30 days\",        2, 30 },",
                "        { \"Last 90 days\",        3, 90 },",
                "        { \"All available days\",  4,  0 }",
                "    }",
                ")"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Foundry Period Days",
            "description": [
              "Days of history in scope. Zero means everything that was loaded, which",
              "is the default so existing figures are unchanged until someone narrows",
              "the window."
            ],
            "expression": [
              "VAR Picked = SELECTEDVALUE( 'Foundry Period'[Days] )",
              "RETURN IF( ISBLANK( Picked ), 0, Picked )"
            ],
            "formatString": "0",
            "displayFolder": "Foundry\\Period",
            "lineageTag": "af880002-0005-4001-8001-000000000005"
          },
          {
            "name": "Foundry Period Start",
            "description": "The earliest usage date still in scope, for measures to filter against.",
            "expression": [
              "// FirstDay / LastDay, because EARLIEST is a DAX function and a VAR",
              "// of that name collides rather than shadows. The parse fails, this",
              "// measure drops to state 5, and the sixteen measures downstream",
              "// all report \"refers to a measure which has an error\" - none of",
              "// them naming the real fault. EARLIEST did exactly that here on",
              "// the first build of this table.",
              "//",
              "// Probed against the engine: DATE, EARLIER and EARLIEST are",
              "// rejected; DAY and DAYS are fine. WindowDays is named for",
              "// clarity, not necessity.",
              "VAR WindowDays = [Foundry Period Days]",
              "VAR LastDay =",
              "    CALCULATE(",
              "        MAX( 'AzureAiSpend'[UsageDate] ),",
              "        REMOVEFILTERS( 'AzureAiSpend'[UsageDate] )",
              "    )",
              "VAR FirstDay =",
              "    CALCULATE(",
              "        MIN( 'AzureAiSpend'[UsageDate] ),",
              "        REMOVEFILTERS( 'AzureAiSpend'[UsageDate] )",
              "    )",
              "RETURN IF( WindowDays = 0, FirstDay, LastDay - WindowDays + 1 )"
            ],
            "formatString": "yyyy-mm-dd",
            "displayFolder": "Foundry\\Period",
            "lineageTag": "af880002-0006-4001-8001-000000000006"
          },
          {
            "name": "Foundry Period Label",
            "description": "Names the window in prose, for subtitles and narrative cards.",
            "expression": [
              "VAR WindowDays = [Foundry Period Days]",
              "RETURN IF( WindowDays = 0, \"all available days\",",
              "           \"the last \" & WindowDays & \" days\" )"
            ],
            "displayFolder": "Foundry\\Period",
            "lineageTag": "af880002-0007-4001-8001-000000000007"
          },
          {
            "name": "Foundry Billing Period",
            "description": [
              "The dates actually covered, so a reader never has to guess what the",
              "figures on the page refer to."
            ],
            "expression": [
              "VAR FromDate = [Foundry Period Start]",
              "VAR Scoped =",
              "    FILTER( ALL( 'AzureAiSpend'[UsageDate] ),",
              "            'AzureAiSpend'[UsageDate] >= FromDate )",
              "VAR Lo = MINX( Scoped, 'AzureAiSpend'[UsageDate] )",
              "VAR Hi = MAXX( Scoped, 'AzureAiSpend'[UsageDate] )",
              "RETURN",
              "    IF(",
              "        ISBLANK( Lo ),",
              "        \"No Azure cost data loaded\",",
              "        FORMAT( Lo, \"d MMM\" ) & \" - \" & FORMAT( Hi, \"d MMM yyyy\" )",
              "    )"
            ],
            "displayFolder": "Foundry\\Period",
            "lineageTag": "af880002-0008-4001-8001-000000000008"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "FoundryPeriodCreditLensFabric"
          }
        ]
      },
      {
        "name": "Reporting Date",
        "lineageTag": "0cc770ab-e284-486a-826b-a5e07ef8b686",
