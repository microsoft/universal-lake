          {
            "name": "RecencyBucket",
            "dataType": "string",
            "sourceColumn": "RecencyBucket",
            "lineageTag": "4c7a1e83-9b52-4d16-8f30-2a6e9d5c7b14",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "UsageCohort",
            "dataType": "string",
            "expression": [
              "VAR Rk = RANKX(ALL('CoworkBilling'), 'CoworkBilling'[MonthlyCreditsUsed],, ASC)",
              "VAR Tot = COUNTROWS(ALL('CoworkBilling'))",
              "VAR P = DIVIDE(Rk, Tot)",
              "RETURN SWITCH(TRUE(),",
              "    P <= 0.50, \"1. Light\",",
              "    P <= 0.75, \"2. Regular\",",
              "    P <= 0.90, \"3. Engaged\",",
              "    P <= 0.95, \"4. Native\",",
              "    P <= 0.99, \"5. Power\",",
              "    \"6. Frontier\")"
            ],
            "sortByColumn": "UsageCohortRank",
            "lineageTag": "6a9d2e75-3c18-4b40-8e29-7f1b5a8c3d62",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "UsageCohortRank",
            "dataType": "int64",
            "isHidden": true,
            "expression": [
              "VAR Rk = RANKX(ALL('CoworkBilling'), 'CoworkBilling'[MonthlyCreditsUsed],, ASC)",
              "VAR Tot = COUNTROWS(ALL('CoworkBilling'))",
              "VAR P = DIVIDE(Rk, Tot)",
              "RETURN SWITCH(TRUE(),",
              "    P <= 0.50, 1,",
              "    P <= 0.75, 2,",
              "    P <= 0.90, 3,",
              "    P <= 0.95, 4,",
              "    P <= 0.99, 5,",
              "    6)"
            ],
            "lineageTag": "7b0e3f86-4d29-4c51-9f3a-8e2c6b9d4e73",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Budget Bucket",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR lim  = 'CoworkBilling'[MonthlyCreditLimit]",
              "VAR used = 'CoworkBilling'[MonthlyCreditsUsed]",
              "VAR r    = DIVIDE( used, lim )",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    lim = 0 && used > 0, \"Over Limit\",   -- zero-limit users who used credits",
              "    r > 1,               \"Over Limit\",",
              "    r >= 0.85,           \"Approaching\",",
              "    \"Under Limit\"",
              ")",
              ""
            ],
            "sortByColumn": "Budget Bucket Sort",
            "displayFolder": "Allowance",
            "lineageTag": "206965f8-2de4-4dc2-8c0c-4ebfc654581d",
            "summarizeBy": "none",
            "changedProperties": [
              {
                "property": "SortByColumn"
              }
            ],
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Budget Bucket Sort",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR lim  = 'CoworkBilling'[MonthlyCreditLimit]",
              "VAR used = 'CoworkBilling'[MonthlyCreditsUsed]",
              "VAR r    = DIVIDE( used, lim )",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    lim = 0 && used > 0, 3,",
              "    r > 1,               3,   -- Over Limit",
              "    r >= 0.85,           2,   -- Approaching",
              "    1                         -- Under Limit",
              ")",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Budget",
            "lineageTag": "5ee20112-81e8-40b1-a29f-99b4c9e95f0d",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "UsageCohort Label",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "SWITCH('CoworkBilling'[UsageCohortRank],",
              "    1, \"1. Light (Bottom 50%)\",",
              "    2, \"2. Regular (Top 25–50%)\",",
              "    3, \"3. Engaged (Top 10–25%)\",",
              "    4, \"4. Native (Top 5–10%)\",",
              "    5, \"5. Power (Top 1–5%)\",",
              "    6, \"6. Frontier (Top 1%)\")"
            ],
            "lineageTag": "41171fc9-c7a5-4192-a132-61b818baf22a",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Weeks Active",
            "dataType": "int64",
            "description": [
              "Distinct weeks in which this person consumed anything, across the whole",
              "13-week history. Zero means they hold a seat and have never used it."
            ],
            "expression": [
              "",
              "VAR upn = 'CoworkBilling'[UserPrincipalName]",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT('CreditsWeekly'[MetricDate]),",
              "    ALL('CreditsWeekly'),",
              "    'CreditsWeekly'[UserPrincipalName] = upn",
              ") + 0",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Optimisation",
            "lineageTag": "c1000001-0001-4001-8001-000000000001",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Weeks Over Limit",
            "dataType": "int64",
            "description": "Weeks in which usage exceeded the pro-rata weekly share of the seat.",
            "expression": [
              "",
              "VAR upn    = 'CoworkBilling'[UserPrincipalName]",
              "VAR lim    = DIVIDE( 'CoworkBilling'[MonthlyCreditLimit], 4.345 )",
              "VAR t      = FILTER( ALL('CreditsWeekly'), 'CreditsWeekly'[UserPrincipalName] = upn )",
              "VAR byWeek = GROUPBY( t, 'CreditsWeekly'[MetricDate], \"@c\", SUMX( CURRENTGROUP(), 'CreditsWeekly'[CreditsUsed] ) )",
              "RETURN IF( lim = 0, 0, COUNTROWS( FILTER( byWeek, [@c] > lim ) ) + 0 )",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Optimisation",
            "lineageTag": "c1000001-0002-4001-8001-000000000002",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Breach Persistence",
            "dataType": "double",
            "description": [
              "Share of active weeks spent over the seat. High = structurally",
              "under-provisioned. Low with a breach = one spiky week, leave alone."
            ],
            "expression": "DIVIDE( 'CoworkBilling'[Weeks Over Limit], 'CoworkBilling'[Weeks Active] )",
            "formatString": "0.0%",
            "displayFolder": "Optimisation",
            "lineageTag": "c1000001-0003-4001-8001-000000000003",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Recommended Limit",
            "dataType": "int64",
            "description": "A seat sized to the person's 90th-percentile week, rounded to 250.",
            "expression": [
              "",
              "VAR used = 'CoworkBilling'[MonthlyCreditsUsed]",
              "RETURN",
              "    IF(",
              "        used = 0,",
              "        0,",
              "        MAX( 250, CEILING( used * 1.15, 250 ) )",
              "    )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "c1000001-0004-4001-8001-000000000004",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Seat Delta",
            "dataType": "int64",
            "description": "Positive = seat is oversized and credits can be released.",
            "expression": "'CoworkBilling'[MonthlyCreditLimit] - 'CoworkBilling'[Recommended Limit]",
            "formatString": "#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "c1000001-0005-4001-8001-000000000005",
            "summarizeBy": "sum"
          },
          {
            "type": "calculated",
            "name": "Seat Action",
            "dataType": "string",
            "description": [
              "Recommended action for a seat.",
              "",
              "Computed on the four-week billing snapshot the export carries, NOT on the",
              "Period control. So a user can be flagged \"no usage in the billing period\"",
              "and still show credits in a 13-week table - the two are measuring different",
              "windows, and the labels say so rather than pretending otherwise.",
              "",
              "Order is deliberate: release, then reduce, then watch, then spend. It reads",
              "top to bottom as increasing cost."
            ],
            "expression": [
              "",
              "VAR act  = 'CoworkBilling'[Weeks Active]",
              "VAR pers = 'CoworkBilling'[Breach Persistence]",
              "VAR util = DIVIDE( 'CoworkBilling'[MonthlyCreditsUsed], 'CoworkBilling'[MonthlyCreditLimit] )",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    act = 0,                       \"1. Reclaim - never used\",",
              "    'CoworkBilling'[MonthlyCreditsUsed] = 0, \"2. Review - no usage in billing period\",",
              "    'CoworkBilling'[MonthlyCreditLimit] = 0, \"0. Set a limit - none recorded\",",
              "    util < 0.25,                   \"3. Downsize - under 25% used\",",
              "    pers > 0 && pers < 0.30,       \"4. Hold - spiky, not structural\",",
              "    util >= 0.85 && pers < 0.60,   \"5. Monitor - near limit\",",
              "    pers >= 0.60,                  \"6. Upgrade - persistently over\",",
              "    \"7. Correctly sized\"",
              ")",
              ""
            ],
            "displayFolder": "Optimisation",
            "lineageTag": "c1000001-0006-4001-8001-000000000006",
            "summarizeBy": "none"
          },
          {
            "name": "SpendingPolicyId",
            "dataType": "string",
            "description": [
              "The spending policy this seat is assigned to. Carried through from the",
              "Viva seat roster so the policy slicer filters the current-period pages,",
              "not just the weekly ones."
            ],
            "isHidden": true,
            "sourceColumn": "SpendingPolicyId",
            "lineageTag": "c1100001-0028-4001-8001-000000000028",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "CoworkBilling",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "\tPeriod = Table.SelectRows(VivaCreditMetrics, each [MetricDate] >= VivaPeriodStart),",
                "\tByPerson = Table.Group(Period, {\"PersonId\"}, {",
                "\t\t{\"CreditsUsed\", each List.Sum([CreditsUsed]), type number},",
                "\t\t{\"SessionCount\", each List.Sum([SessionCount]), Int64.Type}",
                "\t}),",
                "\tLastAny = Table.Group(VivaCreditMetrics, {\"PersonId\"}, {",
                "\t\t{\"LastActivityDate\", each List.Max([MetricDate]), type date}",
                "\t}),",
                "",
                "\tJoined = Table.NestedJoin(VivaSeatRoster, {\"PersonId\"}, ByPerson, {\"PersonId\"}, \"use\", JoinKind.LeftOuter),",
                "\tExpanded = Table.ExpandTableColumn(Joined, \"use\",",
                "\t\t{\"CreditsUsed\",\"SessionCount\"},",
                "\t\t{\"CreditsUsed\",\"SessionCount\"}),",
                "\tJoinLast = Table.NestedJoin(Expanded, {\"PersonId\"}, LastAny, {\"PersonId\"}, \"last\", JoinKind.LeftOuter),",
                "\tExpLast = Table.ExpandTableColumn(JoinLast, \"last\", {\"LastActivityDate\"}, {\"LastActivityDate\"}),",
                "",
                "\tShaped = Table.AddColumn(ExpLast, \"MonthlyCreditsUsed\", each Number.Round(if [CreditsUsed] = null then 0 else [CreditsUsed], 0), Int64.Type),",
                "\tAddLimit = Table.AddColumn(Shaped, \"MonthlyCreditLimit\", each if [SeatLimit] = null then 0 else [SeatLimit], Int64.Type),",
                "\tAddSess = Table.AddColumn(AddLimit, \"SessionCountClean\", each if [SessionCount] = null then 0 else [SessionCount], Int64.Type),",
                "\tAddLic = Table.AddColumn(AddSess, \"CopilotLicense\", each if [IsCopilotLicensed] = true then \"Yes\" else \"No\", type text),",
                "\tAddDate = Table.AddColumn(AddLic, \"LastActivity\", each",
                "\t\tif [LastActivityDate] = null",
                "\t\tthen DateTime.From(List.Min(VivaCreditMetrics[MetricDate]))",
                "\t\telse DateTime.From([LastActivityDate]), type datetime),",
                "\tAddPct = Table.AddColumn(AddDate, \"PctUsed\", each",
                "\t\tif [MonthlyCreditLimit] = 0 then 0 else [MonthlyCreditsUsed] / [MonthlyCreditLimit], type number),",
                "",
                "\tSelected = Table.SelectColumns(AddPct, {",
                "\t\t\"userPrincipalName\",\"displayName\",\"MonthlyCreditLimit\",\"MonthlyCreditsUsed\",",
                "\t\t\"PersonId\",\"CopilotLicense\",\"LastActivity\",\"SessionCountClean\",\"PctUsed\",",
                "\t\t\"SpendingPolicyId\"",
                "\t}),",
                "\tRenamed = Table.RenameColumns(Selected, {",
                "\t\t{\"userPrincipalName\",\"UserPrincipalName\"},",
                "\t\t{\"displayName\",\"DisplayName\"},",
                "\t\t{\"PersonId\",\"UserID\"},",
                "\t\t{\"LastActivity\",\"LastActivityDate\"},",
                "\t\t{\"SessionCountClean\",\"SessionCount\"}",
                "\t}),",
                "\tTyped = Table.TransformColumnTypes(Renamed, {",
                "\t\t{\"DisplayName\", type text},{\"UserPrincipalName\", type text},{\"MonthlyCreditLimit\", Int64.Type},{\"MonthlyCreditsUsed\", Int64.Type},{\"UserID\", type text},{\"CopilotLicense\", type text},{\"LastActivityDate\", type datetime},{\"SessionCount\", Int64.Type},{\"PctUsed\", type number},{\"SpendingPolicyId\", type text}",
                "\t}),",
                "\tAddedDays = Table.AddColumn(Typed, \"DaysSinceActivity\", each Duration.Days(DateTime.Date(DateTime.LocalNow()) - DateTime.Date([LastActivityDate])), Int64.Type),",
                "\tAddedRecency = Table.AddColumn(AddedDays, \"RecencyBucket\", each if [DaysSinceActivity] <= 7 then \"0-7 days\" else if [DaysSinceActivity] <= 30 then \"8-30 days\" else if [DaysSinceActivity] <= 60 then \"31-60 days\" else \"60+ days\", type text)",
                "in",
                "\tAddedRecency"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Cowork Total Credits Used",
            "description": [
              "Credits consumed in the selected period, defaulting to the current",
              "billing period."
            ],
            "expression": [
              "// Read from the weekly grain so the Cowork/WorkIQ toggle applies - the",
              "// period snapshot on this table sums both services together. TREATAS",
              "// carries whichever people are in scope here across to that grain, so",
              "// grouping by a column of this table still filters correctly.",
              "VAR People = VALUES( 'CoworkBilling'[UserPrincipalName] )",
              "VAR Wks = [Cowork Period Weeks]",
              "VAR Used =",
              "    CALCULATE(",
              "        SUM( 'CreditsWeekly'[CreditsUsed] ),",
              "        FILTER( ALL( 'CreditsWeekly'[Weeks Ago] ), 'CreditsWeekly'[Weeks Ago] < Wks ),",
              "        REMOVEFILTERS( 'CreditsWeekly'[MetricDate] ),",
              "        REMOVEFILTERS( 'CreditsWeekly'[Week Index] ),",
              "        REMOVEFILTERS( 'CreditsWeekly'[Week Label] ),",
              "        REMOVEFILTERS( 'Date' ),",
              "        TREATAS( People, 'CreditsWeekly'[UserPrincipalName] )",
              "    )",
              "RETURN",
              "    IF( NOT ISEMPTY( People ), ROUND( Used + 0, 0 ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Credits",
            "lineageTag": "1f8b4c29-7e53-4a06-9d18-2b6a9e5c7d31"
          },
          {
            "name": "Person Allowance",
            "description": [
              "Adds up each person's own monthly credit limit. This is a governance cap,",
              "not capacity anyone paid for - going over it is a policy event, not a bill.",
              "Shown as \"User limits\". Do not confuse with Policy Allowance, which adds up",
              "the limits on spending policies instead and gives a different number."
            ],
            "expression": [
              "VAR Limit = SUM('CoworkBilling'[MonthlyCreditLimit])",
              "RETURN IF(Limit > 0, Limit)"
            ],
            "formatString": "#,0",
            "displayFolder": "Allowance",
            "lineageTag": "9c3e7a14-5d82-4b60-8f29-1e7b3a6d9c05"
          },
          {
            "name": "Person Headroom",
            "description": [
              "Credits still available before people hit their own monthly limits.",
              "Governance headroom, not money already spent. A blank or zero limit means no limit is set, so this returns BLANK."
            ],
            "expression": [
              "VAR Allowance = [Person Allowance]",
              "RETURN IF(NOT ISBLANK(Allowance), Allowance - [Cowork Total Credits Used])"
            ],
            "formatString": "#,0",
            "displayFolder": "Allowance",
            "lineageTag": "4d7a1e93-8c25-4b60-9f18-3e6a2d9c5b74"
          },
          {
            "name": "Cowork Avg Credits per User",
            "expression": "DIVIDE([Cowork Total Credits Used], [User Count])",
            "formatString": "#,0",
            "displayFolder": "Credits",
            "lineageTag": "7e2b9d54-1a63-4c80-8f29-5b3d7a6e1c09"
          },
          {
            "name": "Total Sessions",
            "expression": "SUM('CoworkBilling'[SessionCount])",
            "formatString": "#,0",
            "displayFolder": "Credits",
            "lineageTag": "2a6c8e13-9d47-4b50-8f21-6e9a3c7d5b18"
          },
          {
            "name": "Avg Sessions per User",
            "expression": "DIVIDE([Total Sessions], [User Count])",
            "formatString": "#,0.0",
            "displayFolder": "Credits",
            "lineageTag": "5b9d3e78-4c12-4a60-8f39-1e7a6d2c9b03"
          },
          {
            "name": "User Count",
            "description": "Distinct people holding a seat.",
            "expression": "DISTINCTCOUNT('CoworkBilling'[UserPrincipalName])",
            "formatString": "#,0",
            "displayFolder": "Counts",
            "lineageTag": "8c1e5a92-7d34-4b60-9f28-3a6e9d7c5b41"
          },
          {
            "name": "Licensed Users",
            "expression": "CALCULATE([User Count], 'CoworkBilling'[CopilotLicense] = \"Yes\")",
            "formatString": "#,0",
            "displayFolder": "Counts",
            "lineageTag": "3e7a9c15-8d62-4b40-9f18-5b2a6d3e9c74"
          },
          {
            "name": "Active Users (30d)",
            "expression": "CALCULATE([User Count], 'CoworkBilling'[DaysSinceActivity] <= 30)",
            "formatString": "#,0",
            "displayFolder": "Counts",
            "lineageTag": "6d2b8e94-1c57-4a30-8f69-2e9a7c5b3d10"
          },
          {
            "name": "% Active",
            "expression": "DIVIDE([Active Users (30d)], [User Count])",
            "formatString": "0.0%",
            "displayFolder": "Counts",
            "lineageTag": "9a4c7e18-5d23-4b60-8f39-1e6b3a9d7c52"
          },
          {
            "name": "Chargeback $",
            "expression": "[Cowork Total Credits Used] * [Cowork PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Chargeback",
            "lineageTag": "4b8d2e75-3c19-4a60-8f28-7e1a5d6c9b34"
          },
          {
            "name": "Allocated Budget $",
            "expression": "[Person Allowance] * [Cowork PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Chargeback",
            "lineageTag": "7c1e9a53-8d24-4b60-9f38-2e6b3a7d5c19"
          },
          {
            "name": "Chargeback per User $",
            "expression": "DIVIDE([Chargeback $], [User Count])",
            "formatString": "\\$#,0.00",
            "displayFolder": "Chargeback",
            "lineageTag": "2e6a9d18-5c73-4b40-8f29-1e7b3a6d9c05"
          },
          {
            "name": "% of Total Credits",
            "expression": "DIVIDE([Cowork Total Credits Used], CALCULATE([Cowork Total Credits Used], REMOVEFILTERS()))",
            "formatString": "0.0%",
            "displayFolder": "Chargeback",
            "lineageTag": "5d9b3e74-1a28-4c60-8f39-6e2a7c5d9b13"
          },
          {
            "name": "Person Allowance Used %",
            "description": [
              "Credits used as a share of the sum of people's own monthly limits.",
              "Over 100% means people collectively used more than their personal caps",
              "allowed. Shown as \"Used vs user limits\"."
            ],
            "expression": "DIVIDE([Cowork Total Credits Used], [Person Allowance])",
            "formatString": "0.0%",
            "displayFolder": "Allowance",
            "lineageTag": "8a2c7e19-5d34-4b60-9f28-3e6b1a9d7c54"
          },
          {
            "name": "Over Limit Credits",
            "expression": [
              "VAR Allowance = [Person Allowance]",
              "RETURN IF(NOT ISBLANK(Allowance), MAX(0, [Cowork Total Credits Used] - Allowance), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Budget",
            "lineageTag": "3c7a1e94-8d52-4b60-9f18-2e6a9d3c7b15"
          },
          {
            "name": "Over Limit $",
            "expression": "[Over Limit Credits] * [Cowork PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Budget",
            "lineageTag": "6e2b9d53-1c74-4a60-8f38-5b3a7d6e9c10"
          },
          {
            "name": "Over Limit Credits (Individual)",
            "expression": [
              "SUMX(",
              "    'CoworkBilling',",
              "    VAR Limit = 'CoworkBilling'[MonthlyCreditLimit]",
              "    RETURN IF(Limit > 0, MAX(0, 'CoworkBilling'[MonthlyCreditsUsed] - Limit), 0)",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Budget",
            "lineageTag": "1f8a4c62-9d37-4e15-b0a8-6c2e5d9f7b41"
          },
          {
            "name": "Over Limit $ (Individual)",
            "expression": "[Over Limit Credits (Individual)] * [Cowork PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Budget",
            "lineageTag": "8b3d6e17-2a49-4c50-9f61-7d5a2e8c4b93"
          },
          {
            "name": "Chargeback %",
            "expression": "DIVIDE([Over Limit Credits (Individual)], [Person Allowance])",
            "formatString": "0.0%",
            "displayFolder": "Budget",
            "lineageTag": "2c9f4a17-6b38-4d52-8e1a-9f3c7b6d2e84"
          },
          {
            "name": "Chargeback",
            "expression": "[Over Limit $ (Individual)]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Budget",
            "lineageTag": "5a1d8e73-4c29-4b60-9f38-2e7b6a1d9c54"
          },
          {
            "name": "Unused Credits",
            "expression": "[Under-Utilized Credits]",
            "formatString": "#,0",
            "displayFolder": "Budget",
            "lineageTag": "6b2e9f84-5d3a-4c71-8e29-3f8c7b2e0d65"
          },
          {
            "name": "Under-Utilized Credits",
            "expression": "MAX(0, [Person Allowance] - [Cowork Total Credits Used])",
            "formatString": "#,0",
            "displayFolder": "Budget",
            "lineageTag": "9d4c7e18-5a23-4b60-8f39-1e7b3a6d9c52"
          },
          {
            "name": "Under-Utilized $",
            "expression": "[Under-Utilized Credits] * [Cowork PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Budget",
            "lineageTag": "4a8d2e75-3c16-4b60-9f28-7e1a5d6c9b39"
          },
          {
            "name": "Users Over Limit",
            "expression": [
              "VAR T = SUMMARIZE('CoworkBilling', 'CoworkBilling'[UserPrincipalName], \"u\", [Cowork Total Credits Used], \"l\", [Person Allowance])",
              "RETURN COUNTROWS(FILTER(T, [l] > 0 && [u] > [l])) + 0"
            ],
            "formatString": "#,0",
            "displayFolder": "Budget",
            "lineageTag": "7b1e9a54-8c23-4d60-9f38-2e6a3d7c5b18"
          },
          {
            "name": "Users Near Limit",
            "expression": [
              "VAR T = SUMMARIZE('CoworkBilling', 'CoworkBilling'[UserPrincipalName], \"u\", [Cowork Total Credits Used], \"l\", [Person Allowance])",
              "RETURN COUNTROWS(FILTER(T, [l] > 0 && [u] >= 0.85 * [l] && [u] <= [l])) + 0"
            ],
            "formatString": "#,0",
            "displayFolder": "Budget",
            "lineageTag": "2c6a9d18-5e73-4b40-8f29-1e7b3a6d9c74"
          },
          {
            "name": "Users Within Budget",
            "expression": [
              "VAR T = SUMMARIZE('CoworkBilling', 'CoworkBilling'[UserPrincipalName], \"u\", [Cowork Total Credits Used], \"l\", [Person Allowance])",
              "RETURN COUNTROWS(FILTER(T, [u] < 0.85 * [l]))"
            ],
            "formatString": "#,0",
            "displayFolder": "Budget",
            "lineageTag": "5e9b3d74-1a28-4c60-8f39-6b2a7c5d9e13"
          },
          {
            "name": "Budget Status",
            "expression": [
              "VAR u = [Person Allowance Used %]",
              "RETURN SWITCH(TRUE(), u > 1, \"Over\", u >= 0.85, \"Near\", \"Under\")"
            ],
            "displayFolder": "Budget",
            "lineageTag": "8d2c7e19-5a34-4b60-9f28-3e6b1a9d7c05"
          },
          {
            "name": "Org Avg Credits per User",
            "expression": "DIVIDE(CALCULATE([Cowork Total Credits Used], REMOVEFILTERS('Org')), CALCULATE([User Count], REMOVEFILTERS('Org')))",
            "formatString": "#,0",
            "displayFolder": "Adoption",
            "lineageTag": "3a7c1e94-8d52-4b60-9f18-2e6b9d3c7a15"
          },
          {
            "name": "Dept Avg Credits per User",
            "expression": "CALCULATE([Cowork Avg Credits per User], ALLEXCEPT('Org', 'Org'[Department]))",
            "formatString": "#,0",
            "displayFolder": "Adoption",
            "lineageTag": "6c2b9d53-1e74-4a60-8f38-5b3a7d6c9e10"
          },
          {
            "name": "Standout Ratio",
            "expression": "DIVIDE([Cowork Total Credits Used], [Dept Avg Credits per User])",
            "formatString": "#,0.0",
            "displayFolder": "Adoption",
            "lineageTag": "9e4c7d18-5a23-4b60-8f39-1b7a3e6d9c52"
          },
          {
            "name": "Standout Flag",
            "expression": "IF([Standout Ratio] >= 2, \"★\", \"\")",
            "displayFolder": "Adoption",
            "lineageTag": "4d8a2e75-3c16-4b60-9f28-7b1e5d6c9a39"
          },
          {
            "name": "Consumed Quantity",
            "expression": "[Cowork Total Credits Used]",
            "formatString": "#,0",
            "displayFolder": "FOCUS",
            "lineageTag": "d73764ec-9a8c-4488-9a95-892af36ea938"
          },
          {
            "name": "Pricing Quantity",
            "expression": "[Cowork Total Credits Used]",
            "formatString": "#,0",
            "displayFolder": "FOCUS",
            "lineageTag": "098e45b9-cece-4d80-bf04-f902c2102b2a"
          },
          {
            "name": "List Unit Price",
            "expression": "SELECTEDVALUE('Assumptions'[RatePerCredit], 0.01)",
            "formatString": "\\$#,0.0000",
            "displayFolder": "FOCUS",
            "lineageTag": "bbd43665-9cbd-44e7-9dab-43882de2a123"
          },
          {
            "name": "Contracted Unit Price",
            "expression": "[Cowork PAYG Rate Value]",
            "formatString": "\\$#,0.0000",
            "displayFolder": "FOCUS",
            "lineageTag": "0bb018d1-cd2e-4ae9-a40d-c9d34b585fc6"
          },
          {
            "name": "List Cost",
            "expression": "[Cowork Total Credits Used] * [List Unit Price]",
            "formatString": "\\$#,0.00",
            "displayFolder": "FOCUS",
            "lineageTag": "94ddaabc-b847-4cf1-9025-9d3223cddea9"
          },
          {
            "name": "Contracted Cost",
            "expression": "[Cowork Total Credits Used] * [Contracted Unit Price]",
            "formatString": "\\$#,0.00",
            "displayFolder": "FOCUS",
            "lineageTag": "ad2ec171-95af-46d1-99a0-30e51491b840"
          },
          {
            "name": "Effective Cost",
            "expression": "[Contracted Cost]",
            "formatString": "\\$#,0.00",
            "displayFolder": "FOCUS",
            "lineageTag": "07271528-e508-4f41-8b73-c5b569af1f24"
          },
          {
            "name": "Billed Cost",
            "expression": "[Contracted Cost]",
            "formatString": "\\$#,0.00",
            "displayFolder": "FOCUS",
            "lineageTag": "db0447c4-40c3-4529-b35e-554ae810a1a9"
          },
          {
            "name": "Savings vs List",
            "expression": "[List Cost] - [Contracted Cost]",
            "formatString": "\\$#,0.00",
            "displayFolder": "FOCUS",
            "lineageTag": "a4b036d7-0593-4e0d-a683-8bb72f9ef270"
          },
          {
            "name": "Billing Currency",
            "expression": "\"USD\"",
            "displayFolder": "FOCUS",
            "lineageTag": "8971e507-090b-4ce6-9eff-e0671623c21c"
          },
          {
            "name": "Service Name",
            "expression": "\"Microsoft 365 Copilot\"",
            "displayFolder": "FOCUS",
            "lineageTag": "31ae2cfd-540a-49b6-89c4-22555fd10fec"
          },
          {
            "name": "Service Category",
            "expression": "\"AI and Machine Learning\"",
            "displayFolder": "FOCUS",
            "lineageTag": "fac66686-6d98-407b-995e-79dce63c862a"
          },
          {
            "name": "Service Subcategory",
            "expression": "\"Generative AI\"",
            "displayFolder": "FOCUS",
            "lineageTag": "2e7f41fd-1dfe-44b6-a23b-ee3c38a42750"
          },
          {
            "name": "Charge Category",
            "expression": "\"Usage\"",
            "displayFolder": "FOCUS",
            "lineageTag": "d6ff1e59-9fac-43b8-a61a-ec9789fd8f88"
          },
          {
            "name": "Charge Period Start",
            "expression": "DATE(2026, 7, 1)",
            "formatString": "yyyy-mm-dd",
            "displayFolder": "FOCUS",
            "lineageTag": "757a5a51-3bca-4b3d-9964-0d0bdc16a881"
          },
          {
            "name": "Charge Period End",
            "expression": "DATE(2026, 8, 1)",
            "formatString": "yyyy-mm-dd",
            "displayFolder": "FOCUS",
            "lineageTag": "c859b7fe-3ec2-4a75-98cc-9ed7e6209b95"
          },
          {
            "name": "% Users Over Limit",
            "expression": [
              "",
              "DIVIDE(",
              "    [Users Over Limit],",
              "    [User Count]",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Budget",
            "lineageTag": "443b7de6-4944-4240-bcbe-63b89654e063"
          },
          {
            "name": "% Users Near Limit",
            "expression": "DIVIDE( [Users Near Limit],    [User Count] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Budget",
            "lineageTag": "a825e2f5-6e18-4735-87e6-a850067fda56"
          },
          {
            "name": "% Users Within Budget",
            "expression": "DIVIDE( [Users Within Budget], [User Count] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Budget",
            "lineageTag": "04178563-737c-4238-ad7e-865461cd9178"
          },
          {
            "name": "Top User (Credits)",
            "expression": [
              "",
              "VAR PerUser =",
              "    ADDCOLUMNS(",
              "        SUMMARIZE(",
              "            'CoworkBilling',",
              "            'CoworkBilling'[UserPrincipalName],",
              "            'CoworkBilling'[DisplayName]",
              "        ),",
              "        \"@Used\", [Cowork Total Credits Used]",
              "    )",
              "VAR TopRow = TOPN( 1, PerUser, [@Used], DESC )",
              "RETURN",
              "    CONCATENATEX( TopRow, 'CoworkBilling'[DisplayName], \", \" )"
            ],
            "displayFolder": "Adoption",
            "lineageTag": "d78dad28-7e5f-47d0-8288-6b076a01c1f1"
          },
          {
            "name": "Top User (Chargeback)",
            "expression": [
              "",
              "VAR PerUser =",
              "    ADDCOLUMNS(",
              "        SUMMARIZE(",
              "            'CoworkBilling',",
              "            'CoworkBilling'[UserPrincipalName],",
              "            'CoworkBilling'[DisplayName]",
              "        ),",
              "        \"@Used\", [Over Limit Credits (Individual)]",
              "    )",
              "VAR TopRow = TOPN( 1, PerUser, [@Used], DESC )",
              "RETURN",
              "    CONCATENATEX( TopRow, 'CoworkBilling'[DisplayName], \", \" )"
            ],
            "displayFolder": "Adoption",
            "lineageTag": "5bddd60c-c732-485d-8429-d3f770504c04"
          },
          {
            "name": "Top User (Most unused credits)",
            "expression": [
              "",
              "VAR PerUser =",
              "    ADDCOLUMNS(",
              "        SUMMARIZE(",
              "            'CoworkBilling',",
              "            'CoworkBilling'[UserPrincipalName],",
              "            'CoworkBilling'[DisplayName]",
              "        ),",
              "        \"@Used\", [Unused Credits]",
              "    )",
              "VAR TopRow = TOPN( 1, PerUser, [@Used], DESC )",
              "RETURN",
              "    CONCATENATEX( TopRow, 'CoworkBilling'[DisplayName], \", \" )"
            ],
            "displayFolder": "Adoption",
            "lineageTag": "50304660-0f99-4332-9be7-1ddeaaea6797"
          },
          {
            "name": "Cowork PAYG Rate",
            "expression": "[Cowork PAYG Rate Value]",
            "formatString": "\\$#,0.0000",
            "displayFolder": "Forecast\\Rates",
            "lineageTag": "b1000001-0005-4001-8001-000000000005"
          },
          {
            "name": "Cowork Prepaid Rate",
            "description": [
              "Now delegates to the Prepaid Rate what-if parameter. Previously this was",
              "the hard-coded literal 0.008; the parameter defaults to that same value,",
              "so existing figures are unchanged until someone moves the slider."
            ],
            "expression": "[Cowork Prepaid Rate Value]",
            "formatString": "\\$#,0.0000",
            "displayFolder": "Forecast\\Rates",
            "lineageTag": "b1000001-0006-4001-8001-000000000006"
          },
          {
            "name": "Dormant Seats",
            "description": [
              "Seats with no consumption at all in the four-week billing snapshot.",
              "",
              "Not proof the seat is unused - it is one period, and the Period control does",
              "not reach this figure. Treat it as a list to check, not a list to cancel."
            ],
            "expression": "CALCULATE( [User Count], 'CoworkBilling'[MonthlyCreditsUsed] = 0 )",
            "formatString": "#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "d1000001-0001-4001-8001-000000000001"
          },
          {
            "name": "Dormant Seat Credits",
            "description": "Assigned capacity tied up in seats that were never used this period.",
            "expression": "CALCULATE( [Person Allowance], 'CoworkBilling'[MonthlyCreditsUsed] = 0 )",
            "formatString": "#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "d1000001-0002-4001-8001-000000000002"
          },
          {
            "name": "Dormant Seat $",
            "description": [
              "Value of dormant capacity. Only a real saving under prepaid or hybrid -",
              "see Seat Saving Basis Note."
            ],
            "expression": "[Dormant Seat Credits] * [Cowork PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Optimisation",
            "lineageTag": "d1000001-0003-4001-8001-000000000003"
          },
          {
            "name": "Reclaimable Credits",
            "description": [
              "Credits released if every oversized seat were resized to its",
              "90th-percentile week. Excludes seats that need upgrading."
            ],
            "expression": "SUMX( 'CoworkBilling', MAX( 0, 'CoworkBilling'[Seat Delta] ) )",
            "formatString": "#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "d1000001-0004-4001-8001-000000000004"
          },
          {
            "name": "Reclaimable $",
            "description": [
              "Value of reclaimable capacity. Only a real saving under prepaid or hybrid",
              "- see Seat Saving Basis Note."
            ],
            "expression": "[Reclaimable Credits] * [Cowork PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Optimisation",
            "lineageTag": "d1000001-0005-4001-8001-000000000005"
          },
          {
            "name": "Additional Credits Needed",
            "description": [
              "Capacity required to properly fund users who persistently exceed their",
              "current seat."
            ],
            "expression": "SUMX( 'CoworkBilling', MAX( 0, -'CoworkBilling'[Seat Delta] ) )",
            "formatString": "#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "d1000001-0006-4001-8001-000000000006"
          },
          {
            "name": "Right-Size Net $",
            "description": [
              "Value released each month by acting on every recommendation: reclaims and",
              "downsizes, less the cost of the upgrades. Positive is a net saving.",
              "",
              "Use this rather than Right-Size Net $, which is not scoped to the",
              "recommendation and overstates the opportunity."
            ],
            "expression": "[Action Value /mo]",
            "formatString": "\\$#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "d1000001-0007-4001-8001-000000000007"
          },
          {
            "name": "Seats to Upgrade",
            "description": [
              "People persistently exceeding their seat, who are genuinely",
              "under-provisioned rather than merely spiky."
            ],
            "expression": "CALCULATE( [User Count], 'CoworkBilling'[Breach Persistence] >= 0.60 )",
            "formatString": "#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "d1000001-0008-4001-8001-000000000008"
          },
          {
            "name": "Seats to Downsize",
            "description": "Active users whose seat materially exceeds what they consume.",
            "expression": "CALCULATE( [User Count], 'CoworkBilling'[Seat Delta] > 0, 'CoworkBilling'[MonthlyCreditsUsed] > 0 )",
            "formatString": "#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "d1000001-0009-4001-8001-000000000009"
          },
          {
            "name": "Cowork Top 10% Share",
            "description": [
              "Share of credits consumed by the heaviest 10% of users. High values mean",
              "the run-rate depends on a handful of people."
            ],
            "expression": [
              "",
              "VAR n     = [User Count]",
              "VAR k     = MAX( 1, ROUND( n * 0.10, 0 ) )",
              "VAR t     = ADDCOLUMNS( VALUES('CoworkBilling'[UserPrincipalName]), \"@c\", [Cowork Total Credits Used] )",
              "VAR topK  = TOPN( k, t, [@c], DESC )",
              "RETURN DIVIDE( SUMX( topK, [@c] ), [Cowork Total Credits Used] )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Risk",
            "lineageTag": "d1000001-0010-4001-8001-000000000010"
          },
          {
            "name": "Top 1% Share",
            "description": [
              "Share of credits consumed by the heaviest 1% of users - a key-person",
              "dependency signal."
            ],
            "expression": [
              "",
              "VAR n     = [User Count]",
              "VAR k     = MAX( 1, ROUND( n * 0.01, 0 ) )",
              "VAR t     = ADDCOLUMNS( VALUES('CoworkBilling'[UserPrincipalName]), \"@c\", [Cowork Total Credits Used] )",
              "VAR topK  = TOPN( k, t, [@c], DESC )",
              "RETURN DIVIDE( SUMX( topK, [@c] ), [Cowork Total Credits Used] )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Risk",
            "lineageTag": "d1000001-0011-4001-8001-000000000011"
          },
          {
            "name": "Consumption Gini",
            "description": [
              "Gini coefficient of credit consumption. 0 = perfectly even, 1 = one",
              "person consumes everything."
            ],
            "expression": [
              "",
              "VAR t =",
              "    FILTER(",
              "        ADDCOLUMNS( VALUES('CoworkBilling'[UserPrincipalName]), \"@c\", [Cowork Total Credits Used] + 0 ),",
              "        [@c] > 0",
              "    )",
              "VAR n   = COUNTROWS(t)",
              "VAR tot = SUMX(t, [@c])",
              "VAR ranked = ADDCOLUMNS( t, \"@r\", RANKX( t, [@c],, ASC ) )",
              "VAR num = SUMX( ranked, ( 2 * [@r] - n - 1 ) * [@c] )",
              "RETURN IF( n > 1 && tot > 0, DIVIDE( num, n * tot ) )",
              ""
            ],
            "formatString": "0.000",
            "displayFolder": "Risk",
            "lineageTag": "d1000001-0012-4001-8001-000000000012"
          },
          {
            "name": "Credits per Session",
            "description": "Average credits consumed per session - a session-intensity signal.",
            "expression": "DIVIDE( [Cowork Total Credits Used], [Total Sessions] )",
            "formatString": "#,0.0",
            "displayFolder": "Risk",
            "lineageTag": "d1000001-0013-4001-8001-000000000013"
          },
          {
            "name": "Licensed but Inactive",
            "description": [
              "Licensed people with no consumption this period - a licence-management",
              "question rather than a capacity one."
            ],
            "expression": "CALCULATE( [User Count], 'CoworkBilling'[CopilotLicense] = \"Yes\", 'CoworkBilling'[MonthlyCreditsUsed] = 0 )",
            "formatString": "#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "d1000001-0014-4001-8001-000000000014"
          },
          {
            "name": "Cowork Prepaid Balance",
            "description": [
              "Prepaid Capacity Pack credits available to draw down. Sourced from the",
              "Capacity Pack Balance input, because no Viva export carries the balance -",
              "it lives in admin centre under Cost management > Billing method.",
              "Zero means everything bills pay-as-you-go."
            ],
            "expression": "[Cowork Capacity Pack Balance Value]",
            "formatString": "#,0",
            "displayFolder": "Cost",
            "lineageTag": "c1100001-0001-4001-8001-000000000001"
          },
          {
            "name": "Cowork Total Cost",
            "description": [
              "Consumption that falls inside the prepaid commitment.",
              "What the period actually costs: prepaid credits at the prepaid rate, the rest at the pay-as-you-",
              "go rate."
            ],
            "expression": "[Cowork Prepaid Cost] + [Cowork PAYG Cost]",
            "formatString": "\\$#,0",
            "displayFolder": "Cost",
            "lineageTag": "c1100001-0010-4001-8001-000000000010"
          },
          {
            "name": "Seat Saving Basis Note",
            "description": [
              "States the basis used to price the right-sizing opportunity, so the number",
              "on the page is never read as a cash refund."
            ],
            "expression": "\"Savings are priced at the pay-as-you-go rate, because releasing a credit only saves money if you would otherwise have bought it.\"",
            "displayFolder": "Cost",
            "lineageTag": "c2200001-0007-4001-8001-000000000007"
          },
          {
            "name": "Policy Allowance",
            "description": [
              "Adds up the plan limits on the spending policies. A separate governance",
              "layer from Person Allowance - policies cap a group, user limits cap a",
              "person, and the two totals differ. Shown as \"Policy limits\"."
            ],
            "expression": [
              "VAR Limit =",
              "    CALCULATE(",
              "        SUM('SpendingPolicy'[PlanLimit]),",
              "        'SpendingPolicy'[SpendingPolicyId] <> \"00000000-0000-0000-0000-000000000000\"",
              "    )",
              "RETURN IF(Limit > 0, Limit)"
            ],
            "formatString": "#,0",
            "displayFolder": "Allowance",
            "lineageTag": "c1100001-0024-4001-8001-000000000024"
          },
          {
            "name": "Credits Over Policy Allowance",
            "description": "Credits that would be refused because a policy reached its monthly spending limit. Users on that policy lose access to agents until credits reset on the 1st. Measured over the current billing period, because the configured limit is monthly.",
            "expression": [
              "",
              "SUMX(",
              "    VALUES( 'SpendingPolicy'[SpendingPolicyId] ),",
              "    VAR Lim  = CALCULATE( SUM( 'SpendingPolicy'[PlanLimit] ) )",
              "    VAR Used = CALCULATE( [Cowork Total Credits Used] )",
              "    RETURN IF( Lim > 0, MAX( 0, Used - Lim ), 0 )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Allowance",
            "lineageTag": "c1100001-0025-4001-8001-000000000025"
          },
          {
            "name": "Policies Over Allowance",
            "description": "Spending policies whose current-period consumption has passed their configured monthly limit. Users on these policies lose agent access until the 1st of next month.",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES( 'SpendingPolicy'[SpendingPolicyId] ),",
              "        VAR Lim  = CALCULATE( SUM( 'SpendingPolicy'[PlanLimit] ) )",
              "        VAR Used = CALCULATE( [Cowork Total Credits Used] )",
              "        RETURN Lim > 0 && Used > Lim",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Allowance",
            "lineageTag": "c1100001-0026-4001-8001-000000000026"
          },
          {
            "name": "Policy Allowance Used %",
            "description": [
              "Credits used as a share of the spending policy limits. Over 100% means",
              "consumption exceeded what the policies allow. Shown as \"Used vs policy",
              "limits\" - a different denominator from Person Allowance Used %."
            ],
            "expression": "DIVIDE( [Cowork Total Credits Used], [Policy Allowance] )",
            "formatString": "0.0%",
            "displayFolder": "Allowance",
            "lineageTag": "c1100001-0027-4001-8001-000000000027"
          },
          {
            "name": "Cowork Prepaid Used",
            "description": "Consumption drawn from the prepaid balance. Prepaid is always consumed before pay-as-you-go.",
            "expression": [
              "",
              "// MIN coerces BLANK to a number, so a group with no Cowork users",
              "// reported 0 prepaid credits and kept its row on the Cost page at",
              "// $0 - while the Consumption page correctly dropped it.",
              "// Credits Used already separates \"no users\" (BLANK) from \"users",
              "// who spent nothing\" (0), so defer to it.",
              "VAR Used = [Cowork Total Credits Used]",
              "RETURN",
              "\tIF( NOT ISBLANK( Used ), MIN( Used, [Cowork Prepaid Balance] ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Cost",
            "lineageTag": "c2200001-0001-4001-8001-000000000001"
          },
          {
            "name": "Cowork Prepaid Left",
            "description": "Prepaid credits still unused. Money already spent that is not yet working.",
            "expression": "MAX( 0, [Cowork Prepaid Balance] - [Cowork Prepaid Used] )",
            "formatString": "#,0",
            "displayFolder": "Cost",
            "lineageTag": "c2200001-0002-4001-8001-000000000002"
          },
          {
            "name": "Cowork PAYG Credits",
            "description": "Consumption billed at the pay-as-you-go rate, once prepaid is exhausted.",
            "expression": [
              "",
              "// Same coercion as Cowork Prepaid Used: BLANK - 0 is 0, and MAX",
              "// then returns a real zero rather than passing the blank through.",
              "VAR Used = [Cowork Total Credits Used]",
              "RETURN",
              "\tIF( NOT ISBLANK( Used ),",
              "\t\tMAX( 0, Used - [Cowork Prepaid Balance] ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Cost",
            "lineageTag": "c2200001-0003-4001-8001-000000000003"
          },
          {
            "name": "Blended Rate $",
            "description": [
              "The price actually paid per credit across both rates. Equals the",
              "pay-as-you-go rate when no prepaid balance is held."
            ],
            "expression": "DIVIDE( [Cowork Total Cost], [Cowork Total Credits Used] )",
            "formatString": "\\$#,0.0000",
            "displayFolder": "Cost",
            "lineageTag": "c2200001-0004-4001-8001-000000000004"
          },
          {
            "name": "Billing Basis",
            "description": [
              "How this period is actually billed. Derived from the prepaid balance against consumption, so it",
              "never has to be declared."
            ],
            "expression": [
              "VAR Bal  = [Cowork Prepaid Balance]",
              "VAR Used = [Cowork Total Credits Used]",
              "RETURN",
              "SWITCH(",
              "TRUE(),",
              "Bal = 0,      \"Pay-as-you-go\",",
              "Bal >= Used,  \"Capacity Packs\",",
              "\"Capacity Packs, then pay-as-you-go\"",
              ")"
            ],
            "displayFolder": "Cost",
            "lineageTag": "c2200001-0005-4001-8001-000000000005"
          },
          {
            "name": "Policy Headroom",
            "description": [
              "Credits still available before consumption exceeds the spending policy",
              "limits. Shown as \"Credits left\". A blank or zero limit means no limit is set, so this returns BLANK."
            ],
            "expression": [
              "VAR Allowance = [Policy Allowance]",
              "RETURN IF(NOT ISBLANK(Allowance), Allowance - [Cowork Total Credits Used])"
            ],
            "formatString": "#,0",
            "displayFolder": "Allowance",
            "lineageTag": "c2200001-0006-4001-8001-000000000006"
          },
          {
            "name": "Cowork Prepaid Cost",
            "description": "What the prepaid draw-down cost. Zero when no Capacity Pack balance is held.",
            "expression": "[Cowork Prepaid Used] * [Cowork Prepaid Rate Value]",
            "formatString": "\\$#,0",
            "displayFolder": "Cost",
            "lineageTag": "c3300001-0001-4001-8001-000000000001"
          },
          {
            "name": "Cowork PAYG Cost",
            "description": "What the pay-as-you-go portion cost, after any prepaid balance was used up.",
            "expression": "[Cowork PAYG Credits] * [Cowork PAYG Rate]",
            "formatString": "\\$#,0",
            "displayFolder": "Cost",
            "lineageTag": "c3300001-0002-4001-8001-000000000002"
          },
          {
            "name": "Cowork PAYG Share of Cost %",
            "description": [
              "Share of spend still going through pay-as-you-go. A high share means a",
              "Capacity Pack would likely reduce the bill."
            ],
            "expression": "DIVIDE( [Cowork PAYG Cost], [Cowork Total Cost] )",
            "formatString": "0.0%",
            "displayFolder": "Cost",
            "lineageTag": "c3300001-0003-4001-8001-000000000003"
          },
          {
            "name": "Consuming Users",
            "description": [
              "People who consumed the selected service in the selected period. Differs",
              "from User Count, which counts everyone holding a seat whether they used",
              "it or not."
            ],
            "expression": [
              "",
              "VAR Wks = [Cowork Period Weeks]",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT( 'CreditsWeekly'[UserPrincipalName] ),",
              "    FILTER( ALL( 'CreditsWeekly'[Weeks Ago] ), 'CreditsWeekly'[Weeks Ago] < Wks ),",
              "    REMOVEFILTERS( 'CreditsWeekly'[MetricDate] ),",
              "    REMOVEFILTERS( 'CreditsWeekly'[Week Index] ),",
              "    REMOVEFILTERS( 'CreditsWeekly'[Week Label] ),",
              "    REMOVEFILTERS( 'Date' ),",
              "    TREATAS( VALUES( 'CoworkBilling'[UserPrincipalName] ), 'CreditsWeekly'[UserPrincipalName] )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Counts",
            "lineageTag": "c4400001-0001-4001-8001-000000000001"
          },
          {
            "name": "Action Value /mo",
            "description": [
              "Monthly value of acting on the recommendation, and nothing else.",
              "",
              "Right-Size Net $ is generic headroom arithmetic: it subtracts one column",
              "from another for whoever is in scope, so slicing it by action returned that",
              "group's unused headroom rather than the value of doing what the row says.",
              "That is why 'Correctly sized' showed a $5,739 saving and 'Hold' showed $620.",
              "",
              "Here only the actionable buckets carry a number:",
              "1 reclaim  -> the whole seat is released",
              "2 review   -> the whole seat, if the check confirms it",
              "3 downsize -> the oversized portion is released",
              "6 upgrade  -> negative, because funding those people costs money",
              "4 hold / 5 monitor / 7 correctly sized -> nothing, by definition"
            ],
            "expression": [
              "",
              "VAR Rate = [Cowork PAYG Rate Value]",
              "RETURN",
              "SUMX(",
              "    'CoworkBilling',",
              "    VAR Act   = 'CoworkBilling'[Seat Action]",
              "    VAR Limit = 'CoworkBilling'[MonthlyCreditLimit]",
              "    VAR Delta = 'CoworkBilling'[Seat Delta]",
              "    RETURN",
              "        SWITCH(",
              "            LEFT( Act, 1 ),",
              "            \"1\", Limit * Rate,",
              "            \"2\", Limit * Rate,",
              "            \"3\", MAX( 0, Delta ) * Rate,",
              "            \"6\", -MAX( 0, -Delta ) * Rate,",
              "            0",
              "        )",
              ")",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "Optimisation",
            "lineageTag": "b64c7f9a-73a8-4836-9097-021c3de4339c"
          },
          {
            "name": "Action Meaning",
            "description": [
              "What acting on this recommendation actually means, in one short phrase.",
              "Sits beside the number so a reader never has to infer the action from the",
              "bucket name."
            ],
            "expression": [
              "",
              "VAR Act = SELECTEDVALUE( 'CoworkBilling'[Seat Action] )",
              "RETURN",
              "    SWITCH(",
              "        LEFT( Act, 1 ),",
              "        \"1\", \"Release the seat\",",
              "        \"2\", \"Check with the user first, then release\",",
              "        \"3\", \"Lower the limit to fit actual use\",",
              "        \"4\", \"No action - spiky, not structural\",",
              "        \"5\", \"No action - watch for a breach\",",
              "        \"6\", \"Raise the limit - this costs money\",",
              "        \"7\", \"No action\",",
              "        \"\"",
              "    )",
              ""
            ],
            "displayFolder": "Optimisation",
            "lineageTag": "e94f125f-c5a6-4f5f-af85-d03ee180a7b5"
          },
          {
            "name": "Cowork Credits /mo",
            "description": [
              "Cowork credits normalised to a month.",
              "",
              "The three products are exported over different windows - Cowork 13 weeks,",
              "GitHub 3 months, Studio 9 days - so raw totals cannot be compared. Every",
              "figure on the combined page is a monthly run rate for that reason."
            ],
            "expression": [
              "",
              "VAR Wks = [Cowork Period Weeks]",
              "RETURN DIVIDE( [Cowork Total Credits Used] * 4.345, Wks )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "All products",
            "lineageTag": "f464b9e8-485f-4ed8-b9a5-0f165b0dff91"
          },
          {
            "name": "Cowork Cost /mo",
            "description": "Cowork cost normalised to a month.",
            "expression": [
              "",
              "VAR Wks = [Cowork Period Weeks]",
              "RETURN DIVIDE( [Cowork Total Cost] * 4.345, Wks )",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "All products",
            "lineageTag": "6338378a-ce85-496b-9aaa-b4c7d2f8681c"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "CreditsWeekly",
        "lineageTag": "7a4c0e38-2f95-4d61-9b87-4e9a2c1f6b30",
        "columns": [
          {
            "name": "PersonId",
            "dataType": "string",
            "sourceColumn": "PersonId",
            "lineageTag": "e0000001-0101-4001-8001-000000000101",
            "summarizeBy": "none"
          },
          {
            "name": "UserPrincipalName",
            "dataType": "string",
            "description": "Resolved user principal name, joined from the Viva seat roster. Relates this table to Org.",
            "sourceColumn": "UserPrincipalName",
            "lineageTag": "e0000001-0102-4001-8001-000000000102",
            "summarizeBy": "none"
          },
          {
            "name": "MetricDate",
            "dataType": "dateTime",
            "sourceColumn": "MetricDate",
            "formatString": "yyyy-mm-dd",
            "lineageTag": "e0000001-0103-4001-8001-000000000103",
            "summarizeBy": "none"
          },
          {
            "name": "ServiceName",
            "dataType": "string",
            "sourceColumn": "ServiceName",
            "lineageTag": "e0000001-0104-4001-8001-000000000104",
            "summarizeBy": "none"
          },
          {
            "name": "SpendingPolicyId",
            "dataType": "string",
            "description": "Spending policy governing the row. The all-zero GUID indicates usage outside any policy window.",
            "sourceColumn": "SpendingPolicyId",
            "lineageTag": "e0000001-0105-4001-8001-000000000105",
            "summarizeBy": "none"
          },
          {
            "name": "CreditsUsed",
            "dataType": "double",
            "sourceColumn": "CreditsUsed",
            "formatString": "#,0",
            "lineageTag": "e0000001-0106-4001-8001-000000000106",
            "summarizeBy": "sum"
          },
          {
            "name": "SessionCount",
            "dataType": "int64",
            "sourceColumn": "SessionCount",
            "formatString": "#,0",
            "lineageTag": "e0000001-0107-4001-8001-000000000107",
            "summarizeBy": "sum"
          },
          {
            "type": "calculated",
            "name": "Week Label",
            "dataType": "string",
            "expression": "FORMAT('CreditsWeekly'[MetricDate], \"dd mmm\")",
            "sortByColumn": "MetricDate",
            "lineageTag": "e0000001-0108-4001-8001-000000000108",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Week Index",
            "dataType": "int64",
            "description": "1 = oldest week in the export. The x-axis for the trend regression.",
            "expression": "RANKX( ALL('CreditsWeekly'[MetricDate]), 'CreditsWeekly'[MetricDate],, ASC, DENSE )",
            "formatString": "0",
            "lineageTag": "e0000001-0109-4001-8001-000000000109",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Weeks Ago",
            "dataType": "int64",
            "description": "0 = most recent week, 1 = the week before, and so on.",
            "expression": [
              "",
              "VAR MaxWk = CALCULATE( MAX('CreditsWeekly'[MetricDate]), ALL('CreditsWeekly') )",
              "RETURN DATEDIFF( 'CreditsWeekly'[MetricDate], MaxWk, DAY ) / 7",
              ""
            ],
            "formatString": "0",
            "lineageTag": "e0000001-0110-4001-8001-000000000110",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "CreditsWeekly",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Metrics = Table.SelectColumns(VivaCreditMetrics, {",
                "        \"PersonId\",\"UserPrincipalName\",\"MetricDate\",\"ServiceName\",",
                "        \"SpendingPolicyId\",\"CreditsUsed\",\"SessionCount\"",
                "    }),",
                "    Joined = Table.NestedJoin(Metrics, {\"PersonId\"}, VivaSeatRoster, {\"PersonId\"}, \"seat\", JoinKind.LeftOuter),",
                "    Expanded = Table.ExpandTableColumn(Joined, \"seat\", {\"userPrincipalName\"}, {\"SeatUpn\"}),",
                "    // The roster's first real UPN (else PersonId) is the relationship key for every week.",
                "    Coalesced = Table.AddColumn(Expanded, \"ResolvedUpn\",",
                "        each Text.Lower(Text.Trim(Text.From(",
                "            if [SeatUpn] <> null and [SeatUpn] <> \"\" then [SeatUpn]",
                "            else if [UserPrincipalName] <> null and [UserPrincipalName] <> \"\" then [UserPrincipalName]",
                "            else [PersonId]))), type text),",
                "    Dropped = Table.RemoveColumns(Coalesced, {\"UserPrincipalName\",\"SeatUpn\"}),",
                "    Named = Table.RenameColumns(Dropped, {{\"ResolvedUpn\",\"UserPrincipalName\"}}),",
                "    Selected = Table.SelectColumns(Named, {",
                "        \"PersonId\",\"UserPrincipalName\",\"MetricDate\",\"ServiceName\",",
                "        \"SpendingPolicyId\",\"CreditsUsed\",\"SessionCount\"",
                "    }),",
                "    Typed = Table.TransformColumnTypes(Selected, {",
                "        {\"PersonId\", type text},{\"UserPrincipalName\", type text},",
                "        {\"MetricDate\", type datetime},{\"ServiceName\", type text},",
                "        {\"SpendingPolicyId\", type text},{\"CreditsUsed\", type number},",
                "        {\"SessionCount\", Int64.Type}",
                "    })",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Weekly Credits",
            "description": "Total credits consumed in the week under the current filters.",
            "expression": "SUM('CreditsWeekly'[CreditsUsed])",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "e0000001-0001-4001-8001-000000000001"
          },
          {
            "name": "Weekly Sessions",
            "expression": "SUM('CreditsWeekly'[SessionCount])",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "e0000001-0002-4001-8001-000000000002"
          },
          {
            "name": "Weekly Active Users",
            "description": "Distinct people who consumed credits during the week.",
            "expression": "DISTINCTCOUNT('CreditsWeekly'[UserPrincipalName])",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "e0000001-0003-4001-8001-000000000003"
          },
          {
            "name": "Credits per Active User",
            "expression": "DIVIDE([Weekly Credits], [Weekly Active Users])",
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "e0000001-0004-4001-8001-000000000004"
          },
          {
            "name": "Weekly Credits WoW %",
            "description": "Week-over-week change in credit consumption.",
            "expression": [
              "",
              "VAR CurWeek = MAX('CreditsWeekly'[MetricDate])",
              "VAR Prev =",
              "    CALCULATE(",
              "        [Weekly Credits],",
              "        REMOVEFILTERS('CreditsWeekly'[MetricDate]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Index]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Label]),",
              "        REMOVEFILTERS('CreditsWeekly'[Weeks Ago]),",
              "        REMOVEFILTERS('Date'),",
              "        'CreditsWeekly'[MetricDate] = CurWeek - 7",
              "    )",
              "RETURN DIVIDE( [Weekly Credits] - Prev, Prev )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Trend",
            "lineageTag": "e0000001-0005-4001-8001-000000000005"
          },
          {
            "name": "Credits 4wk Rolling Avg",
            "description": "Average weekly credits over this week and the three before it - a smoothing line that removes single-week noise. Early weeks divide by however many weeks actually exist, so the line is not artificially deflated at the start of the series.",
            "expression": [
              "",
              "VAR CurWeek = MAX('CreditsWeekly'[MetricDate])",
              "VAR Window =",
              "    CALCULATETABLE(",
              "        VALUES('CreditsWeekly'[MetricDate]),",
              "        REMOVEFILTERS('CreditsWeekly'[MetricDate]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Index]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Label]),",
              "        REMOVEFILTERS('CreditsWeekly'[Weeks Ago]),",
              "        REMOVEFILTERS('Date'),",
              "        'CreditsWeekly'[MetricDate] > CurWeek - 28,",
              "        'CreditsWeekly'[MetricDate] <= CurWeek",
              "    )",
              "VAR Weeks = COUNTROWS( Window )",
              "VAR Total =",
              "    CALCULATE(",
              "        [Weekly Credits],",
              "        REMOVEFILTERS('CreditsWeekly'[MetricDate]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Index]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Label]),",
              "        REMOVEFILTERS('CreditsWeekly'[Weeks Ago]),",
              "        REMOVEFILTERS('Date'),",
              "        'CreditsWeekly'[MetricDate] > CurWeek - 28,",
              "        'CreditsWeekly'[MetricDate] <= CurWeek",
              "    )",
              "RETURN DIVIDE( Total, Weeks )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Trend",
            "lineageTag": "e0000001-0006-4001-8001-000000000006"
          },
          {
            "name": "Trend Slope",
            "description": [
              "Least-squares gradient of weekly credits against week index — the growth",
              "rate the data actually supports, as opposed to the slider guess."
            ],
            "expression": [
              "",
              "VAR T =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS( VALUES('CreditsWeekly'[Week Index]), \"@y\", [Weekly Credits] ),",
              "        ALLSELECTED('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[Week Index]),",
              "        ALLSELECTED('CreditsWeekly'[Week Label]),",
              "        ALLSELECTED('CreditsWeekly'[Weeks Ago]),",
              "        ALLSELECTED('Date')",
              "    )",
              "VAR N   = COUNTROWS(T)",
              "VAR SX  = SUMX(T, 'CreditsWeekly'[Week Index])",
              "VAR SY  = SUMX(T, [@y])",
              "VAR SXY = SUMX(T, 'CreditsWeekly'[Week Index] * [@y])",
              "VAR SXX = SUMX(T, 'CreditsWeekly'[Week Index] * 'CreditsWeekly'[Week Index])",
              "RETURN IF( N > 1, DIVIDE( N * SXY - SX * SY, N * SXX - SX * SX ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast\\Model",
            "lineageTag": "e0000001-0007-4001-8001-000000000007"
          },
          {
            "name": "Trend Intercept",
            "description": [
              "Regression baseline used to calculate fitted values. Internal maths with",
              "no business meaning on its own."
            ],
            "expression": [
              "",
              "VAR T =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS( VALUES('CreditsWeekly'[Week Index]), \"@y\", [Weekly Credits] ),",
              "        ALLSELECTED('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[Week Index]),",
              "        ALLSELECTED('CreditsWeekly'[Week Label]),",
              "        ALLSELECTED('CreditsWeekly'[Weeks Ago]),",
              "        ALLSELECTED('Date')",
              "    )",
              "VAR N  = COUNTROWS(T)",
              "VAR SX = SUMX(T, 'CreditsWeekly'[Week Index])",
              "VAR SY = SUMX(T, [@y])",
              "RETURN IF( N > 1, DIVIDE(SY, N) - [Trend Slope] * DIVIDE(SX, N) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast\\Model",
            "lineageTag": "e0000001-0008-4001-8001-000000000008"
          },
          {
            "name": "Trend R2",
            "description": [
              "Goodness of fit. Below about 0.6 the linear projection should be treated",
              "as indicative only."
            ],
            "expression": [
              "",
              "VAR T =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS( VALUES('CreditsWeekly'[Week Index]), \"@y\", [Weekly Credits] ),",
              "        ALLSELECTED('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[Week Index]),",
              "        ALLSELECTED('CreditsWeekly'[Week Label]),",
              "        ALLSELECTED('CreditsWeekly'[Weeks Ago]),",
              "        ALLSELECTED('Date')",
              "    )",
              "VAR N     = COUNTROWS(T)",
              "VAR YBar  = DIVIDE( SUMX(T, [@y]), N )",
              "VAR B1    = [Trend Slope]",
              "VAR B0    = [Trend Intercept]",
              "VAR SSres = SUMX(T, ( [@y] - ( B0 + B1 * 'CreditsWeekly'[Week Index] ) ) ^ 2)",
              "VAR SStot = SUMX(T, ( [@y] - YBar ) ^ 2)",
              "RETURN IF( N > 2, 1 - DIVIDE(SSres, SStot) )",
              ""
            ],
            "formatString": "0.000",
            "displayFolder": "Forecast\\Model",
            "lineageTag": "e0000001-0009-4001-8001-000000000009"
          },
          {
            "name": "Residual SD",
            "description": "Standard deviation of the fit residuals — drives the confidence band.",
            "expression": [
              "",
              "VAR T =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS( VALUES('CreditsWeekly'[Week Index]), \"@y\", [Weekly Credits] ),",
              "        ALLSELECTED('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[Week Index]),",
              "        ALLSELECTED('CreditsWeekly'[Week Label]),",
              "        ALLSELECTED('CreditsWeekly'[Weeks Ago]),",
              "        ALLSELECTED('Date')",
              "    )",
              "VAR N     = COUNTROWS(T)",
              "VAR B1    = [Trend Slope]",
              "VAR B0    = [Trend Intercept]",
              "VAR SSres = SUMX(T, ( [@y] - ( B0 + B1 * 'CreditsWeekly'[Week Index] ) ) ^ 2)",
              "RETURN IF( N > 2, SQRT( DIVIDE(SSres, N - 2) ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast\\Model",
            "lineageTag": "e0000001-0010-4001-8001-000000000010"
          },
          {
            "name": "Forecast Accuracy (Backtest)",
            "description": [
              "Honest self-assessment: fit on all but the last four weeks, then score",
              "the prediction against those held-out weeks."
            ],
            "expression": [
              "",
              "VAR T =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS( VALUES('CreditsWeekly'[Week Index]), \"@y\", [Weekly Credits] ),",
              "        ALLSELECTED('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[Week Index]),",
              "        ALLSELECTED('CreditsWeekly'[Week Label]),",
              "        ALLSELECTED('CreditsWeekly'[Weeks Ago]),",
              "        ALLSELECTED('Date')",
              "    )",
              "VAR MaxIdx = MAXX(T, 'CreditsWeekly'[Week Index])",
              "VAR Train  = FILTER( T, 'CreditsWeekly'[Week Index] <= MaxIdx - 4 )",
              "VAR Test   = FILTER( T, 'CreditsWeekly'[Week Index] >  MaxIdx - 4 )",
              "VAR N      = COUNTROWS(Train)",
              "VAR SX     = SUMX(Train, 'CreditsWeekly'[Week Index])",
              "VAR SY     = SUMX(Train, [@y])",
              "VAR SXY    = SUMX(Train, 'CreditsWeekly'[Week Index] * [@y])",
              "VAR SXX    = SUMX(Train, 'CreditsWeekly'[Week Index] * 'CreditsWeekly'[Week Index])",
              "VAR B1     = DIVIDE( N * SXY - SX * SY, N * SXX - SX * SX )",
              "VAR B0     = DIVIDE(SY, N) - B1 * DIVIDE(SX, N)",
              "VAR MAPE   = AVERAGEX( Test, DIVIDE( ABS( [@y] - ( B0 + B1 * 'CreditsWeekly'[Week Index] ) ), [@y] ) )",
              "RETURN IF( N > 2, 1 - MAPE )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Forecast\\Model",
            "lineageTag": "e0000001-0018-4001-8001-000000000018"
          },
          {
            "name": "Implied Monthly Growth %",
            "description": [
              "Weekly growth implied by the fit, restated monthly so it can be compared",
              "directly with the growth scenario picker.",
              "",
              "Blank under four weeks of history. The opening weeks of a rollout are a",
              "ramp, not a trend: a tenant going from 0.8 credits to 346 in its second",
              "week fits a 199% weekly rate, which compounds to five-figure monthly",
              "growth and a twelve-month cost in the quintillions. Four weeks is the",
              "same threshold Cowork Forecast Confidence uses to say \"too early to",
              "say\", so the rate and the rating can never contradict each other.",
              "Between four and six weeks the fit is reported but rated",
              "\"indicative only\", because the backtest needs six weeks to run.",
              "",
              "Capped at 100% a month either way - already doubling monthly, 4,096x",
              "in a year - so anything beyond is ramp artefact rather than signal.",
              "Growth Rate Was Capped reports when that bites."
            ],
            "expression": [
              "",
              "VAR T =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS( VALUES('CreditsWeekly'[Week Index]), \"@y\", [Weekly Credits] ),",
              "        ALLSELECTED('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[Week Index]),",
              "        ALLSELECTED('CreditsWeekly'[Week Label]),",
              "        ALLSELECTED('CreditsWeekly'[Weeks Ago]),",
              "        ALLSELECTED('Date')",
              "    )",
              "VAR MeanWk = AVERAGEX(T, [@y])",
              "VAR WkRate = DIVIDE( [Trend Slope], MeanWk )",
              "// A weekly rate at or below -100% would raise a negative base to a",
              "// fractional power and error the visual outright.",
              "VAR SafeWk = MAX( WkRate, -0.9 )",
              "VAR Raw    = POWER( 1 + SafeWk, 4.345 ) - 1",
              "RETURN",
              "    IF(",
              "        [Trend Window Weeks] < 4,",
              "        BLANK(),",
              "        MIN( MAX( Raw, -0.75 ), 1 )",
              "    )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Forecast\\Model",
            "lineageTag": "e0000001-0019-4001-8001-000000000019"
          },
          {
            "name": "Volatility (CV)",
            "description": [
              "Weekly coefficient of variation. High = unpredictable spend needing a",
              "budget buffer. Low = safe to commit capacity against."
            ],
            "expression": [
              "",
              "VAR T =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS( VALUES('CreditsWeekly'[Week Index]), \"@y\", [Weekly Credits] ),",
              "        ALLSELECTED('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[Week Index]),",
              "        ALLSELECTED('CreditsWeekly'[Week Label]),",
              "        ALLSELECTED('CreditsWeekly'[Weeks Ago]),",
              "        ALLSELECTED('Date')",
              "    )",
              "VAR mu = AVERAGEX(T, [@y])",
              "VAR sd = STDEVX.P(T, [@y])",
              "RETURN DIVIDE(sd, mu)",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Risk",
            "lineageTag": "e0000001-0021-4001-8001-000000000021"
          },
          {
            "name": "Predictability Rating",
            "expression": [
              "",
              "VAR cv = [Volatility (CV)]",
              "RETURN",
              "SWITCH( TRUE(),",
              "    ISBLANK(cv), BLANK(),",
              "    cv < 0.15,   \"A. Highly predictable\",",
              "    cv < 0.25,   \"B. Predictable\",",
              "    cv < 0.40,   \"C. Variable\",",
              "    \"D. Volatile\"",
              ")",
              ""
            ],
            "displayFolder": "Risk",
            "lineageTag": "e0000001-0022-4001-8001-000000000022"
          },
          {
            "name": "Z-Score (Week)",
            "description": [
              "How far the week in context sits from that group's own mean, in standard",
              "deviations. Feeds the anomaly tripwire."
            ],
            "expression": [
              "",
              "VAR cur = [Weekly Credits]",
              "VAR T =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS( VALUES('CreditsWeekly'[Week Index]), \"@y\", [Weekly Credits] ),",
              "        ALLSELECTED('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[Week Index]),",
              "        ALLSELECTED('CreditsWeekly'[Week Label]),",
              "        ALLSELECTED('CreditsWeekly'[Weeks Ago]),",
              "        ALLSELECTED('Date')",
              "    )",
              "VAR mu = AVERAGEX(T, [@y])",
              "VAR sd = STDEVX.P(T, [@y])",
              "RETURN DIVIDE( cur - mu, sd )",
              ""
            ],
            "formatString": "0.00",
            "displayFolder": "Risk",
            "lineageTag": "e0000001-0023-4001-8001-000000000023"
          },
          {
            "name": "Anomaly Flag",
            "description": [
              "Marks weeks that fall far outside the normal pattern and are worth",
              "investigating. Shown on the page as 'Unusual week'."
            ],
            "expression": [
              "",
              "VAR z = [Z-Score (Week)]",
              "RETURN",
              "SWITCH( TRUE(),",
              "    ISBLANK(z), BLANK(),",
              "    z >=  2,    \"▲ Spike\",",
              "    z <= -2,    \"▼ Collapse\",",
              "    \"\"",
              ")",
              ""
            ],
            "displayFolder": "Risk",
            "lineageTag": "e0000001-0024-4001-8001-000000000024"
          },
          {
            "name": "Ungoverned Credits",
            "description": [
              "Credits recorded against the all-zero policy GUID — usage that fell",
              "outside any spending policy window. A governance gap."
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    [Weekly Credits],",
              "    REMOVEFILTERS('SpendingPolicy'),",
              "    'CreditsWeekly'[SpendingPolicyId] = \"00000000-0000-0000-0000-000000000000\"",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Risk",
            "lineageTag": "e0000001-0025-4001-8001-000000000025"
          },
          {
            "name": "Ungoverned $",
            "description": [
              "Spend recorded against no spending policy - usage that fell outside any",
              "policy window. A governance gap to close."
            ],
            "expression": "[Ungoverned Credits] * [Cowork PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Risk",
            "lineageTag": "e0000001-0026-4001-8001-000000000026"
          },
          {
            "name": "Ungoverned %",
            "description": "Share of credits falling outside policy control.",
            "expression": [
              "",
              "DIVIDE(",
              "    [Ungoverned Credits],",
              "    CALCULATE( [Weekly Credits], REMOVEFILTERS('SpendingPolicy') )",
              ")",
              ""
            ],
            "formatString": "0.00%",
            "displayFolder": "Risk",
            "lineageTag": "e0000001-0027-4001-8001-000000000027"
          },
          {
            "name": "Multi-Service Users",
            "description": [
              "Users touching more than one service. Multi-service users are typically",
              "far stickier than single-service ones."
            ],
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        ADDCOLUMNS(",
              "            VALUES('CreditsWeekly'[UserPrincipalName]),",
              "            \"@s\", CALCULATE( DISTINCTCOUNT('CreditsWeekly'[ServiceName]) )",
              "        ),",
              "        [@s] > 1",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Adoption",
            "lineageTag": "e0000001-0028-4001-8001-000000000028"
          },
          {
            "name": "Multi-Service %",
            "description": [
              "Share of active users who touch more than one service - a",
              "depth-of-adoption signal."
            ],
            "expression": "DIVIDE( [Multi-Service Users], [Weekly Active Users] )",
            "formatString": "0.0%",
            "displayFolder": "Adoption",
            "lineageTag": "e0000001-0029-4001-8001-000000000029"
          },
          {
            "name": "WoW Retention %",
            "description": "Share of last week's active users who were also active this week.",
            "expression": [
              "",
              "VAR CurWeek = MAX('CreditsWeekly'[MetricDate])",
              "VAR PriorUsers =",
              "    CALCULATETABLE(",
              "        VALUES('CreditsWeekly'[UserPrincipalName]),",
              "        REMOVEFILTERS('CreditsWeekly'[MetricDate]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Index]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Label]),",
              "        REMOVEFILTERS('CreditsWeekly'[Weeks Ago]),",
              "        REMOVEFILTERS('Date'),",
              "        'CreditsWeekly'[MetricDate] = CurWeek - 7",
              "    )",
              "VAR CurUsers = VALUES('CreditsWeekly'[UserPrincipalName])",
              "VAR Kept     = COUNTROWS( INTERSECT( PriorUsers, CurUsers ) )",
              "RETURN DIVIDE( Kept, COUNTROWS(PriorUsers) )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Adoption",
            "lineageTag": "e0000001-0030-4001-8001-000000000030"
          },
          {
            "name": "New Users (Week)",
            "description": "Users appearing for the very first time in the week in context.",
            "expression": [
              "",
              "VAR CurWeek = MAX('CreditsWeekly'[MetricDate])",
              "VAR PriorUsers =",
              "    CALCULATETABLE(",
              "        VALUES('CreditsWeekly'[UserPrincipalName]),",
              "        REMOVEFILTERS('CreditsWeekly'[MetricDate]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Index]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Label]),",
              "        REMOVEFILTERS('CreditsWeekly'[Weeks Ago]),",
              "        REMOVEFILTERS('Date'),",
              "        'CreditsWeekly'[MetricDate] < CurWeek",
              "    )",
              "VAR CurUsers = VALUES('CreditsWeekly'[UserPrincipalName])",
              "RETURN COUNTROWS( EXCEPT( CurUsers, PriorUsers ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Adoption",
            "lineageTag": "e0000001-0031-4001-8001-000000000031"
          },
          {
            "name": "Lapsed Users (Week)",
            "description": "Users active last week who did not return this week.",
            "expression": [
              "",
              "VAR CurWeek = MAX('CreditsWeekly'[MetricDate])",
              "VAR PriorUsers =",
              "    CALCULATETABLE(",
              "        VALUES('CreditsWeekly'[UserPrincipalName]),",
              "        REMOVEFILTERS('CreditsWeekly'[MetricDate]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Index]),",
              "        REMOVEFILTERS('CreditsWeekly'[Week Label]),",
              "        REMOVEFILTERS('CreditsWeekly'[Weeks Ago]),",
              "        REMOVEFILTERS('Date'),",
              "        'CreditsWeekly'[MetricDate] = CurWeek - 7",
              "    )",
              "VAR CurUsers = VALUES('CreditsWeekly'[UserPrincipalName])",
              "RETURN COUNTROWS( EXCEPT( PriorUsers, CurUsers ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Adoption",
            "lineageTag": "e0000001-0032-4001-8001-000000000032"
          },
          {
            "name": "Cowork Forecast Confidence",
            "description": [
              "Forecast reliability expressed as a word rather than a coefficient.",
              "Combines how closely history follows a steady pattern with how accurate",
              "the model proved when tested against weeks it had never seen."
            ],
            "expression": [
              "",
              "VAR Fit = [Trend R2]",
              "VAR Acc = [Forecast Accuracy (Backtest)]",
              "VAR Wks =",
              "    CALCULATE(",
              "        DISTINCTCOUNT('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[Week Index]),",
              "        ALLSELECTED('CreditsWeekly'[Week Label]),",
              "        ALLSELECTED('CreditsWeekly'[Weeks Ago]),",
              "        ALLSELECTED('Date')",
              "    )",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        Wks < 4,                     \"Too early to say\",",
              "        Wks < 6,                     \"Indicative only\",",
              "        Fit >= 0.80 && Acc >= 0.85,  \"High\",",
              "        Fit >= 0.60 && Acc >= 0.75,  \"Medium\",",
              "        \"Low\"",
              "    )",
              ""
            ],
            "displayFolder": "Plain English",
            "lineageTag": "e1100001-0001-4001-8001-000000000001"
          },
          {
            "name": "Cowork Forecast Confidence Note",
            "description": "What the confidence rating means for planning, in plain words.",
            "expression": [
              "",
              "SWITCH(",
              "    [Cowork Forecast Confidence],",
              "    \"High\",             \"Usage follows a steady pattern, so this projection is dependable.\",",
              "    \"Medium\",           \"Usage is somewhat uneven. Treat this as a guide rather than a commitment.\",",
              "    \"Low\",              \"Usage is too erratic to project reliably. Plan against the upper end of the range.\",",
              "    \"Indicative only\",  \"Only four or five weeks of history. The trend is fitted but a backtest needs six weeks, so treat it as a direction rather than a number.\",",
              "    \"Too early to say\", \"Not enough weeks of history yet. Revisit once four weeks are available.\",",
              "    \"\"",
              ")",
              ""
            ],
            "displayFolder": "Plain English",
            "lineageTag": "e1100001-0002-4001-8001-000000000002"
          },
          {
            "name": "Cowork Forecast Summary",
            "description": [
              "Plain-English summary of the Cowork forecast. Every figure, including the",
              "length of the fitting window, is read from the model - nothing about this",
              "tenant is written into the text."
            ],
            "expression": [
              "",
              "VAR Credits = [Cowork Total Credits Used]",
              "VAR g     = [Growth Applied %]",
              "VAR Cost  = [Year Cost $]",
              "VAR Conf  = LOWER( [Cowork Forecast Confidence] )",
              "VAR Wks   = [Trend Window Weeks]",
              "VAR Basis =",
              "    IF(",
              "        [Growth Is Override],",
              "        \"Using your rate of \" & FORMAT( g, \"0.0%\" ) & \" a month\",",
              "        \"Usage has grown \" & FORMAT( g, \"0.0%\" ) & \" a month over the last \"",
              "            & FORMAT( Wks, \"#,0\" ) & IF( Wks = 1, \" week\", \" weeks\" )",
              "    )",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK( Credits ) || Credits = 0,",
              "            \"No Cowork or Work IQ consumption in this selection.\",",
              "        ISBLANK( Wks ) || ( NOT [Growth Is Override] && ISBLANK( [Implied Monthly Growth %] ) ),",
              "        \"Only \" & FORMAT( COALESCE( Wks, 0 ), \"#,0\" )",
              "            & IF( COALESCE( Wks, 0 ) = 1, \" week\", \" weeks\" )",
              "            & \" of history so far - too early to read a trend. The figures \"",
              "            & \"above assume usage carries on at its current rate.\",",
              "        Basis",
              "            & IF( [Growth Rate Was Capped], \", capped at the 100% ceiling\", \"\" )",
              "            & \". At that rate the next twelve months cost about \"",
              "            & FORMAT( Cost, \"$#,0\" ) & \". Confidence in this projection is \" & Conf & \".\"",
              "    )",
              ""
            ],
            "displayFolder": "Forecast",
            "lineageTag": "e3300001-0007-4001-8001-000000000007"
          },
          {
            "name": "Cowork Concentration Summary",
            "description": [
              "Plain-language reading of how concentrated consumption is, phrased the",
              "way a business reader would say it out loud."
            ],
            "expression": [
              "",
              "VAR Share = [Cowork Top 10% Share]",
              "RETURN",
              "    IF(",
              "        ISBLANK(Share),",
              "        BLANK(),",
              "        \"The busiest 10% of people account for \" & FORMAT( Share, \"0%\" ) & \" of all credits used.\"",
              "    )",
              ""
            ],
            "displayFolder": "Plain English",
            "lineageTag": "e1100001-0004-4001-8001-000000000004"
          },
          {
            "name": "Steadiness",
            "description": [
              "Steadiness expressed in words, for readers who should not have to know",
              "what a coefficient of variation is."
            ],
            "expression": [
              "",
              "VAR cv = [Volatility (CV)]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(cv), BLANK(),",
              "        cv < 0.15,   \"Very steady\",",
              "        cv < 0.25,   \"Steady\",",
              "        cv < 0.40,   \"Variable\",",
              "        \"Jumpy\"",
              "    )",
              ""
            ],
            "displayFolder": "Plain English",
            "lineageTag": "e1100001-0005-4001-8001-000000000005"
          },
          {
            "name": "Growth Summary",
            "description": "Weekly growth restated as a sentence fragment usable in a card subtitle.",
            "expression": [
              "",
              "VAR s = [Trend Slope]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(s), BLANK(),",
              "        s > 0,      \"Up about \" & FORMAT( s, \"#,0\" ) & \" credits each week\",",
              "        s < 0,      \"Down about \" & FORMAT( ABS(s), \"#,0\" ) & \" credits each week\",",
              "        \"Broadly flat week to week\"",
              "    )",
              ""
            ],
            "displayFolder": "Plain English",
            "lineageTag": "e1100001-0006-4001-8001-000000000006"
          },
          {
            "name": "Growth Applied %",
            "description": [
              "The monthly growth rate the projection uses. Defaults to the rate fitted",
              "from 13 weeks of actual usage; move the slider to test a different rate."
            ],
            "expression": [
              "",
              "// Branch on the scenario name, so no selection and the explicit",
              "// \"Fitted from history\" option behave identically.",
              "VAR Chosen = SELECTEDVALUE( 'Growth Scenario'[Scenario], \"Fitted from history\" )",
              "VAR Rate   = SELECTEDVALUE( 'Growth Scenario'[Rate] )",
              "RETURN",
              "    IF( Chosen = \"Fitted from history\", COALESCE( [Implied Monthly Growth %], 0 ), Rate )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Forecast",
            "lineageTag": "e3300001-0001-4001-8001-000000000001"
          },
          {
            "name": "Growth Is Override",
            "description": "True when the reader has overridden the fitted rate, so the page can say so.",
            "expression": "SELECTEDVALUE( 'Growth Scenario'[Scenario], \"Fitted from history\" ) <> \"Fitted from history\"",
            "displayFolder": "Forecast",
            "lineageTag": "e3300001-0002-4001-8001-000000000002"
          },
          {
            "name": "Month Credits",
            "description": [
              "Credits expected in a given month ahead, growing the current period",
              "forward at the applied rate."
            ],
            "expression": [
              "",
              "VAR m = SELECTEDVALUE( 'Projection Month'[Value] )",
              "VAR g = [Growth Applied %]",
              "RETURN IF( m >= 1 && m <= 12, [Cowork Total Credits Used] * POWER( 1 + g, m ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "e3300001-0003-4001-8001-000000000003"
          },
          {
            "name": "Month Cost $",
            "description": [
              "Cost of that month at the rate actually being achieved today, so a",
              "Capacity Pack discount carries through into the projection."
            ],
            "expression": "[Month Credits] * [Blended Rate $]",
            "formatString": "\\$#,0",
            "displayFolder": "Forecast",
            "lineageTag": "e3300001-0004-4001-8001-000000000004"
          },
          {
            "name": "Year Credits",
            "description": "Credits expected over the next twelve months.",
            "expression": [
              "",
              "VAR g = [Growth Applied %]",
              "VAR Base = [Cowork Total Credits Used]",
              "RETURN SUMX( GENERATESERIES( 1, 12, 1 ), Base * POWER( 1 + g, [Value] ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Forecast",
            "lineageTag": "e3300001-0005-4001-8001-000000000005"
          },
          {
            "name": "Year Cost $",
            "description": "Cost over the next twelve months at today's achieved rate.",
            "expression": "[Year Credits] * [Blended Rate $]",
            "formatString": "\\$#,0",
            "displayFolder": "Forecast",
            "lineageTag": "e3300001-0006-4001-8001-000000000006"
          },
          {
            "name": "Cowork Weekly Cost",
            "description": [
              "What each week actually cost. Cowork Total Cost deliberately strips week",
              "context so it can honour the Period slicer, which makes it flat on a date",
              "axis. This reads the weekly grain instead, so it can be trended.",
              "",
              "Prepaid capacity is drawn down oldest week first, so a week only bills at",
              "the pay-as-you-go rate once the pack is exhausted. With no pack balance",
              "entered it reduces to credits x the pay-as-you-go rate."
            ],
            "expression": [
              "",
              "VAR Wks         = [Cowork Period Weeks]",
              "VAR Bal         = [Cowork Prepaid Balance]",
              "VAR PrepaidRate = [Cowork Prepaid Rate Value]",
              "VAR PaygRate    = [Cowork PAYG Rate Value]",
              "RETURN",
              "SUMX(",
              "    FILTER( VALUES( 'CreditsWeekly'[Weeks Ago] ), 'CreditsWeekly'[Weeks Ago] < Wks ),",
              "    VAR ThisAgo  = 'CreditsWeekly'[Weeks Ago]",
              "    VAR ThisWeek = CALCULATE( SUM( 'CreditsWeekly'[CreditsUsed] ) )",
              "    // Credits consumed in older weeks inside the period, which have already",
              "    // eaten into the prepaid pack before this week starts.",
              "    //",
              "    // The REMOVEFILTERS matter. On a chart the axis filters Week Label, not",
              "    // Weeks Ago, so clearing Weeks Ago alone left the Week Label filter in",
              "    // place and this returned zero for every week -- the pack then never",
              "    // depleted and every week priced as prepaid.",
              "    VAR PriorUsed =",
              "        CALCULATE(",
              "            SUM( 'CreditsWeekly'[CreditsUsed] ),",
              "            FILTER(",
              "                ALL( 'CreditsWeekly'[Weeks Ago] ),",
              "                'CreditsWeekly'[Weeks Ago] > ThisAgo",
              "                    && 'CreditsWeekly'[Weeks Ago] < Wks",
              "            ),",
              "            REMOVEFILTERS( 'CreditsWeekly'[Week Label] ),",
              "            REMOVEFILTERS( 'CreditsWeekly'[Week Index] ),",
              "            REMOVEFILTERS( 'CreditsWeekly'[MetricDate] ),",
              "            REMOVEFILTERS( 'Date' )",
              "        )",
              "    VAR PrepaidLeft = MAX( 0, Bal - PriorUsed )",
              "    VAR PrepaidThis = MIN( ThisWeek, PrepaidLeft )",
              "    VAR PaygThis    = ThisWeek - PrepaidThis",
              "    RETURN PrepaidThis * PrepaidRate + PaygThis * PaygRate",
              ")",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "Trend",
            "lineageTag": "2198a9ba-78a6-4d30-96e0-8209870e3970"
          },
          {
            "name": "Cowork Weekly Prepaid Cost",
            "description": [
              "The prepaid portion of a week's cost.",
              "",
              "Cowork Prepaid Cost is a period total - it strips week context so it can",
              "honour the Period slicer - so it renders flat on a weekly axis and cannot be",
              "stacked. This reads the weekly grain instead.",
              "",
              "The pack is drawn down oldest week first, so early weeks are prepaid and",
              "later weeks fall through to pay-as-you-go once it is exhausted."
            ],
            "expression": [
              "",
              "VAR Wks         = [Cowork Period Weeks]",
              "VAR Bal         = [Cowork Prepaid Balance]",
              "VAR PrepaidRate = [Cowork Prepaid Rate Value]",
              "RETURN",
              "SUMX(",
              "    FILTER( VALUES( 'CreditsWeekly'[Weeks Ago] ), 'CreditsWeekly'[Weeks Ago] < Wks ),",
              "    VAR ThisAgo  = 'CreditsWeekly'[Weeks Ago]",
              "    VAR ThisWeek = CALCULATE( SUM( 'CreditsWeekly'[CreditsUsed] ) )",
              "    // credits consumed in older weeks inside the period, which have already",
              "    // eaten into the pack before this week starts. The REMOVEFILTERS matter:",
              "    // on a chart the axis filters Week Label, not Weeks Ago.",
              "    VAR PriorUsed =",
              "        CALCULATE(",
              "            SUM( 'CreditsWeekly'[CreditsUsed] ),",
              "            FILTER(",
              "                ALL( 'CreditsWeekly'[Weeks Ago] ),",
              "                'CreditsWeekly'[Weeks Ago] > ThisAgo",
              "                    && 'CreditsWeekly'[Weeks Ago] < Wks",
              "            ),",
              "            REMOVEFILTERS( 'CreditsWeekly'[Week Label] ),",
              "            REMOVEFILTERS( 'CreditsWeekly'[Week Index] ),",
              "            REMOVEFILTERS( 'CreditsWeekly'[MetricDate] ),",
              "            REMOVEFILTERS( 'Date' )",
              "        )",
              "    VAR PrepaidLeft = MAX( 0, Bal - PriorUsed )",
              "    VAR PrepaidThis = MIN( ThisWeek, PrepaidLeft )",
              "    RETURN PrepaidThis * PrepaidRate",
              ")",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "Trend",
            "lineageTag": "6d926fec-d9a7-4bc7-9d4e-681a7773c3a8"
          },
          {
            "name": "Cowork Weekly PAYG Cost",
            "description": [
              "The pay-as-you-go portion of a week's cost - what the prepaid pack did not",
              "cover. Stacks with Cowork Weekly Prepaid Cost to give Cowork Weekly Cost.",
              "",
              "With no pack balance entered this is the whole weekly cost, which is the",
              "correct answer for a pay-as-you-go tenant."
            ],
            "expression": [
              "",
              "VAR Wks      = [Cowork Period Weeks]",
              "VAR Bal      = [Cowork Prepaid Balance]",
              "VAR PaygRate = [Cowork PAYG Rate Value]",
              "RETURN",
              "SUMX(",
              "    FILTER( VALUES( 'CreditsWeekly'[Weeks Ago] ), 'CreditsWeekly'[Weeks Ago] < Wks ),",
              "    VAR ThisAgo  = 'CreditsWeekly'[Weeks Ago]",
              "    VAR ThisWeek = CALCULATE( SUM( 'CreditsWeekly'[CreditsUsed] ) )",
              "    VAR PriorUsed =",
              "        CALCULATE(",
              "            SUM( 'CreditsWeekly'[CreditsUsed] ),",
              "            FILTER(",
              "                ALL( 'CreditsWeekly'[Weeks Ago] ),",
              "                'CreditsWeekly'[Weeks Ago] > ThisAgo",
              "                    && 'CreditsWeekly'[Weeks Ago] < Wks",
              "            ),",
              "            REMOVEFILTERS( 'CreditsWeekly'[Week Label] ),",
              "            REMOVEFILTERS( 'CreditsWeekly'[Week Index] ),",
              "            REMOVEFILTERS( 'CreditsWeekly'[MetricDate] ),",
              "            REMOVEFILTERS( 'Date' )",
              "        )",
              "    VAR PrepaidLeft = MAX( 0, Bal - PriorUsed )",
              "    VAR PrepaidThis = MIN( ThisWeek, PrepaidLeft )",
              "    VAR PaygThis    = ThisWeek - PrepaidThis",
              "    RETURN PaygThis * PaygRate",
              ")",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "Trend",
            "lineageTag": "cc5eaf20-8000-4abe-9ba7-75dda4492f2f"
          },
          {
            "name": "Trend Window Weeks",
            "description": [
              "How many weeks the Cowork trend line is actually fitted over. Mirrors the",
              "filter context used by [Trend Slope] and [Implied Monthly Growth %] so any",
              "prose quoting the window stays true to whatever history is loaded."
            ],
            "expression": [
              "",
              "COUNTROWS(",
              "    CALCULATETABLE(",
              "        VALUES( 'CreditsWeekly'[Week Index] ),",
              "        ALLSELECTED( 'CreditsWeekly'[MetricDate] ),",
              "        ALLSELECTED( 'CreditsWeekly'[Week Index] ),",
              "        ALLSELECTED( 'CreditsWeekly'[Week Label] ),",
              "        ALLSELECTED( 'CreditsWeekly'[Weeks Ago] ),",
              "        ALLSELECTED( 'Date' )",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "lineageTag": "3a934b24-648a-4041-a457-2fea111f7199"
          },
          {
            "name": "Growth Rate Was Capped",
            "description": [
              "True when the fitted rate hit the 100% ceiling, so the page can call",
              "the figure a floor rather than an estimate. A silent clamp would be",
              "worse than no clamp."
            ],
            "expression": [
              "",
              "VAR T =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS( VALUES('CreditsWeekly'[Week Index]), \"@y\", [Weekly Credits] ),",
              "        ALLSELECTED('CreditsWeekly'[MetricDate]),",
              "        ALLSELECTED('CreditsWeekly'[Week Index]),",
              "        ALLSELECTED('CreditsWeekly'[Week Label]),",
              "        ALLSELECTED('CreditsWeekly'[Weeks Ago]),",
              "        ALLSELECTED('Date')",
              "    )",
              "VAR MeanWk = AVERAGEX(T, [@y])",
              "VAR SafeWk = MAX( DIVIDE( [Trend Slope], MeanWk ), -0.9 )",
              "VAR Raw    = POWER( 1 + SafeWk, 4.345 ) - 1",
              "RETURN [Trend Window Weeks] >= 4 && Raw > 1",
              ""
            ],
            "displayFolder": "Forecast\\Model",
            "lineageTag": "e0000001-0055-4001-8001-000000000055"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "SpendingPolicy",
        "lineageTag": "f1782a8d-6c9e-4d96-b2c6-a01dc6a2ea08",
        "columns": [
          {
            "name": "SpendingPolicyId",
            "dataType": "string",
            "isKey": true,
            "sourceColumn": "SpendingPolicyId",
            "lineageTag": "f8bb0430-1dea-4da6-9895-5bc98daf4e82",
            "summarizeBy": "none"
          },
          {
            "name": "Policy Name",
            "dataType": "string",
            "sourceColumn": "Policy Name",
            "lineageTag": "10d8869b-67bf-4668-84a0-a2bb136ec890",
            "summarizeBy": "none"
          },
          {
            "name": "PlanLimit",
            "dataType": "int64",
            "sourceColumn": "PlanLimit",
            "formatString": "#,0",
            "lineageTag": "09e6c296-09e8-4ff2-89bd-b291b95dbcdf",
            "summarizeBy": "sum"
          },
          {
            "name": "UserLimit",
            "dataType": "int64",
            "sourceColumn": "UserLimit",
            "formatString": "#,0",
            "lineageTag": "a3921562-a69d-44ee-96d1-8b14716bfbeb",
            "summarizeBy": "sum"
          },
          {
            "name": "IncludedServices",
            "dataType": "string",
            "sourceColumn": "IncludedServices",
            "lineageTag": "3a32ad63-e6b0-471e-adaa-03a8de049c3e",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "SpendingPolicy",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "\t// A missing table is a supported state: this product's pages",
                "\t// come up empty and nothing else is affected.",
                "\tTbl = GetTable(\"viva_spending_policy\"),",
                "\tResult =",
                "\t\tif Tbl = null then",
                "\t\t\t#table(type table [#\"SpendingPolicyId\" = text, #\"Policy Name\" = text, #\"PlanLimit\" = Int64.Type, #\"UserLimit\" = Int64.Type, #\"IncludedServices\" = text], {})",
                "\t\telse",
                "\t\t\tlet",
                "\t\t\t\tKept = Table.SelectColumns(Tbl, {\"spending_policy_id\", \"name\", \"plan_limit\", \"user_limit\", \"included_services\"}, MissingField.UseNull),",
                "\t\t\t\tRenamed = Table.RenameColumns(Kept, {{\"spending_policy_id\", \"SpendingPolicyId\"}, {\"name\", \"Policy Name\"}, {\"plan_limit\", \"PlanLimit\"}, {\"user_limit\", \"UserLimit\"}, {\"included_services\", \"IncludedServices\"}}),",
                "\t\tTyped = Table.TransformColumnTypes(Renamed, {{\"PlanLimit\", Int64.Type}, {\"UserLimit\", Int64.Type}})",
                "\t\t\tin",
                "\t\t\t\tTyped",
                "in",
                "\tResult"
              ]
            }
          }
        ],
        "measures": [
