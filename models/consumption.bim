      {
        "name": "TermOrDefault",
        "kind": "m",
        "expression": [
          "(column as text, fallback as number) as number =>",
          "\tlet",
          "\t\tT = CommercialTerms,",
          "\t\tV = if T = null then null",
          "\t\t\telse if not List.Contains(Table.ColumnNames(T), column) then null",
          "\t\t\telse if Table.RowCount(T) = 0 then null",
          "\t\t\telse Record.Field(T{0}, column)",
          "\tin",
          "\t\tif V = null then fallback else Number.From(V)"
        ],
        "lineageTag": "fb000001-0006-4001-8001-000000000006",
