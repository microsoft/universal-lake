      {
        "name": "Credit Consumption (Tenant)",
        "lineageTag": "cc0003tn-0001-0001-0001-000000000001",
        "columns": [
          {
            "name": "BillingPlan_Id",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "BillingPlan_Id",
            "lineageTag": "cc0003tn-col0-0001-000000000001",
            "summarizeBy": "none"
          },
          {
            "name": "BillingPlan_Name",
            "dataType": "string",
            "sourceColumn": "BillingPlan_Name",
            "lineageTag": "cc0003tn-col0-0001-000000000002",
            "summarizeBy": "none"
          },
          {
            "name": "Environment_Id",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Environment_Id",
            "lineageTag": "cc0003tn-col0-0001-000000000003",
            "summarizeBy": "none"
          },
          {
            "name": "Environment_Name",
            "dataType": "string",
            "sourceColumn": "Environment_Name",
            "lineageTag": "cc0003tn-col0-0001-000000000004",
            "summarizeBy": "none"
          },
          {
            "name": "Capacity_Type",
            "dataType": "string",
            "sourceColumn": "Capacity_Type",
            "lineageTag": "cc0003tn-col0-0001-000000000005",
            "summarizeBy": "none"
          },
          {
            "name": "Entitled_Quantity",
            "dataType": "double",
            "sourceColumn": "Entitled_Quantity",
            "formatString": "#,0",
            "lineageTag": "cc0003tn-col0-0001-000000000006",
            "summarizeBy": "sum"
          },
          {
            "name": "Prepaid_Consumed_Quantity",
            "dataType": "double",
            "sourceColumn": "Prepaid_Consumed_Quantity",
            "formatString": "#,0",
            "lineageTag": "cc0003tn-col0-0001-000000000007",
            "summarizeBy": "sum"
          },
          {
            "name": "Pay_as_you_go_Consumed_Quantity",
            "dataType": "double",
            "sourceColumn": "Pay_as_you_go_Consumed_Quantity",
            "formatString": "#,0",
            "lineageTag": "cc0003tn-col0-0001-000000000008",
            "summarizeBy": "sum"
          },
          {
            "name": "Usage_Date",
            "dataType": "dateTime",
            "sourceColumn": "Usage_Date",
            "formatString": "yyyy-mm-dd",
            "lineageTag": "cc0003tn-col0-0001-000000000009",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Credit Consumption (Tenant)",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Raw = GetTable(\"studio_tenant_daily\"),",
                "    Normalize = ((Source as table, Specs as list, Required as list) as table =>",
                "let",
                "    Key = (s as text) as text => Text.Lower(Text.Select(s, {\"a\"..\"z\", \"A\"..\"Z\", \"0\"..\"9\"})),",
                "    Columns = List.Buffer(Table.ColumnNames(Source)),",
                "    Pick = (spec as list) as nullable text =>",
                "        let",
                "            Candidates = List.Transform({spec{0}} & spec{1}, (alias) =>",
                "                if List.Contains(Columns, alias) then {alias}",
                "                else List.Select(Columns, each Key(_) = Key(alias))),",
                "            Best = List.First(List.Select(Candidates, each not List.IsEmpty(_)), {})",
                "        in",
                "            if List.Count(Best) > 1 then error Error.Record(\"AmbiguousExportColumn\",",
                "                \"Several headers have the same priority. Keep one or use the exact canonical header.\",",
                "                [Column = spec{0}, Candidates = Best])",
                "            else List.First(Best, null),",
                "    Bindings = List.Buffer(List.Transform(Specs, each Pick(_))),",
                "    Names = List.Transform(Specs, each _{0}),",
                "    Missing = List.Select(Required, (c) => Bindings{List.PositionOf(Names, c)} = null),",
                "    Result =",
                "        if List.Count(List.Distinct(Names)) <> List.Count(Names)",
                "            or not List.IsEmpty(List.Difference(Required, Names)) then",
                "            error Error.Record(\"InvalidColumnSpecs\", \"Canonical names must be unique and required names must be specified.\", null)",
                "        else if List.Count(List.RemoveNulls(Bindings)) <> List.Count(List.Distinct(List.RemoveNulls(Bindings))) then",
                "            error Error.Record(\"OverlappingColumnAliases\", \"One input column cannot populate multiple canonical columns.\", null)",
                "        else if not List.IsEmpty(Missing) and not Table.IsEmpty(Source) then",
                "            error Error.Record(\"UnsupportedExportSchema\",",
                "                \"Required columns are missing from this row-level export.\",",
                "                [MissingColumns = Missing, AvailableColumns = Columns])",
                "        else",
                "            Value.ReplaceMetadata(Table.FromColumns(List.Transform(Bindings, (c) =>",
                "                if c = null then List.Repeat({null}, Table.RowCount(Source))",
                "                else Table.Column(Source, c)), Names),",
                "                [ColumnBindings = Record.FromList(Bindings, Names)])",
                "in",
                "    Result",
                "),",
                "    ParseExportDate = ((Values as list) as function =>",
                "let",
                "    Blank = (v as any) as logical => v = null or (Value.Is(v, type text) and Text.Trim(v) = \"\"),",
                "    Parse = (v as any, culture as text) as datetime =>",
                "        if Blank(v) then error Error.Record(\"MissingExportDate\", \"A dated row has no date.\", null)",
                "        else if Value.Is(v, type datetimezone) then DateTimeZone.RemoveZone(v)",
                "        else if Value.Is(v, type datetime) then v",
                "        else if Value.Is(v, type date) then DateTime.From(v)",
                "        else",
                "            let",
                "                s = Text.Trim(Text.From(v, \"en-US\")),",
                "                Compact = Text.Length(s) = 8 and Text.Select(s, {\"0\"..\"9\"}) = s,",
                "                Iso = Text.Length(s) >= 10 and Text.Middle(s, 4, 1) = \"-\"",
                "                    and Text.Middle(s, 7, 1) = \"-\" and Text.Select(Text.Start(s, 4), {\"0\"..\"9\"}) = Text.Start(s, 4),",
                "                Tail = if Text.Length(s) > 10 then Text.Range(s, 10) else \"\",",
                "                Zoned = Iso and (Text.EndsWith(Text.Upper(s), \"Z\") or Text.Contains(Tail, \"+\") or Text.Contains(Tail, \"-\"))",
                "            in",
                "                if Compact then #datetime(Number.FromText(Text.Start(s, 4)), Number.FromText(Text.Middle(s, 4, 2)),",
                "                    Number.FromText(Text.End(s, 2)), 0, 0, 0)",
                "                else if Value.Is(v, type number) then error Error.Record(\"InvalidExportDate\", \"Numeric dates must use yyyyMMdd, not serial dates.\", null)",
                "                else if Zoned then DateTimeZone.RemoveZone(DateTimeZone.FromText(s, [Culture = \"en-US\"]))",
                "                else DateTime.FromText(s, [Culture = if Iso then \"en-US\" else culture]),",
                "    // Try only the two supported date orders; failures are inspected, never converted to null.",
                "    Attempts = List.Buffer(List.Transform(Values, each [US = try Parse(_, \"en-US\"), GB = try Parse(_, \"en-GB\")])),",
                "    Invalid = List.AnyTrue(List.Transform(Attempts, each [US][HasError] and [GB][HasError])),",
                "    USValid = List.AllTrue(List.Transform(Attempts, each not [US][HasError])),",
                "    GBValid = List.AllTrue(List.Transform(Attempts, each not [GB][HasError])),",
                "    Same = if USValid and GBValid then List.AllTrue(List.Transform(Attempts, each [US][Value] = [GB][Value])) else false,",
                "    Culture =",
                "        if Invalid then error Error.Record(\"InvalidExportDate\", \"A date is missing or invalid. No rows were discarded.\", null)",
                "        else if not USValid and not GBValid then error Error.Record(\"MixedExportDateOrder\",",
                "            \"The column mixes day-first and month-first dates. Supply consistent dates or ISO yyyy-MM-dd.\", null)",
                "        else if USValid and GBValid and not Same then error Error.Record(\"AmbiguousExportDate\",",
                "            \"Day/month order cannot be inferred from this column. Supply ISO yyyy-MM-dd.\", null)",
                "        else if USValid then \"en-US\" else \"en-GB\",",
                "    Convert = (v as any) as datetime => Parse(v, Culture)",
                "in",
                "    Convert",
                "),",
                "    Specs = {",
                "        {\"BillingPlan_Id\", {\"BillingPlan Id\", \"billing_plan_id\"}},",
                "        {\"BillingPlan_Name\", {\"BillingPlan Name\", \"billing_plan_name\"}},",
                "        {\"Environment_Id\", {\"Environment Id\"}}, {\"Environment_Name\", {\"Environment Name\"}},",
                "        {\"Capacity_Type\", {\"Capacity Type\"}}, {\"Entitled_Quantity\", {\"Entitled Quantity\"}},",
                "        {\"Prepaid_Consumed_Quantity\", {\"Prepaid Consumed Quantity\", \"prepaid_consumed\"}},",
                "        {\"Pay_as_you_go_Consumed_Quantity\", {\"Pay as you go Consumed Quantity\", \"payg_consumed\"}},",
                "        {\"Usage_Date\", {\"Usage Date\"}}",
                "    },",
                "    Numbers = {\"Entitled_Quantity\", \"Prepaid_Consumed_Quantity\", \"Pay_as_you_go_Consumed_Quantity\"},",
                "    Required = {\"Usage_Date\", \"Prepaid_Consumed_Quantity\", \"Pay_as_you_go_Consumed_Quantity\"},",
                "    Named = Normalize(if Raw = null then #table({}, {}) else Raw, Specs, Required),",
                "    Textual = Table.TransformColumns(Named, List.Transform(",
                "        List.Difference(Table.ColumnNames(Named), Numbers & {\"Usage_Date\"}), (c) =>",
                "        {c, each if _ = null then null else Text.From(_), type nullable text})),",
                "    Numeric = Table.TransformColumns(Textual, List.Transform(Numbers, (c) =>",
                "        {c, each if _ = null or Text.Trim(Text.From(_)) = \"\" then",
                "            null",
                "        else if Value.Is(_, type number) then _ else Number.FromText(Text.Trim(Text.From(_)), \"en-US\"), type nullable number})),",
                "    ReadDate = ParseExportDate(Named[Usage_Date]),",
                "    Final = Table.TransformColumns(Numeric, {{\"Usage_Date\", ReadDate, type datetime}})",
                "in",
                "    Final"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Studio Prepaid Consumed",
            "description": [
              "Prepaid credits consumed, drawn from committed entitlement capacity.",
              "Gated on the selected period, but narrowing rather than replacing existing",
              "date context so the figure still varies along a date axis."
            ],
            "expression": [
              "",
              "// KEEPFILTERS matters here. Without it, FILTER(ALL(Usage_Date), ...)",
              "// replaces the date context supplied by a chart axis, so every point",
              "// returned the whole-period total and the trend line rendered flat.",
              "// KEEPFILTERS intersects the period window with the axis date instead.",
              "VAR FromDate = [Studio Period Start]",
              "RETURN",
              "CALCULATE(",
              "    SUM( 'Credit Consumption (Tenant)'[Prepaid_Consumed_Quantity] ),",
              "    KEEPFILTERS(",
              "        FILTER(",
              "            ALL( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "            'Credit Consumption (Tenant)'[Usage_Date] >= FromDate",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0003tn-meas-0001-000000000001"
          },
          {
            "name": "Studio PAYG Consumed",
            "description": [
              "Pay-as-you-go credits consumed above entitlement, billed as overage.",
              "Gated on the selected period, but narrowing rather than replacing existing",
              "date context so the figure still varies along a date axis."
            ],
            "expression": [
              "",
              "// See Prepaid Consumed: KEEPFILTERS keeps the chart axis date intact.",
              "VAR FromDate = [Studio Period Start]",
              "RETURN",
              "CALCULATE(",
              "    SUM( 'Credit Consumption (Tenant)'[Pay_as_you_go_Consumed_Quantity] ),",
              "    KEEPFILTERS(",
              "        FILTER(",
              "            ALL( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "            'Credit Consumption (Tenant)'[Usage_Date] >= FromDate",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0003tn-meas-0001-000000000002"
          },
          {
            "name": "Studio Entitled Capacity",
            "description": [
              "Credits bought up front for an environment. Microsoft calls this",
              "\"entitlement\" in the Studio admin centre; the report says \"Prepaid capacity\"",
              "to match the word used on the Cowork pages for the same idea. Real money,",
              "unlike the user and policy limits on Cowork, which are only caps.",
              "",
              "The export repeats this on every daily row, so this reads the latest value",
              "per environment rather than summing across days."
            ],
            "expression": [
              "",
              "// Entitlement is a stock, not a flow. The export restates it on every",
              "// daily row, so a plain SUM multiplies it by the number of days observed.",
              "// Read the latest value per environment instead.",
              "SUMX(",
              "    VALUES( 'Credit Consumption (Tenant)'[Environment_Name] ),",
              "    VAR LastDay = CALCULATE( MAX( 'Credit Consumption (Tenant)'[Usage_Date] ) )",
              "    RETURN",
              "        CALCULATE(",
              "            MAX( 'Credit Consumption (Tenant)'[Entitled_Quantity] ),",
              "            'Credit Consumption (Tenant)'[Usage_Date] = LastDay",
              "        )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0003tn-meas-0001-000000000003"
          },
          {
            "name": "Studio Consumed Credits (Tenant)",
            "description": "All Studio credits consumed: prepaid plus pay-as-you-go.",
            "expression": "[Studio Prepaid Consumed] + [Studio PAYG Consumed]",
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0003tn-meas-totalcredits01"
          },
          {
            "name": "Total Billable Cost",
            "description": [
              "Headline Studio cost: prepaid and pay-as-you-go consumption each valued",
              "at their own rate. The entitlement export gives the split as measured",
              "fact, so this does not assume a single blended price."
            ],
            "expression": "( [Studio Prepaid Consumed] * [Studio Prepaid Rate Value] ) + ( [Studio PAYG Consumed] * [Studio PAYG Rate Value] )",
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0003tn-meas-totalcost0001"
          },
          {
            "name": "Studio Entitlement Utilisation %",
            "description": [
              "How much of the prepaid capacity has been used, across environments that",
              "hold any. Over 100% means prepaid is exhausted and usage has spilled onto",
              "pay-as-you-go. Shown as \"Prepaid used %\"."
            ],
            "expression": [
              "",
              "// Only an environment that holds an entitlement can consume one. The",
              "// unscoped version divided tenant-wide prepaid consumption (21,812) by",
              "// a single environment's grant (5,000) and reported 436%.",
              "VAR PerEnv =",
              "    ADDCOLUMNS(",
              "        VALUES( 'Studio Environment'[Environment Name] ),",
              "        \"@ent\",  [Studio Entitled Capacity],",
              "        \"@used\", [Studio Prepaid Consumed]",
              "    )",
              "VAR Entitled = FILTER( PerEnv, [@ent] > 0 )",
              "RETURN",
              "    DIVIDE( SUMX( Entitled, [@used] ), SUMX( Entitled, [@ent] ) )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0003tn-meas-entutil00001"
          },
          {
            "name": "Billing Period",
            "description": [
              "Coverage window of the loaded export, inferred from Usage_Date. The",
              "per-agent and per-user exports carry no date, so this states the period",
              "every figure on the page refers to."
            ],
            "expression": [
              "VAR FromDate = [Studio Period Start]",
              "VAR ScopeDates = FILTER(ALL('Credit Consumption (Tenant)'[Usage_Date]),",
              "    'Credit Consumption (Tenant)'[Usage_Date] >= FromDate)",
              "VAR Lo = MINX(ScopeDates, 'Credit Consumption (Tenant)'[Usage_Date])",
              "VAR Hi = MAXX(ScopeDates, 'Credit Consumption (Tenant)'[Usage_Date])",
              "RETURN IF(ISBLANK(Lo), \"No tenant rows in this period\",",
              "    FORMAT(Lo, \"d MMM yyyy\") & \" - \" & FORMAT(Hi, \"d MMM yyyy\"))"
            ],
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0003tn-meas-period0001"
          },
          {
            "name": "Consumption Without Entitlement",
            "description": [
              "Credits used in environments that hold no prepaid capacity at all, so every",
              "credit bills directly. Shown as \"Credits with no prepaid cover\"."
            ],
            "expression": [
              "",
              "SUMX(",
              "    VALUES( 'Credit Consumption (Tenant)'[Environment_Name] ),",
              "    VAR Ent  = [Studio Entitled Capacity]",
              "    VAR Used = CALCULATE( [Studio Prepaid Consumed] )",
              "    RETURN IF( Ent = 0, Used, 0 )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0003tn-fc00-0001-000000000014"
          },
          {
            "name": "Environments Without Entitlement",
            "description": [
              "How many environments are consuming credits without any prepaid capacity",
              "behind them."
            ],
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES( 'Credit Consumption (Tenant)'[Environment_Name] ),",
              "        [Studio Entitled Capacity] = 0 && CALCULATE( [Studio Prepaid Consumed] ) > 0",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0003tn-fc00-0001-000000000015"
          },
          {
            "name": "Studio Days Observed",
            "description": [
              "Distinct days on which any Studio consumption was recorded. The export",
              "only contains days with activity, so this is the true observation count."
            ],
            "expression": [
              "",
              "VAR FromDate = [Studio Period Start]",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "    FILTER(",
              "        ALL( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "        'Credit Consumption (Tenant)'[Usage_Date] >= FromDate",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000001"
          },
          {
            "name": "Daily Run Rate",
            "description": [
              "Average Studio credits per calendar day across the observed history",
              "window in scope. Missing dates count as zero usage, so this is the",
              "projection baseline rather than an active-day average."
            ],
            "expression": "DIVIDE( [Studio Consumed Credits (Tenant)], [Studio History Span Days] )",
            "formatString": "#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000002"
          },
          {
            "name": "Projected Credits (30d)",
            "description": "First forecast month at the same fitted or selected growth rate used by the projection chart.",
            "expression": "[Daily Run Rate] * 30 * ( 1 + [Studio Growth Applied %] )",
            "formatString": "#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000003"
          },
          {
            "name": "Projected Cost (30d)",
            "description": [
              "Projected 30-day cost, valued at the blended rate implied by the actual",
              "prepaid / pay-as-you-go split rather than a single assumed price."
            ],
            "expression": "[Projected Credits (30d)] * [Studio Effective Rate]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000004"
          },
          {
            "name": "Projected Credits (Horizon)",
            "description": "Sum of forecast months over the selected planning horizon, using the same growth rate as the projection chart.",
            "expression": [
              "",
              "            VAR _months = [Horizon Months Value]",
              "            VAR _growth = [Studio Growth Applied %]",
              "            VAR _base = [Daily Run Rate] * 30",
              "            RETURN",
              "                IF(",
              "                    _months >= 1 && NOT ISBLANK( _base ),",
              "                    SUMX( GENERATESERIES( 1, _months, 1 ), _base * POWER( 1 + _growth, [Value] ) )",
              "                )",
              "            ",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000005"
          },
          {
            "name": "Projected Cost (Horizon)",
            "expression": "[Projected Credits (Horizon)] * [Studio Effective Rate]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000006"
          },
          {
            "name": "Studio Entitlement Days Remaining",
            "description": [
              "How long the prepaid capacity lasts at the current daily rate. Counts only",
              "environments that hold capacity - an environment with none cannot run one",
              "down. Blank when there is no prepaid capacity to burn through."
            ],
            "expression": [
              "",
              "// Only an environment that holds an entitlement can exhaust one.",
              "// Summing tenant-wide consumption against a single environment's",
              "// grant reported \"0 days left\" while that environment was 19% used.",
              "VAR PerEnv =",
              "    ADDCOLUMNS(",
              "        VALUES( 'Studio Environment'[Environment Name] ),",
              "        \"@ent\",  [Studio Entitled Capacity],",
              "        \"@used\", [Studio Prepaid Consumed]",
              "    )",
              "VAR Entitled = FILTER( PerEnv, [@ent] > 0 )",
              "VAR Headroom = SUMX( Entitled, [@ent] - [@used] )",
              "VAR Observed = [Studio Days Observed]",
              "VAR DailyDraw = DIVIDE( SUMX( Entitled, [@used] ), Observed )",
              "RETURN",
              "    IF( DailyDraw > 0 && Headroom > 0, DIVIDE( Headroom, DailyDraw ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000007"
          },
          {
            "name": "Studio Entitlement Headroom",
            "description": [
              "Prepaid credits still unused, across environments that hold any. Shown as",
              "\"Prepaid left\". Environments with no prepaid capacity bill directly and are",
              "excluded rather than dragging this negative."
            ],
            "expression": [
              "",
              "// Scoped to entitled environments for the same reason as Entitlement",
              "// Utilisation %: subtracting tenant-wide consumption from one",
              "// environment's grant went negative and clamped to zero.",
              "VAR PerEnv =",
              "    ADDCOLUMNS(",
              "        VALUES( 'Studio Environment'[Environment Name] ),",
              "        \"@ent\",  [Studio Entitled Capacity],",
              "        \"@used\", [Studio Prepaid Consumed]",
              "    )",
              "VAR Entitled = FILTER( PerEnv, [@ent] > 0 )",
              "RETURN",
              "    MAX( 0, SUMX( Entitled, [@ent] - [@used] ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0003tn-fc00-0001-000000000008"
          },
          {
            "name": "Studio PAYG Share %",
            "description": [
              "Share of consumption billed as pay-as-you-go overage rather than drawn",
              "from prepaid entitlement. A rising value means capacity is undersized."
            ],
            "expression": "DIVIDE( [Studio PAYG Consumed], [Studio Consumed Credits (Tenant)] )",
            "formatString": "0.0%",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0003tn-fc00-0001-000000000009"
          },
          {
            "name": "Studio PAYG Cost",
            "expression": "[Studio PAYG Consumed] * [Studio PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0003tn-fc00-0001-000000000010"
          },
          {
            "name": "Studio Forecast Confidence",
            "description": [
              "How dependable the Studio projection is. A fitted rate needs about",
              "a month of dated history; shorter or very sparse windows fall back",
              "to a flat daily average and stay low confidence."
            ],
            "expression": [
              "",
              "            VAR _observed = [Studio Days Observed]",
              "            VAR _span = [Studio History Span Days]",
              "            VAR _coverage = [Studio History Coverage %]",
              "            VAR _fit = [Studio Fitted Monthly Growth %]",
              "            RETURN",
              "                SWITCH(",
              "                    TRUE(),",
              "                    ISBLANK( _observed ) || _observed = 0, \"No data\",",
              "                    ISBLANK( _span ) || _span < 14 || _observed < 4, \"Indicative only\",",
              "                    ISBLANK( _fit ), \"Low\",",
              "                    _span >= 84 && _coverage >= 0.40, \"High\",",
              "                    _span >= 42 && _coverage >= 0.25, \"Medium\",",
              "                    \"Low\"",
              "                )",
              "            ",
              ""
            ],
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000011"
          },
          {
            "name": "Studio Forecast Note",
            "description": [
              "Plain statement of what the projection rests on, including whether",
              "the fitted trend came from history or whether the page fell back to",
              "a flat daily average."
            ],
            "expression": [
              "",
              "            VAR _observed = [Studio Days Observed]",
              "            VAR _span = [Studio History Span Days]",
              "            VAR _fit = [Studio Fitted Monthly Growth %]",
              "            VAR _chosen = SELECTEDVALUE( 'Growth Scenario'[Scenario], \"Fitted from history\" )",
              "            VAR _basis =",
              "                IF(",
              "                    _chosen = \"Fitted from history\",",
              "                    IF(",
              "                        ISBLANK( _fit ),",
              "                        \" A fit needs at least 28 calendar days and 7 days with positive consumption. This selection has insufficient usable history, so the daily average is projected flat.\",",
              "                        \" Fitted from \" & FORMAT( _span, \"#,0\" ) & \" calendar days of history (\" &",
              "                            FORMAT( _observed, \"#,0\" ) & \" recorded days). Missing dates are treated as zero usage. Fitted growth is capped between -30% and +30% a month.\"",
              "                    ),",
              "                    \" Growth is the scenario you chose, not the fitted rate.\"",
              "                )",
              "            RETURN",
              "                SWITCH(",
              "                    [Studio Forecast Confidence],",
              "                    \"No data\", \"No Studio data loaded.\",",
              "                    \"Indicative only\", \"Only \" & FORMAT( COALESCE( _span, 0 ), \"#,0\" ) &",
              "                        \" calendar days of Studio history are in scope.\" & _basis,",
              "                    \"Low\", FORMAT( COALESCE( _span, 0 ), \"#,0\" ) &",
              "                        \" calendar days of Studio history are in scope.\" & _basis,",
              "                    \"Medium\", FORMAT( _span, \"#,0\" ) & \" calendar days of Studio history are in scope.\" & _basis,",
              "                    FORMAT( _span, \"#,0\" ) & \" calendar days of Studio history are in scope.\" & _basis",
              "                )",
              "            ",
              ""
            ],
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000012"
          },
          {
            "name": "Studio Forecast Summary",
            "description": [
              "Written summary of the Studio outlook, filter-aware. Leads with the",
              "twelve month number and states whether growth was fitted from",
              "history or supplied manually."
            ],
            "expression": [
              "",
              "            VAR _rate = [Daily Run Rate]",
              "            VAR _cost30 = [Projected Cost (30d)]",
              "            VAR _yearCost = [Studio Year Cost]",
              "            VAR _growth = [Studio Growth Applied %]",
              "            VAR _fitted = [Studio Fitted Monthly Growth %]",
              "            VAR _span = [Studio History Span Days]",
              "            VAR _daysLeft = [Studio Entitlement Days Remaining]",
              "            VAR _conf = LOWER( [Studio Forecast Confidence] )",
              "            VAR _chosen = SELECTEDVALUE( 'Growth Scenario'[Scenario], \"Fitted from history\" )",
              "            VAR _growthBit =",
              "                IF(",
              "                    _chosen = \"Fitted from history\",",
              "                    IF(",
              "                        ISBLANK( _fitted ),",
              "                        \" There is insufficient usable history for a fit, so the forecast stays flat from the observed daily average.\",",
              "                        IF(",
              "                            ABS( _growth ) < 0.001,",
              "                            \" History fits essentially flat month on month.\",",
              "                            \" The history-based rate is \" & FORMAT( _growth, \"0.0%\" ) &",
              "                                \" a month across \" & FORMAT( _span, \"#,0\" ) &",
              "                                \" calendar days, bounded to -30%/+30% for planning.\"",
              "                        )",
              "                    ),",
              "                    \" Using your selected growth rate of \" & FORMAT( _growth, \"0.0%\" ) & \" a month.\"",
              "                )",
              "            VAR _tail =",
              "                IF(",
              "                    ISBLANK( _daysLeft ),",
              "                    \"\",",
              "                    \" Prepaid capacity lasts about \" & FORMAT( _daysLeft, \"#,0\" ) & \" more days at this rate.\"",
              "                )",
              "            RETURN",
              "                IF(",
              "                    ISBLANK( _rate ) || _rate = 0,",
              "                    \"No Studio consumption in the current selection.\",",
              "                    \"Studio is averaging about \" & FORMAT( _rate, \"#,0\" ) &",
              "                        \" credits a day across the selected history, which projects to \" &",
              "                        FORMAT( _cost30, \"$#,0\" ) & \" over 30 days and \" &",
              "                        FORMAT( _yearCost, \"$#,0\" ) & \" over twelve months.\" &",
              "                        _growthBit & _tail & \" Confidence is \" & _conf & \".\"",
              "                )",
              "            ",
              ""
            ],
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000013"
          },
          {
            "name": "Studio Prepaid Cost",
            "description": "Cost of Studio consumption drawn from prepaid capacity packs.",
            "expression": "[Studio Prepaid Consumed] * [Studio Prepaid Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0003tn-fc00-0001-000000000016"
          },
          {
            "name": "Studio Prepaid Share %",
            "description": [
              "Share of Studio spend covered by prepaid capacity rather than billed",
              "as pay-as-you-go overage."
            ],
            "expression": "DIVIDE( [Studio Prepaid Consumed], [Studio Consumed Credits (Tenant)] )",
            "formatString": "0.0%",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0003tn-fc00-0001-000000000017"
          },
          {
            "name": "Studio Sessions Proxy",
            "description": "Distinct days with recorded Studio activity in the current selection.",
            "expression": "[Studio Days Observed]",
            "formatString": "#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cc0003tn-fc00-0001-000000000018"
          },
          {
            "name": "Studio Headline",
            "description": [
              "The single most important thing about Studio spend right now, stated in",
              "words. Names the environment carrying most consumption and whether it",
              "sits inside an entitlement, because that is what decides the bill."
            ],
            "expression": [
              "",
              "VAR PerEnv =",
              "    ADDCOLUMNS(",
              "        VALUES( 'Studio Environment'[Environment Name] ),",
              "        \"@used\", [Studio Consumed Credits (Tenant)],",
              "        \"@ent\",  [Studio Entitled Capacity]",
              "    )",
              "VAR Total   = SUMX( PerEnv, [@used] )",
              "VAR Biggest = TOPN( 1, FILTER( PerEnv, [@used] > 0 ), [@used], DESC )",
              "VAR EnvName = MAXX( Biggest, 'Studio Environment'[Environment Name] )",
              "VAR Used    = MAXX( Biggest, [@used] )",
              "VAR Ent     = MAXX( Biggest, [@ent] )",
              "VAR Share   = DIVIDE( Used, Total )",
              "RETURN",
              "    IF(",
              "        ISBLANK( Total ) || Total = 0,",
              "        \"No Studio consumption in this selection.\",",
              "        FORMAT( Share, \"0%\" ) & \" of Studio credits come from \" & EnvName & \".\"",
              "            & IF( Ent > 0, \"\", \" That environment holds no entitlement, so its usage bills directly.\" )",
              "    )",
              ""
            ],
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "8f660001-0001-4001-8001-000000000001"
          },
          {
            "name": "Environments In Use",
            "description": "Environments carrying real consumption, so tables can drop the empty ones.",
            "expression": [
              "",
              "COUNTROWS( FILTER( VALUES( 'Studio Environment'[Environment Name] ), [Studio Consumed Credits (Tenant)] > 0 ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "8f660001-0002-4001-8001-000000000002"
          },
          {
            "name": "Studio Growth Applied %",
            "description": [
              "The monthly growth rate the Studio projection uses.",
              "",
              "On \"Fitted from history\" this fits a capped trend from the dated",
              "tenant history itself once roughly a month of coverage exists,",
              "treating missing dates as zero usage. Shorter windows fall back to",
              "flat. Every other scenario is still the explicit rate you chose."
            ],
            "expression": [
              "",
              "            VAR _chosen = SELECTEDVALUE( 'Growth Scenario'[Scenario], \"Fitted from history\" )",
              "            VAR _rate = SELECTEDVALUE( 'Growth Scenario'[Rate] )",
              "            VAR _fitted = [Studio Fitted Monthly Growth %]",
              "            RETURN",
              "                IF( _chosen = \"Fitted from history\", COALESCE( _fitted, 0 ), _rate )",
              "            ",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "1bd01e7b-274e-4c69-8768-956766451cb1"
          },
          {
            "name": "Studio Month Credits",
            "description": [
              "Credits expected in a given month ahead, growing a 30-day run rate forward",
              "at the applied rate."
            ],
            "expression": [
              "",
              "VAR m = SELECTEDVALUE( 'Projection Month'[Value] )",
              "VAR g = [Studio Growth Applied %]",
              "VAR Base = [Daily Run Rate] * 30",
              "RETURN IF( m >= 1 && m <= 12, Base * POWER( 1 + g, m ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "362df6b1-4176-4d6c-a907-05ddaa1ce91f"
          },
          {
            "name": "Studio Month Cost",
            "description": [
              "Cost of that month at the blended rate actually being achieved across the",
              "measured prepaid and pay-as-you-go split."
            ],
            "expression": "[Studio Month Credits] * [Studio Effective Rate]",
            "formatString": "\\$#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "d7117982-effe-4339-b793-4625d187f24b"
          },
          {
            "name": "Studio Year Credits",
            "description": [
              "Credits projected over the next twelve months, compounding the chosen",
              "growth rate month on month."
            ],
            "expression": [
              "",
              "VAR g = [Studio Growth Applied %]",
              "VAR Base = [Daily Run Rate] * 30",
              "RETURN",
              "    SUMX( GENERATESERIES( 1, 12, 1 ), Base * POWER( 1 + g, [Value] ) )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "cd8e5015-368f-461d-a169-df336c5ebf0e"
          },
          {
            "name": "Studio Year Cost",
            "description": "Cost over the next twelve months at today's achieved blended rate.",
            "expression": "[Studio Year Credits] * [Studio Effective Rate]",
            "formatString": "\\$#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "112e6902-2e74-4d70-9fc7-f23fedf4a36f"
          },
          {
            "name": "Studio History Span Days",
            "description": [
              "Calendar days between the first and last Studio usage date in",
              "scope. Missing dates count toward the span so the fit sees quiet",
              "days as zero usage, not as absent evidence."
            ],
            "expression": [
              "",
              "            VAR _fromDate = [Studio Period Start]",
              "            VAR _history =",
              "                CALCULATETABLE(",
              "                    VALUES( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "                    REMOVEFILTERS( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "                    'Credit Consumption (Tenant)'[Usage_Date] >= _fromDate",
              "                )",
              "            VAR _minDate = MINX( _history, 'Credit Consumption (Tenant)'[Usage_Date] )",
              "            VAR _maxDate = MAXX( _history, 'Credit Consumption (Tenant)'[Usage_Date] )",
              "            RETURN",
              "                IF(",
              "                    ISBLANK( _minDate ) || ISBLANK( _maxDate ),",
              "                    BLANK(),",
              "                    1 + INT( _maxDate - _minDate )",
              "                )",
              "            ",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Forecast\\Model",
            "lineageTag": "8a3c7f9d-6c3f-4a22-b101-54b1a7d6e001"
          },
          {
            "name": "Studio History Coverage %",
            "description": [
              "Share of calendar days in the current Studio history window that",
              "recorded any usage. Low coverage means the fit is being asked to",
              "explain a sparse pattern and confidence should stay low."
            ],
            "expression": "DIVIDE( [Studio Days Observed], [Studio History Span Days] )",
            "formatString": "0.0%",
            "displayFolder": "Studio\\Forecast\\Model",
            "lineageTag": "8a3c7f9d-6c3f-4a22-b101-54b1a7d6e002"
          },
          {
            "name": "Studio Fitted Monthly Growth %",
            "description": [
              "Monthly growth fitted from the dated Studio tenant history itself.",
              "Uses regression on a 7-day rolling average over the calendar-day",
              "series, so missing dates count as zero usage while weekday-only",
              "patterns do not fake a trend,",
              "and clamps the result to +/-30% a month to",
              "stop a short ramp from exploding a twelve-month extrapolation."
            ],
            "expression": [
              "",
              "            VAR _span = [Studio History Span Days]",
              "            VAR _observed = [Studio Days Observed]",
              "            VAR _fromDate = [Studio Period Start]",
              "            VAR _minDate =",
              "                CALCULATE(",
              "                    MIN( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "                    REMOVEFILTERS( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "                    'Credit Consumption (Tenant)'[Usage_Date] >= _fromDate",
              "                )",
              "            VAR _maxDate =",
              "                CALCULATE(",
              "                    MAX( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "                    REMOVEFILTERS( 'Credit Consumption (Tenant)'[Usage_Date] ),",
              "                    'Credit Consumption (Tenant)'[Usage_Date] >= _fromDate",
              "                )",
              "            RETURN",
              "                IF(",
              "                    _span >= 28",
              "                        && _observed >= 7",
              "                        && NOT ISBLANK( _minDate )",
              "                        && NOT ISBLANK( _maxDate ),",
              "                    VAR _daily =",
              "                        ADDCOLUMNS(",
              "                            CALENDAR( _minDate, _maxDate ),",
              "                            \"@x\", INT( [Date] - _minDate ),",
              "                            \"@credits\",",
              "                                VAR _day = [Date]",
              "                                RETURN",
              "                                    COALESCE(",
              "                                        CALCULATE(",
              "                                            [Studio Consumed Credits (Tenant)],",
              "                                            TREATAS( { _day }, 'Credit Consumption (Tenant)'[Usage_Date] )",
              "                                        ),",
              "                                        0",
              "                                    )",
              "                        )",
              "                    VAR _avg7 =",
              "                        FILTER(",
              "                            _daily,",
              "                            [@x] >= 6",
              "                        )",
              "                    VAR _series =",
              "                        ADDCOLUMNS(",
              "                            ADDCOLUMNS(",
              "                                _avg7,",
              "                                \"@avg7\",",
              "                                    VAR _x = [@x]",
              "                                    RETURN",
              "                                        AVERAGEX(",
              "                                            FILTER( _daily, [@x] >= _x - 6 && [@x] <= _x ),",
              "                                            [@credits]",
              "                                        )",
              "                            ),",
              "                            \"@logAvg7\", LN( 1 + MAX( 0, [@avg7] ) )",
              "                        )",
              "                    VAR _n = COUNTROWS( _series )",
              "                    VAR _sx = SUMX( _series, [@x] )",
              "                    VAR _sy = SUMX( _series, [@logAvg7] )",
              "                    VAR _sxy = SUMX( _series, [@x] * [@logAvg7] )",
              "                    VAR _sxx = SUMX( _series, [@x] * [@x] )",
              "                    VAR _dailySlope = DIVIDE( _n * _sxy - _sx * _sy, _n * _sxx - _sx * _sx )",
              "                    VAR _boundedSlope = MIN( MAX( 30 * _dailySlope, LN( 0.70 ) ), LN( 1.30 ) )",
              "                    RETURN",
              "                        IF(",
              "                            _n >= 14",
              "                                && COUNTROWS( FILTER( _daily, [@credits] > 0 ) ) >= 7",
              "                                && NOT ISBLANK( _dailySlope ),",
              "                            EXP( _boundedSlope ) - 1",
              "                        )",
              "                )",
              "            ",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Studio\\Forecast\\Model",
            "lineageTag": "8a3c7f9d-6c3f-4a22-b101-54b1a7d6e003"
          },
          {
            "name": "Tenant Rows Without Quantities",
            "description": [
              "Dated tenant rows carrying neither prepaid nor pay-as-you-go consumption. Blank quantities",
              "are read as no consumption; any number above zero here means the export is thinner than",
              "its row count suggests."
            ],
            "expression": "COUNTROWS(FILTER('Credit Consumption (Tenant)', ISBLANK('Credit Consumption (Tenant)'[Prepaid_Consumed_Quantity]) && ISBLANK('Credit Consumption (Tenant)'[Pay_as_you_go_Consumed_Quantity])))",
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "f3dc024c-79e8-46db-bf91-7327ea42cb76"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Credit Consumption (Agent)",
        "lineageTag": "cc0001ag-0001-0001-0001-000000000001",
        "columns": [
          {
            "name": "Agent_Name",
            "dataType": "string",
            "sourceColumn": "Agent_Name",
            "lineageTag": "cc0001ag-col0-0001-000000000001",
            "summarizeBy": "none"
          },
          {
            "name": "Agent_Id",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Agent_Id",
            "lineageTag": "cc0001ag-col0-0001-000000000002",
            "summarizeBy": "none"
          },
          {
            "name": "Product",
            "dataType": "string",
            "sourceColumn": "Product",
            "lineageTag": "cc0001ag-col0-0001-000000000003",
            "summarizeBy": "none"
          },
          {
            "name": "Billable_Feature",
            "dataType": "string",
            "sourceColumn": "Billable_Feature",
            "lineageTag": "cc0001ag-col0-0001-000000000004",
            "summarizeBy": "none"
          },
          {
            "name": "Billed_credit",
            "dataType": "double",
            "sourceColumn": "Billed_credit",
            "formatString": "#,0",
            "lineageTag": "cc0001ag-col0-0001-000000000005",
            "summarizeBy": "sum"
          },
          {
            "name": "Non_billed_credit",
            "dataType": "double",
            "sourceColumn": "Non_billed_credit",
            "formatString": "#,0",
            "lineageTag": "cc0001ag-col0-0001-000000000006",
            "summarizeBy": "sum"
          },
          {
            "name": "Channel",
