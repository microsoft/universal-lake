      },
      {
        "name": "AzureSolutionSpend",
        "description": "Prototype Azure whole-solution spend and native units. Optional CSV; no tenant data is embedded.",
        "lineageTag": "8239a1ff-a281-4cab-7542-9c33ed33c9ac",
        "columns": [
          {
            "name": "UsageDate",
            "dataType": "dateTime",
            "sourceColumn": "UsageDate",
            "formatString": "yyyy-mm-dd",
            "lineageTag": "c86916e6-dfa5-7259-dada-b35894c9f841",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "SubscriptionName",
            "dataType": "string",
            "sourceColumn": "SubscriptionName",
            "lineageTag": "65a95c30-baa8-2a41-2a8a-65c4b9761af1",
            "summarizeBy": "none"
          },
          {
            "name": "SubscriptionId",
