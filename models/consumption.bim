              "VAR Snapshots = GROUPBY(LatestRows, 'AzureDeploymentHealth'[ResourceId], 'AzureDeploymentHealth'[DeploymentId],",
              "    \"__Sku\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SkuName]),",
              "    \"__Capacity\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PtuCapacity]),",
              "    \"__Util\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanUtilizationPct]),",
              "    \"__Peak\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PeakUtilizationPct]),",
