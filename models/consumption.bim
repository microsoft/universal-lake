          },
          {
            "name": "EvidenceType",
            "dataType": "string",
            "sourceColumn": "EvidenceType",
            "lineageTag": "eafecd00-c0aa-2af2-ea90-94653a36fcfa",
            "summarizeBy": "none"
          },
          {
            "name": "Notes",
            "dataType": "string",
            "sourceColumn": "Notes",
            "lineageTag": "ab94b0d0-cc69-0339-f136-6e3caf409fcd",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "AzureBillingReconciliation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Raw = GetTable(\"azure_billing_reconciliation\"),",
                "    Empty = #table(type table [Period = nullable text, PeriodStart = nullable date, PeriodEnd = nullable date, Product = nullable text, PoolName = nullable text, Representation = nullable text, Amount = nullable number, Currency = nullable text, Status = nullable text, EvidenceType = nullable text, Notes = nullable text], {}),",
                "    Result = if Raw = null then Empty else if Table.IsEmpty(Raw) then Empty else",
                "        let",
                "            Columns = List.Buffer(Table.ColumnNames(Raw)),",
                "            Names = {\"Period\", \"PeriodStart\", \"PeriodEnd\", \"Product\", \"PoolName\", \"Representation\", \"Amount\", \"Currency\", \"Status\", \"EvidenceType\", \"Notes\"},",
                "            Key = (s as text) as text => Text.Lower(Text.Remove(s, {\" \", \"_\", \"-\", \".\"})),",
                "            Pick = (name as text) as nullable text =>",
                "                if List.Contains(Columns, name) then name else",
                "                let Matches = List.Select(Columns, each Key(_) = Key(name))",
                "                in if List.Count(Matches) > 1 then error Error.Record(",
                "                    \"AmbiguousAzureColumn\", \"Use one canonical header per field.\", [Column=name])",
                "                    else List.First(Matches, null),",
                "            Bindings = List.Transform(Names, Pick),",
                "            Missing = List.Select(List.Positions(Names), each Bindings{_} = null),",
                "            Checked = if not List.IsEmpty(Missing) then error Error.Record(",
                "                \"AzureFeedSchema\", \"Supply every documented column; unknown values may be blank.\",",
                "                [MissingColumns=List.Transform(Missing, each Names{_})])",
                "                else Table.FromColumns(List.Transform(Bindings, each Table.Column(Raw, _)), Names),",
                "            Blanks = Table.TransformColumns(Checked, List.Transform(Names, (c) =>",
                "                {c, each if Value.Is(_, type text) and Text.Trim(_) = \"\" then null else _})),",
                "            Typed = Table.TransformColumnTypes(Blanks, {{\"Period\", type nullable text}, {\"PeriodStart\", type nullable date}, {\"PeriodEnd\", type nullable date}, {\"Product\", type nullable text}, {\"PoolName\", type nullable text}, {\"Representation\", type nullable text}, {\"Amount\", type nullable number}, {\"Currency\", type nullable text}, {\"Status\", type nullable text}, {\"EvidenceType\", type nullable text}, {\"Notes\", type nullable text}}, \"en-US\")",
                "        in Typed",
                "in",
                "    Result"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Recon Usage Estimate",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureBillingReconciliation'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureBillingReconciliation'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, CALCULATE(SUM('AzureBillingReconciliation'[Amount]), KEEPFILTERS('AzureBillingReconciliation'[Representation] = \"UsageEstimate\")))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "b2980270-7fff-e72c-212a-7cd000090561"
          },
          {
            "name": "Recon Azure Actual",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureBillingReconciliation'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureBillingReconciliation'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, CALCULATE(SUM('AzureBillingReconciliation'[Amount]), KEEPFILTERS('AzureBillingReconciliation'[Representation] = \"AzureActual\")))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "47d91ec0-d2f5-b84a-e209-53bcff356784"
          },
          {
            "name": "Recon Difference",
            "expression": "IF([Recon Comparison Status] = \"Comparable\", [Recon Azure Actual] - [Recon Usage Estimate])",
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "36c36c69-61b8-9f9d-ac83-7c4d84ad3a8e"
          },
          {
            "name": "Recon Fictional Evidence",
            "description": "Signed synthetic evidence only; not actual billing or a verified explanation. Preserves evidence row filters and currency guard.",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureBillingReconciliation'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureBillingReconciliation'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, CALCULATE(SUM('AzureBillingReconciliation'[Amount]), KEEPFILTERS('AzureBillingReconciliation'[Representation] = \"FictionalEvidence\")))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "ae8153ff-63e1-648d-2972-f305396408a1"
          },
          {
            "name": "Recon Unexplained Residual",
            "expression": [
              "VAR Difference = [Recon Difference]",
              "VAR Evidence = [Recon Fictional Evidence]",
              "RETURN IF(NOT ISBLANK(Difference) && NOT ISBLANK(Evidence), Difference - Evidence)"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "36cf9897-2f05-4de4-3aa9-aa4b5aa6467e"
          },
          {
            "name": "Recon Coverage %",
            "expression": "IF([Recon Comparison Status] = \"Comparable\", DIVIDE([Recon Usage Estimate], [Recon Azure Actual]))",
            "formatString": "0.0%",
            "displayFolder": "Azure prototype",
            "lineageTag": "f6c39d34-047b-8649-4a77-7a02174c66d9"
          },
          {
            "name": "Recon Evidence Amount",
            "description": "Signed ledger amount within one representation only. Estimate, actual and synthetic evidence are alternatives; their combined total is blank.",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureBillingReconciliation'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureBillingReconciliation'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, IF(HASONEVALUE('AzureBillingReconciliation'[Representation]), SUM('AzureBillingReconciliation'[Amount])))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "a76b142a-5d43-590e-040d-9015dc8fb7e8"
          },
          {
            "name": "Recon Comparison Status",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureBillingReconciliation'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureBillingReconciliation'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "VAR ScopeOk = HASONEVALUE('AzureBillingReconciliation'[PeriodStart]) && NOT ISBLANK(SELECTEDVALUE('AzureBillingReconciliation'[PeriodStart])) && HASONEVALUE('AzureBillingReconciliation'[PeriodEnd]) && NOT ISBLANK(SELECTEDVALUE('AzureBillingReconciliation'[PeriodEnd])) && HASONEVALUE('AzureBillingReconciliation'[PoolName]) && NOT ISBLANK(SELECTEDVALUE('AzureBillingReconciliation'[PoolName])) && SELECTEDVALUE('AzureBillingReconciliation'[PeriodStart]) <= SELECTEDVALUE('AzureBillingReconciliation'[PeriodEnd])",
              "VAR Estimate = [Recon Usage Estimate]",
              "VAR Actual = [Recon Azure Actual]",
              "RETURN SWITCH(TRUE(), ISEMPTY('AzureBillingReconciliation'), \"No data\", NOT CurrencyOk, \"Mixed/missing currency\", NOT ScopeOk, \"Select one aligned period and pool\", ISBLANK(Estimate) || ISBLANK(Actual), \"Not comparable: both representations required\", \"Comparable\")"
            ],
            "displayFolder": "Azure prototype",
            "lineageTag": "0b3fce59-d806-eea0-3f3c-41196b34d570"
          },
          {
            "name": "Recon Context",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureBillingReconciliation'[Currency], \"Mixed/missing currency\")",
              "VAR Pool = SELECTEDVALUE('AzureBillingReconciliation'[PoolName], \"Multiple/no pools\")",
              "VAR _FirstDate = SELECTEDVALUE('AzureBillingReconciliation'[PeriodStart])",
              "VAR _LastDate = SELECTEDVALUE('AzureBillingReconciliation'[PeriodEnd])",
              "RETURN [Recon Comparison Status] & \" | \" & CurrencyCode & \" | \" & Pool & \" | \" & IF(ISBLANK(_FirstDate) || ISBLANK(_LastDate), \"Select one period\", FORMAT(_FirstDate, \"yyyy-MM-dd\") & \" to \" & FORMAT(_LastDate, \"yyyy-MM-dd\")) & \" | Synthetic evidence; estimates and actual are alternatives\" "
            ],
            "displayFolder": "Azure prototype",
            "lineageTag": "181ec507-6ded-1cc7-50b9-b657ca026ef3"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
