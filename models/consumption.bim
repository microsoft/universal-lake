              "    \"__Peak\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PeakUtilizationPct]),",
              "    \"__Requests\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Requests]),",
              "    \"__Errors\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[ServerErrors5xx]),",
              "    \"__Throttles\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Throttles429]),",
              "    \"__Latency\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanLatencyMs]))",
              "RETURN COUNTROWS(FILTER(Snapshots, NOT CONTAINSSTRING([__Sku], \"Standard\") && NOT ISBLANK([__Sku]) && [__Capacity] > 0 && NOT ISBLANK([__Util]) && [__Util] >= 0 && [__Util] < 30))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "139e332e-1dce-0617-c9ee-727bf4782b3d"
          },
          {
            "name": "Azure Mean Latency",
            "description": "Latest selected MetricDate period; latest selected SnapshotDate once per ResourceId + DeploymentId. Missing telemetry is excluded from each metric's denominator.",
            "expression": [
              "VAR MetricPeriod = MAXX(ALLSELECTED('AzureDeploymentHealth'[MetricDate]), 'AzureDeploymentHealth'[MetricDate])",
              "VAR PeriodRows =",
              "    CALCULATETABLE(",
              "        FILTER('AzureDeploymentHealth', 'AzureDeploymentHealth'[MetricDate] = MetricPeriod && NOT ISBLANK('AzureDeploymentHealth'[SnapshotDate]) && NOT ISBLANK('AzureDeploymentHealth'[ResourceId]) && NOT ISBLANK('AzureDeploymentHealth'[DeploymentId])),",
              "        REMOVEFILTERS(",
              "            'AzureDeploymentHealth'[Application],",
              "            'AzureDeploymentHealth'[DeploymentName],",
              "            'AzureDeploymentHealth'[ModelName],",
              "            'AzureDeploymentHealth'[ModelVersion],",
              "            'AzureDeploymentHealth'[SkuName],",
              "            'AzureDeploymentHealth'[Region])",
              "    )",
              "VAR LatestKeys =",
              "    SELECTCOLUMNS(",
              "        GROUPBY(",
              "            PeriodRows,",
              "            'AzureDeploymentHealth'[ResourceId],",
              "            'AzureDeploymentHealth'[DeploymentId],",
              "            \"__SnapshotDate\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SnapshotDate])),",
              "        \"ResourceId\", 'AzureDeploymentHealth'[ResourceId],",
              "        \"DeploymentId\", 'AzureDeploymentHealth'[DeploymentId],",
              "        \"SnapshotDate\", [__SnapshotDate])",
              "VAR LatestRows =",
              "    CALCULATETABLE(",
              "        FILTER('AzureDeploymentHealth', 'AzureDeploymentHealth'[MetricDate] = MetricPeriod && NOT ISBLANK('AzureDeploymentHealth'[SnapshotDate]) && NOT ISBLANK('AzureDeploymentHealth'[ResourceId]) && NOT ISBLANK('AzureDeploymentHealth'[DeploymentId])),",
              "        TREATAS(",
              "            LatestKeys,",
              "            'AzureDeploymentHealth'[ResourceId],",
              "            'AzureDeploymentHealth'[DeploymentId],",
              "            'AzureDeploymentHealth'[SnapshotDate]))",
              "VAR Snapshots = GROUPBY(LatestRows, 'AzureDeploymentHealth'[ResourceId], 'AzureDeploymentHealth'[DeploymentId],",
              "    \"__Sku\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SkuName]),",
              "    \"__Capacity\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PtuCapacity]),",
              "    \"__Util\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanUtilizationPct]),",
              "    \"__Peak\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PeakUtilizationPct]),",
              "    \"__Requests\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Requests]),",
              "    \"__Errors\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[ServerErrors5xx]),",
              "    \"__Throttles\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Throttles429]),",
              "    \"__Latency\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanLatencyMs]))",
              "VAR Valid = FILTER(Snapshots, [__Requests] > 0 && NOT ISBLANK([__Latency]) && [__Latency] >= 0)",
              "RETURN DIVIDE(SUMX(Valid, [__Requests] * [__Latency]), SUMX(Valid, [__Requests]))"
            ],
            "formatString": "#,0.0",
            "displayFolder": "Azure prototype",
            "lineageTag": "d7ff36c9-4a7c-c3ab-4391-9d1dc68022a7"
          },
          {
            "name": "Azure Peak PTU Utilisation %",
            "description": "Latest selected MetricDate period; latest selected SnapshotDate once per ResourceId + DeploymentId. Missing telemetry is excluded from each metric's denominator.",
            "expression": [
              "VAR MetricPeriod = MAXX(ALLSELECTED('AzureDeploymentHealth'[MetricDate]), 'AzureDeploymentHealth'[MetricDate])",
              "VAR PeriodRows =",
              "    CALCULATETABLE(",
              "        FILTER('AzureDeploymentHealth', 'AzureDeploymentHealth'[MetricDate] = MetricPeriod && NOT ISBLANK('AzureDeploymentHealth'[SnapshotDate]) && NOT ISBLANK('AzureDeploymentHealth'[ResourceId]) && NOT ISBLANK('AzureDeploymentHealth'[DeploymentId])),",
              "        REMOVEFILTERS(",
              "            'AzureDeploymentHealth'[Application],",
              "            'AzureDeploymentHealth'[DeploymentName],",
              "            'AzureDeploymentHealth'[ModelName],",
              "            'AzureDeploymentHealth'[ModelVersion],",
              "            'AzureDeploymentHealth'[SkuName],",
              "            'AzureDeploymentHealth'[Region])",
              "    )",
              "VAR LatestKeys =",
              "    SELECTCOLUMNS(",
              "        GROUPBY(",
              "            PeriodRows,",
              "            'AzureDeploymentHealth'[ResourceId],",
              "            'AzureDeploymentHealth'[DeploymentId],",
              "            \"__SnapshotDate\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SnapshotDate])),",
              "        \"ResourceId\", 'AzureDeploymentHealth'[ResourceId],",
              "        \"DeploymentId\", 'AzureDeploymentHealth'[DeploymentId],",
              "        \"SnapshotDate\", [__SnapshotDate])",
              "VAR LatestRows =",
              "    CALCULATETABLE(",
              "        FILTER('AzureDeploymentHealth', 'AzureDeploymentHealth'[MetricDate] = MetricPeriod && NOT ISBLANK('AzureDeploymentHealth'[SnapshotDate]) && NOT ISBLANK('AzureDeploymentHealth'[ResourceId]) && NOT ISBLANK('AzureDeploymentHealth'[DeploymentId])),",
              "        TREATAS(",
              "            LatestKeys,",
              "            'AzureDeploymentHealth'[ResourceId],",
              "            'AzureDeploymentHealth'[DeploymentId],",
              "            'AzureDeploymentHealth'[SnapshotDate]))",
              "VAR Snapshots = GROUPBY(LatestRows, 'AzureDeploymentHealth'[ResourceId], 'AzureDeploymentHealth'[DeploymentId],",
              "    \"__Sku\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SkuName]),",
              "    \"__Capacity\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PtuCapacity]),",
              "    \"__Util\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanUtilizationPct]),",
              "    \"__Peak\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PeakUtilizationPct]),",
              "    \"__Requests\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Requests]),",
              "    \"__Errors\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[ServerErrors5xx]),",
              "    \"__Throttles\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Throttles429]),",
              "    \"__Latency\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanLatencyMs]))",
              "RETURN MAXX(FILTER(Snapshots, NOT CONTAINSSTRING([__Sku], \"Standard\") && NOT ISBLANK([__Sku]) && [__Capacity] > 0 && NOT ISBLANK([__Peak]) && [__Peak] >= 0), [__Peak]) / 100"
            ],
            "formatString": "0.0%",
            "displayFolder": "Azure prototype",
            "lineageTag": "c02119cc-e9b8-0ff9-5203-d549d82015d4"
          },
          {
            "name": "Azure Deployment Review",
            "description": "Latest selected MetricDate period; latest selected SnapshotDate once per ResourceId + DeploymentId. Missing telemetry is excluded from each metric's denominator.",
            "expression": [
              "VAR MetricPeriod = MAXX(ALLSELECTED('AzureDeploymentHealth'[MetricDate]), 'AzureDeploymentHealth'[MetricDate])",
              "VAR PeriodRows =",
              "    CALCULATETABLE(",
              "        FILTER('AzureDeploymentHealth', 'AzureDeploymentHealth'[MetricDate] = MetricPeriod && NOT ISBLANK('AzureDeploymentHealth'[SnapshotDate]) && NOT ISBLANK('AzureDeploymentHealth'[ResourceId]) && NOT ISBLANK('AzureDeploymentHealth'[DeploymentId])),",
              "        REMOVEFILTERS(",
              "            'AzureDeploymentHealth'[Application],",
              "            'AzureDeploymentHealth'[DeploymentName],",
              "            'AzureDeploymentHealth'[ModelName],",
              "            'AzureDeploymentHealth'[ModelVersion],",
              "            'AzureDeploymentHealth'[SkuName],",
              "            'AzureDeploymentHealth'[Region])",
              "    )",
              "VAR LatestKeys =",
              "    SELECTCOLUMNS(",
              "        GROUPBY(",
              "            PeriodRows,",
              "            'AzureDeploymentHealth'[ResourceId],",
              "            'AzureDeploymentHealth'[DeploymentId],",
              "            \"__SnapshotDate\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SnapshotDate])),",
              "        \"ResourceId\", 'AzureDeploymentHealth'[ResourceId],",
              "        \"DeploymentId\", 'AzureDeploymentHealth'[DeploymentId],",
              "        \"SnapshotDate\", [__SnapshotDate])",
              "VAR LatestRows =",
              "    CALCULATETABLE(",
              "        FILTER('AzureDeploymentHealth', 'AzureDeploymentHealth'[MetricDate] = MetricPeriod && NOT ISBLANK('AzureDeploymentHealth'[SnapshotDate]) && NOT ISBLANK('AzureDeploymentHealth'[ResourceId]) && NOT ISBLANK('AzureDeploymentHealth'[DeploymentId])),",
              "        TREATAS(",
              "            LatestKeys,",
              "            'AzureDeploymentHealth'[ResourceId],",
              "            'AzureDeploymentHealth'[DeploymentId],",
              "            'AzureDeploymentHealth'[SnapshotDate]))",
              "VAR Snapshots = GROUPBY(LatestRows, 'AzureDeploymentHealth'[ResourceId], 'AzureDeploymentHealth'[DeploymentId],",
              "    \"__Sku\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SkuName]),",
              "    \"__Capacity\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PtuCapacity]),",
              "    \"__Util\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanUtilizationPct]),",
              "    \"__Peak\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PeakUtilizationPct]),",
              "    \"__Requests\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Requests]),",
              "    \"__Errors\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[ServerErrors5xx]),",
              "    \"__Throttles\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Throttles429]),",
              "    \"__Latency\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanLatencyMs]))",
              "VAR OneDeployment = HASONEVALUE('AzureDeploymentHealth'[ResourceId]) && HASONEVALUE('AzureDeploymentHealth'[DeploymentId])",
              "VAR Sku = MAXX(Snapshots, [__Sku])",
              "VAR Capacity = MAXX(Snapshots, [__Capacity])",
              "VAR Util = MAXX(Snapshots, [__Util])",
              "RETURN IF(OneDeployment, SWITCH(TRUE(), COUNTROWS(Snapshots) <> 1, \"No telemetry\", CONTAINSSTRING(Sku, \"Standard\"), \"Not applicable\", ISBLANK(Sku) || ISBLANK(Capacity) || Capacity <= 0 || ISBLANK(Util) || Util < 0, \"No telemetry\", Util < 30, \"Review: <30%\", \"Within threshold\"))"
            ],
            "displayFolder": "Azure prototype",
            "lineageTag": "8d308dbc-cabd-736e-837d-e34f501ac1dd"
          },
          {
            "name": "Azure Capacity Context",
            "description": "Latest selected MetricDate period; latest selected SnapshotDate once per ResourceId + DeploymentId. Missing telemetry is excluded from each metric's denominator.",
            "expression": [
              "VAR MetricPeriod = MAXX(ALLSELECTED('AzureDeploymentHealth'[MetricDate]), 'AzureDeploymentHealth'[MetricDate])",
              "VAR PeriodRows =",
              "    CALCULATETABLE(",
              "        FILTER('AzureDeploymentHealth', 'AzureDeploymentHealth'[MetricDate] = MetricPeriod && NOT ISBLANK('AzureDeploymentHealth'[SnapshotDate]) && NOT ISBLANK('AzureDeploymentHealth'[ResourceId]) && NOT ISBLANK('AzureDeploymentHealth'[DeploymentId])),",
              "        REMOVEFILTERS(",
              "            'AzureDeploymentHealth'[Application],",
              "            'AzureDeploymentHealth'[DeploymentName],",
              "            'AzureDeploymentHealth'[ModelName],",
              "            'AzureDeploymentHealth'[ModelVersion],",
              "            'AzureDeploymentHealth'[SkuName],",
              "            'AzureDeploymentHealth'[Region])",
              "    )",
              "VAR LatestKeys =",
              "    SELECTCOLUMNS(",
              "        GROUPBY(",
              "            PeriodRows,",
              "            'AzureDeploymentHealth'[ResourceId],",
              "            'AzureDeploymentHealth'[DeploymentId],",
              "            \"__SnapshotDate\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SnapshotDate])),",
              "        \"ResourceId\", 'AzureDeploymentHealth'[ResourceId],",
              "        \"DeploymentId\", 'AzureDeploymentHealth'[DeploymentId],",
              "        \"SnapshotDate\", [__SnapshotDate])",
              "VAR LatestRows =",
              "    CALCULATETABLE(",
              "        FILTER('AzureDeploymentHealth', 'AzureDeploymentHealth'[MetricDate] = MetricPeriod && NOT ISBLANK('AzureDeploymentHealth'[SnapshotDate]) && NOT ISBLANK('AzureDeploymentHealth'[ResourceId]) && NOT ISBLANK('AzureDeploymentHealth'[DeploymentId])),",
              "        TREATAS(",
              "            LatestKeys,",
              "            'AzureDeploymentHealth'[ResourceId],",
              "            'AzureDeploymentHealth'[DeploymentId],",
              "            'AzureDeploymentHealth'[SnapshotDate]))",
              "VAR Snapshots = GROUPBY(LatestRows, 'AzureDeploymentHealth'[ResourceId], 'AzureDeploymentHealth'[DeploymentId],",
              "    \"__Sku\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SkuName]),",
              "    \"__Capacity\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PtuCapacity]),",
              "    \"__Util\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanUtilizationPct]),",
              "    \"__Peak\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PeakUtilizationPct]),",
              "    \"__Requests\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Requests]),",
              "    \"__Errors\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[ServerErrors5xx]),",
              "    \"__Throttles\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Throttles429]),",
              "    \"__Latency\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanLatencyMs]))",
              "VAR FirstSnapshot = MINX(LatestRows, 'AzureDeploymentHealth'[SnapshotDate])",
              "VAR LastSnapshot = MAXX(LatestRows, 'AzureDeploymentHealth'[SnapshotDate])",
              "RETURN IF(ISBLANK(LastSnapshot), \"No capacity/health data\", \"Metric period \" & FORMAT(MetricPeriod, \"yyyy-MM-dd\") & \" | Latest selected snapshot per deployment: \" & FORMAT(FirstSnapshot, \"yyyy-MM-dd\") & IF(FirstSnapshot <> LastSnapshot, \" to \" & FORMAT(LastSnapshot, \"yyyy-MM-dd\"), \"\") & \" | Request-based signals, not SLA\")"
            ],
            "displayFolder": "Azure prototype",
            "lineageTag": "83fbe5e9-9d67-434c-e4d6-398e6fc9fbf3"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "AzureBillingReconciliation",
        "description": "Prototype like-for-like billing reconciliation. Actual and product-derived estimates are alternatives, never additive.",
        "lineageTag": "9cfb23ba-1261-81e6-cb44-f6c1ce9f2fd4",
        "columns": [
          {
            "name": "Period",
            "dataType": "string",
