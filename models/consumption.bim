            "isHidden": true,
            "sourceColumn": "SubscriptionId",
            "lineageTag": "87a24ae1-23bb-ba2b-097c-0b343036719a",
            "summarizeBy": "none"
          },
          {
            "name": "ResourceId",
            "dataType": "string",
            "description": "Stable resource key. Do not join on resource name alone.",
            "sourceColumn": "ResourceId",
            "lineageTag": "bc0ae74f-a40f-6830-8bbe-e28e81d39d07",
            "summarizeBy": "none"
          },
          {
            "name": "ResourceName",
            "dataType": "string",
            "sourceColumn": "ResourceName",
            "lineageTag": "621e4d9f-31e3-e92d-faa1-0e390fb1cbc9",
            "summarizeBy": "none"
          },
          {
