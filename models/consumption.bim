        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR MaxData = CALCULATE( MAX('CreditsWeekly'[MetricDate]), ALL('CreditsWeekly') )",
                "RETURN",
                "ADDCOLUMNS(",
                "    CALENDAR( COALESCE(MINX(FILTER(DISTINCT(UNION(",
                "        SELECTCOLUMNS('CreditsWeekly', \"D\", 'CreditsWeekly'[MetricDate]),",
                "        SELECTCOLUMNS('Credit Consumption (Tenant)', \"D\", 'Credit Consumption (Tenant)'[Usage_Date]),",
                "        SELECTCOLUMNS('GitHub Usage', \"D\", 'GitHub Usage'[Usage_Date]),",
                "        SELECTCOLUMNS('AzureAiSpend', \"D\", 'AzureAiSpend'[UsageDate]),",
                "        SELECTCOLUMNS('AzureAiTokens', \"D\", 'AzureAiTokens'[Date])",
                "    )), NOT ISBLANK([D])), [D]), TODAY()), COALESCE(MAXX(FILTER(DISTINCT(UNION(",
                "        SELECTCOLUMNS('CreditsWeekly', \"D\", 'CreditsWeekly'[MetricDate]),",
                "        SELECTCOLUMNS('Credit Consumption (Tenant)', \"D\", 'Credit Consumption (Tenant)'[Usage_Date]),",
                "        SELECTCOLUMNS('GitHub Usage', \"D\", 'GitHub Usage'[Usage_Date]),",
                "        SELECTCOLUMNS('AzureAiSpend', \"D\", 'AzureAiSpend'[UsageDate]),",
                "        SELECTCOLUMNS('AzureAiTokens', \"D\", 'AzureAiTokens'[Date])",
                "    )), NOT ISBLANK([D])), [D]), TODAY()) ),",
                "    \"Year\",            YEAR([Date]),",
                "    \"Month No\",        MONTH([Date]),",
                "    \"Month\",           FORMAT([Date], \"mmm\"),",
                "    \"Month Year\",      FORMAT([Date], \"mmm yyyy\"),",
                "    \"Month Year Sort\", YEAR([Date]) * 100 + MONTH([Date]),",
                "    \"Quarter\",         \"Q\" & FORMAT([Date], \"q\"),",
                "    \"Week Start\",      [Date] - WEEKDAY([Date], 1) + 1,",
                "    \"Week Label\",      FORMAT([Date] - WEEKDAY([Date], 1) + 1, \"dd mmm\"),",
                "    \"Is Future\",       [Date] > MaxData",
                ")"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "DateTableCreditLensViva"
          }
        ]
      },
