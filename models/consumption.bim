      },
      {
        "name": "Org Attribute Source",
        "isHidden": true,
        "lineageTag": "f1a2b3c4-0002-4d5e-8f60-a1b2c3d4e5f6",
        "columns": [
          {
            "name": "Attribute",
            "dataType": "string",
            "sourceColumn": "Attribute",
            "lineageTag": "f1a2b3c4-0003-4d5e-8f60-a1b2c3d4e5f6",
            "summarizeBy": "none"
          },
          {
            "name": "Value",
            "dataType": "string",
            "sourceColumn": "Value",
            "lineageTag": "f1a2b3c4-0004-4d5e-8f60-a1b2c3d4e5f6",
            "summarizeBy": "none"
          },
          {
            "name": "UserPrincipalName",
            "dataType": "string",
            "sourceColumn": "UserPrincipalName",
            "lineageTag": "f1a2b3c4-0005-4d5e-8f60-a1b2c3d4e5f6",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Org Attribute Source",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "// Every org column except the identity key, turned into rows.",
                "//",
                "// Built by appending one projection PER ATTRIBUTE, not by walking rows.",
                "// Table.UnpivotOtherColumns drops a person whose attributes are all null -",
                "// they produced no rows at all and disappeared from every grouped visual,",
                "// so one user with 3,194 credits contributed 3,194 ungrouped and nothing",
                "// grouped by Department. A row-by-row rebuild fixed that and then timed",
                "// out on 1,020 people. This keeps the engine set-based: nine table",
                "// operations, not nine thousand row visits.",
                "//",
                "// DisplayName is kept and surfaces as \"User\", as before.",
                "let",
                "\tBase = Table.Buffer(OrgNormalised),",
                "\tAttrs = List.RemoveItems(Table.ColumnNames(Base), {\"UserPrincipalName\"}),",
                "\tBlank = (v as any) as logical =>",
                "\t\tv = null or Text.Trim(Text.From(v)) = \"\",",
                "\t// An attribute only a handful of people have a value for is an",
                "\t// artefact, not a cohort. Domain and Population Type arrived from",
                "\t// the connector populated for 1 person in 1021 - grouping by either",
                "\t// put everyone else in \"(Not set)\". The old test asked whether ANY",
                "\t// value existed, which one stray row satisfies.",
                "\tTotal = Table.RowCount(Base),",
                "\tCovered = (c as text) as number =>",
                "\t\tList.Count(List.Select(Table.Column(Base, c), each not Blank(_))),",
                "\t// Generous to a real partial rollout, fatal to a single stray row.",
                "\tMinShare = 0.05,",
                "\tUseful = List.Select(Attrs, (c) =>",
                "\t\tTotal > 0 and Covered(c) / Total >= MinShare),",
                "\t// If nothing clears the bar the org data is sparse rather than",
                "\t// wrong, so fall back to anything populated at all rather than",
                "\t// leaving the report with no way to group.",
                "\tLive = if List.IsEmpty(Useful)",
                "\t\tthen List.Select(Attrs, (c) => Covered(c) > 0)",
                "\t\telse Useful,",
                "\tPretty = (c as text) as text =>",
                "\t\tif c = \"DisplayName\" then \"User\"",
                "\t\telse Text.Combine(",
                "\t\t\tSplitter.SplitTextByCharacterTransition({\"a\"..\"z\"}, {\"A\"..\"Z\"})(c), \" \"),",
                "\tOne = (c as text) as table =>",
                "\t\tTable.RenameColumns(",
                "\t\t\tTable.SelectColumns(",
                "\t\t\t\tTable.AddColumn(",
                "\t\t\t\t\tTable.AddColumn(Base, \"_attr\", each Pretty(c), type text),",
                "\t\t\t\t\t\"_val\",",
                "\t\t\t\t\teach if Blank(Record.Field(_, c)) then \"(Not set)\"",
                "\t\t\t\t\t\telse Text.From(Record.Field(_, c)), type text),",
                "\t\t\t\t{\"UserPrincipalName\", \"_attr\", \"_val\"}),",
                "\t\t\t{{\"_attr\", \"Attribute\"}, {\"_val\", \"Value\"}}),",
                "\tEmpty = #table(",
                "\t\ttype table [UserPrincipalName = text, Attribute = text, Value = text], {}),",
                "\tOut = if List.IsEmpty(Live) then Empty",
                "\t\telse Table.Combine(List.Transform(Live, One)),",
                "\tTyped = Table.TransformColumnTypes(Out, {",
                "\t\t{\"UserPrincipalName\", type text}, {\"Attribute\", type text},",
                "\t\t{\"Value\", type text}})",
                "in",
                "\tTyped"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Group By",
        "description": [
          "The single grouping dimension. Whatever attributes the tenant's org export",
          "carries appear here automatically, alongside one Usage Intensity cohort per",
          "product, which is derived from consumption rather than from HR data."
        ],
        "lineageTag": "f1a2b3c4-0010-4d5e-8f60-a1b2c3d4e5f6",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Attribute",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[Attribute]",
            "lineageTag": "f1a2b3c4-0011-4d5e-8f60-a1b2c3d4e5f6",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Group",
            "dataType": "string",
            "isNameInferred": false,
            "description": [
              "The person's value for the chosen attribute. This is what visuals put on",
              "their axis, which is why it is called Group rather than Value."
            ],
            "sourceColumn": "[Group]",
            "lineageTag": "f1a2b3c4-0012-4d5e-8f60-a1b2c3d4e5f6",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "UserPrincipalName",
            "dataType": "string",
            "isNameInferred": false,
            "isHidden": true,
            "sourceColumn": "[UserPrincipalName]",
            "lineageTag": "f1a2b3c4-0013-4d5e-8f60-a1b2c3d4e5f6",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Group By",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "// Usage Intensity comes from consumption, not from HR data, so it cannot be",
                "// produced by the org query. Unioning it here keeps the grouping list to one",
                "// table and therefore the report to one control.",
                "//",
                "// One cohort PER PRODUCT, deliberately named apart. A shared \"Usage Intensity\"",
                "// would put a two-product user in two buckets under one attribute and",
                "// double-count their credits.",
                "VAR OrgRows =",
                "    SELECTCOLUMNS(",
                "        'Org Attribute Source',",
                "        \"Attribute\", 'Org Attribute Source'[Attribute],",
                "        \"Group\", 'Org Attribute Source'[Value],",
                "        \"UserPrincipalName\", 'Org Attribute Source'[UserPrincipalName]",
                "    )",
                "// Cowork already holds one row per person, so it needs no aggregation.",
                "VAR CoworkRows =",
                "    SELECTCOLUMNS(",
                "        FILTER( 'CoworkBilling', NOT ISBLANK( 'CoworkBilling'[UsageCohort Label] ) ),",
                "        \"Attribute\", \"Usage Intensity (Cowork)\",",
                "        \"Group\", 'CoworkBilling'[UsageCohort Label],",
                "        \"UserPrincipalName\", 'CoworkBilling'[UserPrincipalName]",
                "    )",
                "// Studio is per user PER AGENT. Collapse to one row per person before ranking,",
                "// otherwise the percentile ranks agent rows rather than people.",
                "VAR StudioByUser =",
                "    ADDCOLUMNS(",
                "        SUMMARIZE(",
                "            FILTER(",
                "                'Credit Consumption (User)',",
                "                NOT ISBLANK( 'Credit Consumption (User)'[User_Email] )",
                "            ),",
                "            'Credit Consumption (User)'[User_Email]",
                "        ),",
                "        \"@Used\", CALCULATE( SUM( 'Credit Consumption (User)'[Credits_used] ) ) + 0",
                "    )",
                "VAR StudioRows =",
                "    SELECTCOLUMNS(",
                "        ADDCOLUMNS(",
                "            StudioByUser,",
                "            \"@P\", DIVIDE(",
                "                RANKX( StudioByUser, [@Used], , ASC ),",
                "                COUNTROWS( StudioByUser )",
                "            )",
                "        ),",
                "        \"Attribute\", \"Usage Intensity (Studio)\",",
                "        \"Group\", SWITCH( TRUE(),",
                "            [@Used] <= 0, \"0. Not used\",",
                "            [@P] <= 0.50, \"1. Light (Bottom 50%)\",",
                "            [@P] <= 0.75, \"2. Regular (Top 25–50%)\",",
                "            [@P] <= 0.90, \"3. Engaged (Top 10–25%)\",",
                "            [@P] <= 0.95, \"4. Native (Top 5–10%)\",",
                "            [@P] <= 0.99, \"5. Power (Top 1–5%)\",",
                "            \"6. Frontier (Top 1%)\" ),",
                "        \"UserPrincipalName\", [User_Email]",
                "    )",
                "// GitHub User is already one row per developer and carries the UPN; the credits",
                "// come across the Username relationship. Seat holders with no usage coalesce to",
                "// zero and correctly rank into the lightest bucket.",
                "VAR GitHubByUser =",
                "    ADDCOLUMNS(",
                "        SUMMARIZE(",
                "            FILTER( 'GitHub User', NOT ISBLANK( 'GitHub User'[UserPrincipalName] ) ),",
                "            'GitHub User'[UserPrincipalName]",
                "        ),",
                "        \"@Used\", CALCULATE( SUM( 'GitHub Usage'[Credits] ) ) + 0",
                "    )",
                "VAR GitHubRows =",
                "    SELECTCOLUMNS(",
                "        ADDCOLUMNS(",
                "            GitHubByUser,",
                "            \"@P\", DIVIDE(",
                "                RANKX( GitHubByUser, [@Used], , ASC ),",
                "                COUNTROWS( GitHubByUser )",
                "            )",
                "        ),",
                "        \"Attribute\", \"Usage Intensity (GitHub)\",",
                "        \"Group\", SWITCH( TRUE(),",
                "            [@Used] <= 0, \"0. Not used\",",
                "            [@P] <= 0.50, \"1. Light (Bottom 50%)\",",
                "            [@P] <= 0.75, \"2. Regular (Top 25–50%)\",",
                "            [@P] <= 0.90, \"3. Engaged (Top 10–25%)\",",
                "            [@P] <= 0.95, \"4. Native (Top 5–10%)\",",
                "            [@P] <= 0.99, \"5. Power (Top 1–5%)\",",
                "            \"6. Frontier (Top 1%)\" ),",
                "        \"UserPrincipalName\", [UserPrincipalName]",
                "    )",
                "// Everyone the model knows about, from any source. A person is",
                "// \"not a Studio user\" only relative to this population.",
                "VAR AllPeople =",
                "\tDISTINCT(",
                "\t\tUNION(",
                "\t\t\tSELECTCOLUMNS( Org, \"UPN\", Org[UserPrincipalName] ),",
                "\t\t\tSELECTCOLUMNS( CoworkBilling, \"UPN\", CoworkBilling[UserPrincipalName] ),",
                "                SELECTCOLUMNS('Credit Consumption (User)', \"UPN\", 'Credit Consumption (User)'[User_Email]),",
                "                SELECTCOLUMNS('GitHub User', \"UPN\", 'GitHub User'[UserPrincipalName])",
                "\t\t)",
                "\t)",
                "// Absent from a product is worth showing, but only once that product is in",
                "// play. Dropping those people made the credit total change depending on",
                "// which intensity you grouped by - 3,194 under Cowork and 0 under Studio,",
                "// same person, same credits.",
                "VAR StudioMissing =",
                "\tSELECTCOLUMNS(",
                "\t\tEXCEPT( AllPeople,",
                "\t\t\tSELECTCOLUMNS( StudioRows, \"UPN\", [UserPrincipalName] ) ),",
                "\t\t\"Attribute\", \"Usage Intensity (Studio)\",",
                "\t\t\"Group\", \"0. Not used\",",
                "\t\t\"UserPrincipalName\", [UPN]",
                "\t)",
                "VAR GitHubMissing =",
                "\tSELECTCOLUMNS(",
                "\t\tEXCEPT( AllPeople,",
                "\t\t\tSELECTCOLUMNS( GitHubRows, \"UPN\", [UserPrincipalName] ) ),",
                "\t\t\"Attribute\", \"Usage Intensity (GitHub)\",",
                "\t\t\"Group\", \"0. Not used\",",
                "\t\t\"UserPrincipalName\", [UPN]",
                "\t)",
                "VAR CoworkMissing =",
                "\tSELECTCOLUMNS(",
                "\t\tEXCEPT( AllPeople,",
                "\t\t\tSELECTCOLUMNS( CoworkRows, \"UPN\", [UserPrincipalName] ) ),",
                "\t\t\"Attribute\", \"Usage Intensity (Cowork)\",",
                "\t\t\"Group\", \"0. Not used\",",
                "\t\t\"UserPrincipalName\", [UPN]",
                "\t)",
                "// Each product contributes only when it has something to say. A tenant with",
                "// no GitHub data gets no GitHub attribute rather than an attribute in which",
                "// everyone reads \"not used\" - and, more importantly, one empty product can",
                "// no longer take the whole table down with it.",
                "// A product contributes only when it has data. FILTER is used rather than",
                "// IF because IF returns a SCALAR - \"the expression refers to multiple",
                "// columns, multiple columns cannot be converted to a scalar value\" - which",
                "// made the whole calculated table fail and took every visual with it.",
                "//",
                "// FILTER( <block>, NOT ISEMPTY( <source> ) ) is table-valued: the block",
                "// yields its rows when the product has data and none when it does not.",
                "RETURN",
                "\tUNION(",
                "            SELECTCOLUMNS(FILTER(AllPeople, NOT ISBLANK([UPN]) && [UPN] <> \"\"),",
                "                \"Attribute\", \"All users\", \"Group\", \"All users\", \"UserPrincipalName\", [UPN]),",
                "\t\tFILTER( OrgRows,        NOT ISEMPTY( 'Org Attribute Source' ) ),",
                "\t\tFILTER( CoworkRows,     NOT ISEMPTY( CoworkBilling ) ),",
                "\t\tFILTER( StudioRows,     NOT ISEMPTY( 'Credit Consumption (User)' ) ),",
                "\t\tFILTER( GitHubRows,     NOT ISEMPTY( 'GitHub User' ) ),",
                "\t\tFILTER( CoworkMissing,  NOT ISEMPTY( CoworkBilling ) ),",
                "\t\tFILTER( StudioMissing,  NOT ISEMPTY( 'Credit Consumption (User)' ) ),",
                "\t\tFILTER( GitHubMissing,  NOT ISEMPTY( 'GitHub User' ) )",
                "\t)"
              ]
            },
            "annotations": [
              {
                "name": "PBI_Id",
                "value": "f1a2b3c4-0018-4d5e-8f60-a1b2c3d4e5f6"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Grouped By",
            "description": [
              "Name of the attribute currently chosen, for chart titles. Reads \"several",
              "attributes\" if more than one is selected, which would double-count people."
            ],
            "expression": [
              "IF(",
              "    ISFILTERED('Group By'[Attribute]),",
              "    SELECTEDVALUE('Group By'[Attribute], \"several attributes\"),",
              "    \"All users\"",
              ")"
            ],
            "lineageTag": "f1a2b3c4-0014-4d5e-8f60-a1b2c3d4e5f6"
          },
          {
            "name": "Cost Title",
            "description": [
              "Chart title that names the chosen grouping, replacing the dynamic header a",
              "field parameter would have given."
            ],
            "expression": "\"COST BY \" & UPPER( [Grouped By] )",
            "lineageTag": "f1a2b3c4-0015-4d5e-8f60-a1b2c3d4e5f6"
          },
          {
            "name": "Consumption Title",
            "expression": "\"CREDIT CONSUMPTION BY \" & UPPER( [Grouped By] )",
            "lineageTag": "f1a2b3c4-0016-4d5e-8f60-a1b2c3d4e5f6"
          },
          {
            "name": "Growth Title",
            "expression": "\"GROWTH BY \" & UPPER( [Grouped By] )",
            "lineageTag": "f1a2b3c4-0017-4d5e-8f60-a1b2c3d4e5f6"
          },
          {
            "name": "Grouping Selection Valid",
            "description": "Pick one of these in the GROUP BY slicer to decide how the report is cut.",
            "expression": [
              "VAR _chosen = ISFILTERED('Group By'[Attribute])",
              "VAR _attribute = SELECTEDVALUE('Group By'[Attribute])",
              "RETURN",
              "IF(",
              "    _chosen,",
              "    IF(HASONEVALUE('Group By'[Attribute]), 1, 0),",
              "    IF(_attribute = \"All users\", 1, 0)",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "00dd3034-07c2-44c0-aa8b-746696a75364"
          }
        ]
      },
      {
        "name": "Settings",
        "lineageTag": "5e770002-0001-4001-8001-000000000001",
        "columns": [
          {
            "name": "Cowork Rate",
            "dataType": "double",
            "sourceColumn": "Cowork Rate",
            "formatString": "\\$#,0.0000",
            "lineageTag": "5e770002-0002-4001-8001-000000000002",
            "summarizeBy": "none"
          },
          {
            "name": "Cowork Prepaid Rate",
            "dataType": "double",
            "sourceColumn": "Cowork Prepaid Rate",
            "formatString": "\\$#,0.0000",
            "lineageTag": "5e770002-0003-4001-8001-000000000003",
            "summarizeBy": "none"
          },
          {
            "name": "Studio Rate",
            "dataType": "double",
            "sourceColumn": "Studio Rate",
            "formatString": "\\$#,0.0000",
            "lineageTag": "5e770002-0004-4001-8001-000000000004",
            "summarizeBy": "none"
          },
          {
            "name": "Studio Prepaid Rate",
