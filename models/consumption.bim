          },
          {
            "name": "ServiceName",
            "dataType": "string",
            "sourceColumn": "ServiceName",
            "lineageTag": "2fc68e93-2fe7-2542-dbc9-51ba1090185c",
            "summarizeBy": "none"
          },
          {
            "name": "ServiceCategory",
            "dataType": "string",
            "sourceColumn": "ServiceCategory",
            "lineageTag": "77219960-f50d-e540-482e-16bf29214e2b",
            "summarizeBy": "none"
          },
          {
            "name": "ActualCost",
            "dataType": "double",
            "sourceColumn": "ActualCost",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "6dbc2bda-76a8-5644-953f-74f35327ca39",
            "summarizeBy": "none"
          },
