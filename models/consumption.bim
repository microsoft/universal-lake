          },
          {
            "name": "Representation",
            "dataType": "string",
            "sourceColumn": "Representation",
            "lineageTag": "024c6dcc-f248-8b46-9643-a3ffb70f01db",
            "summarizeBy": "none"
          },
          {
            "name": "Amount",
