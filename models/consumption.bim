            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Raw = GetTable(\"azure_deployment_health\"),",
                "    Empty = #table(type table [SnapshotDate = nullable date, MetricDate = nullable date, SubscriptionName = nullable text, SubscriptionId = nullable text, ResourceId = nullable text, DeploymentId = nullable text, DeploymentName = nullable text, Application = nullable text, ModelName = nullable text, ModelVersion = nullable text, SkuName = nullable text, Region = nullable text, PtuCapacity = nullable number, MeanUtilizationPct = nullable number, PeakUtilizationPct = nullable number, Requests = nullable number, ServerErrors5xx = nullable number, Throttles429 = nullable number, MeanLatencyMs = nullable number], {}),",
                "    Result = if Raw = null then Empty else if Table.IsEmpty(Raw) then Empty else",
                "        let",
                "            Columns = List.Buffer(Table.ColumnNames(Raw)),",
                "            Names = {\"SnapshotDate\", \"MetricDate\", \"SubscriptionName\", \"SubscriptionId\", \"ResourceId\", \"DeploymentId\", \"DeploymentName\", \"Application\", \"ModelName\", \"ModelVersion\", \"SkuName\", \"Region\", \"PtuCapacity\", \"MeanUtilizationPct\", \"PeakUtilizationPct\", \"Requests\", \"ServerErrors5xx\", \"Throttles429\", \"MeanLatencyMs\"},",
                "            Key = (s as text) as text => Text.Lower(Text.Remove(s, {\" \", \"_\", \"-\", \".\"})),",
                "            Pick = (name as text) as nullable text =>",
                "                if List.Contains(Columns, name) then name else",
                "                let Matches = List.Select(Columns, each Key(_) = Key(name))",
                "                in if List.Count(Matches) > 1 then error Error.Record(",
                "                    \"AmbiguousAzureColumn\", \"Use one canonical header per field.\", [Column=name])",
                "                    else List.First(Matches, null),",
                "            Bindings = List.Transform(Names, Pick),",
                "            Missing = List.Select(List.Positions(Names), each Bindings{_} = null),",
                "            Checked = if not List.IsEmpty(Missing) then error Error.Record(",
                "                \"AzureFeedSchema\", \"Supply every documented column; unknown values may be blank.\",",
                "                [MissingColumns=List.Transform(Missing, each Names{_})])",
                "                else Table.FromColumns(List.Transform(Bindings, each Table.Column(Raw, _)), Names),",
                "            Blanks = Table.TransformColumns(Checked, List.Transform(Names, (c) =>",
                "                {c, each if Value.Is(_, type text) and Text.Trim(_) = \"\" then null else _})),",
                "            Typed = Table.TransformColumnTypes(Blanks, {{\"SnapshotDate\", type nullable date}, {\"MetricDate\", type nullable date}, {\"SubscriptionName\", type nullable text}, {\"SubscriptionId\", type nullable text}, {\"ResourceId\", type nullable text}, {\"DeploymentId\", type nullable text}, {\"DeploymentName\", type nullable text}, {\"Application\", type nullable text}, {\"ModelName\", type nullable text}, {\"ModelVersion\", type nullable text}, {\"SkuName\", type nullable text}, {\"Region\", type nullable text}, {\"PtuCapacity\", type nullable number}, {\"MeanUtilizationPct\", type nullable number}, {\"PeakUtilizationPct\", type nullable number}, {\"Requests\", type nullable number}, {\"ServerErrors5xx\", type nullable number}, {\"Throttles429\", type nullable number}, {\"MeanLatencyMs\", type nullable number}}, \"en-US\")",
                "        in Typed",
                "in",
                "    Result"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Azure Deployments",
            "description": "Latest selected MetricDate period; latest selected SnapshotDate once per ResourceId + DeploymentId. Missing telemetry is excluded from each metric's denominator.",
            "expression": [
              "VAR MetricPeriod = MAXX(ALLSELECTED('AzureDeploymentHealth'[MetricDate]), 'AzureDeploymentHealth'[MetricDate])",
              "VAR PeriodRows =",
              "    CALCULATETABLE(",
              "        FILTER('AzureDeploymentHealth', 'AzureDeploymentHealth'[MetricDate] = MetricPeriod && NOT ISBLANK('AzureDeploymentHealth'[SnapshotDate]) && NOT ISBLANK('AzureDeploymentHealth'[ResourceId]) && NOT ISBLANK('AzureDeploymentHealth'[DeploymentId])),",
              "        REMOVEFILTERS(",
              "            'AzureDeploymentHealth'[Application],",
              "            'AzureDeploymentHealth'[DeploymentName],",
              "            'AzureDeploymentHealth'[ModelName],",
              "            'AzureDeploymentHealth'[ModelVersion],",
              "            'AzureDeploymentHealth'[SkuName],",
              "            'AzureDeploymentHealth'[Region])",
              "    )",
              "VAR LatestKeys =",
              "    SELECTCOLUMNS(",
              "        GROUPBY(",
              "            PeriodRows,",
              "            'AzureDeploymentHealth'[ResourceId],",
              "            'AzureDeploymentHealth'[DeploymentId],",
              "            \"__SnapshotDate\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SnapshotDate])),",
              "        \"ResourceId\", 'AzureDeploymentHealth'[ResourceId],",
              "        \"DeploymentId\", 'AzureDeploymentHealth'[DeploymentId],",
              "        \"SnapshotDate\", [__SnapshotDate])",
              "VAR LatestRows =",
              "    CALCULATETABLE(",
              "        FILTER('AzureDeploymentHealth', 'AzureDeploymentHealth'[MetricDate] = MetricPeriod && NOT ISBLANK('AzureDeploymentHealth'[SnapshotDate]) && NOT ISBLANK('AzureDeploymentHealth'[ResourceId]) && NOT ISBLANK('AzureDeploymentHealth'[DeploymentId])),",
              "        TREATAS(",
              "            LatestKeys,",
              "            'AzureDeploymentHealth'[ResourceId],",
              "            'AzureDeploymentHealth'[DeploymentId],",
              "            'AzureDeploymentHealth'[SnapshotDate]))",
              "VAR Snapshots = GROUPBY(LatestRows, 'AzureDeploymentHealth'[ResourceId], 'AzureDeploymentHealth'[DeploymentId],",
              "    \"__Sku\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[SkuName]),",
              "    \"__Capacity\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PtuCapacity]),",
              "    \"__Util\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanUtilizationPct]),",
              "    \"__Peak\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[PeakUtilizationPct]),",
              "    \"__Requests\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Requests]),",
              "    \"__Errors\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[ServerErrors5xx]),",
              "    \"__Throttles\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[Throttles429]),",
              "    \"__Latency\", MAXX(CURRENTGROUP(), 'AzureDeploymentHealth'[MeanLatencyMs]))",
              "RETURN COUNTROWS(Snapshots)"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "e81e1ca0-91a5-80be-2892-230cb02229ba"
          },
