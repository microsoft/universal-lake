          "(name as text) as nullable table =>",
          "\tlet",
          "\t\tMatch = Table.SelectRows(FabricSource,",
          "\t\t\teach [Schema] = \"dbo\" and [Item] = name and [Kind] = \"Table\"),",
          "\t\tResult = if Table.IsEmpty(Match) then null else Match{0}[Data]",
          "\tin",
          "\t\tResult"
        ],
        "lineageTag": "fb000001-0004-4001-8001-000000000004",
        "annotations": [
