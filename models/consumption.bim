          }
        ],
        "partitions": [
          {
            "name": "Credit Consumption (Agent)",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Raw = GetTable(\"studio_agent\"),",
                "    Normalize = ((Source as table, Specs as list, Required as list) as table =>",
                "let",
                "    Key = (s as text) as text => Text.Lower(Text.Select(s, {\"a\"..\"z\", \"A\"..\"Z\", \"0\"..\"9\"})),",
                "    Columns = List.Buffer(Table.ColumnNames(Source)),",
                "    Pick = (spec as list) as nullable text =>",
                "        let",
                "            Candidates = List.Transform({spec{0}} & spec{1}, (alias) =>",
                "                if List.Contains(Columns, alias) then {alias}",
                "                else List.Select(Columns, each Key(_) = Key(alias))),",
                "            Best = List.First(List.Select(Candidates, each not List.IsEmpty(_)), {})",
                "        in",
                "            if List.Count(Best) > 1 then error Error.Record(\"AmbiguousExportColumn\",",
                "                \"Several headers have the same priority. Keep one or use the exact canonical header.\",",
                "                [Column = spec{0}, Candidates = Best])",
                "            else List.First(Best, null),",
                "    Bindings = List.Buffer(List.Transform(Specs, each Pick(_))),",
                "    Names = List.Transform(Specs, each _{0}),",
                "    Missing = List.Select(Required, (c) => Bindings{List.PositionOf(Names, c)} = null),",
                "    Result =",
                "        if List.Count(List.Distinct(Names)) <> List.Count(Names)",
                "            or not List.IsEmpty(List.Difference(Required, Names)) then",
                "            error Error.Record(\"InvalidColumnSpecs\", \"Canonical names must be unique and required names must be specified.\", null)",
                "        else if List.Count(List.RemoveNulls(Bindings)) <> List.Count(List.Distinct(List.RemoveNulls(Bindings))) then",
                "            error Error.Record(\"OverlappingColumnAliases\", \"One input column cannot populate multiple canonical columns.\", null)",
                "        else if not List.IsEmpty(Missing) and not Table.IsEmpty(Source) then",
                "            error Error.Record(\"UnsupportedExportSchema\",",
                "                \"Required columns are missing from this row-level export.\",",
                "                [MissingColumns = Missing, AvailableColumns = Columns])",
                "        else",
                "            Value.ReplaceMetadata(Table.FromColumns(List.Transform(Bindings, (c) =>",
                "                if c = null then List.Repeat({null}, Table.RowCount(Source))",
                "                else Table.Column(Source, c)), Names),",
                "                [ColumnBindings = Record.FromList(Bindings, Names)])",
                "in",
                "    Result",
                "),",
                "    ParseExportDate = ((Values as list) as function =>",
                "let",
                "    Blank = (v as any) as logical => v = null or (Value.Is(v, type text) and Text.Trim(v) = \"\"),",
                "    Parse = (v as any, culture as text) as datetime =>",
                "        if Blank(v) then error Error.Record(\"MissingExportDate\", \"A dated row has no date.\", null)",
                "        else if Value.Is(v, type datetimezone) then DateTimeZone.RemoveZone(v)",
                "        else if Value.Is(v, type datetime) then v",
                "        else if Value.Is(v, type date) then DateTime.From(v)",
                "        else",
                "            let",
                "                s = Text.Trim(Text.From(v, \"en-US\")),",
                "                Compact = Text.Length(s) = 8 and Text.Select(s, {\"0\"..\"9\"}) = s,",
                "                Iso = Text.Length(s) >= 10 and Text.Middle(s, 4, 1) = \"-\"",
                "                    and Text.Middle(s, 7, 1) = \"-\" and Text.Select(Text.Start(s, 4), {\"0\"..\"9\"}) = Text.Start(s, 4),",
                "                Tail = if Text.Length(s) > 10 then Text.Range(s, 10) else \"\",",
                "                Zoned = Iso and (Text.EndsWith(Text.Upper(s), \"Z\") or Text.Contains(Tail, \"+\") or Text.Contains(Tail, \"-\"))",
                "            in",
                "                if Compact then #datetime(Number.FromText(Text.Start(s, 4)), Number.FromText(Text.Middle(s, 4, 2)),",
                "                    Number.FromText(Text.End(s, 2)), 0, 0, 0)",
                "                else if Value.Is(v, type number) then error Error.Record(\"InvalidExportDate\", \"Numeric dates must use yyyyMMdd, not serial dates.\", null)",
                "                else if Zoned then DateTimeZone.RemoveZone(DateTimeZone.FromText(s, [Culture = \"en-US\"]))",
                "                else DateTime.FromText(s, [Culture = if Iso then \"en-US\" else culture]),",
                "    // Try only the two supported date orders; failures are inspected, never converted to null.",
                "    Attempts = List.Buffer(List.Transform(Values, each [US = try Parse(_, \"en-US\"), GB = try Parse(_, \"en-GB\")])),",
                "    Invalid = List.AnyTrue(List.Transform(Attempts, each [US][HasError] and [GB][HasError])),",
                "    USValid = List.AllTrue(List.Transform(Attempts, each not [US][HasError])),",
                "    GBValid = List.AllTrue(List.Transform(Attempts, each not [GB][HasError])),",
                "    Same = if USValid and GBValid then List.AllTrue(List.Transform(Attempts, each [US][Value] = [GB][Value])) else false,",
                "    Culture =",
                "        if Invalid then error Error.Record(\"InvalidExportDate\", \"A date is missing or invalid. No rows were discarded.\", null)",
                "        else if not USValid and not GBValid then error Error.Record(\"MixedExportDateOrder\",",
                "            \"The column mixes day-first and month-first dates. Supply consistent dates or ISO yyyy-MM-dd.\", null)",
                "        else if USValid and GBValid and not Same then error Error.Record(\"AmbiguousExportDate\",",
                "            \"Day/month order cannot be inferred from this column. Supply ISO yyyy-MM-dd.\", null)",
                "        else if USValid then \"en-US\" else \"en-GB\",",
                "    Convert = (v as any) as datetime => Parse(v, Culture)",
                "in",
                "    Convert",
                "),",
                "    LatestSnapshot = ((Raw as nullable table, Normalize as function, ParseExportDate as function) as nullable table =>",
                "if Raw = null then null else",
                "let",
                "    Snapshot = Normalize(Raw, {{\"snapshot_month\", {\"Snapshot Month\", \"SnapshotMonth\"}}}, {}),",
                "    Binding = Value.Metadata(Snapshot)[ColumnBindings][snapshot_month],",
                "    MonthValue = (v as any) as any =>",
                "        if not Value.Is(v, type text) and not Value.Is(v, type number) then v else",
                "        let",
                "            s = Text.Trim(Text.From(v, \"en-US\")),",
                "            Parts = Text.Split(s, \"-\"),",
                "            Compact = Text.Length(s) = 6 and Text.Select(s, {\"0\"..\"9\"}) = s",
                "        in",
                "            if Compact then #date(Number.FromText(Text.Start(s, 4)), Number.FromText(Text.End(s, 2)), 1)",
                "            else if List.Count(Parts) = 2 and Text.Length(Parts{0}) = 4",
                "                and Text.Select(Parts{0} & Parts{1}, {\"0\"..\"9\"}) = Parts{0} & Parts{1}",
                "                then #date(Number.FromText(Parts{0}), Number.FromText(Parts{1}), 1)",
                "            else v,",
                "    Snapshots = if Binding = null then {} else List.Buffer(Table.Column(Table.Distinct(Table.SelectColumns(Raw, {Binding})), Binding)), Values = List.Buffer(List.Transform(Snapshots, MonthValue)), // only the distinct snapshot values decide the newest month; this folds to SELECT DISTINCT",
                "    ReadDate = ParseExportDate(Values),",
                "    Months = List.Buffer(List.Transform(Values, each Date.StartOfMonth(Date.From(ReadDate(_))))),",
                "    LastMonth = List.Max(Months),",
                "    // Force every snapshot value before filtering, including invalid/blank older metadata. A blank in any row still arrives here, because a blank is its own distinct value.",
                "    CheckedMonth = if List.NonNullCount(Months) = List.Count(Months) then LastMonth",
                "        else error Error.Record(\"InvalidSnapshotMonth\", \"Every row must identify its snapshot month.\", null),",
                "    KeepValues = List.Buffer(List.Transform(List.Select(List.Positions(Months), each Months{_} = CheckedMonth), each Snapshots{_})), // raw values that parse to the newest month",
                "    Result = if Binding = null or Table.IsEmpty(Raw) then Raw else",
                "        Table.SelectRows(Raw, each List.Contains(KeepValues, Record.Field(_, Binding)))",
                "in",
                "    Result",
                "),",
                "    Latest = LatestSnapshot(Raw, Normalize, ParseExportDate),",
                "    Specs = {",
                "        {\"Agent_Name\", {\"Agent Name\", \"AgentName\"}}, {\"Agent_Id\", {\"Agent Id\", \"AgentId\"}},",
                "        {\"Product\", {}},",
                "        {\"Billable_Feature\", {\"AI Feature/Billable Feature\", \"Billable Feature\", \"AI Feature\", \"Feature\"}},",
                "        {\"Billed_credit\", {\"Billed credit\", \"Billed Credits\", \"Billable credits\"}},",
                "        {\"Non_billed_credit\", {\"Non-billed credit\", \"Non-billed credits\", \"Nonbillable credits\"}},",
                "        {\"Channel\", {}}, {\"Knowledge_Sources\", {\"Knowledge Sources\"}}, {\"Tool_Used\", {\"Tool Used\"}},",
                "        {\"LLM_Model\", {\"LLM Model\", \"Model\", \"Model Name\"}}, {\"Scenario_Name\", {\"Scenario Name\"}},",
                "        {\"Environment_Id\", {\"Environment Id\"}}, {\"Environment_Name\", {\"Environment Name\"}}",
                "    },",
                "    Named = Normalize(if Latest = null then #table({}, {}) else Latest, Specs, {\"Billed_credit\"}),",
                "    Numbers = {\"Billed_credit\", \"Non_billed_credit\"},",
                "    Textual = Table.TransformColumns(Named, List.Transform(List.Difference(Table.ColumnNames(Named), Numbers), (c) =>",
                "        {c, each if _ = null then null else Text.Trim(Text.From(_)), type nullable text})),",
                "    HasIdentity = (r as record) as logical =>",
                "        List.AnyTrue(List.Transform({r[Agent_Id], r[Agent_Name]}, each _ <> null and _ <> \"\")),",
                "    Identified = if List.AllTrue(List.Transform(Table.ToRecords(Textual), HasIdentity)) then Textual",
                "        else error Error.Record(\"MissingAgentIdentity\", \"Each row requires an Agent Id or Agent Name; no identity is inferred.\", null),",
                "    Numeric = Table.TransformColumns(Identified, List.Transform(Numbers, (c) =>",
                "        {c, each if _ = null or Text.Trim(Text.From(_)) = \"\" then",
                "            null",
                "        else if Value.Is(_, type number) then _ else Number.FromText(Text.Trim(Text.From(_)), \"en-US\"), type nullable number})),",
                "    Final = Table.TransformColumns(Numeric, List.Transform(",
                "        {\"LLM_Model\", \"Billable_Feature\", \"Product\", \"Channel\", \"Environment_Name\"}, (c) =>",
                "        {c, each if _ = null or _ = \"\" then \"Not provided\" else _, type text}))",
                "in",
                "    Final"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Billed Credits",
            "description": "Credits the customer is actually charged for.",
            "expression": "SUM('Credit Consumption (Agent)'[Billed_credit])",
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0001ag-meas-0001-000000000001"
          },
          {
            "name": "Total Non-Billed Credits",
            "description": "Credits consumed inside entitlement and therefore not charged.",
            "expression": "SUM('Credit Consumption (Agent)'[Non_billed_credit])",
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0001ag-meas-0001-000000000002"
          },
          {
            "name": "Studio Consumed Credits (Agent)",
            "expression": "[Total Billed Credits] + [Total Non-Billed Credits]",
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0001ag-meas-0001-000000000003"
          },
          {
            "name": "Billing Agents with Credits",
            "description": "Distinct agents appearing in the billing actuals.",
            "expression": [
              "VAR AgentNames =",
              "    DISTINCT(UNION(",
              "        SELECTCOLUMNS(FILTER('Credit Consumption (Agent)', [Studio Consumed Credits (Agent)] > 0),",
              "            \"Agent\", 'Credit Consumption (Agent)'[Agent_Name]),",
              "        SELECTCOLUMNS(FILTER('Credit Consumption (User)', 'Credit Consumption (User)'[Credits_used] > 0),",
              "            \"Agent\", 'Credit Consumption (User)'[Agent_Name])))",
              "RETURN COUNTROWS(FILTER(AgentNames, NOT ISBLANK([Agent]) && [Agent] <> \"\"))"
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0001ag-meas-agentcnt0001"
          },
          {
            "name": "Avg Credits per Agent (Billing)",
            "expression": "DIVIDE( [Studio Consumed Credits (Agent)], [Billing Agents with Credits] )",
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0001ag-meas-avgagent0001"
          },
          {
            "name": "Agent Credit Share %",
            "description": "This agent's share of all consumed Studio credits in the current view.",
            "expression": [
              "",
              "// Must clear the Agent Bridge as well as the fact table: the visual groups by",
              "// the bridge, so filtering only the fact table leaves the denominator scoped",
              "// to a single agent and every share reads near 100%.",
              "DIVIDE(",
              "    [Studio Consumed Credits (Agent)],",
              "    CALCULATE(",
              "        [Studio Consumed Credits (Agent)],",
              "        ALLSELECTED( 'Credit Consumption (Agent)' ),",
              "        ALLSELECTED( 'Agent Bridge' )",
              "    )",
              ")",
              ""
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0001ag-meas-share00001"
          },
          {
            "name": "Billable Credit Cost (Agent)",
            "expression": "[Total Billed Credits] * [Studio PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0001ag-meas-cost000001"
          },
          {
            "name": "Billed Credit Ratio",
            "description": [
              "The share of an agent's credits that were chargeable. High is not",
              "necessarily bad - it means the agent's work falls outside what prepaid",
              "capacity covers. Shown as \"Charged %\"."
            ],
            "expression": "DIVIDE( [Total Billed Credits], [Studio Consumed Credits (Agent)] )",
            "formatString": "0.0%",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0001ag-meas-ratio00001"
          },
          {
            "name": "Entitlement Absorbed %",
            "description": [
              "The share of an agent's credits covered by prepaid capacity, so they never",
              "reached a bill. Shown as \"Covered, not charged\"."
            ],
            "expression": "DIVIDE( [Total Non-Billed Credits], [Studio Consumed Credits (Agent)] )",
            "formatString": "0.0%",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0001ag-opt0-0001-000000000001"
          },
          {
            "name": "Cost per Consumed Credit",
            "description": [
              "Average cost of every credit an agent consumes, billed or not. Reveals",
              "which agents are genuinely expensive rather than merely busy."
            ],
            "expression": "DIVIDE( [Billable Credit Cost (Agent)], [Studio Consumed Credits (Agent)] )",
            "formatString": "\\$#,0.0000",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0001ag-opt0-0001-000000000002"
          },
          {
            "name": "Features Used",
            "description": [
              "Distinct billable features an agent draws on. Breadth here usually means",
              "a richer agent, and a more expensive one."
            ],
            "expression": "DISTINCTCOUNT('Credit Consumption (Agent)'[Billable_Feature])",
            "formatString": "#,0",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0001ag-opt0-0001-000000000003"
          },
          {
            "name": "Agent Action",
            "description": [
              "Recommended action for an agent, combining how much it consumes with how",
              "much of that consumption is actually chargeable.",
              "",
              "These labels must stay character-identical to 'Agent Action Group'[Action],",
              "which the Agents by Recommended Action chart matches against."
            ],
            "expression": [
              "",
              "VAR Consumed = [Studio Consumed Credits (Agent)]",
              "VAR Billed   = [Total Billed Credits]",
              "VAR Ratio    = DIVIDE( Billed, Consumed )",
              "VAR Share    = [Agent Credit Share %]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(Consumed) || Consumed = 0, \"5. Unused - retire or promote\",",
              "        Share >= 0.25 && Ratio >= 0.5,     \"1. Review - high volume, mostly billed\",",
              "        Ratio >= 0.75,                     \"2. Investigate - almost all billed\",",
              "        Share >= 0.25,                     \"3. Monitor - high volume, well covered\",",
              "        // residual bucket: under a quarter of tenant consumption and under",
              "        // three quarters billed, so neither big enough nor exposed enough",
              "        // to be worth acting on",
              "        \"4. Healthy - low volume, no action needed\"",
              "    )",
              ""
            ],
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0001ag-opt0-0001-000000000004"
          },
          {
            "name": "Agents with No Consumption",
            "description": [
              "Agents present in the export that consumed nothing at all - typically",
              "built and then abandoned."
            ],
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES('Credit Consumption (Agent)'[Agent_Name]),",
              "        CALCULATE( [Studio Consumed Credits (Agent)] ) = 0",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0001ag-opt0-0001-000000000005"
          },
          {
            "name": "Projected Cost by Agent (30d)",
            "description": [
              "This agent's slice of the projected 30-day cost.",
              "",
              "The per-agent export carries no date, so an agent cannot have its own run",
              "rate. This allocates the tenant projection by the agent's share of",
              "consumption instead, which assumes the mix between agents holds. Fine for",
              "sizing, wrong for an agent that is ramping or being retired."
            ],
            "expression": "[Projected Cost (30d)] * [Agent Credit Share %]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "dc86a469-a7b7-443f-b95f-eeb0bad5e0ae"
          },
          {
            "name": "Projected Cost by Agent (12mo)",
            "description": [
              "This agent's slice of the projected twelve-month cost, allocated by its",
              "share of consumption. Same assumption as the 30-day version: the mix",
              "between agents is taken to hold."
            ],
            "expression": "[Studio Year Cost] * [Agent Credit Share %]",
            "formatString": "\\$#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "ddd77762-fd3b-4b7e-9362-6f9bfe079e73"
          },
          {
            "name": "Agent Rows Without Credits",
            "description": [
              "Agent rows the export carried with no credit figures at all. These are agents with no",
              "billable activity in the period, not an error, but they add empty categories to the",
              "model and feature breakdowns, so the count is stated rather than hidden."
            ],
            "expression": "COUNTROWS(FILTER('Credit Consumption (Agent)', ISBLANK('Credit Consumption (Agent)'[Billed_credit]) && ISBLANK('Credit Consumption (Agent)'[Non_billed_credit])))",
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "c163cf90-4fa7-4413-ad07-361a15587fd9"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Credit Consumption (User)",
        "lineageTag": "cc0002us-0001-0001-0001-000000000001",
        "columns": [
          {
            "name": "User_Id",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "User_Id",
            "lineageTag": "cc0002us-col0-0001-000000000001",
            "summarizeBy": "none"
          },
          {
            "name": "User_Email",
            "dataType": "string",
            "sourceColumn": "User_Email",
            "lineageTag": "cc0002us-col0-0001-000000000002",
            "summarizeBy": "none"
          },
          {
            "name": "Agent_Id",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Agent_Id",
            "lineageTag": "cc0002us-col0-0001-000000000003",
            "summarizeBy": "none"
          },
          {
            "name": "Agent_Name",
            "dataType": "string",
            "sourceColumn": "Agent_Name",
            "lineageTag": "cc0002us-col0-0001-000000000004",
            "summarizeBy": "none"
          },
          {
            "name": "Billable_credit_used",
            "dataType": "double",
            "sourceColumn": "Billable_credit_used",
            "formatString": "#,0",
            "lineageTag": "cc0002us-col0-0001-000000000005",
            "summarizeBy": "sum"
          },
          {
            "name": "Credits_used",
            "dataType": "double",
            "sourceColumn": "Credits_used",
            "formatString": "#,0",
            "lineageTag": "cc0002us-col0-0001-000000000006",
            "summarizeBy": "sum"
          },
          {
            "name": "M365_Copilot_Licensed",
            "dataType": "boolean",
            "sourceColumn": "M365_Copilot_Licensed",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "cc0002us-col0-0001-000000000007",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "User Name",
            "dataType": "string",
            "description": "Everything before the @ in the user's email, for display where the full address would crowd a visual.",
            "expression": [
              "",
              "VAR Email = 'Credit Consumption (User)'[User_Email]",
              "VAR AtPos = SEARCH( \"@\", Email, 1, 0 )",
              "RETURN IF( AtPos > 1, LEFT( Email, AtPos - 1 ), Email )",
              ""
            ],
            "lineageTag": "cc0002us-col0-0001-000000000008",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Credit Consumption (User)",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Raw = GetTable(\"studio_user\"),",
                "    Normalize = ((Source as table, Specs as list, Required as list) as table =>",
                "let",
                "    Key = (s as text) as text => Text.Lower(Text.Select(s, {\"a\"..\"z\", \"A\"..\"Z\", \"0\"..\"9\"})),",
                "    Columns = List.Buffer(Table.ColumnNames(Source)),",
                "    Pick = (spec as list) as nullable text =>",
                "        let",
                "            Candidates = List.Transform({spec{0}} & spec{1}, (alias) =>",
                "                if List.Contains(Columns, alias) then {alias}",
                "                else List.Select(Columns, each Key(_) = Key(alias))),",
                "            Best = List.First(List.Select(Candidates, each not List.IsEmpty(_)), {})",
                "        in",
                "            if List.Count(Best) > 1 then error Error.Record(\"AmbiguousExportColumn\",",
                "                \"Several headers have the same priority. Keep one or use the exact canonical header.\",",
                "                [Column = spec{0}, Candidates = Best])",
                "            else List.First(Best, null),",
                "    Bindings = List.Buffer(List.Transform(Specs, each Pick(_))),",
                "    Names = List.Transform(Specs, each _{0}),",
                "    Missing = List.Select(Required, (c) => Bindings{List.PositionOf(Names, c)} = null),",
                "    Result =",
                "        if List.Count(List.Distinct(Names)) <> List.Count(Names)",
                "            or not List.IsEmpty(List.Difference(Required, Names)) then",
                "            error Error.Record(\"InvalidColumnSpecs\", \"Canonical names must be unique and required names must be specified.\", null)",
                "        else if List.Count(List.RemoveNulls(Bindings)) <> List.Count(List.Distinct(List.RemoveNulls(Bindings))) then",
                "            error Error.Record(\"OverlappingColumnAliases\", \"One input column cannot populate multiple canonical columns.\", null)",
                "        else if not List.IsEmpty(Missing) and not Table.IsEmpty(Source) then",
                "            error Error.Record(\"UnsupportedExportSchema\",",
                "                \"Required columns are missing from this row-level export.\",",
                "                [MissingColumns = Missing, AvailableColumns = Columns])",
                "        else",
                "            Value.ReplaceMetadata(Table.FromColumns(List.Transform(Bindings, (c) =>",
                "                if c = null then List.Repeat({null}, Table.RowCount(Source))",
                "                else Table.Column(Source, c)), Names),",
                "                [ColumnBindings = Record.FromList(Bindings, Names)])",
                "in",
                "    Result",
                "),",
                "    ParseExportDate = ((Values as list) as function =>",
                "let",
                "    Blank = (v as any) as logical => v = null or (Value.Is(v, type text) and Text.Trim(v) = \"\"),",
                "    Parse = (v as any, culture as text) as datetime =>",
                "        if Blank(v) then error Error.Record(\"MissingExportDate\", \"A dated row has no date.\", null)",
                "        else if Value.Is(v, type datetimezone) then DateTimeZone.RemoveZone(v)",
                "        else if Value.Is(v, type datetime) then v",
                "        else if Value.Is(v, type date) then DateTime.From(v)",
                "        else",
                "            let",
                "                s = Text.Trim(Text.From(v, \"en-US\")),",
                "                Compact = Text.Length(s) = 8 and Text.Select(s, {\"0\"..\"9\"}) = s,",
                "                Iso = Text.Length(s) >= 10 and Text.Middle(s, 4, 1) = \"-\"",
                "                    and Text.Middle(s, 7, 1) = \"-\" and Text.Select(Text.Start(s, 4), {\"0\"..\"9\"}) = Text.Start(s, 4),",
                "                Tail = if Text.Length(s) > 10 then Text.Range(s, 10) else \"\",",
                "                Zoned = Iso and (Text.EndsWith(Text.Upper(s), \"Z\") or Text.Contains(Tail, \"+\") or Text.Contains(Tail, \"-\"))",
                "            in",
                "                if Compact then #datetime(Number.FromText(Text.Start(s, 4)), Number.FromText(Text.Middle(s, 4, 2)),",
                "                    Number.FromText(Text.End(s, 2)), 0, 0, 0)",
                "                else if Value.Is(v, type number) then error Error.Record(\"InvalidExportDate\", \"Numeric dates must use yyyyMMdd, not serial dates.\", null)",
                "                else if Zoned then DateTimeZone.RemoveZone(DateTimeZone.FromText(s, [Culture = \"en-US\"]))",
                "                else DateTime.FromText(s, [Culture = if Iso then \"en-US\" else culture]),",
                "    // Try only the two supported date orders; failures are inspected, never converted to null.",
                "    Attempts = List.Buffer(List.Transform(Values, each [US = try Parse(_, \"en-US\"), GB = try Parse(_, \"en-GB\")])),",
                "    Invalid = List.AnyTrue(List.Transform(Attempts, each [US][HasError] and [GB][HasError])),",
                "    USValid = List.AllTrue(List.Transform(Attempts, each not [US][HasError])),",
                "    GBValid = List.AllTrue(List.Transform(Attempts, each not [GB][HasError])),",
                "    Same = if USValid and GBValid then List.AllTrue(List.Transform(Attempts, each [US][Value] = [GB][Value])) else false,",
                "    Culture =",
                "        if Invalid then error Error.Record(\"InvalidExportDate\", \"A date is missing or invalid. No rows were discarded.\", null)",
                "        else if not USValid and not GBValid then error Error.Record(\"MixedExportDateOrder\",",
                "            \"The column mixes day-first and month-first dates. Supply consistent dates or ISO yyyy-MM-dd.\", null)",
                "        else if USValid and GBValid and not Same then error Error.Record(\"AmbiguousExportDate\",",
                "            \"Day/month order cannot be inferred from this column. Supply ISO yyyy-MM-dd.\", null)",
                "        else if USValid then \"en-US\" else \"en-GB\",",
                "    Convert = (v as any) as datetime => Parse(v, Culture)",
                "in",
                "    Convert",
                "),",
                "    LatestSnapshot = ((Raw as nullable table, Normalize as function, ParseExportDate as function) as nullable table =>",
                "if Raw = null then null else",
                "let",
                "    Snapshot = Normalize(Raw, {{\"snapshot_month\", {\"Snapshot Month\", \"SnapshotMonth\"}}}, {}),",
                "    Binding = Value.Metadata(Snapshot)[ColumnBindings][snapshot_month],",
                "    MonthValue = (v as any) as any =>",
                "        if not Value.Is(v, type text) and not Value.Is(v, type number) then v else",
                "        let",
                "            s = Text.Trim(Text.From(v, \"en-US\")),",
                "            Parts = Text.Split(s, \"-\"),",
                "            Compact = Text.Length(s) = 6 and Text.Select(s, {\"0\"..\"9\"}) = s",
                "        in",
                "            if Compact then #date(Number.FromText(Text.Start(s, 4)), Number.FromText(Text.End(s, 2)), 1)",
                "            else if List.Count(Parts) = 2 and Text.Length(Parts{0}) = 4",
                "                and Text.Select(Parts{0} & Parts{1}, {\"0\"..\"9\"}) = Parts{0} & Parts{1}",
                "                then #date(Number.FromText(Parts{0}), Number.FromText(Parts{1}), 1)",
                "            else v,",
                "    Snapshots = if Binding = null then {} else List.Buffer(Table.Column(Table.Distinct(Table.SelectColumns(Raw, {Binding})), Binding)), Values = List.Buffer(List.Transform(Snapshots, MonthValue)), // only the distinct snapshot values decide the newest month; this folds to SELECT DISTINCT",
                "    ReadDate = ParseExportDate(Values),",
                "    Months = List.Buffer(List.Transform(Values, each Date.StartOfMonth(Date.From(ReadDate(_))))),",
                "    LastMonth = List.Max(Months),",
                "    // Force every snapshot value before filtering, including invalid/blank older metadata. A blank in any row still arrives here, because a blank is its own distinct value.",
                "    CheckedMonth = if List.NonNullCount(Months) = List.Count(Months) then LastMonth",
                "        else error Error.Record(\"InvalidSnapshotMonth\", \"Every row must identify its snapshot month.\", null),",
                "    KeepValues = List.Buffer(List.Transform(List.Select(List.Positions(Months), each Months{_} = CheckedMonth), each Snapshots{_})), // raw values that parse to the newest month",
                "    Result = if Binding = null or Table.IsEmpty(Raw) then Raw else",
                "        Table.SelectRows(Raw, each List.Contains(KeepValues, Record.Field(_, Binding)))",
                "in",
                "    Result",
                "),",
                "    Latest = LatestSnapshot(Raw, Normalize, ParseExportDate),",
                "    Specs = {",
                "        {\"User_Id\", {\"User Id\"}}, {\"User_Email\", {\"User Email\", \"UserPrincipalName\", \"UPN\"}},",
                "        {\"Agent_Id\", {\"Agent Id\"}}, {\"Agent_Name\", {\"Agent Name\"}},",
                "        {\"Billable_credit_used\", {\"Billable credit used\", \"Billable credits used\"}},",
                "        {\"Credits_used\", {\"Credits used\", \"Credit used\"}},",
                "        {\"M365_Copilot_Licensed\", {\"M365 Copilot Licensed\"}}",
                "    },",
                "    Named = Normalize(if Latest = null then #table({}, {}) else Latest, Specs, {\"Billable_credit_used\"}),",
                "    Textual = Table.TransformColumns(Named, List.Transform({\"User_Id\", \"User_Email\", \"Agent_Id\", \"Agent_Name\"}, (c) =>",
                "        {c, each if _ = null then null else Text.Trim(Text.From(_)), type nullable text})),",
                "    HasIdentity = (r as record) as logical =>",
                "        List.AnyTrue(List.Transform({r[User_Id], r[User_Email]}, each _ <> null and _ <> \"\")),",
                "    Identified = if List.AllTrue(List.Transform(Table.ToRecords(Textual), HasIdentity)) then Textual",
                "        else error Error.Record(\"MissingUserIdentity\", \"Each row requires a User Id or User Email; no identity is inferred.\", null),",
                "    Numeric = Table.TransformColumns(Identified, List.Transform({\"Billable_credit_used\", \"Credits_used\"}, (c) =>",
                "        {c, each if _ = null or Text.Trim(Text.From(_)) = \"\" then",
                "            null",
                "        else if Value.Is(_, type number) then _ else Number.FromText(Text.Trim(Text.From(_)), \"en-US\"), type nullable number})),",
                "    Final = Table.TransformColumns(Numeric, {",
                "        {\"User_Email\", each if _ = null then null else Text.Lower(_), type nullable text},",
                "        {\"M365_Copilot_Licensed\", each if _ = null or Text.Trim(Text.From(_)) = \"\" then null",
                "            else if Value.Is(_, type logical) then _",
                "            else if List.Contains({\"true\",\"yes\",\"1\"}, Text.Lower(Text.Trim(Text.From(_)))) then true",
                "            else if List.Contains({\"false\",\"no\",\"0\"}, Text.Lower(Text.Trim(Text.From(_)))) then false",
                "            else error Error.Record(\"InvalidLicenceFlag\", \"Expected true/false or yes/no.\", null), type nullable logical}",
                "    })",
                "in",
                "    Final"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Studio Total Credits Used",
            "description": "All credits used across users, billable or not.",
            "expression": "SUM('Credit Consumption (User)'[Credits_used])",
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0002us-meas-0001-000000000001"
          },
          {
            "name": "Total Billable Credits Used",
            "description": "The chargeable portion of user consumption.",
            "expression": "SUM('Credit Consumption (User)'[Billable_credit_used])",
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0002us-meas-0001-000000000002"
          },
          {
            "name": "Billing Active Users",
            "description": "Distinct people who consumed at least one Studio credit.",
            "expression": "DISTINCTCOUNT('Credit Consumption (User)'[User_Email])",
            "formatString": "#,0",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0002us-meas-0001-000000000003"
          },
          {
            "name": "Studio Avg Credits per User",
            "expression": "DIVIDE( [Studio Total Credits Used], [Billing Active Users] )",
            "formatString": "#,0.00",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0002us-meas-0001-000000000004"
          },
          {
            "name": "User Credit Share %",
            "description": "This user's share of all Studio credits in the current view.",
            "expression": [
              "",
              "// Clears the Agent Bridge too, so the denominator stays the whole selection",
              "// even when the visual is grouped by a bridged dimension.",
              "DIVIDE(",
              "    [Studio Total Credits Used],",
              "    CALCULATE(",
              "        [Studio Total Credits Used],",
              "        ALLSELECTED( 'Credit Consumption (User)' ),",
              "        ALLSELECTED( 'Agent Bridge' )",
              "    )",
              ")",
              ""
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0002us-meas-orgshare0001"
          },
          {
            "name": "Billable Credit Cost (User)",
            "expression": "[Total Billable Credits Used] * [Studio PAYG Rate Value]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "cc0002us-meas-cost000001"
          },
          {
            "name": "Studio Users with Copilot Licence",
            "description": "Studio users who also hold a Microsoft 365 Copilot licence.",
            "expression": [
              "",
              "CALCULATE(",
              "    [Billing Active Users],",
              "    'Credit Consumption (User)'[M365_Copilot_Licensed] = TRUE()",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Adoption",
            "lineageTag": "cc0002us-meas-lic0000001"
          },
          {
            "name": "% Studio Users Licensed",
            "expression": "DIVIDE( [Studio Users with Copilot Licence], [Billing Active Users] )",
            "formatString": "0.0%",
            "displayFolder": "Studio\\Adoption",
            "lineageTag": "cc0002us-meas-licpct0001"
          },
          {
            "name": "Avg Agents per User",
            "description": "Agents touched per user - a breadth-of-adoption signal within Studio.",
            "expression": [
              "",
              "DIVIDE(",
              "    COUNTROWS( SUMMARIZE( 'Credit Consumption (User)', 'Credit Consumption (User)'[User_Email], 'Credit Consumption (User)'[Agent_Name] ) ),",
              "    [Billing Active Users]",
              ")",
              ""
            ],
            "formatString": "#,0.0",
            "displayFolder": "Studio\\Adoption",
            "lineageTag": "cc0002us-meas-agtperusr1"
          },
          {
            "name": "Unlicensed Credits",
            "description": [
              "Studio credits consumed by people who hold no M365 Copilot licence.",
              "Worth knowing: it is demand that a licence purchase would not remove."
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    [Studio Total Credits Used],",
              "    'Credit Consumption (User)'[M365_Copilot_Licensed] = FALSE()",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0002us-opt0-0001-000000000001"
          },
          {
            "name": "Unlicensed Credit Share %",
            "expression": "DIVIDE( [Unlicensed Credits], [Studio Total Credits Used] )",
            "formatString": "0.0%",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0002us-opt0-0001-000000000002"
          },
          {
            "name": "Cost per Studio User",
            "description": "Studio cost attributable to each consuming person.",
            "expression": "DIVIDE( [Billable Credit Cost (User)], [Billing Active Users] )",
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0002us-opt0-0001-000000000003"
          },
          {
            "name": "Studio Top 10% Share",
            "description": [
              "Share of Studio credits used by the heaviest 10% of users. Studio",
              "adoption is usually far more concentrated than Cowork."
            ],
            "expression": [
              "",
              "VAR n = [Billing Active Users]",
              "VAR k = MAX( 1, ROUND( n * 0.10, 0 ) )",
              "VAR t = ADDCOLUMNS( VALUES('Credit Consumption (User)'[User_Email]), \"@c\", [Studio Total Credits Used] )",
              "RETURN DIVIDE( SUMX( TOPN( k, t, [@c], DESC ), [@c] ), [Studio Total Credits Used] )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0002us-opt0-0001-000000000004"
          },
          {
            "name": "Studio Concentration Summary",
            "description": "Plain-language reading of how concentrated Studio usage is.",
            "expression": [
              "",
              "VAR s = [Studio Top 10% Share]",
              "RETURN",
              "    IF(",
              "        ISBLANK(s),",
              "        BLANK(),",
              "        \"Top 10% of users: \" & FORMAT( s, \"0%\" ) & \" of credits\"",
              "    )",
              ""
            ],
            "displayFolder": "Studio\\Optimisation",
            "lineageTag": "cc0002us-opt0-0001-000000000005"
          },
          {
            "name": "Org Match Rate",
            "description": [
              "Share of Studio users that resolve to a record in the org dimension.",
              "Studio reports a work email and the org export a UPN; in most tenants",
              "these are the same string, but they need not be. A low figure here means",
              "slicing Studio by department will silently drop people."
            ],
            "expression": [
              "",
              "VAR StudioPeople = VALUES( 'Credit Consumption (User)'[User_Email] )",
              "VAR Matched =",
              "    COUNTROWS(",
              "        INTERSECT( StudioPeople, VALUES( 'Org'[UserPrincipalName] ) )",
              "    )",
              "RETURN DIVIDE( Matched + 0, COUNTROWS( StudioPeople ) )",
              ""
            ],
            "formatString": "0%",
            "displayFolder": "Studio\\Adoption",
            "lineageTag": "8f660002-0001-4001-8001-000000000001"
          },
          {
            "name": "Org Filter Status",
            "description": [
              "Plain statement of whether the Group By control will reach the Studio",
              "figures on this page, and which grains it cannot reach."
            ],
            "expression": [
              "",
              "VAR Rate = [Org Match Rate]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK( Rate ) || Rate = 0,",
              "            \"Studio users do not match the org directory, so Group By does not apply on this page.\",",
              "        Rate < 0.9,",
              "            FORMAT( Rate, \"0%\" ) & \" of Studio users match the org directory - Group By covers only those. Agent and environment figures carry no person, so they stay unfiltered.\",",
              "        \"Group By filters the user figures on this page. Agent and environment figures carry no person in the export, so they stay unfiltered.\"",
              "    )",
              ""
            ],
            "displayFolder": "Studio\\Adoption",
            "lineageTag": "8f660002-0002-4001-8001-000000000002"
          },
          {
            "name": "Projected Cost by Group (30d)",
            "description": [
              "This group's slice of the projected 30-day cost.",
              "",
              "The per-user export carries no date, so this allocates the tenant",
              "projection by the group's share of user-attributed consumption. Only covers",
              "credits that reached a named user - agent and environment activity with no",
              "person attached is not in the share, so these will not sum to the tenant",
              "total."
            ],
            "expression": "[Projected Cost (30d)] * [Group Credit Share %]",
            "formatString": "\\$#,0.00",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "9c618268-6aa0-4718-8ee8-c0a0961335aa"
          },
          {
            "name": "Projected Cost by Group (12mo)",
            "description": [
              "This group's slice of the projected twelve-month cost, allocated by its",
              "share of user-attributed consumption."
            ],
            "expression": "[Studio Year Cost] * [Group Credit Share %]",
            "formatString": "\\$#,0",
            "displayFolder": "Studio\\Forecast",
            "lineageTag": "ec136472-6eb6-4023-9c83-c54dfaa7a47c"
          },
          {
            "name": "Group Credit Share %",
            "description": [
              "This group's share of user-attributed Studio credits.",
              "",
              "Separate from User Credit Share % because the denominator has to clear the",
              "Group By and Org tables too. A visual grouped by Group By[Group] filters",
              "through Org, so clearing only the fact table leaves the denominator scoped",
              "to the group and every share reads 100%."
            ],
            "expression": [
              "",
              "DIVIDE(",
              "    [Studio Total Credits Used],",
              "    CALCULATE(",
              "        [Studio Total Credits Used],",
              "        ALLSELECTED( 'Credit Consumption (User)' ),",
              "        ALLSELECTED( 'Agent Bridge' ),",
              "        ALLSELECTED( 'Group By' ),",
              "        ALLSELECTED( 'Org' )",
              "    )",
              ")",
              ""
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Studio\\Billing",
            "lineageTag": "2526456a-4d11-4a2f-b28b-f0a1250eec2d"
          },
          {
            "name": "Studio Credits /mo",
            "description": [
              "Copilot Studio credits normalised to a month, from the days observed.",
              "",
              "Covers only credits attributed to a named user - the agent and environment",
              "exports carry no person, so this is a floor rather than the whole picture."
            ],
            "expression": [
              "",
              "VAR ObservedDays = [Studio Days Observed]",
              "RETURN DIVIDE( [Studio Total Credits Used] * 30, ObservedDays )",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "All products",
            "lineageTag": "f026e779-336a-4106-8db3-7a39c235a66b"
          },
          {
            "name": "Studio Cost /mo",
            "description": [
              "Copilot Studio cost normalised to a month, for credits attributed to a",
              "named user."
            ],
            "expression": [
              "",
              "VAR ObservedDays = [Studio Days Observed]",
              "RETURN DIVIDE( [Billable Credit Cost (User)] * 30, ObservedDays )",
              ""
            ],
            "formatString": "\\$#,0",
            "displayFolder": "All products",
            "lineageTag": "93c10f77-c08c-4d74-b2db-bbb5b0f012c2"
          },
          {
            "name": "User Rows Without Credits",
            "description": [
              "User rows the export carried with no credit figures at all. Counted rather than dropped,",
              "so a partly empty export is visible instead of quietly shrinking the user list."
            ],
            "expression": "COUNTROWS(FILTER('Credit Consumption (User)', ISBLANK('Credit Consumption (User)'[Billable_credit_used]) && ISBLANK('Credit Consumption (User)'[Credits_used])))",
            "formatString": "#,0",
            "displayFolder": "Reporting consistency",
            "lineageTag": "b650a6ca-ff8c-4fbb-9c2d-10e00969a446"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Agent Bridge",
        "description": [
          "Distinct agent list spanning both Studio fact tables, so a single agent",
          "slicer filters the per-agent and per-user views together. Built from the",
          "union of both exports because an agent can appear in one but not the other."
        ],
        "lineageTag": "cc0005ab-0001-0001-0001-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Agent Name",
            "dataType": "string",
            "isNameInferred": false,
            "isKey": true,
            "sourceColumn": "[Agent Name]",
            "lineageTag": "cc0005ab-col0-0001-000000000001",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Agent Bridge",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "\t\t\t\t// A blank name would break the isKey on this column and put the",
                "// whole table into an invalid state, taking every visual that",
                "// touches it with it. PPAC leaves the name blank for Power",
                "// Automate flows, so this is routine rather than exceptional.",
                "// Those rows stay in the fact table and in every total - they",
                "// are just not selectable here, which a blank never was.",
                "FILTER(",
                "    DISTINCT(",
                "",
                "    UNION(",
                "    SELECTCOLUMNS( 'Credit Consumption (Agent)', \"Agent Name\", 'Credit Consumption (Agent)'[Agent_Name] ),",
                "    SELECTCOLUMNS( 'Credit Consumption (User)',  \"Agent Name\", 'Credit Consumption (User)'[Agent_Name] )",
                "    )",
                "",
                "    ),",
                "    NOT ISBLANK( [Agent Name] )",
                ")",
                ""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Agents without User Activity",
            "description": [
              "Agents present in the per-agent export but with no recorded user",
              "activity - typically system or orchestration agents."
            ],
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES('Agent Bridge'[Agent Name]),",
              "        ISBLANK( CALCULATE( [Studio Total Credits Used] ) )",
              "            && NOT ISBLANK( CALCULATE( [Studio Consumed Credits (Agent)] ) )",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Studio\\Adoption",
            "lineageTag": "cc0005ab-meas-0001-000000000001"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "AgentBridgeCreditLensViva"
          }
        ]
      },
      {
        "name": "Studio Environment",
        "description": [
          "Distinct Power Platform environments across the Studio exports, so one",
          "environment slicer filters tenant, agent and user views consistently."
        ],
        "lineageTag": "cc0006ev-0001-0001-0001-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Environment Name",
            "dataType": "string",
            "isNameInferred": false,
            "isKey": true,
            "sourceColumn": "[Environment Name]",
            "lineageTag": "cc0006ev-col0-0001-000000000001",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Studio Environment",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "\t\t\t\t// A blank name would break the isKey on this column and put the",
                "// whole table into an invalid state, taking every visual that",
                "// touches it with it. PPAC leaves the name blank for Power",
                "// Automate flows, so this is routine rather than exceptional.",
                "// Those rows stay in the fact table and in every total - they",
                "// are just not selectable here, which a blank never was.",
                "FILTER(",
                "    DISTINCT(",
                "",
                "    UNION(",
                "    SELECTCOLUMNS( 'Credit Consumption (Tenant)', \"Environment Name\", 'Credit Consumption (Tenant)'[Environment_Name] ),",
                "    SELECTCOLUMNS( 'Credit Consumption (Agent)',  \"Environment Name\", 'Credit Consumption (Agent)'[Environment_Name] )",
                "    )",
                "",
                "    ),",
                "    NOT ISBLANK( [Environment Name] )",
                ")",
                ""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "StudioEnvironmentCreditLensViva"
          }
        ]
      },
      {
        "name": "Capacity Pack Balance",
        "description": [
          "Scenario input - Cowork prepaid Capacity Pack balance.",
          "",
          "The tenant's actual balance is a deployment setting (CapacityPackCredits),",
          "because no Viva Insights export carries it - it lives in the Microsoft 365",
          "admin centre under Cost management > Billing method.",
          "",
          "This slicer exists so a reader can ask \"what if we bought a pack of N",
          "credits\" without changing the tenant's configuration. Leave it unselected",
          "and the deployment setting applies; pick a value and it overrides.",
          "The override itself lives in Settings[Cowork Capacity Pack Balance Value]."
        ],
        "lineageTag": "c0000005-0001-4001-8001-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Capacity Pack Balance",
            "dataType": "int64",
            "isNameInferred": false,
            "sourceColumn": "[Value]",
            "formatString": "#,0",
            "lineageTag": "c0000005-0003-4001-8001-000000000003",
            "summarizeBy": "none",
            "extendedProperties": [
              {
                "type": "json",
                "name": "ParameterMetadata",
                "value": {
                  "version": 0
                }
              }
            ],
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Capacity Pack Balance",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "GENERATESERIES(0, 10000000, 250000)"
            }
          }
