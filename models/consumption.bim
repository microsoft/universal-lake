        "partitions": [
          {
            "name": "AzureSolutionSpend",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Raw = GetTable(\"azure_solution_spend\"),",
                "    Empty = #table(type table [UsageDate = nullable date, SubscriptionName = nullable text, SubscriptionId = nullable text, ResourceId = nullable text, ResourceName = nullable text, ResourceGroup = nullable text, Application = nullable text, DepartmentTag = nullable text, ServiceName = nullable text, ServiceCategory = nullable text, ActualCost = nullable number, AmortizedCost = nullable number, Currency = nullable text, TotalTokensM = nullable number, PaygTokensM = nullable number, InputPaygCost = nullable number, OutputPaygCost = nullable number, CachedPaygCost = nullable number, Requests = nullable number, SpeechHours = nullable number, DocumentPages = nullable number, Images = nullable number, AllocationStatus = nullable text, PricingModel = nullable text, BillingScope = nullable text], {}),",
                "    Result = if Raw = null then Empty else if Table.IsEmpty(Raw) then Empty else",
                "        let",
                "            Columns = List.Buffer(Table.ColumnNames(Raw)),",
                "            Names = {\"UsageDate\", \"SubscriptionName\", \"SubscriptionId\", \"ResourceId\", \"ResourceName\", \"ResourceGroup\", \"Application\", \"DepartmentTag\", \"ServiceName\", \"ServiceCategory\", \"ActualCost\", \"AmortizedCost\", \"Currency\", \"TotalTokensM\", \"PaygTokensM\", \"InputPaygCost\", \"OutputPaygCost\", \"CachedPaygCost\", \"Requests\", \"SpeechHours\", \"DocumentPages\", \"Images\", \"AllocationStatus\", \"PricingModel\", \"BillingScope\"},",
                "            Key = (s as text) as text => Text.Lower(Text.Remove(s, {\" \", \"_\", \"-\", \".\"})),",
                "            Pick = (name as text) as nullable text =>",
                "                if List.Contains(Columns, name) then name else",
                "                let Matches = List.Select(Columns, each Key(_) = Key(name))",
                "                in if List.Count(Matches) > 1 then error Error.Record(",
                "                    \"AmbiguousAzureColumn\", \"Use one canonical header per field.\", [Column=name])",
                "                    else List.First(Matches, null),",
                "            Bindings = List.Transform(Names, Pick),",
                "            Missing = List.Select(List.Positions(Names), each Bindings{_} = null),",
                "            Checked = if not List.IsEmpty(Missing) then error Error.Record(",
                "                \"AzureFeedSchema\", \"Supply every documented column; unknown values may be blank.\",",
                "                [MissingColumns=List.Transform(Missing, each Names{_})])",
                "                else Table.FromColumns(List.Transform(Bindings, each Table.Column(Raw, _)), Names),",
                "            Blanks = Table.TransformColumns(Checked, List.Transform(Names, (c) =>",
                "                {c, each if Value.Is(_, type text) and Text.Trim(_) = \"\" then null else _})),",
                "            Typed = Table.TransformColumnTypes(Blanks, {{\"UsageDate\", type nullable date}, {\"SubscriptionName\", type nullable text}, {\"SubscriptionId\", type nullable text}, {\"ResourceId\", type nullable text}, {\"ResourceName\", type nullable text}, {\"ResourceGroup\", type nullable text}, {\"Application\", type nullable text}, {\"DepartmentTag\", type nullable text}, {\"ServiceName\", type nullable text}, {\"ServiceCategory\", type nullable text}, {\"ActualCost\", type nullable number}, {\"AmortizedCost\", type nullable number}, {\"Currency\", type nullable text}, {\"TotalTokensM\", type nullable number}, {\"PaygTokensM\", type nullable number}, {\"InputPaygCost\", type nullable number}, {\"OutputPaygCost\", type nullable number}, {\"CachedPaygCost\", type nullable number}, {\"Requests\", type nullable number}, {\"SpeechHours\", type nullable number}, {\"DocumentPages\", type nullable number}, {\"Images\", type nullable number}, {\"AllocationStatus\", type nullable text}, {\"PricingModel\", type nullable text}, {\"BillingScope\", type nullable text}}, \"en-US\")",
                "        in Typed",
                "in",
                "    Result"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Azure Selected Cost",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency])",
              "VAR Basis = SELECTEDVALUE('Azure Cost Basis'[Cost Basis], \"Actual\")",
              "RETURN IF(NOT CurrencyOk, BLANK(), SWITCH(Basis, \"Amortized\", SUM('AzureSolutionSpend'[AmortizedCost]), SUM('AzureSolutionSpend'[ActualCost])))))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "61790f8f-62a1-7c6a-cdab-c7ead49991ba"
          },
          {
            "name": "Azure Model Cost",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (CALCULATE([Azure Selected Cost], KEEPFILTERS('AzureSolutionSpend'[ServiceCategory] = \"Model\"))))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "7304b539-abbd-d0ac-892a-c861cdbd2ec5"
          },
          {
            "name": "Azure AI Service Cost",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (CALCULATE([Azure Selected Cost], KEEPFILTERS('AzureSolutionSpend'[ServiceCategory] = \"AI service\"))))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "15634e68-5ac9-4f22-eded-8657a4dc942c"
          },
          {
            "name": "Azure Supporting Cost",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (CALCULATE([Azure Selected Cost], KEEPFILTERS('AzureSolutionSpend'[ServiceCategory] = \"Supporting\"))))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "f3ec6d7d-a8f1-1230-914d-455118592e78"
          },
          {
            "name": "Azure Model Share %",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (DIVIDE([Azure Model Cost], [Azure Selected Cost])))"
            ],
            "formatString": "0.0%",
            "displayFolder": "Azure prototype",
            "lineageTag": "8cf737b0-edf6-582b-75ff-31a4e2165184"
          },
          {
            "name": "Azure Tagged Allocation %",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (DIVIDE(CALCULATE([Azure Selected Cost], KEEPFILTERS('AzureSolutionSpend'[AllocationStatus] = \"Tagged\")), [Azure Selected Cost])))"
            ],
            "formatString": "0.0%",
            "displayFolder": "Azure prototype",
            "lineageTag": "e8eb5645-4e92-0018-4b83-b2af3784ce3e"
          },
          {
            "name": "Azure AI Requests",
            "expression": "SUM('AzureSolutionSpend'[Requests])",
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "34cf7fe7-0e86-824a-2bf3-10ea559e6a42"
          },
          {
            "name": "Azure Total Tokens (M)",
            "expression": "SUM('AzureSolutionSpend'[TotalTokensM])",
            "formatString": "#,0.0",
            "displayFolder": "Azure prototype",
            "lineageTag": "6279c94c-b386-9334-72c9-ea1f99e3a3c3"
          },
          {
            "name": "Azure PAYG Tokens (M)",
            "expression": "SUM('AzureSolutionSpend'[PaygTokensM])",
            "formatString": "#,0.0",
            "displayFolder": "Azure prototype",
            "lineageTag": "af8ca157-20a2-15a2-d6fe-6d9f98a90c46"
          },
          {
            "name": "Azure PAYG Token Cost",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (SUM('AzureSolutionSpend'[InputPaygCost]) + SUM('AzureSolutionSpend'[OutputPaygCost]) + SUM('AzureSolutionSpend'[CachedPaygCost])))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "501cf14b-75cc-62ad-11cf-c4467e18ad06"
          },
          {
            "name": "Azure Provisioned Model Cost",
            "description": "Selected-basis model cost less observed PAYG components; blank if either input is missing. Not a savings estimate.",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (VAR ModelCost = [Azure Model Cost]",
              "VAR PaygCost = [Azure PAYG Token Cost]",
              "RETURN IF(NOT ISBLANK(ModelCost) && NOT ISBLANK(PaygCost), ModelCost - PaygCost)))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "4ceabdfe-e809-cd0f-6f99-39e7a2e67045"
          },
          {
            "name": "Azure Cost per 1M PAYG Tokens",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (DIVIDE([Azure PAYG Token Cost], [Azure PAYG Tokens (M)])))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Azure prototype",
            "lineageTag": "bdfddf61-7b2b-39db-2293-72220a244928"
          },
          {
            "name": "Azure Input PAYG Cost",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (SUM('AzureSolutionSpend'[InputPaygCost])))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "4e2b9b1f-11eb-6173-d33b-a8abcf3ad8a9"
          },
          {
            "name": "Azure Output PAYG Cost",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (SUM('AzureSolutionSpend'[OutputPaygCost])))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "57463b9d-4494-5db3-fba2-0147ec14298f"
          },
          {
            "name": "Azure Cached PAYG Cost",
            "expression": [
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyOk = HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3",
              "RETURN IF(CurrencyOk, (SUM('AzureSolutionSpend'[CachedPaygCost])))"
            ],
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "8a14f290-8479-897c-1e01-4e3c153089b4"
          },
          {
            "name": "Azure Speech Hours",
            "expression": "SUM('AzureSolutionSpend'[SpeechHours])",
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "9ace4b8d-cdd8-8e95-d729-36185d250f93"
          },
          {
            "name": "Azure Document Pages",
            "expression": "SUM('AzureSolutionSpend'[DocumentPages])",
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "d34e94bc-1c35-8cac-d9e6-e7b854b9c09a"
          },
          {
            "name": "Azure Generated Images",
            "expression": "SUM('AzureSolutionSpend'[Images])",
            "formatString": "#,0",
            "displayFolder": "Azure prototype",
            "lineageTag": "a8067360-bf89-d488-2d71-ea877812c9ee"
          },
          {
            "name": "Azure Spend Context",
            "expression": [
              "VAR Basis = SELECTEDVALUE('Azure Cost Basis'[Cost Basis], \"Actual\")",
              "VAR CurrencyCode = SELECTEDVALUE('AzureSolutionSpend'[Currency])",
              "VAR CurrencyLabel = IF(HASONEVALUE('AzureSolutionSpend'[Currency]) && NOT ISBLANK(CurrencyCode) && LEN(TRIM(CurrencyCode)) = 3, CurrencyCode, \"Mixed/missing currency - costs hidden\")",
              "VAR _FirstDate = MIN('AzureSolutionSpend'[UsageDate])",
              "VAR _LastDate = MAX('AzureSolutionSpend'[UsageDate])",
              "RETURN Basis & IF(NOT HASONEVALUE('Azure Cost Basis'[Cost Basis]), \" (default)\", \"\") & \" | \" & CurrencyLabel & \" | \" & IF(ISBLANK(_FirstDate), \"No spend data\", FORMAT(_FirstDate, \"yyyy-MM-dd\") & \" to \" & FORMAT(_LastDate, \"yyyy-MM-dd\"))"
            ],
            "displayFolder": "Azure prototype",
            "lineageTag": "5ff0ff90-7ac1-23b4-a90c-596ccc914892"
          }
        ],
        "annotations": [
