      {
        "name": "BillingPeriodWeeks",
        "kind": "m",
        "expression": "4 meta [IsParameterQuery=true, Type=\"Number\", IsParameterQueryRequired=false]",
        "lineageTag": "4f1b7d05-9e62-4c38-8a54-1d6f9b8e3a97",
