      {
        "name": "VivaPolicyLookup",
        "description": [
          "Spending policy names and limits, from the Lakehouse.",
          "",
          "Optional: the limits already travel inline on the metrics rows, so without",
          "this the report still prices correctly and policies show as their GUID."
        ],
        "kind": "m",
        "expression": [
          "let",
          "\tTbl = GetTable(\"viva_spending_policy\"),",
          "\tEmpty = #table(",
          "\t\ttype table [SpendingPolicyId = text, Name = text,",
          "\t\t            PlanLimit = Int64.Type, UserLimit = Int64.Type,",
          "\t\t            IncludedServices = text], {})",
          "in",
          "\tif Tbl = null then Empty",
          "\telse",
          "\t\tTable.TransformColumnTypes(",
          "\t\t\tTable.RenameColumns(",
          "\t\t\t\tTable.SelectColumns(Tbl, {",
          "\t\t\t\t\t\"spending_policy_id\", \"name\", \"plan_limit\",",
          "\t\t\t\t\t\"user_limit\", \"included_services\"",
          "\t\t\t\t}, MissingField.UseNull),",
          "\t\t\t\t{",
          "\t\t\t\t\t{\"spending_policy_id\", \"SpendingPolicyId\"},",
          "\t\t\t\t\t{\"name\", \"Name\"}, {\"plan_limit\", \"PlanLimit\"},",
          "\t\t\t\t\t{\"user_limit\", \"UserLimit\"},",
          "\t\t\t\t\t{\"included_services\", \"IncludedServices\"}",
          "\t\t\t\t}),",
          "\t\t\t{{\"PlanLimit\", Int64.Type}, {\"UserLimit\", Int64.Type}})"
        ],
        "lineageTag": "5a2c8e16-0f73-4d49-9b65-2e7a0c9f4b19",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "VivaSeatRosterFromFiles",
        "description": [
          "Always null on the Fabric path.",
          "",
          "The person/policy map files are an artefact of the de-identified CSV",
          "export; no ingester notebook produces a roster table. VivaSeatRoster",
          "therefore always falls through to deriving the roster from the metrics.",
          "",
          "Same limitation as the identified CSV path, and worth knowing: a derived",
          "roster only sees people who CONSUMED something, so a seat holder with no",
          "usage is not counted. Seat totals are usage-based rather than",
          "entitlement-based here."
        ],
        "kind": "m",
        "expression": "null",
        "lineageTag": "7c4e0a38-2b95-4f61-9d87-4a9c2e1b6d30",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "VivaSeatRosterFromMetrics",
        "kind": "m",
        "expression": [
          "let",
          "\tRows = Table.SelectColumns(VivaCreditMetrics,",
          "\t\t{\"PersonId\",\"UserPrincipalName\",\"SpendingPolicyId\",\"CreditsUsed\",\"UserLimit\"}),",
          "\t// One row per person. Someone whose usage spans two policies would",
          "\t// otherwise appear twice and double every figure that joins on PersonId.",
          "\t// The all-zero GUID marks usage outside any policy window, so a real",
          "\t// policy is preferred when the person has both.",
          "\tGrouped = Table.Group(Rows, {\"PersonId\"}, {",
          "\t\t{\"UpnRaw\", each List.First(List.RemoveNulls([UserPrincipalName]), null), type text},",
          "\t\t{\"SpendingPolicyId\", each",
          "\t\t\tlet",
          "\t\t\t\tReal = List.Select([SpendingPolicyId],",
          "\t\t\t\t\teach _ <> null and _ <> \"00000000-0000-0000-0000-000000000000\")",
          "\t\t\tin",
          "\t\t\t\tif List.Count(Real) > 0 then List.First(Real) else List.First([SpendingPolicyId]),",
          "\t\t type text},",
          "\t\t// The metrics file can carry a per-person seat limit alongside the",
          "\t\t// policy id. That inline figure is the person's actual allowance and",
          "\t\t// takes priority over the policy default further down.",
          "\t\t{\"InlineUserLimit\", each List.First(List.RemoveNulls([UserLimit]), null), type nullable number}",
          "\t}),",
          "\t// A de-identified export carries no UPN, so fall back to the person key.",
          "\t// Without this every downstream count of people is a count of nulls -",
          "\t// which reads as one user rather than nine hundred.",
          "\tResolved = Table.AddColumn(Grouped, \"UserPrincipalName\",",
          "\t\teach if [UpnRaw] = null or [UpnRaw] = \"\" then [PersonId] else [UpnRaw], type text),",
          "\tDropped = Table.RemoveColumns(Resolved, {\"UpnRaw\"}),",
          "\tNamed = Table.AddColumn(Dropped, \"displayName\",",
          "\t\teach if Text.Contains([UserPrincipalName], \"@\")",
          "\t\t     then Text.BeforeDelimiter([UserPrincipalName], \"@\")",
          "\t\t     else [UserPrincipalName], type text),",
          "\tJoinPol = Table.NestedJoin(Named, {\"SpendingPolicyId\"}, VivaPolicyLookup, {\"SpendingPolicyId\"}, \"pol\", JoinKind.LeftOuter),",
          "\tExpPol = Table.ExpandTableColumn(JoinPol, \"pol\", {\"Name\",\"PlanLimit\",\"UserLimit\"}, {\"PolicyName\",\"PlanLimit\",\"PolicySeatLimit\"}),",
          "\t// The inline per-person limit wins when present; only fall back to the",
          "\t// policy's UserLimit when the metrics row carried no limit of its own.",
          "\tAddSeat = Table.AddColumn(ExpPol, \"SeatLimit\",",
          "\t\teach if [InlineUserLimit] <> null then [InlineUserLimit] else [PolicySeatLimit], type nullable number),",
          "\tDropHelpers = Table.RemoveColumns(AddSeat, {\"InlineUserLimit\",\"PolicySeatLimit\"}),",
          "\t// Organization arrives from the Entra export, joined by UPN in the Org",
          "\t// table. IsCopilotLicensed is not carried by the consumption export at",
          "\t// all, so it is left unknown rather than guessed - CoworkBilling renders",
          "\t// an unknown licence as \"No\".",
          "\tAddOrg = Table.AddColumn(DropHelpers, \"Organization\", each null, type text),",
          "\tAddLic = Table.AddColumn(AddOrg, \"IsCopilotLicensed\", each null, type logical),",
          "\tAddPhid = Table.AddColumn(AddLic, \"PeopleHistoricalId\", each [PersonId], type text),",
          "\tRenamed = Table.RenameColumns(AddPhid, {{\"UserPrincipalName\",\"userPrincipalName\"}})",
          "in",
          "\tRenamed"
        ],
        "lineageTag": "7c4e0a38-2b95-4f61-9d87-4a9c2e1b6d31",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "VivaOrgFromMetrics",
        "kind": "m",
        "expression": [
          "let",
          "    Source = VivaCreditMetrics,",
          "    Key = (n as text) as text => Text.Lower(Text.Remove(n, {\" \", \"_\", \"-\"})),",
          "    NotOrg = {",
          "        \"userprincipalname\", \"upn\", \"userprincipal\", \"email\", \"mail\",",
          "        \"entraid\", \"entraobjectid\", \"objectid\", \"aadobjectid\", \"aadid\", \"aad\",",
          "        \"personid\", \"personidnormalized\", \"personidnormalised\",",
          "        \"peoplehistoricalid\", \"personhistoricalid\", \"phid\",",
          "        \"serviceid\", \"servicename\", \"spendingpolicyid\", \"spendingpolicyname\",",
          "        \"policyname\", \"policylimit\", \"policyservicesincluded\", \"includedservices\",",
          "        \"metricdate\", \"date\", \"week\", \"weekstart\", \"sessioncount\",",
          "        \"spendingpolicylimit\", \"totalcopilotcreditsused\", \"creditsused\", \"userlimit\", \"planlimit\",",
          "        \"iscopilotlicensed\", \"standardtimezone\", \"timezone\"",
          "    },",
          "    OrgCols = List.Select(Table.ColumnNames(Source), each not List.Contains(NotOrg, Key(_))),",
          "    Clean = (v as any) as nullable text =>",
          "        if v = null then null else let t = Text.Trim(Text.From(v)) in if t = \"\" then null else t,",
          "    Result =",
          "        if List.IsEmpty(OrgCols) then null",
          "        else",
          "            let",
          "                Picked = Table.SelectColumns(Source, {\"PersonId\"} & OrgCols),",
          "                AsText = Table.TransformColumns(Picked,",
          "                    List.Transform(OrgCols, each {_, Clean, type nullable text})),",
          "                // Group before joining: roster resolves all weeks of a person to one key.",
          "                Grouped = Table.Buffer(Table.Group(AsText, {\"PersonId\"}, List.Transform(OrgCols, (c) =>",
          "                    {c, each List.First(List.RemoveNulls(Table.Column(_, c)), null), type nullable text}))),",
          "                Joined = Table.NestedJoin(VivaSeatRoster, {\"PersonId\"}, Grouped, {\"PersonId\"},",
          "                    \"__attributes\", JoinKind.LeftOuter),",
          "                Expanded = Table.Buffer(Table.ExpandTableColumn(",
          "                    Table.SelectColumns(Joined, {\"userPrincipalName\", \"__attributes\"}), \"__attributes\", OrgCols)),",
          "                Named = Table.RenameColumns(Expanded, {{\"userPrincipalName\", \"UserPrincipalName\"}}),",
          "                NormalKeys = Table.Buffer(Table.TransformColumns(Named, {{\"UserPrincipalName\",",
          "                    each if _ = null then null else Text.Lower(Text.Trim(Text.From(_))), type nullable text}})),",
          "                Live = List.Select(OrgCols, (c) => List.NonNullCount(Table.Column(NormalKeys, c)) > 0)",
          "            in",
          "                if List.IsEmpty(Live) then null",
          "                else Table.SelectColumns(NormalKeys, {\"UserPrincipalName\"} & Live)",
          "in",
          "    Result",
          ""
        ],
        "lineageTag": "fb000010-0001-4001-8001-000000000001",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "description": [
          "Department, cost centre and so on, from the Lakehouse.",
          "",
          "The ingester notebook already alias-matched the tenant's own spellings and",
          "created any absent attribute as empty, so this only has to rename.",
          "",
          "No org table is a supported state - Group By then has nothing to offer and"
        ]
      },
      {
        "name": "VivaOrgFromPeople",
        "description": [
          "Org attributes from a Viva people table, when the pipeline writes one.",
          "",
          "OPTIONAL and absent today - the Viva ingester writes viva_credits_weekly",
          "and viva_spending_policy only. Reading for it now means the notebook can",
          "start writing one later without a model change, and costs nothing when it",
          "does not exist: GetTable returns null rather than failing.",
          "",
          "Joined on people_historical_id, which the metrics table already carries."
        ],
        "kind": "m",
        "expression": [
          "let",
          "    // Prefer the shared org table so a single org ingestion feeds both templates,",
          "    // then fall back to the original Consumption Central name for existing deployments.",
          "    OrgTableNames = {\"copilot_org_data\", \"org_attributes\"},",
          "    Tbl = List.First(",
          "        List.Select(",
          "            List.RemoveNulls(List.Transform(OrgTableNames, GetTable)),",
          "            each not Table.IsEmpty(_)),",
          "        null),",
          "    Key = (n as text) as text => Text.Lower(Text.Remove(n, {\" \", \"_\", \"-\"})),",
          "    Ident = (v as any) as nullable text =>",
          "        if v = null then null else let t = Text.Lower(Text.Trim(Text.From(v))) in if t = \"\" then null else t,",
          "    IdAliases = {",
          "        \"personid\", \"personidnormalized\", \"personidnormalised\",",
          "        \"userprincipalname\", \"upn\", \"userprincipal\", \"email\", \"mail\",",
          "        \"entraid\", \"entraobjectid\", \"objectid\", \"aadobjectid\", \"aadid\",",
          "        \"peoplehistoricalid\", \"personhistoricalid\", \"phid\"",
          "    },",
          "    // copilot_org_data is a full directory (tens of thousands of rows), while org_attributes",
          "    // was already scoped. Without this filter the directory sets the grain of Org and every",
          "    // per-user count reports the whole company instead of the licensed population.",
          "    RosterKeys = List.Buffer(List.Distinct(List.RemoveNulls(",
          "        List.Transform(VivaSeatRoster[PersonId], Ident)",
          "        & List.Transform(VivaSeatRoster[userPrincipalName], Ident)))),",
          "    // Record lookup gives an O(1) membership test; List.Contains would rescan per row.",
          "    RosterSet = Record.FromList(List.Repeat({true}, List.Count(RosterKeys)), RosterKeys),",
          "    InRoster = (v as any) as logical =>",
          "        let k = Ident(v) in if k = null then false else Record.FieldOrDefault(RosterSet, k, false),",
          "    Result =",
          "        if Tbl = null or Table.IsEmpty(Tbl) then null",
          "        else",
          "            let",
          "                Typed = Table.TransformColumnTypes(Tbl,",
          "                    List.Transform(Table.ColumnNames(Tbl), each {_, type text})),",
          "                Trimmed = Table.TransformColumns(Typed,",
          "                    List.Transform(Table.ColumnNames(Typed), each",
          "                        {_, (v) => if v = null then null else Text.Trim(Text.From(v)), type nullable text})),",
          "                IdCols = List.Select(Table.ColumnNames(Trimmed), each List.Contains(IdAliases, Key(_))),",
          "                Scoped =",
          "                    if List.IsEmpty(RosterKeys) or List.IsEmpty(IdCols) then Trimmed",
          "                    else Table.SelectRows(Trimmed,",
          "                        (row) => List.AnyTrue(List.Transform(IdCols, each InRoster(Record.Field(row, _))))),",
          "                Final = if Table.IsEmpty(Scoped) then Trimmed else Scoped",
          "            in",
          "                Final",
          "in",
          "    Result"
        ],
        "lineageTag": "fb000010-0002-4001-8001-000000000002",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Assumptions\",\"CoworkBilling\",\"CreditsWeekly\",\"SpendingPolicy\",\"Org\",\"SecurityFilter\",\"BillingPeriodWeeks\",\"VivaCreditMetrics\",\"VivaPeriodStart\",\"VivaSeatRoster\",\"Credit Consumption (Tenant)\",\"Credit Consumption (Agent)\",\"Credit Consumption (User)\",\"Org Attribute Source\",\"Settings\",\"GitHub Usage\",\"GitHub User\",\"AzureAiSpend\",\"AzureAiTokens\",\"FabricSQLEndpoint\",\"LakehouseName\",\"FabricSource\",\"GetTable\",\"CommercialTerms\",\"TermOrDefault\",\"OrgNormalised\",\"CreditRate\",\"PrepaidCreditRate\",\"PrepaidCreditBalance\",\"GitHubBusinessSeatPrice\",\"GitHubEnterpriseSeatPrice\",\"VivaPolicyLookup\",\"VivaSeatRosterFromFiles\",\"VivaSeatRosterFromMetrics\",\"VivaOrgFromMetrics\",\"VivaOrgFromPeople\",\"AzureSolutionSpend\",\"AzureDeploymentHealth\",\"AzureBillingReconciliation\"]"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"MCP-PBIModeling\",\"DevMode\"]"
      }
